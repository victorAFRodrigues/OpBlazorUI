@namespace OpBlazorUI.Components.Menu
@using OpBlazorUI.Models
@using OpBlazorUI.Components.Common
@using OpBlazorUI.Components.Overlay
@inherits OpComponentBase

<span class="op-contextmenu-host" @ref="_host" hidden></span>

@if (_visible)
{
    <div class="@RootClass" @ref="_panel" @attributes="AdditionalAttributes">
        <OpOverlayAttach Anchor="_anchor" Coordinate="_coordinate"
                         AnchorPrevious="@(_anchor is null && _coordinate is null)"
                         Layer="menu" Gap="2" OnOutsideClick="HideAsync" OnEscape="HideAsync"/>
        <OpMenuItems Items="Model"
                     Prefix="contextmenu"
                     Root="true"
                     IsOpen="IsOpen"
                     OnToggle="ToggleSubmenuAsync"
                     OnItemClick="HandleItemClickAsync"/>
    </div>
}
