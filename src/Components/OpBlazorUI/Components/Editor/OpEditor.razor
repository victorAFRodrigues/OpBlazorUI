@namespace OpBlazorUI.Components.Editor
@using OpBlazorUI.Components.Common
@inherits OpComponentBase

<div class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="p-editor-toolbar" @ref="_toolbarRef">
        @if (HeaderTemplate != null)
        {
            @HeaderTemplate
        }
        else
        {
            <span class="ql-formats">
                <select class="ql-header">
                    <option value="1">@Tr.Editor.Heading1</option>
                    <option value="2">@Tr.Editor.Heading2</option>
                    <option selected>@Tr.Editor.Normal</option>
                </select>
            </span>
            <span class="ql-formats">
                <button type="button" class="ql-bold" aria-label="@Tr.Editor.Bold"></button>
                <button type="button" class="ql-italic" aria-label="@Tr.Editor.Italic"></button>
                <button type="button" class="ql-underline" aria-label="@Tr.Editor.Underline"></button>
            </span>
            <span class="ql-formats">
                <select class="ql-color" aria-label="@Tr.Editor.TextColor"></select>
                <select class="ql-background" aria-label="@Tr.Editor.BackgroundColor"></select>
            </span>
            <span class="ql-formats">
                <button type="button" class="ql-list" value="ordered" aria-label="@Tr.Editor.OrderedList"></button>
                <button type="button" class="ql-list" value="bullet" aria-label="@Tr.Editor.UnorderedList"></button>
                <select class="ql-align" aria-label="@Tr.Editor.Align">
                    <option selected></option>
                    <option value="center"></option>
                    <option value="right"></option>
                    <option value="justify"></option>
                </select>
            </span>
            <span class="ql-formats">
                <button type="button" class="ql-link" aria-label="@Tr.Editor.InsertLink"></button>
                <button type="button" class="ql-image" aria-label="@Tr.Editor.InsertImage"></button>
                <button type="button" class="ql-code-block" aria-label="@Tr.Editor.CodeBlock"></button>
            </span>
            <span class="ql-formats">
                <button type="button" class="ql-clean" aria-label="@Tr.Editor.ClearFormatting"></button>
            </span>
        }
    </div>
    <div class="p-editor-content" @ref="_contentRef"></div>
    @if (_loadFailed)
    {
        <div class="p-message p-message-error p-message-outlined p-message-sm" role="alert">
            <div class="p-message-content">
                <span class="p-message-text">@Tr.Editor.LoadError</span>
            </div>
        </div>
    }
</div>
