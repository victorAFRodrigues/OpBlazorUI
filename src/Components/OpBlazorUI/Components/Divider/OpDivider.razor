@namespace OpBlazorUI.Components.Divider
@using OpBlazorUI.Components.Common
@inherits OpComponentBase

<div class="@RootClass"
     role="separator"
     aria-orientation="@(Layout == "vertical" ? "vertical" : "horizontal")"
     style="@RootStyle"
     @attributes="AdditionalAttributes">
    @if (ChildContent != null)
    {
        <div class="p-divider-content">@ChildContent</div>
    }
</div>
