@namespace OpBlazorUI.Components.InputText
@using OpBlazorUI.Components.Forms
@inherits OpInputBase<string>

<input type="@Type"
       class="@RootClass"
       value="@Value"
       placeholder="@Placeholder"
       id="@Id"
       name="@(Name ?? NameAttributeValue)"
       aria-label="@AriaLabel"
       aria-invalid="@(IsInvalid ? "true" : null)"
       maxlength="@MaxLength"
       autocomplete="@Autocomplete"
       disabled="@Disabled"
       readonly="@Readonly"
        @oninput="HandleInput"
        @onchange="HandleChange"
        @onfocus="OnFocus"
        @onblur="HandleBlur"
        @onkeydown="OnKeyDown"
        @ref="_input"
       @attributes="AdditionalAttributes"/>
