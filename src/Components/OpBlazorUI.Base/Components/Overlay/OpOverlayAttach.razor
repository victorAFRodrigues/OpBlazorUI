@namespace OpBlazorUI.Base.Components.Overlay
@using Microsoft.JSInterop
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase

@* Marcador invisível: o painel conectado é o elemento pai deste span. *@
<span @ref="_marker" hidden aria-hidden="true" data-op-overlay-marker></span>

@code {
    private ElementReference _marker;
    private bool _attached;
    private bool _disposed;
    private DotNetObjectReference<OpOverlayAttach>? _selfRef;
    private (bool Outside, bool Escape) _appliedDismiss;
    private string? _appliedAnchorId;
    private string? _appliedAnchorSelector;
    private (double X, double Y)? _appliedCoordinate;

    /// <summary>Elemento de referência. Sem âncora, o painel só recebe o z-index da camada.</summary>
    [Parameter] public ElementReference? Anchor { get; set; }

    /// <summary>Seletor CSS da âncora, resolvido no cliente (ex.: <c>#alvo</c>). Usado sem <see cref="Anchor"/>.</summary>
    [Parameter] public string? AnchorSelector { get; set; }

    /// <summary>
    /// Âncora virtual por coordenadas (px do viewport). Usada quando não há elemento
    /// (ex.: ContextMenu aberto nas coordenadas do mouse). Tem precedência sobre <see cref="Anchor"/>.
    /// </summary>
    [Parameter] public (double X, double Y)? Coordinate { get; set; }

    /// <summary>Sem <see cref="Anchor"/>, usa o elemento irmão anterior do painel como âncora.</summary>
    [Parameter] public bool AnchorPrevious { get; set; }

    /// <summary>Camada de z-index: <c>overlay</c>, <c>menu</c>, <c>modal</c> ou <c>tooltip</c>.</summary>
    [Parameter] public string Layer { get; set; } = "overlay";

    [Parameter] public int BaseZIndex { get; set; }

    /// <summary>Aplica o z-index da camada. Desligado, o overlay só registra clique fora/Escape.</summary>
    [Parameter] public bool AutoZIndex { get; set; } = true;

    /// <summary>Lado preferido: <c>bottom</c>, <c>top</c>, <c>left</c> ou <c>right</c>. Inverte se não couber.</summary>
    [Parameter] public string Placement { get; set; } = "bottom";

    /// <summary><c>start</c> alinha à borda inicial da âncora; <c>center</c> centraliza.</summary>
    [Parameter] public string Align { get; set; } = "start";

    /// <summary>Largura mínima igual à da âncora (padrão dos selects).</summary>
    [Parameter] public bool MatchWidth { get; set; }

    /// <summary>Distância em px entre âncora e painel.</summary>
    [Parameter] public double Gap { get; set; }

    /// <summary>Mantém a margem do tema (o Popover usa a margem como espaço da seta).</summary>
    [Parameter] public bool KeepMargin { get; set; }

    /// <summary>Alinhamento da seta: <c>popover</c>, <c>tooltip</c> ou nulo.</summary>
    [Parameter] public string? Arrow { get; set; }

    /// <summary>Dá ao irmão anterior do painel (a máscara) o z-index do painel menos 1.</summary>
    [Parameter] public bool MaskPrevious { get; set; }

    /// <summary>
    /// Disparado num <c>pointerdown</c> fora do painel, da âncora e de overlays abertos acima
    /// deste. Só é registrado quando há handler e <see cref="Dismissable"/> é <c>true</c>.
    /// </summary>
    [Parameter] public EventCallback OnOutsideClick { get; set; }

    /// <summary>
    /// Disparado no Escape quando este é o overlay do topo que aceita Escape. A tecla não
    /// propaga, então overlays abaixo (ex.: o Dialog que contém um Select) não a recebem.
    /// </summary>
    [Parameter] public EventCallback OnEscape { get; set; }

    /// <summary>Liga/desliga o fechamento por clique fora sem remover o handler.</summary>
    [Parameter] public bool Dismissable { get; set; } = true;

    private bool DismissOutside => OnOutsideClick.HasDelegate && Dismissable;
    private bool DismissEscape => OnEscape.HasDelegate;

    private object Options => new
    {
        layer = Layer,
        baseZIndex = BaseZIndex,
        autoZIndex = AutoZIndex,
        positioned = Anchor is not null || AnchorPrevious || Coordinate is not null || !string.IsNullOrEmpty(AnchorSelector),
        anchorPrevious = AnchorPrevious,
        anchorSelector = AnchorSelector,
        coordinate = Coordinate is null ? (object?)null : new { x = Coordinate.Value.X, y = Coordinate.Value.Y },
        placement = Placement,
        align = Align,
        matchWidth = MatchWidth,
        gap = Gap,
        keepMargin = KeepMargin,
        arrow = Arrow,
        maskPrevious = MaskPrevious,
        dismissOutside = DismissOutside,
        dismissEscape = DismissEscape
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;

        var dismiss = (DismissOutside, DismissEscape);
        if (dismiss is not (false, false))
        {
            _selfRef ??= DotNetObjectReference.Create(this);
        }

        if (firstRender)
        {
            await Interop.InvokeVoidAsync(OpInterop.OverlayInterop, "attachParent", _marker, Anchor, Options, _selfRef);
            _appliedDismiss = dismiss;
            _appliedAnchorId = Anchor?.Id;
            _appliedAnchorSelector = AnchorSelector;
            _appliedCoordinate = Coordinate;
            if (!_disposed) _attached = true;
            return;
        }

        if (_attached && dismiss != _appliedDismiss)
        {
            _appliedDismiss = dismiss;
            await Interop.InvokeVoidAsync(OpInterop.OverlayInterop, "updateDismissParent", _marker, Anchor, Options, _selfRef);
        }

        // Reancora quando o alvo (elemento, seletor ou coordenadas) muda com o painel aberto.
        if (_attached && (Anchor?.Id != _appliedAnchorId || AnchorSelector != _appliedAnchorSelector || Coordinate != _appliedCoordinate))
        {
            _appliedAnchorId = Anchor?.Id;
            _appliedAnchorSelector = AnchorSelector;
            _appliedCoordinate = Coordinate;
            await Interop.InvokeVoidAsync(OpInterop.OverlayInterop, "repositionParent", _marker, Anchor, Options);
        }
    }

    /// <summary>Recalcula a posição (ex.: após o conteúdo do painel mudar de tamanho).</summary>
    public async Task UpdateAsync()
    {
        if (!_attached) return;
        await Interop.InvokeVoidAsync(OpInterop.OverlayInterop, "updateParent", _marker);
    }

    [JSInvokable]
    public Task OnOverlayOutsideClick() => _disposed || !DismissOutside ? Task.CompletedTask : OnOutsideClick.InvokeAsync();

    [JSInvokable]
    public Task OnOverlayEscape() => _disposed || !DismissEscape ? Task.CompletedTask : OnEscape.InvokeAsync();

    public override async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;

        if (_attached)
        {
            await Interop.InvokeVoidAsync(OpInterop.OverlayInterop, "detachParent", _marker);
        }

        _selfRef?.Dispose();
        await base.DisposeAsync();
    }
}
