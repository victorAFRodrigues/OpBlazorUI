@namespace OpBlazorUI.Base.Components.Overlay

@if (Visible)
{
    @if (Mode == "modal")
    {
        <div class="@MaskClass"
             style="@MaskStyle"
             @onclick="OnMaskClick"
             @attributes="AdditionalAttributes">
            <OpOverlayAttach Layer="modal" OnEscape="EscapeCallback"/>
            <div class="@RootClass" style="@Style" role="dialog" aria-modal="true">
                <div class="@ContentClass" style="@ContentStyle" @onclick:stopPropagation="true">@ChildContent</div>
            </div>
        </div>
    }
    else
    {
        <div class="@RootClass"
             style="@Style"
             role="dialog"
             @attributes="AdditionalAttributes">
            <OpOverlayAttach Layer="overlay"
                             AnchorSelector="@TargetSelector"
                             OnOutsideClick="OutsideCallback"
                             OnEscape="EscapeCallback"/>
            <div class="@ContentClass" style="@ContentStyle">@ChildContent</div>
        </div>
    }
}
