@namespace OpBlazorUI.Base.Components.SpeedDial
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.Tooltip
@using OpBlazorUI.Base.Models

<div @ref="_root" class="@RootClass" style="@RootStyle" @attributes="AdditionalAttributes">
    @if (ButtonTemplate != null)
    {
        var ctx = new SpeedDialButtonContext { Toggle = () => _ = Toggle() };
        @ButtonTemplate(ctx)
    }
    else
    {
        <OpButton StyleClass="@ButtonClass"
                  Icon="@ButtonIconClass"
                  IconTemplate="@IconTemplate"
                  Severity="@ButtonSeverity"
                  Rounded="true"
                  Raised="@ButtonRaised"
                  Text="@ButtonText"
                  Outlined="@ButtonOutlined"
                  Size="@ButtonSize"
                  Disabled="@Disabled"
                  AriaLabel="@AriaLabel"
                  TabIndex="@ButtonTabIndex"
                  style="@ButtonStyle"
                  aria-haspopup="menu"
                  aria-expanded="@(_visible ? "true" : "false")"
                  aria-controls="@($"{_id}_list")"
                  aria-labelledby="@AriaLabelledBy"
                  OnClick="OnButtonClick"/>
    }

    <ul class="p-speeddial-list" role="menu" id="@($"{_id}_list")" style="@ListStyle">
        @for (var i = 0; i < Items.Count; i++)
        {
            var item = Items[i];
            <li class="@ItemClass(item)" role="menuitem" id="@($"{_id}_{i}")" aria-label="@item.Label" style="@ItemStyle(i)">
                @if (Tooltip)
                {
                    <OpTooltip Content="@item.Label" Position="@TooltipPosition">
                        @RenderAction(item, i)
                    </OpTooltip>
                }
                else
                {
                    @RenderAction(item, i)
                }
            </li>
        }
    </ul>
</div>

@* Fora do root, como no upstream: um clique na máscara conta como clique fora. *@
@if (Mask && _visible)
{
    <div class="@MaskClass" style="@MaskStyle"></div>
}

@code {
    private RenderFragment RenderAction(OpMenuItem item, int index) => __builder =>
    {
        @if (ItemTemplate != null)
        {
            @ItemTemplate(ItemContext(item, index))
        }
        else
        {
            <OpButton StyleClass="p-speeddial-action" Icon="@item.Icon" Severity="secondary" Rounded="true"
                      Size="small" Disabled="@item.Disabled" TabIndex="@(_visible ? 0 : -1)"
                      AriaLabel="@item.Label" OnClick="() => OnItemClick(item)"/>
        }
    };
}
