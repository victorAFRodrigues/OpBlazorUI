@namespace OpBlazorUI.Base.Components.Breadcrumb
@using OpBlazorUI.Base.Models
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase

<nav class="@RootClass" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    <ul class="p-breadcrumb-list">
        @if (Home is not null && Home.Visible)
        {
            <li class="p-breadcrumb-item">
                @if (HomeTemplate is not null)
                {
                    @HomeTemplate(Home)
                }
                else if (Home.Disabled)
                {
                    <span class="p-breadcrumb-item-link p-disabled" aria-disabled="true">
                        @ItemContent(Home)
                    </span>
                }
                else
                {
                    <a class="p-breadcrumb-item-link" href="@Home.Url" target="@Home.Target" rel="@TargetRel(Home)"
                       @onclick="() => InvokeCommand(Home)" @onclick:preventDefault="@(Home.Command is not null)">
                        @ItemContent(Home)
                    </a>
                }
            </li>
            <li class="p-breadcrumb-separator">
                <i class="@SeparatorIconClass" aria-hidden="true"></i>
            </li>
        }

        @{
            var items = VisibleModel;
        }
        @for (var i = 0; i < items.Count; i++)
        {
            var item = items[i];
            var last = i == items.Count - 1;

            <li class="p-breadcrumb-item">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else if (last)
                {
                    <span class="p-breadcrumb-item-label" aria-current="page">@item.Label</span>
                }
                else if (item.Disabled)
                {
                    <span class="p-breadcrumb-item-link p-disabled" aria-disabled="true">
                        @ItemContent(item)
                    </span>
                }
                else
                {
                    <a class="p-breadcrumb-item-link" href="@item.Url" target="@item.Target" rel="@TargetRel(item)"
                       @onclick="() => InvokeCommand(item)" @onclick:preventDefault="@(item.Command is not null)">
                        @ItemContent(item)
                    </a>
                }
            </li>

            @if (!last)
            {
                <li class="p-breadcrumb-separator">
                    <i class="@SeparatorIconClass" aria-hidden="true"></i>
                </li>
            }
        }
    </ul>
</nav>

@code {
    private RenderFragment ItemContent(OpMenuItem item) => __builder =>
    {
        @if (!string.IsNullOrEmpty(item.Icon))
        {
            <span class="p-breadcrumb-item-icon @item.Icon" aria-hidden="true"></span>
        }
        @if (!string.IsNullOrEmpty(item.Label))
        {
            <span class="p-breadcrumb-item-label">@item.Label</span>
        }
    };
}
