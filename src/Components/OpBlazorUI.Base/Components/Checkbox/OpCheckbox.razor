@using OpBlazorUI.Base.Components.Forms
@namespace OpBlazorUI.Base.Components.Checkbox
@inherits OpInputBase<bool?>

<div class="@RootClass" @attributes="AdditionalAttributes">
    <input type="checkbox"
           class="@InputCss"
           id="@Id"
           name="@(Name ?? NameAttributeValue)"
           checked="@(CurrentValue == true)"
           tabindex="@TabIndex"
           required="@Required"
           readonly="@Readonly"
           disabled="@Disabled"
           aria-checked="@(Indeterminate ? "mixed" : null)"
           aria-labelledby="@AriaLabelledBy"
           aria-label="@AriaLabel"
           @onchange="HandleChange"
           @onclick:preventDefault="@Readonly"
           @onkeydown:preventDefault="@(Readonly && Disabled == false)"
           @onfocus="OnFocus"
           @onblur="OnBlur"/>

    <div class="p-checkbox-box">
        @if (CheckboxIconTemplate != null)
        {
            @CheckboxIconTemplate(CurrentValue == true)
        }
        else if (Indeterminate)
        {
            <i class="p-icon pi pi-minus p-checkbox-icon"></i>
        }
        else if (CurrentValue == true)
        {
            @if (!string.IsNullOrEmpty(CheckboxIcon))
            {
                <span class="p-checkbox-icon @CheckboxIcon"></span>
            }
            else
            {
                <i class="p-icon pi pi-check p-checkbox-icon"></i>
            }
        }
    </div>
</div>
