@namespace OpBlazorUI.Base.Components.Dialog
@using OpBlazorUI.Base.Components.Common
@using OpBlazorUI.Base.Components.Overlay
@inherits OpModalBase

@if (Visible)
{
    <div class="@MaskClass"
         style="@MaskInlineStyle"
         @onclick="OnMaskClick"
         @attributes="AdditionalAttributes">
        <OpOverlayAttach Layer="modal" BaseZIndex="BaseZIndex" AutoZIndex="AutoZIndex" OnEscape="EscapeCallback"/>
        <div class="@RootClass"
             @ref="_root"
             style="@RootInlineStyle"
             role="dialog"
             aria-modal="@(Modal ? "true" : null)"
             aria-labelledby="@(_headerId)"
             tabindex="-1"
             @onclick:stopPropagation="true">
            @if (ShowHeader)
            {
                <div class="p-dialog-header" @ref="_header">
                    @if (HeaderTemplate != null)
                    {
                        @HeaderTemplate
                    }
                    else if (!string.IsNullOrEmpty(Header))
                    {
                        <span class="p-dialog-title" id="@_headerId">@Header</span>
                    }

                    <div class="p-dialog-header-actions">
                        @if (Maximizable)
                        {
                            <button type="button"
                                    class="p-dialog-header-icon p-dialog-maximize-button"
                                    aria-label="@(_maximized ? "Minimize" : "Maximize")"
                                    @onclick="ToggleMaximize">
                                <span class="@(_maximized ? "pi pi-window-minimize" : "pi pi-window-maximize")" aria-hidden="true"></span>
                            </button>
                        }
                        @if (Closable)
                        {
                            <button type="button"
                                    class="p-dialog-header-icon p-dialog-close-button"
                                    aria-label="@CloseAriaLabel"
                                    @onclick="Close">
                                @if (CloseIconTemplate != null)
                                {
                                    @CloseIconTemplate
                                }
                                else
                                {
                                    <span class="@CloseIcon" aria-hidden="true"></span>
                                }
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="p-dialog-content" style="@ContentStyle">
                @ChildContent
            </div>

            @if (FooterTemplate != null)
            {
                <div class="p-dialog-footer">@FooterTemplate</div>
            }

            @if (Resizable && !_maximized)
            {
                <div class="p-resizable-handle p-resizable-n" data-op-resize="n"></div>
                <div class="p-resizable-handle p-resizable-e" data-op-resize="e"></div>
                <div class="p-resizable-handle p-resizable-s" data-op-resize="s"></div>
                <div class="p-resizable-handle p-resizable-w" data-op-resize="w"></div>
                <div class="p-resizable-handle p-resizable-se" data-op-resize="se"></div>
                <div class="p-resizable-handle p-resizable-sw" data-op-resize="sw"></div>
                <div class="p-resizable-handle p-resizable-ne" data-op-resize="ne"></div>
                <div class="p-resizable-handle p-resizable-nw" data-op-resize="nw"></div>
            }
        </div>
    </div>
}
