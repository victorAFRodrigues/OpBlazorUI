@using OpBlazorUI.Base.Components.Button.Parts
@using OpBlazorUI.Base.Components.Badge
@namespace OpBlazorUI.Base.Components.Button

<button type="@Type"
        class="@RootClass"
        aria-label="@AriaLabel"
        tabindex="@TabIndex"
        disabled="@(Disabled || Loading)"
        @onclick="OnClick"
        @onfocus="OnFocus"
        @onblur="OnBlur"
        @attributes="AdditionalAttributes">
    @ChildContent

    @if (Loading)
    {
        <OpButtonLoadingIcon Icon="@LoadingIcon" Template="@LoadingIconTemplate"/>
    }
    else
    {
        <OpButtonIcon Icon="@Icon" IconPos="@IconPos" HasLabel="@HasLabel" Template="@IconTemplate"/>
    }

    @if (HasLabel && ChildContent == null)
    {
        <OpButtonLabel Label="@Label"/>
    }

    @if (HasBadge)
    {
        <div class="p-button-badge">
            <OpBadge Value="@Badge"
                     Severity="@BadgeSeverity"
                     Size="@BadgeSize"
                     StyleClass="@BadgeClass"
                     Disabled="@BadgeDisabled"
                     Style="@BadgeStyle"
                     AdditionalAttributes="@BadgeAdditionalAttributes"/>
        </div>
    }
</button>
