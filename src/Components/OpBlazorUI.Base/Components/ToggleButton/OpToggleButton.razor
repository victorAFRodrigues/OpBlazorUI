@namespace OpBlazorUI.Base.Components.ToggleButton
@using OpBlazorUI.Base.Components.Forms
@inherits OpInputBase<bool>

<button type="button"
        class="@RootClass"
        role="button"
        aria-pressed="@(CurrentValue ? "true" : "false")"
        aria-label="@AriaLabel"
        tabindex="@(Disabled ? -1 : 0)"
        disabled="@Disabled"
        @onclick="Toggle"
        @attributes="AdditionalAttributes">
    <span class="p-togglebutton-content">
        @if (ContentTemplate != null)
        {
            @ContentTemplate(CurrentValue)
        }
        else
        {
            @if (HasIcon)
            {
                <span class="@IconClass"></span>
            }

            <span
                class="p-togglebutton-label">@(CurrentValue ? (HasOnLabel ? OnLabel : "\u00A0") : (HasOffLabel ? OffLabel : "\u00A0"))</span>
        }
    </span>
</button>
