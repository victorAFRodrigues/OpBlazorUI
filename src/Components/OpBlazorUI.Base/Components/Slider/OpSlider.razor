@namespace OpBlazorUI.Base.Components.Slider
@using OpBlazorUI.Base.Components.Forms
@inherits OpInputBase<double>

<span class="@RootClass" @ref="_root" @attributes="AdditionalAttributes">
    <span class="p-slider-range" style="@RangeStyle"></span>
    <span class="p-slider-handle"
          data-op-slider-handle="0"
          role="slider"
          style="@HandleStyle"
          aria-valuemin="@Min"
          aria-valuemax="@Max"
          aria-valuenow="@Value"
          aria-orientation="@Orientation"
          aria-label="@AriaLabel"
          aria-labelledby="@AriaLabelledBy"
          tabindex="@(Disabled ? null : TabIndex)"
          @onkeydown="HandleKeyDown"></span>
</span>
