@namespace OpBlazorUI.Base.Components.Password
@using OpBlazorUI.Base.Components.InputText

<div class="@RootClass" @attributes="AdditionalAttributes">
    <OpInputText Value="@Value"
                 OnInput="HandleInputAsync"
                 Type="@(_masked ? "password" : "text")"
                 StyleClass="p-password-input"
                 Id="@_id"
                 Placeholder="@Placeholder"
                 Variant="@Variant"
                 Size="@Size"
                 Invalid="@Invalid"
                 Disabled="@Disabled"
                 Readonly="@Readonly"
                 Fluid="@Fluid"
                 Autocomplete="@Autocomplete"
                 AriaLabel="@AriaLabel"
                 MaxLength="@MaxLength"
                 aria-labelledby="@AriaLabelledBy"
                 OnFocus="HandleFocusAsync"
                 OnBlur="HandleBlurAsync"/>

    @if (ShowClear && !Disabled && HasValue)
    {
        @if (ClearIconTemplate != null)
        {
            <span class="p-password-clear-icon" @onclick="Clear">@ClearIconTemplate</span>
        }
        else
        {
            <i class="pi pi-times p-password-clear-icon" @onclick="Clear"></i>
        }
    }

    @if (ToggleMask)
    {
        @if (ShowIconTemplate != null || HideIconTemplate != null)
        {
            <span class="p-password-toggle-mask-icon" @onclick="ToggleMaskClick">
                @if (_masked)
                {
                    @(ShowIconTemplate ?? HideIconTemplate)
                }
                else
                {
                    @(HideIconTemplate ?? ShowIconTemplate)
                }
            </span>
        }
        else
        {
            <i class="p-password-toggle-mask-icon pi @(_masked ? "pi-eye" : "pi-eye-slash")" @onclick="ToggleMaskClick"></i>
        }
    }

    @if (_overlayVisible)
    {
        <div class="p-password-overlay" style="position:absolute; top:100%; margin-top:.25rem; z-index:10;">
            @HeaderTemplate

            @if (ContentTemplate != null)
            {
                <div class="p-password-content">@ContentTemplate</div>
            }
            else
            {
                <div class="p-password-content">
                    <div class="p-password-meter">
                        <div class="p-password-meter-label @MeterLabelClass" style="width:@MeterWidth"></div>
                    </div>
                    @if (!string.IsNullOrEmpty(MeterText))
                    {
                        <div style="font-size:.85rem; color:var(--p-text-muted-color);">@MeterText</div>
                    }
                </div>
            }

            @FooterTemplate
        </div>
    }
</div>
