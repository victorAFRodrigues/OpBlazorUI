@using OpBlazorUI.Base.Models
@using OpBlazorUI.Base.Services
@namespace OpBlazorUI.Base.Components.Toast
@implements IDisposable

<div class="@RootClass" style="@RootStyle" role="region" aria-live="polite" aria-label="Toast messages">
    @if (Breakpoints != null && Breakpoints.Count > 0)
    {
        <style>
            @((MarkupString)GetBreakpointStyles())
        </style>
    }

    @foreach (var msg in VisibleMessages)
    {
        <div @key="msg"
             class="@GetMessageClass(msg)"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">
            @if (MessageTemplate != null)
            {
                @MessageTemplate(msg)
            }
            else if (HeadlessTemplate != null)
            {
                @HeadlessTemplate(new OpToastHeadlessContext(msg, () => { _ = Close(msg); }))
            }
            else
            {
                <div class="p-toast-message-content">
                    @if (!string.IsNullOrEmpty(msg.EffectiveIcon(OpSeverityIcon.Get(msg.Severity))))
                    {
                        <span class="p-toast-message-icon @msg.EffectiveIcon(OpSeverityIcon.Get(msg.Severity))" aria-hidden="true"></span>
                    }
                    <div class="p-toast-message-text">
                        @if (!string.IsNullOrEmpty(msg.Summary))
                        {
                            <div class="p-toast-summary">@msg.Summary</div>
                        }
                        @if (!string.IsNullOrEmpty(msg.Detail))
                        {
                            <div class="p-toast-detail">@msg.Detail</div>
                        }
                    </div>
                    @if (msg.Closable)
                    {
                        <button type="button"
                                class="p-toast-close-button"
                                aria-label="Close"
                                @onclick="@(e => Close(msg))">
                            <span class="p-toast-close-icon pi pi-times" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>