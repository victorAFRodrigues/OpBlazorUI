@namespace OpBlazorUI.Base.Components.MultiSelect
@using OpBlazorUI.Base.Components.Overlay
@using OpBlazorUI.Base.Components.Checkbox
@using OpBlazorUI.Base.Components.Chip
@using OpBlazorUI.Base.Components.IconField
@using OpBlazorUI.Base.Components.InputIcon
@using OpBlazorUI.Base.Components.VirtualScroller
@using OpBlazorUI.Base.Components.Forms
@typeparam TValue
@inherits OpInputBase<IReadOnlyList<TValue>>

<div class="@RootClass" @ref="_rootRef" style="position: relative"
     @attributes="AdditionalAttributes">
    <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString"/>
    <div class="p-hidden-accessible">
        <input role="combobox"
               id="@_id"
               @ref="_inputRef"
               tabindex="@(Disabled ? -1 : TabIndex)"
               aria-haspopup="listbox"
               aria-expanded="@(_overlayVisible ? "true" : "false")"
               aria-controls="@(_overlayVisible ? $"{_id}_list" : null)"
               aria-label="@AriaLabel"
               disabled="@Disabled"
               @onfocus="OnInputFocus"
               @onblur="OnInputBlur"
               @onkeydown="OnInputKeydown"/>
    </div>

    <div class="p-multiselect-label-container" @onclick="OnRootClick">
        <div class="@LabelClass">
            @if (SelectedItemsTemplate != null)
            {
                @SelectedItemsTemplate(SelectedOptions)
                @if (!HasSelection)
                {
                    @(Placeholder ?? "\u00A0")
                }
            }
            else if (Display == "chip")
            {
                @if (MaxSelectedLabels is { } max && SelectedOptions.Count > max)
                {
                    @($"{SelectedOptions.Count} items selected")
                }
                else
                {
                    @foreach (var item in ChipItems)
                    {
                        <div class="p-multiselect-chip-item">
                            <OpChip Label="@GetOptionLabel((object)item!)"
                                    Removable="@(!Disabled && !Readonly)"
                                    RemoveIcon="p-multiselect-chip-icon pi pi-times-circle"
                                    StyleClass="p-multiselect-chip"
                                    OnRemove="() => RemoveOptionAsync(item)"/>
                        </div>
                    }

                    @if (!HasSelection)
                    {
                        @(Placeholder ?? "\u00A0")
                    }
                }
            }
            else
            {
                @(HasSelection ? CommaLabel : Placeholder ?? "\u00A0")
            }
        </div>
    </div>

    @if (ShowClear && !Disabled && HasSelection)
    {
        @if (ClearIconTemplate != null)
        {
            <span class="p-multiselect-clear-icon" aria-hidden="true" @onclick="Clear">@ClearIconTemplate</span>
        }
        else
        {
            <i class="p-icon pi pi-times p-multiselect-clear-icon" @onclick="Clear"></i>
        }
    }

    <div class="p-multiselect-dropdown" role="button" aria-label="dropdown trigger" aria-haspopup="listbox"
         aria-expanded="@(_overlayVisible ? "true" : "false")" @onclick="OnDropdownClick">
        @if (Loading)
        {
            @if (LoadingIconTemplate != null)
            {
                @LoadingIconTemplate
            }
            else
            {
                <span class="p-multiselect-loading-icon pi pi-spinner pi-spin" aria-hidden="true"></span>
            }
        }
        else if (DropdownIconTemplate != null)
        {
            @DropdownIconTemplate
        }
        else if (!string.IsNullOrEmpty(DropdownIcon))
        {
            <span class="p-multiselect-dropdown-icon @DropdownIcon"></span>
        }
        else
        {
            <i class="p-icon pi pi-chevron-down p-multiselect-dropdown-icon"></i>
        }
    </div>

    @if (_panelRendered)
    {
        <div class="@PanelClass"
             @onanimationend="OnPanelAnimationEnd">
            <OpOverlayAttach Anchor="_rootRef" MatchWidth="true" Gap="2" OnOutsideClick="CloseAsync" OnEscape="CloseAsync"/>
            <span role="presentation" class="p-hidden-accessible p-hidden-focusable" tabindex="0"></span>

            @HeaderTemplate

            @if (ShowHeader)
            {
                <div class="p-multiselect-header" @onclick:stopPropagation="true">
                    @if (ShowToggleAll)
                    {
                        <OpCheckbox IgnoreEditContext="true" Value="@AllSelected" Variant="@Variant" Disabled="@Disabled"
                                    AriaLabel="Selecionar todos" OnChange="_ => ToggleAllAsync()"/>
                    }
                    @if (Filter)
                    {
                        <OpIconField IconPosition="left" StyleClass="p-multiselect-filter-container">
                            <input type="text"
                                   class="p-inputtext p-multiselect-filter"
                                   role="searchbox"
                                   autocomplete="off"
                                   value="@_filterValue"
                                   placeholder="Filter"
                                   aria-owns="@($"{_id}_list")"
                                   aria-label="Filter"
                                   @oninput="OnFilterInput"
                                   @onkeydown="OnInputKeydown"/>
                            <OpInputIcon>
                                <i class="p-icon pi pi-search"></i>
                            </OpInputIcon>
                        </OpIconField>
                    }
                </div>
            }

            @if (VirtualScroll && !Group && VisibleOptions.Count > 0)
            {
                <OpVirtualScroller TItem="object"
                                   Items="VisibleOptions"
                                   ItemSize="VirtualScrollItemSize"
                                   ScrollHeight="ScrollHeight"
                                   StyleClass="p-multiselect-list-container">
                    <ContentTemplate Context="ctx">
                        @BuildList(ctx.Items)
                    </ContentTemplate>
                </OpVirtualScroller>
            }
            else
            {
                <div class="p-multiselect-list-container" style="max-height:@(ScrollHeight ?? "auto")">
                    @BuildList(VisibleOptions)
                </div>
            }

            @FooterTemplate

            <span role="presentation" class="p-hidden-accessible p-hidden-focusable" tabindex="0"></span>
        </div>
    }
</div>

@code {
    private RenderFragment BuildList(IReadOnlyList<object> options) => __builder =>
    {
        <ul class="p-multiselect-list" role="listbox" id="@($"{_id}_list")">
            @if (Group)
            {
                @foreach (var group in VisibleOptions)
                {
                    <li class="p-multiselect-option-group" role="option">
                        @if (GroupTemplate != null)
                        {
                            @GroupTemplate(group)
                        }
                        else
                        {
                            <span class="p-multiselect-option-group-label">@GetOptionGroupLabelValue(group)</span>
                        }
                    </li>
                    @foreach (var child in GetOptionGroupChildren(group))
                    {
                        @if (MatchesFilter(child))
                        {
                            var isSel = IsSelected(child);
                            <li class="@OptionClass(child)" role="option" aria-label="@GetOptionLabel(child)"
                                aria-selected="@(isSel ? "true" : "false")"
                                @onclick="() => OnOptionClick(child)">
                                <OpCheckbox IgnoreEditContext="true" Value="@isSel" TabIndex="-1" Variant="@Variant"/>
                                @if (ItemTemplate != null && child is TValue childTv)
                                {
                                    @ItemTemplate(childTv)
                                }
                                else
                                {
                                    <span class="p-multiselect-option-label">@GetOptionLabel(child)</span>
                                }
                            </li>
                        }
                    }
                }
            }
            else
            {
                @for (var flatIndex = 0; flatIndex < options.Count; flatIndex++)
                {
                    @RenderOption(options[flatIndex], flatIndex)
                }
            }

            @if (ShowEmptyMessage)
            {
                <li class="p-multiselect-empty-message" role="option">
                    @if (!string.IsNullOrEmpty(_filterValue) && EmptyFilterTemplate != null)
                    {
                        @EmptyFilterTemplate
                    }
                    else if (string.IsNullOrEmpty(_filterValue) && EmptyTemplate != null)
                    {
                        @EmptyTemplate
                    }
                    else
                    {
                        @(!string.IsNullOrEmpty(_filterValue) ? EmptyFilterMessage : EmptyMessage)
                    }
                </li>
            }
        </ul>
    };

    private RenderFragment RenderOption(object option, int index) => __builder =>
    {
        var isSel = IsSelected(option);

        <li class="@OptionClass(option) @(_focusedOptionIndex == index ? "p-focus" : "")"
            id="@($"{_id}_{index}")"
            role="option"
            aria-label="@GetOptionLabel(option)"
            aria-selected="@(isSel ? "true" : "false")"
            data-p-focused="@(_focusedOptionIndex == index ? "true" : null)"
            @onclick="() => OnOptionClick(option)"
            @onmouseenter="() => OnOptionMouseEnter(index)">
            <OpCheckbox IgnoreEditContext="true" Value="@isSel" TabIndex="-1" Variant="@Variant"/>
            @if (ItemTemplate != null && option is TValue optTv)
            {
                @ItemTemplate(optTv)
            }
            else
            {
                <span class="p-multiselect-option-label">@GetOptionLabel(option)</span>
            }
        </li>
    };
}
