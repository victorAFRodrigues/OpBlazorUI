@namespace OpBlazorUI.Base.Components.CascadeSelect
@using OpBlazorUI.Base.Components.Overlay
@using OpBlazorUI.Base.Components.Forms
@typeparam TValue
@inherits OpInputBase<TValue>

<span class="@RootClass" @ref="_rootRef" @onkeydown="OnRootKeydown"
      @attributes="AdditionalAttributes">
    <input type="hidden" name="@NameAttributeValue" value="@CurrentValueAsString"/>
    <span class="@LabelClass"
          id="@_id"
          role="combobox"
          tabindex="@(Disabled ? -1 : TabIndex)"
          aria-haspopup="tree"
          aria-expanded="@(_overlayVisible ? "true" : "false")"
          aria-controls="@(_overlayVisible ? $"{_id}_tree" : null)"
          aria-label="@AriaLabel"
          aria-labelledby="@AriaLabelledBy"
          aria-disabled="@(Disabled ? "true" : null)"
          @onfocus="OnLabelFocus"
          @onblur="OnLabelBlur"
          @onclick="OnLabelClick"
          @onkeydown="OnLabelKeydown">
        @if (SelectedItemTemplate != null && HasSelection && SelectedOption is TValue selTv)
        {
            @SelectedItemTemplate(selTv)
        }
        else if (HasSelection)
        {
            @CurrentLabel
        }
        else
        {
            @(Placeholder ?? "&nbsp;")
        }
    </span>

    @if (ShowClear && !Disabled && HasSelection)
    {
        @if (ClearIconTemplate != null)
        {
            <span class="p-cascadeselect-clear-icon" @onclick="Clear">@ClearIconTemplate</span>
        }
        else
        {
            <i class="p-icon pi pi-times p-cascadeselect-clear-icon" @onclick="Clear"></i>
        }
    }

    <div class="p-cascadeselect-dropdown" role="button" aria-label="dropdown trigger" aria-haspopup="tree"
         aria-expanded="@(_overlayVisible ? "true" : "false")" @onclick="OnDropdownClick">
        @if (Loading)
        {
            @if (LoadingIconTemplate != null)
            {
                @LoadingIconTemplate
            }
            else
            {
                <span class="p-cascadeselect-loading-icon pi pi-spinner pi-spin" aria-hidden="true"></span>
            }
        }
        else if (DropdownIconTemplate != null)
        {
            @DropdownIconTemplate
        }
        else if (!string.IsNullOrEmpty(DropdownIcon))
        {
            <span class="@DropdownIcon"></span>
        }
        else
        {
            <i class="p-icon pi pi-chevron-down"></i>
        }
    </div>

    @if (_panelRendered)
    {
        <div class="@PanelClass"
             @onanimationend="OnPanelAnimationEnd">
            <OpOverlayAttach Anchor="_rootRef" MatchWidth="true" Gap="2" OnOutsideClick="CloseAsync" OnEscape="CloseAsync"/>
            <span role="presentation" class="p-hidden-accessible p-hidden-focusable" tabindex="0"></span>

            @HeaderTemplate

            @BuildTree()

            @FooterTemplate

            <span role="presentation" class="p-hidden-accessible p-hidden-focusable" tabindex="0"></span>
        </div>
    }
</span>
