@namespace OpBlazorUI.Base.Components.Fieldset
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase

<fieldset id="@RootId" class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    <legend class="p-fieldset-legend">
        @if (Toggleable)
        {
            <button id="@HeaderId"
                    type="button"
                    class="p-fieldset-toggle-button"
                    aria-controls="@ContentId"
                    aria-expanded="@((!Collapsed).ToString().ToLowerInvariant())"
                    aria-label="@Legend"
                    @onclick="ToggleAsync">
                <i class="@ToggleIconClass" aria-hidden="true"></i>
                <span class="p-fieldset-legend-label">@Legend</span>
                @HeaderTemplate
            </button>
        }
        else
        {
            <span class="p-fieldset-legend-label">@Legend</span>
            @HeaderTemplate
        }
    </legend>

    <div id="@ContentId"
         class="@ContentContainerClass"
         role="region"
         aria-labelledby="@HeaderId"
         aria-hidden="@(Collapsed ? "true" : null)"
         tabindex="@(Collapsed ? "-1" : null)">
        <div class="p-fieldset-content-wrapper">
            <div class="p-fieldset-content">@ChildContent</div>
        </div>
    </div>
</fieldset>
