@namespace OpBlazorUI.Base.Components.BlockUI

<div class="@RootClass"
     style="@RootStyle"
     aria-busy="@(Blocked ? "true" : "false")"
     @attributes="AdditionalAttributes">
    @ChildContent

    @if (Blocked)
    {
        <div class="@MaskClass" style="@MaskStyle">
            @ContentTemplate
        </div>
    }
</div>
