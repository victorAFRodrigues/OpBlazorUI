@namespace OpBlazorUI.Base.Components.Popover
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase
@using OpBlazorUI.Base.Components.Overlay

@if (_visible)
{
    @* Posição, z-index, seta e .p-popover-flipped são aplicados pelo overlay.interop.js. *@
    <div class="@RootClass"
         @ref="_root"
         style="@Style"
         role="dialog"
         aria-modal="true"
         aria-label="@AriaLabel"
         aria-labelledby="@AriaLabelledBy"
         tabindex="@(FocusOnShow ? 0 : -1)"
         @attributes="AdditionalAttributes">
        <OpOverlayAttach Anchor="_target" Placement="@Position" Align="center" KeepMargin="true" Arrow="popover"
                         OnOutsideClick="Hide" OnEscape="Hide" Dismissable="Dismissable"/>
        <div class="@ContentClass" style="@ContentStyle">@ChildContent</div>
    </div>
}
