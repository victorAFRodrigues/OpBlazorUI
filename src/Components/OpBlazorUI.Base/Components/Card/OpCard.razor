@namespace OpBlazorUI.Base.Components.Card
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase

<div class="@RootClass" style="@Style" @attributes="AdditionalAttributes">
    @if (HeaderTemplate != null)
    {
        <div class="p-card-header">@HeaderTemplate</div>
    }

    <div class="p-card-body">
        @if (TitleTemplate != null)
        {
            <div class="p-card-title">@TitleTemplate</div>
        }
        else if (!string.IsNullOrEmpty(Header))
        {
            <div class="p-card-title">@Header</div>
        }

        @if (SubtitleTemplate != null)
        {
            <div class="p-card-subtitle">@SubtitleTemplate</div>
        }
        else if (!string.IsNullOrEmpty(Subheader))
        {
            <div class="p-card-subtitle">@Subheader</div>
        }

        <div class="p-card-content">@ChildContent</div>

        @if (FooterTemplate != null)
        {
            <div class="p-card-footer">@FooterTemplate</div>
        }
    </div>
</div>
