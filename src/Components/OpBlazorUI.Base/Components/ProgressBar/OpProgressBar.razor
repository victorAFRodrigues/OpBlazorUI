@namespace OpBlazorUI.Base.Components.ProgressBar

<div class="@RootClass"
     style="@Style"
     role="progressbar"
     aria-valuemin="0"
     aria-valuemax="100"
     aria-valuenow="@AriaValueNow"
     @attributes="AdditionalAttributes">
    @if (IsIndeterminate)
    {
        <div class="@ValueClass" style="@ColorStyle"></div>
    }
    else
    {
        @* Estrutura do upstream: o label sempre existe; o texto some com valor 0. *@
        <div class="@ValueClass" style="@($"width: {Value}%; display: flex;{ColorStyle}")">
            <div class="p-progressbar-label">
                @if (ShowValue && ContentTemplate == null)
                {
                    <div style="display: @(Value != 0 ? "flex" : "none");">@($"{Value}{Unit}")</div>
                }
                @ContentTemplate?.Invoke(Value)
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public bool ShowValue { get; set; } = true;
    [Parameter] public string Unit { get; set; } = "%";
    [Parameter] public string Mode { get; set; } = "determinate";
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? StyleClass { get; set; }
    [Parameter] public string? ValueStyleClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public RenderFragment<int>? ContentTemplate { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string RootClass => OpCss.BuildClass(
        "p-progressbar p-component",
        string.Equals(Mode, "indeterminate", StringComparison.OrdinalIgnoreCase)
            ? "p-progressbar-indeterminate"
            : "p-progressbar-determinate",
        StyleClass);

    private string ValueClass => OpCss.BuildClass(
        "p-progressbar-value",
        ValueStyleClass);

    private string? AriaValueNow => string.Equals(Mode, "indeterminate", StringComparison.OrdinalIgnoreCase)
        ? null
        : Value.ToString();

    private bool IsIndeterminate => string.Equals(Mode, "indeterminate", StringComparison.OrdinalIgnoreCase);

    private string? ColorStyle => string.IsNullOrEmpty(Color) ? null : $" background: {Color};";
}
