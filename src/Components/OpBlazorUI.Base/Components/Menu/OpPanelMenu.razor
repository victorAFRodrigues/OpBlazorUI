@namespace OpBlazorUI.Base.Components.Menu
@using OpBlazorUI.Base.Models
@using OpBlazorUI.Base.Components.Common
@inherits OpComponentBase

<div class="@RootClass" @attributes="AdditionalAttributes">
    <ul class="p-panelmenu-root-list" role="tree">
        @foreach (var item in Model)
        {
            if (!item.Visible || item.Separator)
            {
                continue;
            }

            if (item.HasChildren && !item.Disabled)
            {
                var panel = item;
                var open = IsOpen(panel);

                <li class="p-panelmenu-panel">
                    <div class="p-panelmenu-header @(open ? "p-panelmenu-header-active" : null)">
                        <div class="p-panelmenu-header-content">
                            <a class="p-panelmenu-header-link"
                               role="button"
                               aria-expanded="@(open ? "true" : "false")"
                               tabindex="0"
                               @onclick="() => ToggleAsync(panel)">
                                @if (!string.IsNullOrEmpty(panel.Icon))
                                {
                                    <span class="p-panelmenu-header-icon @panel.Icon" aria-hidden="true"></span>
                                }
                                <span class="p-panelmenu-header-label">@panel.Label</span>
                                <span class="p-panelmenu-submenu-icon pi @(open ? "pi-angle-up" : "pi-angle-down")" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>

                    @if (open)
                    {
                        <div class="p-panelmenu-content-container">
                            <div class="p-panelmenu-content-wrapper">
                                <ul class="p-panelmenu-submenu" role="menu">
                                    @foreach (var child in panel.Items!)
                                    {
                                        <li class="p-panelmenu-item p-disabled-none">
                                            <div class="p-panelmenu-item-content">
                                                <a class="p-panelmenu-item-link"
                                                   href="@child.Url"
                                                   role="menuitem"
                                                   tabindex="-1"
                                                   @onclick="() => SelectItemAsync(child)"
                                                   @onclick:preventDefault="@(child.Command is not null || string.IsNullOrEmpty(child.Url))">
                                                    @if (!string.IsNullOrEmpty(child.Icon))
                                                    {
                                                        <span class="p-panelmenu-item-icon @child.Icon" aria-hidden="true"></span>
                                                    }
                                                    <span class="p-panelmenu-item-label">@child.Label</span>
                                                </a>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </li>
            }
            else
            {
                <li class="p-panelmenu-item">
                    <div class="p-panelmenu-item-content">
                        <a class="p-panelmenu-item-link"
                           href="@item.Url"
                           role="menuitem"
                           @onclick="() => SelectItemAsync(item)"
                           @onclick:preventDefault="@(item.Command is not null || string.IsNullOrEmpty(item.Url))">
                            @if (!string.IsNullOrEmpty(item.Icon))
                            {
                                <span class="p-panelmenu-item-icon @item.Icon" aria-hidden="true"></span>
                            }
                            <span class="p-panelmenu-item-label">@item.Label</span>
                        </a>
                    </div>
                </li>
            }
        }
    </ul>
</div>
