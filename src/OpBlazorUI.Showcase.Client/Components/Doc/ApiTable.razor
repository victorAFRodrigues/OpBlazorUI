@namespace OpBlazorUI.Showcase.Client.Components.Doc

@if (!string.IsNullOrEmpty(Caption))
{
    <h3 style="font-size:1.1rem;font-weight:600;margin:0 0 .75rem;color:var(--text-color);">@Caption</h3>
}

<div class="doc-tablewrapper">
    <table class="doc-table">
        <thead>
            <tr>
                @foreach (var header in Headers)
                {
                    <th>@header</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Length; i++)
                    {
                        <td>
                            @if (i == 0)
                            {
                                <code>@row[i]</code>
                            }
                            else
                            {
                                @((MarkupString)row[i])
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public string? Caption { get; set; }
    [Parameter] public IReadOnlyList<string> Headers { get; set; } = [];
    [Parameter] public IReadOnlyList<string[]> Rows { get; set; } = [];
}
