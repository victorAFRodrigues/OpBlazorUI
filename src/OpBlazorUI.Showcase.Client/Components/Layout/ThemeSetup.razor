@namespace OpBlazorUI.Showcase.Client.Components.Layout
@implements IDisposable
@inject IJSRuntime Js

<style>@((MarkupString)OpConfig.BuildCss())</style>

@code {
    private bool _darkMode;
    private bool _rtl;
    private bool _pendingApply;

    protected override void OnInitialized()
    {
        OpConfig.ConfigChanged += OnConfigChanged;
        DarkModeState.Changed += OnDarkChanged;
    }

    private void OnConfigChanged()
    {
        _rtl = OpConfig.Rtl;
        _pendingApply = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnDarkChanged()
    {
        _darkMode = DarkModeState.Dark;
        _pendingApply = true;
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _pendingApply)
        {
            _pendingApply = false;
            await ApplyAsync();
        }
    }

    private async Task ApplyAsync()
    {
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import",
                "./_content/OpBlazorUI.Base/optimus.interop.js");
            await module.InvokeVoidAsync("setDarkMode", _darkMode);
            await module.InvokeVoidAsync("setRtl", _rtl);
        }
        catch
        {
            // ignore JS errors
        }
    }

    public void Dispose()
    {
        OpConfig.ConfigChanged -= OnConfigChanged;
        DarkModeState.Changed -= OnDarkChanged;
    }
}
