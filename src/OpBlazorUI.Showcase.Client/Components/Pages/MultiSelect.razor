@page "/multiselect"
@namespace OpBlazorUI.Showcase.Client.Components.Pages
@using OpBlazorUI.Showcase.Client.Components.Doc
@using OpBlazorUI.Base.Components.MultiSelect

<DocComponent Title="MultiSelect"
              Description="O MultiSelect é usado para selecionar vários itens de uma coleção.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Placeholder="Selecione as Cidades" StyleClass="w-full"/>
                <div class="mt-2 text-sm">Selecionados: @string.Join(", ", _sel ?? [])</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Chips + Limpar">
            <ChildContent>
                <OpMultiSelect TValue="string" @bind-Value="_sel2" Options="Cities" Display="chip" ShowClear="true" Placeholder="Selecione as Cidades" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@ChipsCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro + Máx. Rótulos">
            <ChildContent>
                <OpMultiSelect TValue="string" @bind-Value="_sel3" Options="Cities" Display="chip" Filter="true" MaxSelectedLabels="2" Placeholder="Selecione as Cidades" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupado">
            <ChildContent>
                <OpMultiSelect TValue="string" @bind-Value="_sel4" Options="CountryGroups" Group="true" OptionGroupLabel="Label" OptionGroupChildren="Items" Placeholder="Selecione os Países" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@GroupedCode"/></Code>
        </DocSection>

        <DocSection Label="Preenchido / Desabilitado">
            <ChildContent>
                <div class="flex gap-3">
                    <OpMultiSelect TValue="string" @bind-Value="_sel5" Options="Cities" Variant="filled" Placeholder="Preenchido" StyleClass="w-56"/>
                    <OpMultiSelect TValue="string" Options="Cities" Disabled="true" Placeholder="Desabilitado" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;object&gt;?", "null", "Coleção de opções." },
                              new[] { "OptionLabel", "string?", "null", "Propriedade usada como rótulo da opção." },
                              new[] { "OptionValue", "string?", "null", "Propriedade usada como valor da opção." },
                              new[] { "OptionDisabled", "string?", "null", "Propriedade que indica opção desabilitada." },
                              new[] { "Value", "IReadOnlyList&lt;TValue&gt;?", "null", "Valores selecionados." },
                              new[] { "ValueChanged", "EventCallback&lt;IReadOnlyList&lt;TValue&gt;?&gt;", "-", "Callback de binding." },
                              new[] { "Placeholder", "string?", "null", "Texto exibido quando vazio." },
                              new[] { "Display", "string", "comma", "Modo de exibição: <code>comma</code> ou <code>chip</code>." },
                              new[] { "MaxSelectedLabels", "int?", "null", "Máximo de labels exibidas." },
                              new[] { "Filter", "bool", "false", "Habilita filtro." },
                              new[] { "ShowClear", "bool", "false", "Exibe botão de limpar." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Readonly", "bool", "false", "Somente leitura." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Required", "bool", "false", "Obrigatório." },
                              new[] { "Group", "bool", "false", "Opções agrupadas." },
                              new[] { "OptionGroupLabel", "string", "label", "Propriedade do rótulo do grupo." },
                              new[] { "OptionGroupChildren", "string", "items", "Propriedade dos itens do grupo." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura." },
                              new[] { "ScrollHeight", "string?", "null", "Altura máxima da lista (px)." },
                              new[] { "Loading", "bool", "false", "Exibe estado de carregamento." },
                              new[] { "DropdownIcon", "string?", "null", "Classe do ícone do dropdown." },
                              new[] { "EmptyMessage", "string", "No results found", "Mensagem quando não há opções." },
                              new[] { "EmptyFilterMessage", "string", "No results found", "Mensagem quando o filtro não encontra opções." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "InputId", "string?", "null", "Id do input." },
                              new[] { "ShowOnFocus", "bool", "true", "Abre o overlay ao focar." },
                              new[] { "PanelStyleClass", "string?", "null", "Classes do painel do overlay." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;IReadOnlyList&lt;TValue&gt;?&gt;", "Disparado ao mudar a seleção." },
                              new[] { "OnFilter", "EventCallback&lt;string&gt;", "Disparado ao filtrar." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar." },
                              new[] { "OnClick", "EventCallback&lt;MouseEventArgs&gt;", "Disparado ao clicar." },
                              new[] { "OnShow", "EventCallback", "Disparado ao exibir o overlay." },
                              new[] { "OnHide", "EventCallback", "Disparado ao ocultar o overlay." },
                              new[] { "OnClear", "EventCallback", "Disparado ao limpar." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TValue&gt;?", "Template do item da lista." },
                              new[] { "SelectedItemsTemplate", "RenderFragment&lt;IReadOnlyList&lt;TValue&gt;&gt;?", "Template dos itens selecionados." },
                              new[] { "GroupTemplate", "RenderFragment&lt;object&gt;?", "Template do grupo." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Template do cabeçalho." },
                              new[] { "FooterTemplate", "RenderFragment?", "Template do rodapé." },
                              new[] { "EmptyTemplate", "RenderFragment?", "Template quando vazio." },
                              new[] { "EmptyFilterTemplate", "RenderFragment?", "Template quando o filtro não encontra opções." },
                              new[] { "DropdownIconTemplate", "RenderFragment?", "Template do ícone do dropdown." },
                              new[] { "LoadingIconTemplate", "RenderFragment?", "Template do ícone de carregamento." },
                              new[] { "ClearIconTemplate", "RenderFragment?", "Template do ícone de limpar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="multiselect"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code>, <code>PanelStyleClass</code> e os templates para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private IReadOnlyList<string>? _sel;
    private IReadOnlyList<string>? _sel2;
    private IReadOnlyList<string>? _sel3;
    private IReadOnlyList<string>? _sel4;
    private IReadOnlyList<string>? _sel5;

    private static readonly List<string> Cities = new() { "Nova York", "Roma", "Londres", "Istambul", "Paris", "Barcelona", "Berlim" };

    private sealed class CountryGroup
    {
        public string Label { get; set; } = "";
        public List<string> Items { get; set; } = new();
    }

    private static readonly List<CountryGroup> CountryGroups = new()
    {
        new() { Label = "Alemanha", Items = new() { "Berlim", "Frankfurt", "Hamburgo" } },
        new() { Label = "EUA", Items = new() { "Chicago", "Los Angeles", "Nova York" } },
        new() { Label = "Japão", Items = new() { "Quioto", "Osaka", "Tóquio" } }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.MultiSelect

        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Placeholder="Selecione as Cidades" />
        """;

    private const string BasicCode = """
        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Placeholder="Selecione as Cidades" StyleClass="w-full" />

        @code {
            private IReadOnlyList<string>? _sel;
            private static readonly List<string> Cities = new() { "Nova York", "Roma", "Londres", "Istambul", "Paris" };
        }
        """;

    private const string ChipsCode = """
        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Display="chip" ShowClear="true" Placeholder="Selecione as Cidades" />
        """;

    private const string FilterCode = """
        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Display="chip" Filter="true" MaxSelectedLabels="2" Placeholder="Selecione as Cidades" />
        """;

    private const string GroupedCode = """
        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="CountryGroups" Group="true"
                       OptionGroupLabel="Label" OptionGroupChildren="Items" Placeholder="Selecione os Países" />
        """;

    private const string FilledCode = """
        <OpMultiSelect TValue="string" @bind-Value="_sel" Options="Cities" Variant="filled" Placeholder="Preenchido" />
        <OpMultiSelect TValue="string" Options="Cities" Disabled="true" Placeholder="Desabilitado" />
        """;
}
