@page "/radiobutton"
@namespace OpBlazorUI.Showcase.Client.Components.Pages
@using OpBlazorUI.Showcase.Client.Components.Doc
@using OpBlazorUI.Base.Components.RadioButton

<DocComponent Title="RadioButton"
              Description="O RadioButton é uma extensão do elemento radio button padrão.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpRadioButton TValue="string" Value="@("opt1")" @bind-ModelValue="_selected" Name="rb"/>
                    <OpRadioButton TValue="string" Value="@("opt2")" @bind-ModelValue="_selected" Name="rb"/>
                    <OpRadioButton TValue="string" Value="@("opt3")" @bind-ModelValue="_selected" Name="rb"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido / Desabilitado">
            <ChildContent>
                <div class="flex gap-4">
                    <OpRadioButton TValue="string" Value="@("a")" ModelValue="@("a")" Name="rb2" Invalid="true"/>
                    <OpRadioButton TValue="string" Value="@("b")" ModelValue="@("b")" Name="rb2" Disabled="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StateCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex gap-4">
                    <OpRadioButton TValue="string" Value="@("a")" ModelValue="@("a")" Name="rb3" Size="small"/>
                    <OpRadioButton TValue="string" Value="@("b")" ModelValue="@("b")" Name="rb3"/>
                    <OpRadioButton TValue="string" Value="@("c")" ModelValue="@("c")" Name="rb3" Size="large"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "TValue?", "null", "Valor desta opção." },
                              new[] { "ModelValue", "TValue?", "null", "Valor selecionado do grupo." },
                              new[] { "ModelValueChanged", "EventCallback&lt;TValue?&gt;", "-", "Callback de binding." },
                              new[] { "Name", "string?", "null", "Name do grupo de radios." },
                              new[] { "Id", "string?", "null", "Id do input." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "AriaLabelledBy", "string?", "null", "Id do elemento que rotula." },
                              new[] { "Required", "bool", "false", "Obrigatório." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;TValue?&gt;", "Disparado ao mudar o valor." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="radiobutton"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e atributos extras para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string _selected = "opt1";

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.RadioButton

        <OpRadioButton TValue="string" Value="@("opt1")" @bind-ModelValue="_selected" Name="rb" />
        """;

    private const string BasicCode = """
        <OpRadioButton TValue="string" Value="@("opt1")" @bind-ModelValue="_selected" Name="rb" />
        <OpRadioButton TValue="string" Value="@("opt2")" @bind-ModelValue="_selected" Name="rb" />
        <OpRadioButton TValue="string" Value="@("opt3")" @bind-ModelValue="_selected" Name="rb" />

        @code {
            private string _selected = "opt1";
        }
        """;

    private const string StateCode = """
        <OpRadioButton TValue="string" Value="@("a")" ModelValue="@("a")" Name="rb" Invalid="true" />
        <OpRadioButton TValue="string" Value="@("b")" ModelValue="@("b")" Name="rb" Disabled="true" />
        """;

    private const string SizeCode = """
        <OpRadioButton TValue="string" Value="@("a")" ModelValue="@("a")" Name="rb" Size="small" />
        <OpRadioButton TValue="string" Value="@("b")" ModelValue="@("b")" Name="rb" />
        <OpRadioButton TValue="string" Value="@("c")" ModelValue="@("c")" Name="rb" Size="large" />
        """;
}
