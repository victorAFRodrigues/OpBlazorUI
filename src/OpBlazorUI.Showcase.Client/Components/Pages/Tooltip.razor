@page "/tooltip"
@namespace OpBlazorUI.Showcase.Client.Components.Pages
@using OpBlazorUI.Showcase.Client.Components.Doc
@using OpBlazorUI.Base.Components.Tooltip
@using OpBlazorUI.Base.Components.Button

<DocComponent Title="Tooltip"
              Description="Tooltip exibe informações de orientação para um componente.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpTooltip Content="Eu sou um tooltip">
                    <OpButton Label="Passe o mouse"/>
                </OpTooltip>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Posição">
            <ChildContent>
                <div class="flex gap-3 flex-wrap">
                    <OpTooltip Content="Acima" Position="top"><OpButton Label="Acima" Severity="secondary" Outlined="true"/></OpTooltip>
                    <OpTooltip Content="Abaixo" Position="bottom"><OpButton Label="Abaixo" Severity="secondary" Outlined="true"/></OpTooltip>
                    <OpTooltip Content="Esquerda" Position="left"><OpButton Label="Esquerda" Severity="secondary" Outlined="true"/></OpTooltip>
                    <OpTooltip Content="Direita" Position="right"><OpButton Label="Direita" Severity="secondary" Outlined="true"/></OpTooltip>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PositionCode"/></Code>
        </DocSection>

        <DocSection Label="Atraso / Desabilitado">
            <ChildContent>
                <div class="flex gap-3 flex-wrap">
                    <OpTooltip Content="Com atraso" ShowDelay="500" HideDelay="500"><OpButton Label="Atraso" Severity="secondary" Outlined="true"/></OpTooltip>
                    <OpTooltip Content="Tooltip desabilitado" Disabled="true"><OpButton Label="Desabilitado" Severity="secondary" Outlined="true"/></OpTooltip>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DelayCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Content", "string?", "null", "Conteúdo do tooltip." },
                              new[] { "Position", "string", "right", "Posição: <code>right</code>, <code>left</code>, <code>top</code>, <code>bottom</code>." },
                              new[] { "Disabled", "bool", "false", "Desabilita o tooltip." },
                              new[] { "ShowDelay", "int", "0", "Atraso (ms) para exibir." },
                              new[] { "HideDelay", "int", "0", "Atraso (ms) para ocultar." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Elemento âncora do tooltip." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="tooltip"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e <code>ChildContent</code> (âncora) para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Tooltip

        <OpTooltip Content="Conteúdo do tooltip">
            <OpButton Label="Passe o mouse" />
        </OpTooltip>
        """;

    private const string BasicCode = """
        <OpTooltip Content="Eu sou um tooltip">
            <OpButton Label="Passe o mouse" />
        </OpTooltip>
        """;

    private const string PositionCode = """
        <OpTooltip Content="Acima" Position="top"><OpButton Label="Acima" /></OpTooltip>
        <OpTooltip Content="Abaixo" Position="bottom"><OpButton Label="Abaixo" /></OpTooltip>
        <OpTooltip Content="Esquerda" Position="left"><OpButton Label="Esquerda" /></OpTooltip>
        <OpTooltip Content="Direita" Position="right"><OpButton Label="Direita" /></OpTooltip>
        """;

    private const string DelayCode = """
        <OpTooltip Content="Com atraso" ShowDelay="500" HideDelay="500">
            <OpButton Label="Atraso" />
        </OpTooltip>

        <OpTooltip Content="Tooltip desabilitado" Disabled="true">
            <OpButton Label="Desabilitado" />
        </OpTooltip>
        """;
}
