@page "/inputtext"
@namespace OpBlazorUI.Showcase.Client.Components.Pages
@using OpBlazorUI.Showcase.Client.Components.Doc
@using OpBlazorUI.Base.Components.InputText

<DocComponent Title="InputText"
              Description="O InputText renderiza um campo de texto para inserir dados.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpInputText Placeholder="Usuário" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Variantes">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpInputText Placeholder="Com contorno" StyleClass="w-full"/>
                    <OpInputText Placeholder="Preenchido" Variant="filled" StyleClass="w-full"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VariantCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpInputText Placeholder="Pequeno" Size="small" StyleClass="w-full"/>
                    <OpInputText Placeholder="Normal" StyleClass="w-full"/>
                    <OpInputText Placeholder="Grande" Size="large" StyleClass="w-full"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido / Desabilitado">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpInputText Placeholder="Inválido" Invalid="true" StyleClass="w-full"/>
                    <OpInputText Placeholder="Desabilitado" Disabled="true" StyleClass="w-full"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StateCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "string?", "null", "Valor do input." },
                              new[] { "ValueChanged", "EventCallback&lt;string?&gt;", "-", "Callback de binding." },
                              new[] { "Placeholder", "string?", "null", "Placeholder." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Readonly", "bool", "false", "Somente leitura." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura." },
                              new[] { "Type", "string", "text", "Tipo do input (ex.: <code>password</code>)." },
                              new[] { "Id", "string?", "null", "Id do input." },
                              new[] { "Name", "string?", "null", "Name do input." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "MaxLength", "int?", "null", "Tamanho máximo." },
                              new[] { "Autocomplete", "string?", "null", "Valor de autocomplete." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnInput", "EventCallback&lt;string?&gt;", "Disparado ao digitar." },
                              new[] { "OnChange", "EventCallback&lt;string?&gt;", "Disparado ao mudar o valor." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="inputtext"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e atributos extras para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.InputText

        <OpInputText Placeholder="Usuário" />
        """;

    private const string BasicCode = """
        <OpInputText Placeholder="Usuário" StyleClass="w-full" />
        """;

    private const string VariantCode = """
        <OpInputText Placeholder="Com contorno" StyleClass="w-full" />
        <OpInputText Placeholder="Preenchido" Variant="filled" StyleClass="w-full" />
        """;

    private const string SizeCode = """
        <OpInputText Placeholder="Pequeno" Size="small" />
        <OpInputText Placeholder="Normal" />
        <OpInputText Placeholder="Grande" Size="large" />
        """;

    private const string StateCode = """
        <OpInputText Placeholder="Inválido" Invalid="true" />
        <OpInputText Placeholder="Desabilitado" Disabled="true" />
        """;
}
