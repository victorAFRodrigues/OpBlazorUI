<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="@Assets["css/doc-variables.css"]"/>
    <link rel="stylesheet" href="@Assets["css/doc-layout.css"]"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["OpBlazorUI.Showcase.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<OpBlazorUiSetup />
<Routes @rendermode="InteractiveServer"/>
<script>
    window.opCopy = function (btn) {
        var container = btn.closest('.doc-section-code');
        var code = container ? container.querySelector('pre') : null;
        if (!code) return;
        var text = code.textContent || '';
        var done = function () {
            var i = btn.querySelector('i');
            if (i) { i.className = 'pi pi-check'; }
            setTimeout(function () { if (i) i.className = 'pi pi-copy'; }, 1500);
        };
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done).catch(function () { done(); });
        } else {
            done();
        }
    };
</script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>