@namespace OpBlazorUI.Showcase.Components.Layout
@using OpBlazorUI.Base.Components.InputSwitch

<div class="config-panel-content">
    <div class="config-panel-colors">
        <span class="config-panel-label">Primária</span>
        <div>
            @foreach (var palette in OpConfig.PrimaryPalettes)
            {
                <button type="button" title="@palette.Name"
                        @onclick="() => OpConfig.SetPrimary(palette.Name)"
                        class="@(OpConfig.Primary == palette.Name ? "active-color" : null)"
                        style="background-color: @palette.Swatch;"></button>
            }
        </div>
    </div>

    <div class="config-panel-colors">
        <span class="config-panel-label">Superfície</span>
        <div>
            @foreach (var palette in OpConfig.SurfacePalettes)
            {
                <button type="button" title="@palette.Name"
                        @onclick="() => OpConfig.SetSurface(palette.Name)"
                        class="@(OpConfig.Surface == palette.Name ? "active-color" : null)"
                        style="background-color: @palette.Swatch;"></button>
            }
        </div>
    </div>

    <div class="config-panel-settings">
        <span class="config-panel-label">Presets</span>
        <div class="flex gap-2 flex-wrap">
            @foreach (var preset in new[] { "Aura", "Material", "Lara", "Nora" })
            {
                var isAura = preset == "Aura";
                <button type="button" title="@(isAura ? "Aura" : $"{preset} (em breve)")"
                        disabled="@(!isAura)"
                        style="padding:.25rem .75rem;border-radius:6px;border:1px solid var(--border-color);background-color:@(isAura ? "var(--primary-color)" : "var(--card-background)");color:@(isAura ? "var(--primary-contrast-color)" : "var(--text-secondary-color)");cursor:@(isAura ? "pointer" : "default");font-weight:600;font-size:.875rem;opacity:@(isAura ? "1" : ".6");">
                    @preset
                </button>
            }
        </div>
    </div>

    <div class="config-panel-setting-row">
        <span class="config-panel-label">RTL</span>
        <OpInputSwitch @bind-Checked="_rtl" OnChange="OnRtlChanged"/>
    </div>
</div>

@code {
    private bool _rtl = OpConfig.Rtl;

    private void OnRtlChanged(bool value) => OpConfig.SetRtl(value);
}
