@page "/configuration"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.ThemeSwitcher

<PageTitle>Configuration - Optimus UI (Blazor)</PageTitle>

<GuidePage Title="Configuration"
           Description="Personalize temas, modo escuro, direção e o comportamento dos componentes."
           Sections="@Sections">

    <DocSection Label="Visão geral">
        <Description>
            <p>A configuração é opcional: com o <code>&lt;OpBlazorUiSetup /&gt;</code> adicionado no <code>App.razor</code>, o tema padrão já é aplicado automaticamente.</p>
            <p>As opções abaixo permitem trocar o tema, alternar o modo escuro e ativar o layout RTL.</p>
        </Description>
    </DocSection>

    <DocSection Label="Temas">
        <Description>
            <p>Cada tema é um arquivo CSS em <code>_content/OpBlazorUI.Base/themes/</code>. O tema padrão é o <code>aura.css</code> (paleta <strong>noir</strong>), e existem 16 variantes de cor:</p>
            <ul>
                <li><code>emerald</code>, <code>green</code>, <code>lime</code>, <code>orange</code>, <code>amber</code>, <code>yellow</code>, <code>teal</code>, <code>cyan</code></li>
                <li><code>sky</code>, <code>blue</code>, <code>indigo</code>, <code>violet</code>, <code>purple</code>, <code>fuchsia</code>, <code>pink</code>, <code>rose</code></li>
            </ul>
            <p>Defina o tema padrão informando a URL do arquivo desejado:</p>
        </Description>
        <Code>
            <CodeBlock Language="csharp"
                       Code="@("OpTheme.SetThemeUrl(\"_content/OpBlazorUI.Base/themes/aura-emerald.css\");")"/>
        </Code>
    </DocSection>

    <DocSection Label="Trocando o tema em tempo de execução">
        <Description>
            <p>O componente <code>OpThemeSwitcher</code> renderiza os seletores de cor e o botão de modo escuro. Ao trocar o tema, ele atualiza o <code>OpTheme</code> e o <code>&lt;OpBlazorUiSetup /&gt;</code> recarrega o CSS automaticamente.</p>
        </Description>
        <ChildContent>
            <OpThemeSwitcher/>
        </ChildContent>
        <Code>
            <CodeBlock Language="razor"
                       Code="@("@using OpBlazorUI.Base.Components.ThemeSwitcher\n\n<OpThemeSwitcher OnThemeChanged=\"OnThemeChanged\" />")"/>
        </Code>
    </DocSection>

    <DocSection Label="Modo escuro">
        <Description>
            <p>O modo escuro é aplicado pela classe <code>app-dark</code> no elemento <code>&lt;html&gt;</code>, através do módulo de interop:</p>
        </Description>
        <Code>
            <CodeBlock Language="csharp"
                       Code="@("var module = await Js.InvokeAsync<IJSObjectReference>(\"import\",\n    \"./_content/OpBlazorUI.Base/optimus.interop.js\");\n\nawait module.InvokeVoidAsync(\"setDarkMode\", true);")"/>
        </Code>
    </DocSection>

    <DocSection Label="Direção (RTL)">
        <Description>
            <p>Para layouts da direita para a esquerda, use <code>setRtl</code>. Ele define o atributo <code>dir</code> do <code>&lt;html&gt;</code> e os estilos usam propriedades lógicas, então o layout se adapta:</p>
        </Description>
        <Code>
            <CodeBlock Language="csharp"
                       Code="@("await module.InvokeVoidAsync(\"setRtl\", true);")"/>
        </Code>
    </DocSection>

    <DocSection Label="Interop JS">
        <Description>
            <p>Funções exportadas por <code>_content/OpBlazorUI.Base/optimus.interop.js</code>:</p>
        </Description>
        <ChildContent>
            <ApiTable Caption="Interop"
                      Headers="@(new[] { "Função", "Retorno", "Descrição" })"
                      Rows="@(new[] {
                          new[] { "setDarkMode(enabled)", "void", "Ativa/desativa o modo escuro via classe <code>app-dark</code>." },
                          new[] { "getDarkMode()", "bool", "Indica se o modo escuro está ativo." },
                          new[] { "setRtl(enabled)", "void", "Define a direção do documento como <code>rtl</code> ou <code>ltr</code>." },
                          new[] { "getRtl()", "bool", "Indica se a direção atual é RTL." },
                          new[] { "copyText(text)", "Promise", "Copia o texto informado para a área de transferência." }
                      })"/>
        </ChildContent>
    </DocSection>

    <DocSection Label="Variáveis CSS">
        <Description>
            <p>O <code>optimus-base.css</code> contém a estrutura dos componentes e o arquivo de tema define os design tokens (<code>--p-*</code>) usados por eles. Para sobrescrever cores, fontes ou raios, declare as variáveis depois do setup:</p>
        </Description>
        <Code>
            <CodeBlock Language="css"
                       Code="@(":root {\n    --p-primary-color: #10b981;\n    --p-border-radius-md: 8px;\n}")"/>
        </Code>
    </DocSection>
</GuidePage>

@code {
    private static readonly IReadOnlyList<string> Sections =
    [
        "Visão geral",
        "Temas",
        "Trocando o tema em tempo de execução",
        "Modo escuro",
        "Direção (RTL)",
        "Interop JS",
        "Variáveis CSS"
    ];
}
