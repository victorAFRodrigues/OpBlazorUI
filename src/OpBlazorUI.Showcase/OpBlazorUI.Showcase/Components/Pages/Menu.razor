@page "/menu"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Menu
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Models

<DocComponent Title="Menu"
              Description="Menu é um componente de navegação/comando que oferece suporte a posicionamento dinâmico e estático.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <div style="border:1px solid var(--p-content-border-color); border-radius:6px; width:max-content;">
                    <OpMenu Items="Items" StyleClass="w-56" OnItemClick="OnItemClick"/>
                </div>
                <div class="mt-2 text-sm">Último clique: @_lastClick</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupado">
            <ChildContent>
                <div style="border:1px solid var(--p-content-border-color); border-radius:6px; width:max-content;">
                    <OpMenu Groups="Groups" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@GroupedCode"/></Code>
        </DocSection>

        <DocSection Label="Popup">
            <ChildContent>
                <div style="position:relative; display:inline-block;">
                    <OpButton Label="Abrir menu" Severity="secondary" @onclick="TogglePopup"/>
                    <OpMenu @ref="_popupMenu" Popup="true" Items="PopupItems" StyleClass="w-56" OnItemClick="OnItemClick"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PopupCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Items", "IReadOnlyList&lt;OpMenuItem&gt;?", "null", "Itens do menu (lista simples)." },
                              new[] { "Groups", "IReadOnlyList&lt;OpMenuGroup&gt;?", "null", "Itens agrupados." },
                              new[] { "Popup", "bool", "false", "Renderiza como menu popup (overlay)." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." },
                              new[] { "Id", "string?", "null", "Id do elemento raiz." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "Disparado ao clicar em um item." },
                              new[] { "OnShow", "EventCallback", "Disparado ao exibir o popup." },
                              new[] { "OnHide", "EventCallback", "Disparado ao ocultar o popup." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;OpMenuItem&gt;?", "Template customizado do item." },
                              new[] { "StartTemplate", "RenderFragment?", "Conteúdo no topo do menu." },
                              new[] { "EndTemplate", "RenderFragment?", "Conteúdo no final do menu." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="OpMenuItem">
            <ChildContent>
                <ApiTable Caption="OpMenuItem"
                          Headers="@(new[] { "Propriedade", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Label", "string?", "null", "Texto do item." },
                              new[] { "Icon", "string?", "null", "Classe do ícone." },
                              new[] { "Url", "string?", "null", "URL do link." },
                              new[] { "Disabled", "bool", "false", "Item desabilitado." },
                              new[] { "Separator", "bool", "false", "Renderiza um separador." },
                              new[] { "Visible", "bool", "true", "Visibilidade do item." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="menu"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code>, <code>ItemTemplate</code> e <code>StartTemplate</code>/<code>EndTemplate</code> para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private OpMenu? _popupMenu;
    private bool _popupOpen;
    private string _lastClick = "—";

    private static readonly List<OpMenuItem> Items = new()
    {
        new() { Label = "Novo", Icon = "pi pi-plus" },
        new() { Label = "Abrir", Icon = "pi pi-folder-open" },
        new() { Label = "Salvar", Icon = "pi pi-save" },
        new() { Label = "Exportar", Icon = "pi pi-upload", Disabled = true }
    };

    private static readonly List<OpMenuGroup> Groups = new()
    {
        new() { Label = "Documentos", Items = new() { new() { Label = "Novo", Icon = "pi pi-plus" }, new() { Label = "Pesquisar", Icon = "pi pi-search" } } },
        new() { Label = "Perfil", Items = new() { new() { Label = "Configurações", Icon = "pi pi-cog" }, new() { Label = "Sair", Icon = "pi pi-sign-out" } } }
    };

    private static readonly List<OpMenuItem> PopupItems = new()
    {
        new() { Label = "Editar", Icon = "pi pi-pencil" },
        new() { Label = "Duplicar", Icon = "pi pi-copy" },
        new() { Separator = true },
        new() { Label = "Arquivar", Icon = "pi pi-inbox" },
        new() { Label = "Excluir", Icon = "pi pi-trash" }
    };

    private void OnItemClick(OpMenuItem item) => _lastClick = item.Label ?? "—";

    private async Task TogglePopup()
    {
        if (_popupOpen) await _popupMenu!.HideAsync();
        else await _popupMenu!.ShowAsync();
        _popupOpen = !_popupOpen;
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Menu
        @using OpBlazorUI.Base.Models

        <OpMenu Items="Items" StyleClass="w-56" OnItemClick="OnItemClick" />
        """;

    private const string BasicCode = """
        <OpMenu Items="Items" StyleClass="w-56" OnItemClick="OnItemClick" />

        @code {
            private static readonly List<OpMenuItem> Items = new()
            {
                new() { Label = "Novo", Icon = "pi pi-plus" },
                new() { Label = "Abrir", Icon = "pi pi-folder-open" },
                new() { Label = "Salvar", Icon = "pi pi-save" }
            };

            private void OnItemClick(OpMenuItem item) { }
        }
        """;

    private const string GroupedCode = """
        <OpMenu Groups="Groups" StyleClass="w-56" />

        @code {
            private static readonly List<OpMenuGroup> Groups = new()
            {
                new() { Label = "Documentos", Items = new() { new() { Label = "Novo", Icon = "pi pi-plus" }, new() { Label = "Pesquisar", Icon = "pi pi-search" } } },
                new() { Label = "Perfil", Items = new() { new() { Label = "Configurações", Icon = "pi pi-cog" } } }
            };
        }
        """;

    private const string PopupCode = """
        <div style="position: relative; display: inline-block;">
            <OpButton Label="Abrir menu" Severity="secondary" @onclick="TogglePopup" />
            <OpMenu @ref="_popupMenu" Popup="true" Items="PopupItems" StyleClass="w-56" OnItemClick="OnItemClick" />
        </div>

        @code {
            private OpMenu? _popupMenu;
            private bool _popupOpen;

            private async Task TogglePopup()
            {
                if (_popupOpen) await _popupMenu!.HideAsync();
                else await _popupMenu!.ShowAsync();
                _popupOpen = !_popupOpen;
            }
        }
        """;
}
