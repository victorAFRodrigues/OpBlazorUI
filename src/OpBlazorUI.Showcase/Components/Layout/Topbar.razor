@namespace OpBlazorUI.Showcase.Components.Layout
@using OpBlazorUI.Base.Components.Popover
@implements IDisposable

<div class="layout-topbar layout-topbar-sticky">
    <div class="layout-topbar-inner">
        <div class="layout-topbar-logo-container">
            <a class="layout-topbar-logo" href="" aria-label="OpBlazorUI Logo">
                <img src="assets/OpBlazorUI-icon.png" alt="" style="height:1.75rem;width:auto;margin-inline-end:.5rem;"/>OpBlazor<span style="color:#6326b7;">UI</span>
            </a>
            <a class="layout-topbar-icon" href="" aria-label="OpBlazorUI Logo">
                <img src="assets/OpBlazorUI-icon.png" alt="" style="height:1.75rem;width:auto;margin-inline-end:.5rem;"/>OpBlazor<span style="color:#6326b7;">UI</span>
            </a>
        </div>

        <ul class="topbar-items">
            <li>
                <button type="button" class="topbar-item" title="Pesquisar" aria-label="Pesquisar">
                    <i class="pi pi-search"></i>
                </button>
            </li>
            <li>
                <button type="button" class="topbar-item ask-ai-button" title="Perguntar à IA" aria-label="Perguntar à IA">
                    <i class="pi pi-sparkles"></i>
                    <span class="ask-ai-label">Perguntar à IA</span>
                </button>
            </li>
            <li class="topbar-desktop-item">
                <a target="_blank" rel="noopener noreferrer" class="topbar-item" href="https://github.com/openng-org/optimus-ui" aria-label="GitHub">
                    <i class="pi pi-github"></i>
                </a>
            </li>
            <li class="topbar-desktop-item">
                <a target="_blank" rel="noopener noreferrer" class="topbar-item" href="https://discord.gg/auSfMzVVPr" aria-label="Discord">
                    <i class="pi pi-discord"></i>
                </a>
            </li>
            <li class="topbar-desktop-item">
                <a target="_blank" rel="noopener noreferrer" class="topbar-item" href="https://github.com/openng-org/optimus-ui/discussions" aria-label="Discussions">
                    <i class="pi pi-comments"></i>
                </a>
            </li>
            <li class="topbar-desktop-item">
                <button type="button" class="topbar-item" title="@(_darkMode ? "Modo claro" : "Modo escuro")" @onclick="ToggleDarkMode">
                    <i class="pi @(_darkMode ? "pi-sun" : "pi-moon")"></i>
                </button>
            </li>
            <li class="relative topbar-desktop-item">
                <button type="button" class="topbar-item config-item" @ref="_trigger" aria-label="Personalizar tema" @onclick="ToggleConfig">
                    <i class="pi pi-palette"></i>
                </button>
                <OpPopover @ref="_configPopover">
                    <div class="config-panel-content">
                        <div class="config-panel-header">
                            <span class="config-panel-title">Configurações</span>
                            <button type="button" class="config-panel-close" aria-label="Fechar" @onclick="CloseConfig">
                                <i class="pi pi-times"></i>
                            </button>
                        </div>
                        <Configurator/>
                    </div>
                </OpPopover>
            </li>
            <li class="topbar-desktop-item">
                <select class="topbar-item" aria-label="Versão" style="width:4rem;height:2rem;border-radius:6px;border:1px solid var(--border-color);background-color:var(--card-background);color:var(--text-color);font-weight:600;padding:0 .5rem;cursor:pointer;">
                    <option value="v2" selected>v2</option>
                </select>
            </li>
            <li class="menu-button">
                <button type="button" class="topbar-item menu-button" aria-label="Menu" @onclick="LayoutState.ToggleSidebar">
                    <i class="pi pi-bars"></i>
                </button>
            </li>
        </ul>
    </div>
</div>

@code {
    private bool _darkMode;
    private ElementReference _trigger;
    private OpPopover? _configPopover;

    protected override void OnInitialized() => DarkModeState.Changed += OnDarkChanged;

    private void OnDarkChanged() => _darkMode = DarkModeState.Dark;

    private void ToggleDarkMode() => DarkModeState.Set(!DarkModeState.Dark);

    private void ToggleConfig() => _ = _configPopover!.Toggle(_trigger);

    private void CloseConfig() => _ = _configPopover!.Hide();

    public void Dispose() => DarkModeState.Changed -= OnDarkChanged;
}
