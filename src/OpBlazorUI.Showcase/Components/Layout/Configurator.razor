@namespace OpBlazorUI.Showcase.Components.Layout
@using OpBlazorUI.Base.Components.InputSwitch
@implements IDisposable
@inject OpThemeService Theme

<div class="config-panel-content">
    <div class="config-panel-colors">
        <span class="config-panel-label">Primária</span>
        <div>
            @foreach (var palette in OpConfig.PrimaryPalettes)
            {
                <button type="button" title="@palette.Name"
                        @onclick="() => Theme.SetPrimary(palette.Name)"
                        class="@(ActivePrimary == palette.Name ? "active-color" : null)"
                        style="background-color: @palette.Swatch;"></button>
            }
        </div>
    </div>

    <div class="config-panel-colors">
        <span class="config-panel-label">Superfície</span>
        <div>
            @foreach (var palette in OpConfig.SurfacePalettes)
            {
                <button type="button" title="@palette.Name"
                        @onclick="() => Theme.SetSurface(palette.Name)"
                        class="@(ActiveSurface == palette.Name ? "active-color" : null)"
                        style="background-color: @palette.Swatch;"></button>
            }
        </div>
    </div>

    <div class="config-panel-settings">
        <span class="config-panel-label">Presets</span>
        <div class="flex gap-2 flex-wrap">
            @foreach (var preset in Presets)
            {
                <button type="button" title="@preset.Title"
                        disabled="@(!preset.Available)"
                        @onclick="() => SelectPreset(preset)"
                        style="@PresetButtonStyle(preset)">
                    @preset.Name
                </button>
            }
        </div>
    </div>

    <div class="config-panel-setting-row">
        <span class="config-panel-label">RTL</span>
        <OpInputSwitch Value="Theme.Rtl" ValueChanged="OnRtlChanged"/>
    </div>
</div>

@code {
    private sealed record ThemePreset(string Name, string Key, bool Available)
    {
        public string Title => Available ? Name : $"{Name} (em breve)";
    }

    private static readonly ThemePreset[] Presets =
    [
        new("Aura", "aura", true),
        new("Lara", "lara", true),
        new("Nora", "nora", true),
    ];

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    private string ActivePrimary => Theme.Primary ?? "emerald";

    // Sem superfície definida, o preset usa slate no claro e zinc no escuro.
    private string ActiveSurface => Theme.Surface ?? (Theme.DarkMode ? "zinc" : "slate");

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    private bool IsActivePreset(ThemePreset preset) =>
        string.Equals(Theme.Preset, preset.Key, StringComparison.Ordinal);

    private void SelectPreset(ThemePreset preset)
    {
        if (!preset.Available) return;
        Theme.SetPreset(preset.Key);
    }

    private string PresetButtonStyle(ThemePreset preset)
    {
        var active = IsActivePreset(preset);
        var baseCss = "padding:.25rem .75rem;border-radius:6px;font-weight:600;font-size:.875rem;";
        if (!preset.Available)
            return baseCss +
                   $"border:1px solid var(--border-color);background-color:var(--card-background);" +
                   $"color:var(--text-secondary-color);cursor:default;opacity:.6;";
        return baseCss +
               $"border:1px solid {(active ? "var(--primary-color)" : "var(--border-color)")};" +
               $"background-color:{(active ? "var(--primary-color)" : "var(--card-background)")};" +
               $"color:{(active ? "var(--primary-contrast-color)" : "var(--text-secondary-color)")};" +
               "cursor:pointer;";
    }

    private void OnRtlChanged(bool value) => Theme.SetRtl(value);

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
