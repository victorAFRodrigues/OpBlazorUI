            </svg>
        </OpAvatar>
        """;

    private const string AccessibilityCode = """
        <OpAvatar Image="foto.jpg" role="img" AriaLabel="Foto de perfil de Amy" />

        <OpAvatar Label="U" AriaLabel="Usuário U" tabindex="0" />
        """;
}
