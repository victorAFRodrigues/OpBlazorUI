        <OpAvatar Label="V" Size="large" Shape="circle" />
        <OpAvatar Label="U" />
        """;

    private const string IconCode = """
        <OpAvatar Icon="pi pi-user" Size="xlarge" Shape="circle" />
        <OpAvatar Icon="pi pi-user" Size="large" Shape="circle" />
        <OpAvatar Icon="pi pi-user" Shape="circle" />
        """;

    private const string ImageCode = """
        <OpAvatar Image="https://optimus.openng.org/demo/avatar/amyelsner.png" Size="xlarge" Shape="circle" Alt="Amy Elsner" />
        <OpAvatar Image="https://optimus.openng.org/demo/avatar/asiyajavayant.png" Size="large" Shape="circle" Alt="Asiya Javayant" />
        <OpAvatar Image="https://optimus.openng.org/demo/avatar/onyamalimba.png" Shape="circle" Alt="Onya Malimba" />
        """;

    private const string AvatarGroupCode = """
        <OpAvatarGroup>
            <OpAvatar Image="https://optimus.openng.org/demo/avatar/amyelsner.png" Size="large" Shape="circle" Alt="Amy Elsner" />
            <OpAvatar Image="https://optimus.openng.org/demo/avatar/asiyajavayant.png" Size="large" Shape="circle" Alt="Asiya Javayant" />
            <OpAvatar Image="https://optimus.openng.org/demo/avatar/onyamalimba.png" Size="large" Shape="circle" Alt="Onya Malimba" />
            <OpAvatar Label="+2" Shape="circle" Size="large" />
        </OpAvatarGroup>
        """;

    private const string SizeCode = """
        <OpAvatar Label="N" />
        <OpAvatar Label="P" Size="large" />
        <OpAvatar Label="T" Size="xlarge" />
        """;

    private const string ShapeCode = """
        <OpAvatar Label="P" Shape="circle" />
        <OpAvatar Label="T" />
        """;

    private const string BadgeCode = """
        <OpOverlayBadge Value="4" Severity="danger">
            <OpAvatar Image="https://optimus.openng.org/demo/avatar/amyelsner.png" Size="xlarge" Shape="circle" Alt="Amy Elsner" />
        </OpOverlayBadge>
