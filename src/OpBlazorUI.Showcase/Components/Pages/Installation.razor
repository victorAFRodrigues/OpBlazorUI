@page "/installation"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Button

<PageTitle>Installation - OpBlazorUI</PageTitle>

<GuidePage Title="Installation"
           Description="Como instalar o OpBlazorUI em uma aplicação Blazor e colocar o primeiro componente na tela."
           Sections="@Sections">

    <DocSection Label="Pré-requisitos">
        <Description>
            <p>Antes de começar, certifique-se de ter:</p>
            <ul>
                <li>.NET SDK <strong>10.0</strong> ou superior.</li>
                <li>Uma aplicação <strong>Blazor Web App</strong>, <strong>Blazor Server</strong> ou <strong>Blazor WebAssembly</strong>.</li>
                <li>Um editor como Rider, Visual Studio ou VS Code.</li>
            </ul>
        </Description>
    </DocSection>

    <DocSection Label="Compatibilidade">
        <Description>
            <p>O OpBlazorUI é distribuído como uma <em>Razor Class Library</em> e funciona em qualquer modelo de hospedagem do Blazor.</p>
        </Description>
        <ChildContent>
            <ApiTable Caption="Compatibilidade"
                      Headers="@(new[] { "Versão", ".NET", "Modelos" })"
                      Rows="@(new[] {
                          new[] { "1.0.0", "10.0", "Blazor Web App, Server, WebAssembly" }
                      })"/>
        </ChildContent>
    </DocSection>

    <DocSection Label="Autenticação no GitHub Packages">
        <Description>
            <p>O pacote é publicado no <strong>GitHub Packages</strong> deste repositório. O registro do GitHub exige autenticação mesmo para pacotes públicos, então comece criando um <code>nuget.config</code> na raiz do seu projeto com um PAT de escopo <code>read:packages</code>:</p>
            <p>O <code>packageSourceMapping</code> do exemplo garante que apenas <code>OpBlazorUI.*</code> venha do GitHub. Sem ele, uma falha de autenticação do GitHub Packages pode derrubar o restore de pacotes do nuget.org.</p>
        </Description>
        <Code>
            <CodeBlock Language="xml" Code="@NuGetConfigCode"/>
        </Code>
    </DocSection>

    <DocSection Label="Adicionar o pacote">
        <Description>
            <p>Com a autenticação configurada, adicione o pacote normalmente:</p>
        </Description>
        <Code>
            <CodeBlock Language="bash" Code="@("dotnet add package OpBlazorUI.Base")"/>
            <p class="doc-section-description">Ou declare a referência manualmente no <code>.csproj</code>:</p>
            <CodeBlock Language="xml" Code="@PackageReferenceCode"/>
        </Code>
    </DocSection>

    <DocSection Label="Alternativa: GitHub Release">
        <Description>
            <p>Se preferir não configurar credenciais, baixe o <code>.nupkg</code> na página de releases e aponte um source local para a pasta onde salvou:</p>
        </Description>
        <Code>
            <CodeBlock Language="bash"
                       Code="@("dotnet nuget add source ./packages --name optimus-local\ndotnet add package OpBlazorUI.Base")"/>
        </Code>
    </DocSection>

    <DocSection Label="Alternativa: referência de projeto">
        <Description>
            <p>Para desenvolver contra o código-fonte da biblioteca, use a referência direta ao projeto:</p>
        </Description>
        <Code>
            <CodeBlock Language="bash"
                       Code="@("dotnet add reference ../Components/OpBlazorUI.Base/OpBlazorUI.Base.csproj")"/>
        </Code>
    </DocSection>

    <DocSection Label="Imports">
        <Description>
            <p>Importe o namespace raiz no <code>_Imports.razor</code> para ter acesso ao <code>OpBlazorUiSetup</code> e aos serviços (<code>OpThemeService</code>, <code>OpMessageService</code>). Cada componente vive em seu próprio namespace:</p>
        </Description>
        <Code>
            <CodeBlock Language="razor"
                       Code="@("@using OpBlazorUI.Base\n@using OpBlazorUI.Base.Components.Button\n@using OpBlazorUI.Base.Services")"/>
        </Code>
    </DocSection>

    <DocSection Label="Registrar os serviços">
        <Description>
            <p>Registre os serviços da biblioteca no <code>Program.cs</code>. A extensão <code>AddOpBlazorUI()</code> registra o <code>OpThemeService</code> e o <code>OpMessageService</code>, e aceita o tema inicial. Numa <em>Blazor Web App</em> com WebAssembly ou Auto, registre nos <strong>dois</strong> <code>Program.cs</code> (servidor e <code>.Client</code>), com as mesmas opções:</p>
        </Description>
        <Code>
            <CodeBlock Language="csharp"
                       Code="@ServicesCode"/>
        </Code>
    </DocSection>

    <DocSection Label="Adicionar o setup">
        <Description>
            <p>Duas peças, ambas no <code>App.razor</code> (ou no <code>index.html</code>, em WebAssembly standalone):</p>
            <ul>
                <li><code>op-theme.js</code> no <code>&lt;head&gt;</code>, depois do <code>&lt;base href&gt;</code>: carrega o CSS do tema e aplica cores, modo escuro e RTL antes da primeira pintura. Os <code>data-*</code> repetem o tema do <code>AddOpBlazorUI</code>.</li>
                <li><code>&lt;OpBlazorUiSetup /&gt;</code> <strong>dentro da parte interativa</strong> da aplicação, normalmente no <code>MainLayout</code>: carrega ícones e CSS base e aplica as trocas de tema feitas em tempo de execução.</li>
            </ul>
        </Description>
        <Code>
            <CodeBlock Language="razor"
                       Code="@SetupCode"/>
        </Code>
    </DocSection>

    <DocSection Label="Modos de renderização">
        <Description>
            <p>Os componentes são agnósticos ao modo de renderização: o mesmo código roda em <strong>Interactive Server</strong>, <strong>Interactive WebAssembly</strong> e <strong>Interactive Auto</strong> (validado nos três). Algumas regras do Blazor valem para o tema:</p>
            <ul>
                <li><strong>Interatividade global</strong> (<code>&lt;Routes @@rendermode="..." /&gt;</code>) é o cenário mais simples: um único <code>OpThemeService</code> para a aplicação toda.</li>
                <li><strong>Interatividade por página</strong>: o <code>&lt;OpBlazorUiSetup /&gt;</code> precisa usar o <strong>mesmo</strong> render mode das páginas que trocam o tema (por exemplo, <code>&lt;OpBlazorUiSetup @@rendermode="InteractiveServer" /&gt;</code> no layout). Cada “ilha” de render mode tem a sua instância do serviço; um Setup em Server não enxerga trocas feitas numa página WebAssembly.</li>
                <li><strong>Auto</strong>: a primeira visita roda em Server e as seguintes em WebAssembly. O estado do serviço não passa de um runtime para o outro; com <code>PersistTheme = true</code> o tema salvo é restaurado nos dois.</li>
                <li><strong>SSR estático</strong> (sem interatividade): os componentes de exibição renderizam normalmente, mas os interativos (Select, Dialog, DatePicker...) não respondem a eventos, como qualquer componente Blazor. O tema vem só do <code>op-theme.js</code>.</li>
            </ul>
        </Description>
    </DocSection>

    <DocSection Label="Ícones">
        <Description>
            <p>O <code>openng-icons.css</code> é carregado pelo <code>OpBlazorUiSetup</code>, então basta usar as classes <code>pi pi-*</code>:</p>
        </Description>
        <ChildContent>
            <div class="flex gap-3 flex-wrap items-center" style="font-size:1.25rem">
                <i class="pi pi-search"></i>
                <i class="pi pi-user"></i>
                <i class="pi pi-save"></i>
                <i class="pi pi-trash"></i>
                <i class="pi pi-cog"></i>
                <i class="pi pi-bolt"></i>
            </div>
        </ChildContent>
        <Code>
            <CodeBlock Language="razor" Code="@("<i class=\"pi pi-search\"></i>")"/>
        </Code>
    </DocSection>

    <DocSection Label="Verificação">
        <Description>
            <p>Coloque um componente em qualquer página e execute a aplicação. Se o botão aparecer estilizado, a instalação está concluída.</p>
        </Description>
        <ChildContent>
            <OpButton Label="Save" Icon="pi pi-save"/>
        </ChildContent>
        <Code>
            <CodeBlock Language="razor"
                       Code="@("<OpButton Label=\"Save\" Icon=\"pi pi-save\" />")"/>
        </Code>
    </DocSection>

    <DocSection Label="Próximos passos">
        <Description>
            <ul>
                <li><a href="configuration">Configuration</a> — temas, modo escuro, RTL e interop.</li>
                <li><a href="button">Button</a> — comece pelos componentes básicos.</li>
            </ul>
        </Description>
    </DocSection>
</GuidePage>

@code {
    private static readonly IReadOnlyList<string> Sections =
    [
        "Pré-requisitos",
        "Compatibilidade",
        "Autenticação no GitHub Packages",
        "Adicionar o pacote",
        "Alternativa: GitHub Release",
        "Alternativa: referência de projeto",
        "Imports",
        "Registrar os serviços",
        "Adicionar o setup",
        "Modos de renderização",
        "Ícones",
        "Verificação",
        "Próximos passos"
    ];

    private const string NuGetConfigCode = """
        <?xml version="1.0" encoding="utf-8"?>
        <configuration>
            <packageSources>
                <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
                <add key="github" value="https://nuget.pkg.github.com/victorAFRodrigues/index.json" />
            </packageSources>
            <packageSourceCredentials>
                <github>
                    <add key="Username" value="SEU_USUARIO_GITHUB" />
                    <add key="ClearTextPassword" value="SEU_PAT" />
                </github>
            </packageSourceCredentials>
            <packageSourceMapping>
                <packageSource key="nuget.org">
                    <package pattern="*" />
                </packageSource>
                <packageSource key="github">
                    <package pattern="OpBlazorUI.*" />
                </packageSource>
            </packageSourceMapping>
        </configuration>
        """;

    private const string PackageReferenceCode = """
        <ItemGroup>
            <PackageReference Include="OpBlazorUI.Base" Version="1.0.0" />
        </ItemGroup>
        """;

    private const string ServicesCode = """
        builder.Services.AddOpBlazorUI(theme =>
        {
            theme.Preset = "aura";
            theme.PersistTheme = true; // opcional
        });
        """;

    private const string SetupCode = """
        @* App.razor *@
        <head>
            <base href="/" />
            <script src="_content/OpBlazorUI.Base/op-theme.js"
                    data-preset="aura" data-primary="noir"></script>
            ...
            <HeadOutlet @rendermode="InteractiveAuto" />
        </head>
        <body>
            <Routes @rendermode="InteractiveAuto" />
        </body>

        @* MainLayout.razor *@
        <OpBlazorUiSetup />
        @Body
        """;
}
