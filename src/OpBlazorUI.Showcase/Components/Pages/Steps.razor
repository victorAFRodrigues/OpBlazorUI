@page "/steps"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Steps
@using OpBlazorUI.Base.Models

<PageTitle>Steps - OpBlazorUI</PageTitle>

<DocComponent Title="Steps"
              Description="O Steps indica o progresso de um fluxo por meio de uma sequência de etapas.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Clique em uma etapa para ativá-la; use <code>@@bind-ActiveIndex</code>.</Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpSteps Model="_items" @bind-ActiveIndex="_active"/>
                    <span class="text-sm">Etapa ativa: <b>@(_active + 1)</b> — @_items[_active].Label</span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Readonly" Id="readonly">
            <Description>Com <code>Readonly</code>, as etapas exibem o progresso sem permitir interação.</Description>
            <ChildContent>
                <OpSteps Model="_items" ActiveIndex="1" Readonly="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@ReadonlyCode"/></Code>
        </DocSection>

        <DocSection Label="Com itens desabilitados" Id="disabled">
            <Description>Itens com <code>Disabled</code> não podem ser selecionados.</Description>
            <ChildContent>
                <OpSteps Model="_disabledItems" @bind-ActiveIndex="_disabledActive"/>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Cada etapa usa <code>role="tab"</code> com <code>aria-selected</code>; o item ativo recebe <code>tabindex="0"</code>.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para a etapa ativa." },
                              new[] { "enter / space", "Ativa a etapa focada." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Etapas." },
                              new[] { "ActiveIndex", "int", "0", "Índice da etapa ativa (usar <code>@@bind-ActiveIndex</code>)." },
                              new[] { "Readonly", "bool", "false", "Impede a interação." },
                              new[] { "OnSelect", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao selecionar uma etapa." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="steps"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent><div class="doc-section-description"><p>Usa <code>OpMenuItem</code> para as etapas (o upstream usa um item próprio). Sem animação de transição entre etapas.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _active;
    private int _disabledActive;
    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem { Label = "Pessoal" },
        new OpMenuItem { Label = "Endereço" },
        new OpMenuItem { Label = "Pagamento" }
    };
    private readonly List<OpMenuItem> _disabledItems = new()
    {
        new OpMenuItem { Label = "Pessoal" },
        new OpMenuItem { Label = "Endereço", Disabled = true },
        new OpMenuItem { Label = "Pagamento" }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Steps
        @using OpBlazorUI.Base.Models

        <OpSteps Model="_items" @bind-ActiveIndex="_active" />
        """;

    private const string BasicCode = """
        <OpSteps Model="_items" @bind-ActiveIndex="_active" />

        @code {
            private int _active;
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Pessoal" },
                new OpMenuItem { Label = "Endereço" },
                new OpMenuItem { Label = "Pagamento" }
            };
        }
        """;

    private const string ReadonlyCode = """
        <OpSteps Model="_items" ActiveIndex="1" Readonly="true" />
        """;

    private const string DisabledCode = """
        <OpSteps Model="_items" @bind-ActiveIndex="_active" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Pessoal" },
                new OpMenuItem { Label = "Endereço", Disabled = true },
                new OpMenuItem { Label = "Pagamento" }
            };
        }
        """;
}
