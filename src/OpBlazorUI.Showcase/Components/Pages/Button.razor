@page "/button"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Button

<PageTitle>Button - OpBlazorUI</PageTitle>

<DocComponent Title="Button"
              Description="O Button é uma extensão do elemento input padrão, com ícones e temas.">

    <Features>
        <DocSection Label="Importação">
            <Code>
                <CodeBlock Language="razor"
                            Code="@("@using OpBlazorUI.Base.Components.Button\n\n<OpButton Label=\"Salvar\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <div class="flex gap-2 flex-wrap">
                    <OpButton Label="Primário"/>
                    <OpButton Label="Secundário" Severity="secondary"/>
                    <OpButton Label="Sucesso" Severity="success"/>
                    <OpButton Label="Informação" Severity="info"/>
                    <OpButton Label="Aviso" Severity="warn"/>
                    <OpButton Label="Perigo" Severity="danger"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Primário\" />\n<OpButton Label=\"Secundário\" Severity=\"secondary\" />\n<OpButton Label=\"Sucesso\" Severity=\"success\" />\n<OpButton Label=\"Informação\" Severity=\"info\" />\n<OpButton Label=\"Aviso\" Severity=\"warn\" />\n<OpButton Label=\"Perigo\" Severity=\"danger\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Variantes">
            <ChildContent>
                <div class="flex gap-2 flex-wrap">
                    <OpButton Label="Primário"/>
                    <OpButton Label="Contornado" Outlined="true"/>
                    <OpButton Label="Texto" Text="true"/>
                    <OpButton Label="Elevado" Raised="true"/>
                    <OpButton Label="Link" Link="true"/>
                    <OpButton Label="Simples" Plain="true"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Primário\" />\n<OpButton Label=\"Contornado\" Outlined=\"true\" />\n<OpButton Label=\"Texto\" Text=\"true\" />\n<OpButton Label=\"Elevado\" Raised=\"true\" />\n<OpButton Label=\"Link\" Link=\"true\" />\n<OpButton Label=\"Simples\" Plain=\"true\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Ícone">
            <ChildContent>
                <div class="flex gap-2 flex-wrap">
                    <OpButton Label="Pesquisar" Icon="pi pi-search"/>
                    <OpButton Label="Direita" Icon="pi pi-arrow-right" IconPos="right"/>
                    <OpButton Icon="pi pi-search" AriaLabel="Pesquisar"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Pesquisar\" Icon=\"pi pi-search\" />\n<OpButton Label=\"Direita\" Icon=\"pi pi-arrow-right\" IconPos=\"right\" />\n<OpButton Icon=\"pi pi-search\" AriaLabel=\"Pesquisar\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex gap-2 items-center flex-wrap">
                    <OpButton Label="Pequeno" Size="small"/>
                    <OpButton Label="Normal"/>
                    <OpButton Label="Grande" Size="large"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Pequeno\" Size=\"small\" />\n<OpButton Label=\"Normal\" />\n<OpButton Label=\"Grande\" Size=\"large\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Carregando e Desabilitado">
            <ChildContent>
                <div class="flex gap-2 flex-wrap">
                    <OpButton Label="Carregando" Loading="true"/>
                    <OpButton Label="Desabilitado" Disabled="true"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Carregando\" Loading=\"true\" />\n<OpButton Label=\"Desabilitado\" Disabled=\"true\" />")"/>
            </Code>
        </DocSection>

        <DocSection Label="Badge">
            <ChildContent>
                <div class="flex gap-2 flex-wrap">
                    <OpButton Label="Emails" Badge="8"/>
                    <OpButton Label="Mensagens" Badge="24" BadgeSeverity="secondary"/>
                    <OpButton Label="Notificações" Badge="3" BadgeSeverity="success"/>
                    <OpButton Label="Sistema" Badge="9" BadgeSeverity="warn" BadgeSize="large"/>
                    <OpButton Icon="pi pi-bell" Badge="5" BadgeSeverity="danger" AriaLabel="Notificações"/>
                </div>
            </ChildContent>
            <Code>
                <CodeBlock Code="@("<OpButton Label=\"Emails\" Badge=\"8\" />\n<OpButton Label=\"Mensagens\" Badge=\"24\" BadgeSeverity=\"secondary\" />\n<OpButton Label=\"Notificações\" Badge=\"3\" BadgeSeverity=\"success\" />\n<OpButton Label=\"Sistema\" Badge=\"9\" BadgeSeverity=\"warn\" BadgeSize=\"large\" />\n<OpButton Icon=\"pi pi-bell\" Badge=\"5\" BadgeSeverity=\"danger\" AriaLabel=\"Notificações\" />")"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Label", "string?", "null", "Texto exibido no botão." },
                              new[] { "Icon", "string?", "null", "Classe do ícone (ex.: <code>pi pi-search</code>)." },
                              new[] { "IconPos", "string", "left", "Posição do ícone: <code>left</code>, <code>right</code>, <code>top</code>, <code>bottom</code>." },
                              new[] { "Severity", "string?", "null", "Severidade: <code>secondary</code>, <code>success</code>, <code>info</code>, <code>warn</code>, <code>danger</code>, <code>contrast</code>." },
                              new[] { "Variant", "string?", "null", "Variante: <code>outlined</code>, <code>text</code>, <code>raised</code>, <code>link</code>, <code>plain</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Loading", "bool", "false", "Exibe o spinner de carregamento e desabilita o botão." },
                              new[] { "Badge", "string?", "null", "Valor exibido no badge do botão (posicionado no canto superior direito)." },
                              new[] { "BadgeSeverity", "string?", "null", "Severidade do badge: <code>secondary</code>, <code>success</code>, <code>info</code>, <code>warn</code>, <code>danger</code>, <code>contrast</code>." },
                              new[] { "BadgeSize", "string?", "null", "Tamanho do badge: <code>small</code>, <code>large</code>, <code>xlarge</code>." },
                              new[] { "BadgeClass", "string?", "null", "Classes adicionais no badge." },
                              new[] { "BadgeDisabled", "bool", "false", "Desabilita o badge." },
                              new[] { "BadgeStyle", "string?", "null", "Estilo inline adicional no badge." },
                              new[] { "BadgeAdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos adicionais repassados ao badge." },
                              new[] { "Disabled", "bool", "false", "Desabilita o botão." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura disponível." },
                              new[] { "Rounded", "bool", "false", "Aplica cantos totalmente arredondados." },
                              new[] { "Raised", "bool", "false", "Aplica sombra elevada." },
                              new[] { "Text", "bool", "false", "Renderiza como botão de texto (sem fundo/borda)." },
                              new[] { "Outlined", "bool", "false", "Renderiza como botão outlined." },
                              new[] { "Link", "bool", "false", "Renderiza como link." },
                              new[] { "Plain", "bool", "false", "Renderiza sem decoração." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Conteúdo customizado." },
                              new[] { "IconTemplate", "RenderFragment?", "null", "Template customizado para o ícone." },
                              new[] { "OnClick", "EventCallback&lt;MouseEventArgs&gt;", "-", "Evento disparado no clique." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent>
                <DocTokens Component="button"/>
            </ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular ainda não foi portado para o Blazor. Para customização de estilo, use <code>StyleClass</code>, <code>ChildContent</code>, <code>IconTemplate</code> e os <code>AdditionalAttributes</code> (qualquer atributo extra é repassado ao elemento raiz).</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description">
                    <p>Nenhum problema conhecido no momento.</p>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>
