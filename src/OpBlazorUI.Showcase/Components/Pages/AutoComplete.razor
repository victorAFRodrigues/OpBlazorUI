    private const string VirtualCode = """
        <OpAutoComplete TValue="VirtualItem" @bind-Value="_selected"
                         VirtualScroll="true" VirtualScrollItemSize="34"
                         ItemsProvider="LoadItems" OptionLabel="Label" Dropdown="true" Placeholder="Item" />

        @code {
            private VirtualItem? _selected;

            private static readonly List<VirtualItem> _items =
                Enumerable.Range(0, 10000).Select(i => new VirtualItem { Label = "Item " + i, Value = "Item " + i }).ToList();

            private ValueTask<ItemsProviderResult<object>> LoadItems(ItemsProviderRequest request)
            {
                var items = _items.Skip(request.StartIndex).Take(request.Count).Cast<object>();
                return ValueTask.FromResult(new ItemsProviderResult<object>(items, _items.Count));
            }
        }
        """;
