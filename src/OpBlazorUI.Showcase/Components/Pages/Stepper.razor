@page "/stepper"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Stepper - OpBlazorUI</PageTitle>

<DocComponent Title="Stepper"
              Description="O Stepper exibe um fluxo de trabalho estilo assistente, guiando o usuário por uma progressão de múltiplas etapas. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Horizontal" Id="horizontal">
            <Description><p>O Stepper consiste em uma combinação dos componentes <code>StepList</code>, <code>Step</code>, <code>StepPanels</code> e <code>StepPanel</code>. A propriedade <code>value</code> é essencial para associar <code>Step</code> e <code>StepPanel</code> entre si.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Vertical" Id="vertical">
            <Description><p>O layout vertical requer <code>StepItem</code> como invólucro dos componentes <code>Step</code> e <code>StepPanel</code>.</p></Description>
            <Code><CodeBlock Code="@VerticalCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Linear" Id="linear">
            <Description><p>Quando a propriedade <code>linear</code> é definida como <code>true</code>, a etapa atual deve ser concluída para avançar para a próxima.</p></Description>
            <Code><CodeBlock Code="@LinearCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Somente Passos" Id="steps-only">
            <Description><p>Use o Stepper apenas com um <code>StepList</code> para requisitos customizados onde um indicador de progresso é necessário.</p></Description>
            <Code><CodeBlock Code="@StepsOnlyCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>O Stepper oferece várias opções de template para customizar o design padrão da interface.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O contêiner do Stepper é definido com o papel <code>tablist</code>; como qualquer atributo é repassado ao elemento contêiner, <code>aria-labelledby</code> pode ser usado opcionalmente para especificar um elemento que descreva o Stepper. Cada cabeçalho do stepper tem o papel <code>tab</code> e <code>aria-controls</code> para se referir ao elemento de conteúdo correspondente. O elemento de conteúdo de cada stepper tem o papel <code>tabpanel</code>, um id que corresponde ao <code>aria-controls</code> do cabeçalho e uma referência <code>aria-labelledby</code> ao cabeçalho como nome acessível.</p>
                <h3>Suporte a teclado do cabeçalho</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco pelos cabeçalhos." },
                              new[] { "enter", "Ativa o cabeçalho do stepper focado." },
                              new[] { "space", "Ativa o cabeçalho do stepper focado." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { StepperModule } from 'primeng/stepper';
        """;

    private const string BasicCode = """
