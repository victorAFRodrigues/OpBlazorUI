@page "/stepper"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Stepper
@using OpBlazorUI.Base.Models

<PageTitle>Stepper - OpBlazorUI</PageTitle>

<DocComponent Title="Stepper"
              Description="O Stepper organiza um fluxo em etapas, cada uma com seu próprio painel de conteúdo.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Cada item do <code>Model</code> traz um <code>Label</code> e um <code>Content</code>.</Description>
            <ChildContent>
                <OpStepper Model="_steps" @bind-ActiveIndex="_active"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Readonly" Id="readonly">
            <Description>Com <code>Readonly</code>, as etapas são apenas indicativas.</Description>
            <ChildContent>
                <OpStepper Model="_steps" ActiveIndex="1" Readonly="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@ReadonlyCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O passo ativo recebe <code>aria-current="step"</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Cada cabeçalho de passo é um botão alcançável por <code>tab</code> e acionável por <code>enter</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpStepItem&gt;", "[]", "Passos (Label + Content + Disabled)." },
                              new[] { "ActiveIndex", "int", "0", "Índice do passo ativo (usar <code>@@bind-ActiveIndex</code>)." },
                              new[] { "Readonly", "bool", "false", "Impede a interação." },
                              new[] { "Linear", "bool", "false", "Navegação linear: só avança para o próximo passo, sem pular etapas." },
                              new[] { "OnSelect", "EventCallback&lt;OpStepItem&gt;", "—", "Disparado ao selecionar um passo." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="stepper"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>A API é model-driven (<code>OpStepItem</code> com <code>Content</code>), diferente da composição por componentes-filhos do Angular.</li>
                        <li>O painel só é renderizado para o passo ativo (sem animação de slide entre passos).</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _active;
    private List<OpStepItem> _steps = new();

    protected override void OnInitialized()
    {
        _steps = new List<OpStepItem>
        {
            new() { Label = "Conta", Content = @<p class="m-0">Informe os dados da conta.</p> },
            new() { Label = "Perfil", Content = @<p class="m-0">Configure o seu perfil.</p> },
            new() { Label = "Confirmação", Content = @<p class="m-0">Revise e confirme.</p> }
        };
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Stepper
        @using OpBlazorUI.Base.Models

        <OpStepper Model="_steps" @bind-ActiveIndex="_active" />

        @code {
            private int _active;
            private List<OpStepItem> _steps = new()
            {
                new() { Label = "Conta", Content = @<p>Dados da conta.</p> },
                new() { Label = "Perfil", Content = @<p>Configuração do perfil.</p> }
            };
        }
        """;

    private const string BasicCode = """
        <OpStepper Model="_steps" @bind-ActiveIndex="_active" />

        @code {
            private int _active;
            private List<OpStepItem> _steps = new()
            {
                new() { Label = "Conta", Content = @<p>Dados da conta.</p> },
                new() { Label = "Perfil", Content = @<p>Configuração do perfil.</p> },
                new() { Label = "Confirmação", Content = @<p>Revise e confirme.</p> }
            };
        }
        """;

    private const string ReadonlyCode = """
        <OpStepper Model="_steps" ActiveIndex="1" Readonly="true" />
        """;

    private const string AccessibilityCode = """
        <OpStepper Model="_steps" @bind-ActiveIndex="_active" />
        """;
}
