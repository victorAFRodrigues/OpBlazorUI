@page "/styleclass"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.Directives

<PageTitle>StyleClass - OpBlazorUI</PageTitle>

<style>
    .sc-invisible {
        opacity: 0;
    }

    @@keyframes sc-fadein {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes sc-fadeout {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    .sc-fadein {
        animation: sc-fadein .4s ease forwards;
    }

    .sc-fadeout {
        animation: sc-fadeout .4s ease forwards;
    }

    .sc-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 8rem;
        height: 8rem;
        font-weight: 700;
        border-radius: 6px;
        background: var(--p-primary-color);
        color: var(--p-primary-contrast-color);
    }
</style>

<DocComponent Title="StyleClass"
              Description="O StyleClass gerencia classes CSS de um alvo de forma declarativa, para alternar classes ou executar animações de enter/leave. No Blazor é um componente que envolve o gatilho do clique.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Alternar Classe" Id="toggleclass">
            <Description>
                <p>Com <code>ToggleClass</code>, o alvo (definido por <code>Target</code>) tem as classes
                    alternadas a cada clique. <code>Target</code> aceita qualquer seletor CSS ou as
                    palavras-chave <code>@@next</code>, <code>prev</code>, <code>parent</code> e
                    <code>grandparent</code> (relativas ao wrapper).</p>
            </Description>
            <ChildContent>
                <div class="card flex flex-col items-center gap-4">
                    <OpStyleClass Target="@("@next")" ToggleClass="hidden">
                        <OpButton Label="Toggle Display"/>
                    </OpStyleClass>
                    <input type="text" class="p-inputtext hidden" placeholder="Texto"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ToggleClassCode"/></Code>
        </DocSection>

        <DocSection Label="Animação" Id="animation">
            <Description>
                <p>As classes aplicadas durante as animações de enter/leave são definidas por
                    <code>EnterFromClass</code>, <code>EnterActiveClass</code>, <code>EnterToClass</code>,
                    <code>LeaveFromClass</code>, <code>LeaveActiveClass</code> e <code>LeaveToClass</code>.
                    Quando só as propriedades de enter (ou só as de leave) são informadas, o gatilho
                    executa sempre aquele sentido.</p>
            </Description>
            <ChildContent>
                <div class="card flex items-center justify-center gap-8">
                    <div class="flex flex-col items-center gap-4">
                        <div class="flex gap-2">
                            <OpStyleClass Target=".sc-box1" EnterFromClass="sc-invisible" EnterActiveClass="sc-fadein">
                                <OpButton Label="FadeIn"/>
                            </OpStyleClass>
                            <OpStyleClass Target=".sc-box1" LeaveActiveClass="sc-fadeout" LeaveToClass="sc-invisible">
                                <OpButton Label="FadeOut" Severity="secondary"/>
                            </OpStyleClass>
                        </div>
                        <div class="sc-box1 sc-invisible sc-box">Custom</div>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@AnimationCode"/></Code>
        </DocSection>

        <DocSection Label="Ocultar ao Redimensionar" Id="hideonresize">
            <Description>
                <p>Com <code>HideOnResize</code>, a animação de leave é disparada ao redimensionar.
                    <code>ResizeSelector</code> define o que observar: <code>window</code> (padrão),
                    <code>document</code> ou um seletor CSS.</p>
            </Description>
            <ChildContent>
                <div class="card flex flex-wrap justify-center gap-4">
                    <div class="flex flex-col items-center gap-4" style="width:25rem">
                        <OpStyleClass Target=".sc-resize-box" EnterFromClass="hidden" EnterActiveClass="sc-fadein"
                                      LeaveActiveClass="sc-fadeout" LeaveToClass="hidden"
                                      HideOnResize="true" ResizeSelector="window">
                            <OpButton Label="Show Window Responsive Content"/>
                        </OpStyleClass>
                        <div class="sc-resize-box hidden"
                             style="width:100%;border:1px solid var(--p-content-border-color);border-radius:12px">
                            <div class="p-4 flex flex-col gap-2">
                                <h3 class="font-bold">Window Responsive Panel</h3>
                                <p class="text-muted-color">This panel will hide when you resize the browser window.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@HideOnResizeCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Target", "string?", "null", "Seletor do alvo (CSS ou <code>@next</code>/<code>prev</code>/<code>parent</code>/<code>grandparent</code>). Sem valor, o alvo é o próprio wrapper." },
                              new[] { "ToggleClass", "string?", "null", "Modo simples: classes alternadas a cada clique." },
                              new[] { "EnterFromClass", "string?", "null", "Classe(s) iniciais da animação de enter." },
                              new[] { "EnterActiveClass", "string?", "null", "Classe(s) ativas durante a animação de enter." },
                              new[] { "EnterToClass", "string?", "null", "Classe(s) finais da animação de enter." },
                              new[] { "LeaveFromClass", "string?", "null", "Classe(s) iniciais da animação de leave." },
                              new[] { "LeaveActiveClass", "string?", "null", "Classe(s) ativas durante a animação de leave." },
                              new[] { "LeaveToClass", "string?", "null", "Classe(s) finais da animação de leave." },
                              new[] { "HideOnOutsideClick", "bool", "false", "Dispara o leave quando o clique ocorre fora do alvo." },
                              new[] { "HideOnEscape", "bool", "false", "Dispara o leave ao pressionar <code>Escape</code>." },
                              new[] { "HideOnResize", "bool", "false", "Dispara o leave ao redimensionar." },
                              new[] { "ResizeSelector", "string", "\"window\"", "Alvo do <code>HideOnResize</code>: <code>window</code>, <code>document</code> ou seletor CSS." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Elemento gatilho do clique." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS" Id="style">
            <ChildContent>
                <div class="doc-section-description">
                    <p>As classes manipuladas são definidas pelo consumidor; o componente não adiciona
                        classes estruturais além do wrapper <code>&lt;span style="display:contents"&gt;</code>.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular não será portado como tal; a customização é feita pelos
                        parâmetros do componente.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O upstream aplica a diretiva ao próprio gatilho; aqui o componente renderiza um
                            <code>&lt;span style="display:contents"&gt;</code> em volta dele (desvio consciente).</li>
                        <li>As palavras-chave relativas (<code>@@next</code>, <code>parent</code>, …) são
                            resolvidas a partir do wrapper, não do gatilho interno.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Directives
        """;

    private const string ToggleClassCode = """
        <OpStyleClass Target="@("@next")" ToggleClass="hidden">
            <OpButton Label="Toggle Display" />
        </OpStyleClass>
        <input type="text" class="p-inputtext hidden" />
        """;

    private const string AnimationCode = """
        <OpStyleClass Target=".box1" EnterFromClass="sc-invisible" EnterActiveClass="sc-fadein">
            <OpButton Label="FadeIn" />
        </OpStyleClass>
        <OpStyleClass Target=".box1" LeaveActiveClass="sc-fadeout" LeaveToClass="sc-invisible">
            <OpButton Label="FadeOut" Severity="secondary" />
        </OpStyleClass>
        <div class="box1 sc-invisible sc-box">Custom</div>
        """;

    private const string HideOnResizeCode = """
        <OpStyleClass Target=".panel" EnterFromClass="hidden" EnterActiveClass="sc-fadein"
                      LeaveActiveClass="sc-fadeout" LeaveToClass="hidden"
                      HideOnResize="true" ResizeSelector="window">
            <OpButton Label="Show Window Responsive Content" />
        </OpStyleClass>
        <div class="panel hidden">...</div>
        """;
}
