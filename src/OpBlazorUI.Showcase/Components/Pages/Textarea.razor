@page "/textarea"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Textarea - OpBlazorUI</PageTitle>

<DocComponent Title="Textarea"
              Description="Campo de texto multilinha. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>Textarea é aplicado a um campo de entrada com a diretiva <code>pTextarea</code>.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Redimensionamento Automático" Id="autoresize">
            <Description><p>Com <code>autoResize</code> habilitado, o campo cresce em vez de exibir barra de rolagem.</p></Description>
            <Code><CodeBlock Code="@AutoResizeCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Float Label" Id="floatlabel">
            <Description><p>Um rótulo flutuante aparece sobre o campo quando ele recebe foco. Veja a documentação de <a href="/floatlabel">FloatLabel</a>.</p></Description>
            <Code><CodeBlock Code="@FloatLabelCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Ifta Label" Id="iftalabel">
            <Description><p>O IftaLabel cria rótulos alinhados no topo, dentro do campo. Veja a documentação de <a href="/iftalabel">IftaLabel</a>.</p></Description>
            <Code><CodeBlock Code="@IftaLabelCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos" Id="sizes">
            <Description><p>Textarea oferece os tamanhos <code>small</code> e <code>large</code> como alternativa ao padrão.</p></Description>
            <Code><CodeBlock Code="@SizesCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Largura Total" Id="fluid">
            <Description><p>A propriedade <code>fluid</code> faz o componente ocupar toda a largura do contêiner.</p></Description>
            <Code><CodeBlock Code="@FluidCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Preenchido" Id="filled">
            <Description><p>Defina <code>variant="filled"</code> para um destaque visual maior que o estilo <code>outlined</code> padrão.</p></Description>
            <Code><CodeBlock Code="@FilledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description><p>Com <code>disabled</code>, o elemento não pode ser editado nem focado.</p></Description>
            <Code><CodeBlock Code="@DisabledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description><p>O estado inválido é aplicado com a propriedade <code>invalid</code> para indicar falha de validação; integra-se com os formulários Angular.</p></Description>
            <Code><CodeBlock Code="@InvalidCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description><p>No Blazor, a integração acontecerá via <code>EditForm</code> + <code>DataAnnotationsValidator</code>, herdando de <code>OpInputBase&lt;TValue&gt;</code>. Abaixo, o equivalente da referência Angular.</p></Description>
            <Code><CodeBlock Code="@ReactiveCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template Driven" Id="templatedriven">
            <Description><p>Uso com formulários template driven do Angular (<code>ngModel</code>).</p></Description>
            <Code><CodeBlock Code="@TemplateDrivenCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Reactive Forms" Id="reactive">
            <Description><p>Uso com formulários reativos do Angular (<code>formControlName</code>).</p></Description>
            <Code><CodeBlock Code="@ReactiveCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente renderiza um elemento <code>textarea</code> nativo. O valor para descrever o componente pode ser informado via <code>label</code> + <code>id</code> ou pelos atributos <code>aria-labelledby</code>/<code>aria-label</code>.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] { new[] { "tab", "Move o foco para o campo." } })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { TextareaModule } from 'primeng/textarea';
        """;

    private const string BasicCode = """
        <textarea rows="5" cols="30" pTextarea [(ngModel)]="value"></textarea>
        """;

    private const string AutoResizeCode = """
        <textarea rows="5" cols="30" pTextarea [autoResize]="true"></textarea>
        """;

    private const string FloatLabelCode = """
        <p-floatlabel>
            <textarea pTextarea id="over_label" [(ngModel)]="value1" rows="5" cols="30" style="resize: none" class="h-full"></textarea>
            <label for="over_label">Over Label</label>
        </p-floatlabel>

        <p-floatlabel variant="in">
            <textarea pTextarea id="in_label" [(ngModel)]="value2" rows="5" cols="30" style="resize: none" class="h-full"></textarea>
            <label for="in_label">In Label</label>
        </p-floatlabel>

        <p-floatlabel variant="on">
            <textarea pTextarea id="on_label" [(ngModel)]="value3" rows="5" cols="30" style="resize: none" class="h-full"></textarea>
            <label for="on_label">On Label</label>
        </p-floatlabel>
        """;

    private const string IftaLabelCode = """
        <p-iftalabel>
            <textarea pTextarea id="description" [(ngModel)]="value" rows="5" cols="30" style="resize: none"></textarea>
            <label for="description">Description</label>
        </p-iftalabel>
        """;

    private const string SizesCode = """
        <textarea pTextarea [(ngModel)]="value1" pSize="small" placeholder="Small" rows="3"></textarea>
        <textarea pTextarea [(ngModel)]="value2" placeholder="Normal" rows="3"></textarea>
        <textarea pTextarea [(ngModel)]="value3" pSize="large" placeholder="Large" rows="3"></textarea>
        """;

    private const string FluidCode = """
        <textarea rows="5" cols="30" pTextarea [(ngModel)]="value" fluid></textarea>
        """;

    private const string FilledCode = """
        <textarea [(ngModel)]="value" [variant]="'filled'" rows="5" cols="30" pTextarea></textarea>
        """;

    private const string DisabledCode = """
        <textarea rows="5" cols="30" pTextarea [disabled]="true"></textarea>
        """;

    private const string InvalidCode = """
        <textarea rows="5" cols="30" pTextarea [(ngModel)]="value" [invalid]="!value" placeholder="Address"></textarea>
        """;

    private const string TemplateDrivenCode = """
        <form #exampleForm="ngForm" (ngSubmit)="onSubmit(exampleForm)" class="flex flex-col gap-4">
            <textarea name="address" #address="ngModel" rows="5" cols="30" [(ngModel)]="value" pTextarea
                [invalid]="address.invalid && (address.touched || exampleForm.submitted)" required></textarea>
            @if (address.invalid && (address.touched || exampleForm.submitted)) {
                <p-message severity="error" size="small" variant="simple">Address is required.</p-message>
            }
            <button pButton severity="secondary" type="submit"><span pButtonLabel>Submit</span></button>
        </form>
        """;

    private const string ReactiveCode = """
        <form [formGroup]="exampleForm" (ngSubmit)="onSubmit()" class="flex flex-col gap-4">
            <textarea rows="5" cols="30" pTextarea formControlName="address" [invalid]="isInvalid('address')"></textarea>
            @if (isInvalid('address')) {
                <p-message severity="error" size="small" variant="simple">Address is required.</p-message>
            }
            <button pButton severity="secondary" type="submit"><span pButtonLabel>Submit</span></button>
        </form>
        """;
}
