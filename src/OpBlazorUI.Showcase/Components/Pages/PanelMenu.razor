@page "/panelmenu"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Menu
@using OpBlazorUI.Base.Models

<PageTitle>PanelMenu - OpBlazorUI</PageTitle>

<DocComponent Title="PanelMenu"
              Description="O PanelMenu combina painéis expansíveis com itens de menu em uma navegação vertical.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Os itens raiz com filhos viram painéis expansíveis.</Description>
            <ChildContent>
                <div style="max-width: 20rem;">
                    <OpPanelMenu Model="_items"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Um por vez" Id="single">
            <Description>Com <code>Multiple="false"</code>, apenas um painel fica aberto.</Description>
            <ChildContent>
                <div style="max-width: 20rem;">
                    <OpPanelMenu Model="_items" Multiple="false"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SingleCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>A lista raiz usa <code>role="tree"</code>; os cabeçalhos usam <code>role="button"</code> com <code>aria-expanded</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Os cabeçalhos e links são alcançáveis por <code>tab</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Itens do menu." },
                              new[] { "Multiple", "bool", "true", "Permite vários painéis abertos." },
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao clicar em um item." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="panelmenu"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Suporta um nível de itens por painel (sem submenus aninhados).</li>
                        <li>Sem animação de abertura; o painel é renderizado ao expandir.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem
        {
            Label = "Arquivo",
            Icon = "pi pi-folder",
            Items = new List<OpMenuItem>
            {
                new() { Label = "Novo", Icon = "pi pi-plus" },
                new() { Label = "Abrir", Icon = "pi pi-folder-open" },
                new() { Label = "Salvar", Icon = "pi pi-save" }
            }
        },
        new OpMenuItem
        {
            Label = "Usuário",
            Icon = "pi pi-user",
            Items = new List<OpMenuItem>
            {
                new() { Label = "Perfil", Icon = "pi pi-id-card" },
                new() { Label = "Sair", Icon = "pi pi-power-off" }
            }
        },
        new OpMenuItem { Label = "Ajuda", Icon = "pi pi-question-circle" }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Menu
        @using OpBlazorUI.Base.Models

        <OpPanelMenu Model="_items" />
        """;

    private const string BasicCode = """
        <OpPanelMenu Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem
                {
                    Label = "Arquivo",
                    Icon = "pi pi-folder",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Novo" },
                        new() { Label = "Abrir" }
                    }
                },
                new OpMenuItem { Label = "Ajuda" }
            };
        }
        """;

    private const string SingleCode = """
        <OpPanelMenu Model="_items" Multiple="false" />
        """;

    private const string AccessibilityCode = """
        <OpPanelMenu Model="_items" />
        """;
}
