@page "/picklist"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.PickList

<PageTitle>PickList - OpBlazorUI</PageTitle>

<DocComponent Title="PickList"
              Description="Usado para mover itens entre duas listas (origem e destino) por meio dos botões de transferência.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>O PickList é usado como uma entrada controlada pelas propriedades <code>Source</code> e
                <code>Target</code>, com <code>@@bind-Source</code> e <code>@@bind-Target</code> para receber as listas
                após cada transferência. O conteúdo de um item da lista precisa ser definido com o template
                <code>ItemTemplate</code>, que recebe um objeto da lista como parâmetro.</p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpPickList TItem="Product"
                                @bind-Source="_source"
                                @bind-Target="_target"
                                OptionLabel="Name"
                                SourceHeader="Disponíveis"
                                TargetHeader="Selecionados"
                                AriaLabel="Produtos"
                                ScrollHeight="20rem">
                        <ItemTemplate Context="p">
                            <span>@p.Name</span>
                        </ItemTemplate>
                    </OpPickList>
                    <span class="text-sm">Origem: <b>@_source.Count</b> — Destino: <b>@_target.Count</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description>
                <p>O valor do filtro é verificado contra a propriedade de um objeto configurada com a propriedade
                <code>FilterBy</code>. Habilite com <code>Filter="true"</code>; use <code>FilterSource</code> e
                <code>FilterTarget</code> para ligar o campo em apenas uma das listas.</p>
            </Description>
            <ChildContent>
                <OpPickList TItem="Product"
                            Source="_filterSource"
                            Target="_filterTarget"
                            OptionLabel="Name"
                            Filter="true"
                            FilterBy="Name"
                            ScrollHeight="20rem">
                    <ItemTemplate Context="p">
                        <div style="display:flex; align-items:center; gap:1rem; width:100%;">
                            <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:3rem; border-radius:var(--p-content-border-radius);"/>
                            <div style="display:flex; flex-direction:column;">
                                <span class="font-medium text-sm">@p.Name</span>
                                <span class="text-sm" style="color:var(--p-text-muted-color);">@p.Category</span>
                            </div>
                            <span class="font-bold" style="margin-left:auto;">$@p.Price</span>
                        </div>
                    </ItemTemplate>
                </OpPickList>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                <p>Para conteúdo customizado, defina o template <code>ItemTemplate</code>, que recebe a instância do
                item como parâmetro. Além disso, os parâmetros <code>SourceHeader</code> e <code>TargetHeader</code>
                são fornecidos para customização adicional.</p>
            </Description>
            <ChildContent>
                <OpPickList TItem="Product"
                            Source="_templateSource"
                            Target="_templateTarget"
                            OptionLabel="Name"
                            SourceHeader="Disponíveis"
                            TargetHeader="Selecionados"
                            ScrollHeight="20rem">
                    <ItemTemplate Context="p">
                        <div style="display:flex; align-items:center; gap:1rem; width:100%;">
                            <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:3rem; border-radius:var(--p-content-border-radius);"/>
                            <div style="display:flex; flex-direction:column;">
                                <span class="font-medium text-sm">@p.Name</span>
                                <span class="text-sm" style="color:var(--p-text-muted-color);">@p.Category</span>
                            </div>
                            <span class="font-bold" style="margin-left:auto;">$@p.Price</span>
                        </div>
                    </ItemTemplate>
                </OpPickList>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O valor para descrever as listboxes de origem e destino pode ser fornecido com
                <code>AriaLabel</code>. Os elementos de lista têm o papel <code>listbox</code> com o atributo
                <code>aria-multiselectable</code>. Cada item da lista tem o papel <code>option</code> com
                <code>aria-selected</code> e <code>aria-disabled</code> como atributos.</p>
                <p>Os botões de controle são elementos <code>button</code> com um <code>aria-label</code> que se refere
                às ações de mover para a lista de destino, mover todos, mover para a lista de origem e mover todos de
                volta.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Caption="PickList"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para a primeira opção selecionada; se não houver nenhuma, a primeira opção recebe o foco." },
                              new[] { "up arrow", "Move o foco para a opção anterior." },
                              new[] { "down arrow", "Move o foco para a próxima opção." },
                              new[] { "enter", "Alterna o estado selecionado da opção em foco." },
                              new[] { "space", "Alterna o estado selecionado da opção em foco." },
                              new[] { "home", "Move o foco para a primeira opção." },
                              new[] { "end", "Move o foco para a última opção." }
                          })"/>
                <ApiTable Caption="Botões"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "enter", "Executa a ação do botão." },
                              new[] { "space", "Executa a ação do botão." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Source", "IReadOnlyList&lt;TItem&gt;", "[]", "Lista de origem; use <code>@@bind-Source</code>." },
                              new[] { "Target", "IReadOnlyList&lt;TItem&gt;", "[]", "Lista de destino; use <code>@@bind-Target</code>." },
                              new[] { "SelectedSource", "IReadOnlyList&lt;TItem&gt;?", "null", "Itens selecionados na origem; use <code>@@bind-SelectedSource</code>." },
                              new[] { "SelectedTarget", "IReadOnlyList&lt;TItem&gt;?", "null", "Itens selecionados no destino; use <code>@@bind-SelectedTarget</code>." },
                              new[] { "OptionLabel", "string?", "null", "Propriedade do item usada como rótulo e critério do filtro." },
                              new[] { "Filter", "bool", "false", "Habilita o campo de busca nas listas." },
                              new[] { "FilterSource", "bool", "true", "Habilita o campo de busca na lista de origem." },
                              new[] { "FilterTarget", "bool", "true", "Habilita o campo de busca na lista de destino." },
                              new[] { "FilterBy", "string?", "null", "Propriedade do item usada como critério do filtro." },
                              new[] { "ShowSourceControls", "bool", "true", "Exibe os controles de reordenação da origem." },
                              new[] { "ShowTargetControls", "bool", "true", "Exibe os controles de reordenação do destino." },
                              new[] { "ScrollHeight", "string?", "14rem", "Altura máxima de cada lista, com rolagem." },
                              new[] { "EmptyMessage", "string?", "No results found", "Mensagem exibida quando não há itens." },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo de acessibilidade das listboxes." },
                              new[] { "SourceHeader", "string?", "null", "Texto do cabeçalho da lista de origem." },
                              new[] { "TargetHeader", "string?", "null", "Texto do cabeçalho da lista de destino." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "SourceChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;&gt;", "Disparado quando a lista de origem muda." },
                              new[] { "TargetChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;&gt;", "Disparado quando a lista de destino muda." },
                              new[] { "SelectedSourceChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;&gt;", "Disparado quando a seleção da origem muda." },
                              new[] { "SelectedTargetChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;&gt;", "Disparado quando a seleção do destino muda." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TItem&gt;?", "Conteúdo customizado de cada item; o contexto é a instância do item." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="picklist"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code>, o <code>ItemTemplate</code> e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O arrastar e soltar (<code>dragdrop</code>) do upstream, que depende do <code>@@angular/cdk</code>, não foi portado. A transferência é feita pelos botões de controle.</li>
                        <li>Não há as propriedades <code>dataKey</code>, <code>responsive</code> e <code>breakpoint</code> do upstream.</li>
                        <li>Não há as props de customização dos botões (<code>moveTopButtonProps</code> e afins); os rótulos acessíveis são fixos em inglês.</li>
                        <li>Os cabeçalhos (<code>SourceHeader</code>/<code>TargetHeader</code>) são entregues ao cabeçalho de cada listbox, e não como irmãos no flex do componente, para preservar o layout.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private IReadOnlyList<Product> _source = SourceProducts();
    private IReadOnlyList<Product> _target = TargetProducts();

    private static readonly IReadOnlyList<Product> _filterSource = SourceProducts();
    private static readonly IReadOnlyList<Product> _filterTarget = TargetProducts();
    private static readonly IReadOnlyList<Product> _templateSource = SourceProducts();
    private static readonly IReadOnlyList<Product> _templateTarget = TargetProducts();

    private sealed record Product(string Name, string Category, string Image, decimal Price, int Rating, string InventoryStatus);

    private static IReadOnlyList<Product> SourceProducts() =>
    [
        new("Bamboo Watch", "Acessórios", "bamboo-watch.jpg", 65, 5, "INSTOCK"),
        new("Black Watch", "Acessórios", "black-watch.jpg", 72, 4, "INSTOCK"),
        new("Blue Band", "Fitness", "blue-band.jpg", 79, 3, "LOWSTOCK"),
        new("Blue T-Shirt", "Vestuário", "blue-t-shirt.jpg", 29, 5, "INSTOCK"),
        new("Bolt Shirt", "Vestuário", "bolt-shirt.jpg", 89, 4, "LOWSTOCK")
    ];

    private static IReadOnlyList<Product> TargetProducts() =>
    [
        new("Chakra Bracelet", "Acessórios", "chakra-bracelet.jpg", 45, 4, "OUTOFSTOCK"),
        new("Gaming Set", "Eletrônicos", "gaming-set.jpg", 299, 5, "INSTOCK"),
        new("Wristwatch", "Acessórios", "wristwatch.jpg", 120, 4, "LOWSTOCK")
    ];

    private static string ImageUrl(string image) => $"https://primefaces.org/cdn/primeng/images/demo/product/{image}";

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.PickList
        """;

    private const string BasicCode = """
        <OpPickList TItem="Product"
                    @bind-Source="_source"
                    @bind-Target="_target"
                    OptionLabel="Name"
                    SourceHeader="Disponíveis"
                    TargetHeader="Selecionados"
                    ScrollHeight="20rem">
            <ItemTemplate Context="p">
                <span>@p.Name</span>
            </ItemTemplate>
        </OpPickList>

        @code {
            private sealed record Product(string Name);
            private IReadOnlyList<Product> _source = [ new("Bamboo Watch"), new("Black Watch") ];
            private IReadOnlyList<Product> _target = [ new("Chakra Bracelet") ];
        }
        """;

    private const string FilterCode = """
        <OpPickList TItem="Product"
                    Source="_source"
                    Target="_target"
                    OptionLabel="Name"
                    Filter="true"
                    FilterBy="Name"
                    ScrollHeight="20rem">
            <ItemTemplate Context="p">
                <div style="display:flex; align-items:center; gap:1rem; width:100%;">
                    <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:3rem;" />
                    <div style="display:flex; flex-direction:column;">
                        <span class="font-medium text-sm">@p.Name</span>
                        <span class="text-sm">@p.Category</span>
                    </div>
                    <span class="font-bold" style="margin-left:auto;">$@p.Price</span>
                </div>
            </ItemTemplate>
        </OpPickList>
        """;

    private const string TemplateCode = """
        <OpPickList TItem="Product"
                    Source="_source"
                    Target="_target"
                    OptionLabel="Name"
                    SourceHeader="Disponíveis"
                    TargetHeader="Selecionados"
                    ScrollHeight="20rem">
            <ItemTemplate Context="p">
                <div style="display:flex; align-items:center; gap:1rem; width:100%;">
                    <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:3rem;" />
                    <div style="display:flex; flex-direction:column;">
                        <span class="font-medium text-sm">@p.Name</span>
                        <span class="text-sm">@p.Category</span>
                    </div>
                    <span class="font-bold" style="margin-left:auto;">$@p.Price</span>
                </div>
            </ItemTemplate>
        </OpPickList>
        """;
}
