@page "/organizationchart"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>OrganizationChart - OpBlazorUI</PageTitle>

<DocComponent Title="OrganizationChart"
              Description="Visualiza dados hierárquicos de organização. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O OrganizationChart exige uma coleção de instâncias de <code>TreeNode</code> como <code>value</code>.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>Conteúdo personalizado em vez do <code>label</code> do nó é definido pela propriedade <code>pTemplate</code>.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Seleção" Id="selection">
            <Description><p>Os nós podem ser selecionados definindo <code>selectionMode</code> junto de um vínculo de valor com as propriedades <code>selection</code>. Por padrão, apenas um nó pode ser selecionado; defina <code>selectionMode</code> como <code>multiple</code> para selecionar mais de um.</p></Description>
            <Code><CodeBlock Code="@SelectionCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Colorido" Id="colored">
            <Description><p>A estilização de um nó específico é configurada com as opções <code>class</code> e <code>style</code> de um <code>TreeNode</code>.</p></Description>
            <Code><CodeBlock Code="@ColoredCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente atualmente usa uma implementação baseada em tabela e não oferece alto nível de suporte a leitores de tela; uma substituição por uma implementação de lista aninhada está planejada, com papéis e atributos ARIA alinhados a um widget de árvore para alto nível de suporte nas próximas versões.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco pelos elementos focáveis dentro do gráfico." },
                              new[] { "enter", "Alterna o estado expandido de um nó." },
                              new[] { "space", "Alterna o estado expandido de um nó." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { OrganizationChartModule } from 'primeng/organizationchart';
        """;

    private const string BasicCode = """
        <p-organization-chart [value]="data" />
        """;

    private const string TemplateCode = """
        <p-organization-chart [value]="data" [collapsible]="true">
            <ng-template let-node pTemplate="default">
                <div class="flex flex-col items-center">
                    <img src="https://primefaces.org/cdn/primeng/images/flag/flag_placeholder.png" [alt]="node.label" [class]="'flag' + ' flag-' + node.data" width="32" />
                    <div class="mt-4 font-medium text-lg">{{ node.label }}</div>
                </div>
            </ng-template>
        </p-organization-chart>
        """;

    private const string SelectionCode = """
        <p-organization-chart [value]="data" selectionMode="multiple" [(selection)]="selectedNodes" [collapsible]="true">
            <ng-template let-node pTemplate="person">
                <div class="flex flex-col">
                    <div class="flex flex-col items-center">
                        <img [src]="node.data.image" class="mb-4 w-12 h-12" />
                        <div class="font-bold mb-2">{{ node.data.name }}</div>
                        <div>{{ node.data.title }}</div>
                    </div>
                </div>
            </ng-template>
        </p-organization-chart>
        """;

    private const string ColoredCode = """
        <p-organization-chart [value]="data" [collapsible]="true">
            <ng-template let-node pTemplate="person">
                <div class="flex flex-col">
                    <div class="flex flex-col items-center">
                        <img [src]="node.data.image" class="mb-4 w-12 h-12" />
                        <span class="font-bold mb-2">{{ node.data.name }}</span>
                        <span>{{ node.data.title }}</span>
                    </div>
                </div>
            </ng-template>
        </p-organization-chart>
        """;
}
