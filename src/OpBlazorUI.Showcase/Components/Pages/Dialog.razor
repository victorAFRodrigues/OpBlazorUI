@page "/dialog"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Dialog
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.InputText

<PageTitle>Dialog - OpBlazorUI</PageTitle>

<DocComponent Title="Dialog"
              Description="O Dialog é um contêiner que sobrepõe a página com conteúdo.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O Dialog é usado como contêiner e sua visibilidade é controlada pela propriedade <code>Visible</code>,
                normalmente com <code>@@bind-Visible</code>. Use <code>Modal</code> para bloquear o fundo com a máscara.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" OnClick="ShowDialog"/>
                    <OpDialog @bind-Visible="_basicVisible" Header="Editar Perfil" Modal="true" Style="width:25rem">
                        <span class="block mb-4 text-muted-color">Atualize suas informações.</span>
                        <div class="flex items-center gap-4 mb-4">
                            <label for="dlg-basic-username" class="font-semibold w-24">Usuário</label>
                            <OpInputText Id="dlg-basic-username" Placeholder="Nome de usuário" StyleClass="flex-auto"/>
                        </div>
                        <div class="flex items-center gap-4 mb-4">
                            <label for="dlg-basic-email" class="font-semibold w-24">Email</label>
                            <OpInputText Id="dlg-basic-email" Placeholder="email@exemplo.com" StyleClass="flex-auto"/>
                        </div>
                        <div class="flex justify-end gap-2">
                            <OpButton Label="Cancelar" Severity="secondary" OnClick="HideDialog"/>
                            <OpButton Label="Salvar" OnClick="HideDialog"/>
                        </div>
                    </OpDialog>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                O Dialog pode ser personalizado com os templates <code>HeaderTemplate</code> (cabeçalho) e
                <code>FooterTemplate</code> (rodapé). Quando o cabeçalho customizado é usado, a propriedade
                <code>Header</code> é ignorada.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" OnClick="ShowTemplateDialog"/>
                    <OpDialog @bind-Visible="_templateVisible" Modal="true" Style="width:25rem">
                        <HeaderTemplate>
                            <div class="inline-flex items-center justify-center gap-2">
                                <span style="display:inline-flex;align-items:center;justify-content:center;width:2rem;height:2rem;border-radius:50%;background:var(--p-primary-color);color:var(--p-primary-contrast-color);font-weight:600;">AE</span>
                                <span class="font-bold whitespace-nowrap">Amy Elsner</span>
                            </div>
                        </HeaderTemplate>
                        <ChildContent>
                            <span class="block mb-4 text-muted-color">Atualize suas informações.</span>
                            <div class="flex items-center gap-4 mb-4">
                                <label for="dlg-tpl-username" class="font-semibold w-24">Usuário</label>
                                <OpInputText Id="dlg-tpl-username" Placeholder="Nome de usuário" StyleClass="flex-auto"/>
                            </div>
                            <div class="flex items-center gap-4 mb-2">
                                <label for="dlg-tpl-email" class="font-semibold w-24">Email</label>
                                <OpInputText Id="dlg-tpl-email" Placeholder="email@exemplo.com" StyleClass="flex-auto"/>
                            </div>
                        </ChildContent>
                        <FooterTemplate>
                            <OpButton Label="Cancelar" Text="true" Severity="secondary" OnClick="HideTemplateDialog"/>
                            <OpButton Label="Salvar" Outlined="true" Severity="secondary" OnClick="HideTemplateDialog"/>
                        </FooterTemplate>
                    </OpDialog>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Posição" Id="position">
            <Description>
                A propriedade <code>Position</code> exibe o Dialog em todas as bordas e cantos da tela. Os valores
                aceitos são <code>center</code> (padrão), <code>top</code>, <code>bottom</code>, <code>left</code>,
                <code>right</code>, <code>topleft</code>, <code>topright</code>, <code>bottomleft</code> e
                <code>bottomright</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col">
                    <div class="flex flex-wrap justify-center gap-2 mb-2">
                        <OpButton Label="Esquerda" Icon="pi pi-arrow-right" Severity="secondary" StyleClass="w-40" OnClick="ShowLeft"/>
                        <OpButton Label="Direita" Icon="pi pi-arrow-left" Severity="secondary" StyleClass="w-40" OnClick="ShowRight"/>
                    </div>
                    <div class="flex flex-wrap justify-center gap-2 mb-2">
                        <OpButton Label="Sup. Esquerda" Icon="pi pi-arrow-down-right" Severity="secondary" StyleClass="w-40" OnClick="ShowTopLeft"/>
                        <OpButton Label="Superior" Icon="pi pi-arrow-down" Severity="secondary" StyleClass="w-40" OnClick="ShowTop"/>
                        <OpButton Label="Sup. Direita" Icon="pi pi-arrow-down-left" Severity="secondary" StyleClass="w-40" OnClick="ShowTopRight"/>
                    </div>
                    <div class="flex flex-wrap justify-center gap-2">
                        <OpButton Label="Inf. Esquerda" Icon="pi pi-arrow-up-right" Severity="secondary" StyleClass="w-40" OnClick="ShowBottomLeft"/>
                        <OpButton Label="Inferior" Icon="pi pi-arrow-up" Severity="secondary" StyleClass="w-40" OnClick="ShowBottom"/>
                        <OpButton Label="Inf. Direita" Icon="pi pi-arrow-up-left" Severity="secondary" StyleClass="w-40" OnClick="ShowBottomRight"/>
                    </div>
                    <OpDialog @bind-Visible="_positionVisible" Header="Editar Perfil" Modal="true" Position="@_position" Style="width:25rem">
                        <span class="block mb-4 text-muted-color">Atualize suas informações.</span>
                        <div class="flex items-center gap-4 mb-4">
                            <label for="dlg-pos-username" class="font-semibold w-24">Usuário</label>
                            <OpInputText Id="dlg-pos-username" Placeholder="Nome de usuário" StyleClass="flex-auto"/>
                        </div>
                        <div class="flex items-center gap-4 mb-4">
                            <label for="dlg-pos-email" class="font-semibold w-24">Email</label>
                            <OpInputText Id="dlg-pos-email" Placeholder="email@exemplo.com" StyleClass="flex-auto"/>
                        </div>
                        <div class="flex justify-end gap-2">
                            <OpButton Label="Cancelar" Severity="secondary" OnClick="HidePositionDialog"/>
                            <OpButton Label="Salvar" OnClick="HidePositionDialog"/>
                        </div>
                    </OpDialog>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PositionCode"/></Code>
        </DocSection>

        <DocSection Label="Maximizável" Id="maximizable">
            <Description>
                Definir <code>Maximizable</code> como <code>true</code> habilita o modo tela cheia. Um botão de
                maximizar passa a ser exibido no cabeçalho e alterna o Dialog entre o tamanho normal e a tela inteira.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" OnClick="ShowMaxDialog"/>
                    <OpDialog @bind-Visible="_maxVisible" Header="Cabeçalho" Modal="true" Maximizable="true" Style="width:50rem">
                        <p class="mb-4">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut
                            labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco
                            laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in
                            voluptate velit esse cillum dolore eu fugiat nulla pariatur.
                        </p>
                    </OpDialog>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MaxCode"/></Code>
        </DocSection>

        <DocSection Label="Conteúdo Longo" Id="longcontent">
            <Description>
                Quando o conteúdo ultrapassa a altura da viewport, o Dialog exibe uma barra de rolagem no conteúdo
                automaticamente, mantendo o cabeçalho e o rodapé visíveis.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" OnClick="ShowLongDialog"/>
                    <OpDialog @bind-Visible="_longVisible" Header="Cabeçalho" Modal="true" Style="width:50rem">
                        <p class="mb-8">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut
                            labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco
                            laboris nisi ut aliquip ex ea commodo consequat.
                        </p>
                        <p class="mb-8">
                            Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque
                            laudantium, totam rem aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto
