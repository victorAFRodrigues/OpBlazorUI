@page "/chart"
@namespace OpBlazorUI.Showcase.Components.Pages
@using ApexCharts
@using OpBlazorUI.Charts
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Chart - OpBlazorUI</PageTitle>

<DocComponent Title="Chart"
              Description="Gráficos do OpBlazorUI, construídos sobre o Blazor-ApexCharts (baseado no ApexCharts.js).">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Description>
                <p>
                    O Chart vive em um projeto separado, <code>OpBlazorUI.Charts</code>, que depende de
                    <code>Blazor-ApexCharts</code>. Assim o <code>OpBlazorUI</code> não fica acoplado a uma
                    biblioteca de gráficos. Registre o serviço com <code>AddOpBlazorCharts()</code>.
                </p>
            </Description>
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    Use o wrapper <code>OpChart&lt;TItem&gt;</code> (ou diretamente <code>ApexChart</code>) e
                    declare uma ou mais séries com <code>ApexPointSeries&lt;TItem&gt;</code>. O tipo do gráfico é
                    definido por <code>SeriesType</code> (<code>Bar</code>, <code>Line</code>, <code>Area</code>,
                    <code>Pie</code>, <code>Donut</code>…).
                </p>
            </Description>
            <ChildContent>
                <OpChart TItem="ChartItem" Height="260" Title="Vendas por mês">
                    <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Vendas"
                                     SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value"/>
                </OpChart>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Múltiplas Séries" Id="series">
            <Description>
                <p>
                    Adicione quantas <code>ApexPointSeries</code> precisar. Cada série tem seu próprio
                    <code>SeriesType</code>, permitindo combinar barras e linhas no mesmo gráfico.
                </p>
            </Description>
            <ChildContent>
                <OpChart TItem="ChartItem" Height="260" Title="Receita x Despesa">
                    <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Receita"
                                     SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value"/>
                    <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Despesa"
                                     SeriesType="SeriesType.Line" XValue="e => e.Month" YValue="e => e.Cost"/>
                </OpChart>
            </ChildContent>
            <Code><CodeBlock Code="@SeriesCode"/></Code>
        </DocSection>

        <DocSection Label="Opções" Id="options">
            <Description>
                <p>
                    Personalize com <code>ApexChartOptions&lt;TItem&gt;</code> (mesma API do ApexCharts.js):
                    eixos, legenda, tooltip, gradientes e mais. As <code>Options</code> passadas ao
                    <code>OpChart</code> têm precedência sobre o tema.
                </p>
            </Description>
            <Code><CodeBlock Code="@OptionsCode"/></Code>
        </DocSection>

        <DocSection Label="Tema" Id="theme">
            <Description>
                <p>
                    O <code>OpChart</code> lê as cores e a fonte dos tokens do tema (<code>--p-primary-color</code>
                    e afins) quando <code>Options.Colors</code> não é informado. Desative com
                    <code>UseThemeColors="false"</code> para usar a paleta padrão do ApexCharts.
                </p>
            </Description>
            <Code><CodeBlock Code="@ThemeCode"/></Code>
        </DocSection>

        <DocSection Label="Renderização Estática (SSR)" Id="ssr">
            <Description>
                <p>
                    O ApexCharts depende de JavaScript e só funciona de forma interativa. No prerender
                    estático o <code>OpChart</code> exibe um placeholder (ou o conteúdo de
                    <code>Placeholder</code>) e o gráfico real é montado após a hidratação. Em Blazor
                    Server/WASM/Auto isso é transparente; em SSR puro o gráfico não é renderizado no HTML.
                </p>
            </Description>
            <Code><CodeBlock Code="@SsrCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="OpChart" Id="api-props">
            <ChildContent>
                <ApiTable Caption="OpChart&lt;TItem&gt;"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "TItem", "class", "-", "Tipo dos itens dos gráficos (precisa ser classe)." },
                              new[] { "Options", "ApexChartOptions&lt;TItem&gt;?", "null", "Opções do ApexCharts (não podem ser compartilhadas entre gráficos)." },
                              new[] { "Height / Width", "object?", "null", "Dimensões (número em px ou string CSS)." },
                              new[] { "Title", "string?", "null", "Título exibido no topo do gráfico." },
                              new[] { "UseThemeColors", "bool", "true", "Aplica cores/fonte dos tokens do tema quando <code>Options.Colors</code> está vazio." },
                              new[] { "Placeholder", "RenderFragment?", "null", "Conteúdo exibido no prerender estático." },
                              new[] { "ChildContent", "RenderFragment?", "null", "As séries (<code>ApexPointSeries&lt;TItem&gt;</code>)." },
                              new[] { "Style / StyleClass", "string?", "null", "Estilos/classes do contêiner." },
                              new[] { "Atributos", "Dictionary&lt;string, object&gt;?", "null", "Atributos extras repassados ao contêiner (ex.: <code>data-*</code>, <code>aria-*</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Serviço" Id="api-service">
            <ChildContent>
                <ApiTable Caption="AddOpBlazorCharts"
                          Headers="@(new[] { "Membro", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "AddOpBlazorCharts()", "Registra o serviço do Blazor-ApexCharts (AddApexCharts)." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Tokens" Id="theming">
            <Description>
                <p>
                    O gráfico usa os tokens do tema para cores e fonte. Ajuste os tokens
                    <code>--p-primary-*</code>, <code>--p-surface-*</code> e <code>--p-text-color</code> para
                    mudar a aparência — ou informe <code>Options.Colors</code> diretamente.
                </p>
            </Description>
        </DocSection>
    </Theming>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>
                            <strong>API diferente da referência:</strong> o Chart do PrimeNG/Optimus usa
                            Chart.js com <code>type</code>/<code>data</code>/<code>options</code>. Aqui a base é
                            o ApexCharts (Blazor-ApexCharts), com componentes <code>OpChart</code> +
                            <code>ApexPointSeries</code> e <code>ApexChartOptions</code>. Os nomes de opções não
                            são equivalentes.
                        </li>
                        <li>
                            <strong>Prerender estático:</strong> o gráfico não é renderizado no HTML de SSR; é
                            necessário um render mode interativo (Server, WebAssembly ou Auto).
                        </li>
                        <li>
                            <strong>Cores do tema são lidas na montagem:</strong> trocar o tema depois (claro ⇄ escuro)
                            não recalcula as cores do gráfico — recarregue a página ou informe
                            <code>Options.Colors</code> para fixar uma paleta.
                        </li>
                        <li>
                            Cada instância precisa de um <code>ApexChartOptions</code> próprio; não compartilhe a
                            mesma instância entre gráficos.
                        </li>
                        <li>
                            O pacote <code>OpBlazorUI.Charts</code> é distribuído separadamente do
                            <code>OpBlazorUI</code>.
                        </li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private sealed class ChartItem
    {
        public string Month { get; set; } = "";
        public decimal Value { get; set; }
        public decimal Cost { get; set; }
    }

    private readonly List<ChartItem> _sales = new()
    {
        new ChartItem { Month = "Jan", Value = 42, Cost = 24 },
        new ChartItem { Month = "Fev", Value = 38, Cost = 20 },
        new ChartItem { Month = "Mar", Value = 55, Cost = 30 },
        new ChartItem { Month = "Abr", Value = 47, Cost = 28 },
        new ChartItem { Month = "Mai", Value = 63, Cost = 35 }
    };

    private const string ImportCode = """
        @using ApexCharts
        @using OpBlazorUI.Charts

        // Program.cs
        builder.Services.AddOpBlazorCharts();
        """;

    private const string BasicCode = """
        <OpChart TItem="ChartItem" Height="260" Title="Vendas por mês">
            <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Vendas"
                             SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value" />
        </OpChart>

        @code {
            private sealed class ChartItem
            {
                public string Month { get; set; } = "";
                public decimal Value { get; set; }
            }

            private readonly List<ChartItem> _sales = new() { /* ... */ };
        }
        """;

    private const string SeriesCode = """
        <OpChart TItem="ChartItem" Height="260" Title="Receita x Despesa">
            <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Receita"
                             SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value" />
            <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Despesa"
                             SeriesType="SeriesType.Line" XValue="e => e.Month" YValue="e => e.Cost" />
        </OpChart>
        """;

    private const string OptionsCode = """
        @code {
            private ApexChartOptions<ChartItem> _options = new()
            {
                Chart = new Chart { Toolbar = new Toolbar { Show = false } },
                PlotOptions = new PlotOptions
                {
                    Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 4 }
                },
                Legend = new Legend { Position = LegendPosition.Bottom }
            };
        }

        <OpChart TItem="ChartItem" Options="_options" Height="260">
            <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Vendas"
                             SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value" />
        </OpChart>
        """;

    private const string ThemeCode = """
        <!-- Cores automáticas dos tokens do tema (padrão) -->
        <OpChart TItem="ChartItem" Height="260"> ... </OpChart>

        <!-- Paleta própria (também ignora o bridge de tema) -->
        <OpChart TItem="ChartItem" Height="260" Options="_colored"> ... </OpChart>
        """;

    private const string SsrCode = """
        <OpChart TItem="ChartItem" Height="260">
            <Placeholder>
                <div class="p-4 text-center">Carregando gráfico…</div>
            </Placeholder>
            <ApexPointSeries TItem="ChartItem" Items="_sales" Name="Vendas"
                             SeriesType="SeriesType.Bar" XValue="e => e.Month" YValue="e => e.Value" />
        </OpChart>
        """;
}
