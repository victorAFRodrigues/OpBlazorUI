@page "/chart"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Chart - OpBlazorUI</PageTitle>

<DocComponent Title="Chart"
              Description="Gráficos baseados no Chart.js. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Chart.js" Id="chartjs">
            <Description><p>Para começar, primeiro instale o pacote charts.js com o npm e depois inclua-o no seu projeto. Um exemplo com a CLI seria;</p></Description>
            <Code><CodeBlock Code="@ChartjsCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>Um gráfico é configurado com 3 propriedades: <i>type</i>, <i>data</i> e <i>options</i>. O tipo do gráfico é definido pela propriedade <i>type</i>, que aceita <i>pie</i>, <i>doughnut</i>, <i>line</i>, <i>bar</i>, <i>radar</i> e <i>polarArea</i> como valor. O <i>data</i> define os conjuntos de dados representados no gráfico e as <i>options</i> fornecem inúmeras opções de personalização para customizar a apresentação.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Pizza" Id="pie">
            <Description><p>Um gráfico de pizza é uma representação estatística circular dividida em fatias para ilustrar proporção numérica.</p></Description>
            <Code><CodeBlock Code="@PieCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Rosca" Id="doughnut">
            <Description><p>Um gráfico de rosca é uma variante do gráfico de pizza, com o centro vazio, permitindo incluir informações adicionais sobre o conjunto de dados como um todo.</p></Description>
            <Code><CodeBlock Code="@DoughnutCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Barra Vertical" Id="verticalbar">
            <Description><p>Um gráfico de barras é um gráfico que apresenta dados agrupados em barras retangulares com comprimentos proporcionais aos valores que representam.</p></Description>
            <Code><CodeBlock Code="@VerticalBarCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Barra Horizontal" Id="horizontalbar">
            <Description><p>Um gráfico de barras é renderizado horizontalmente quando a opção <i>indexAxis</i> é definida como <i>y</i>.</p></Description>
            <Code><CodeBlock Code="@HorizontalBarCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Barra Empilhada" Id="stackedbar">
            <Description><p>As barras podem ser empilhadas umas sobre as outras quando a opção <i>stacked</i> de uma escala está habilitada.</p></Description>
            <Code><CodeBlock Code="@StackedBarCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Linha" Id="line">
            <Description><p>Um gráfico de linhas é um tipo de gráfico que exibe informações como uma série de pontos de dados chamados 'marcadores', conectados por segmentos de reta.</p></Description>
            <Code><CodeBlock Code="@LineCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Múltiplos Eixos" Id="multiaxis">
            <Description><p>Múltiplos eixos podem ser adicionados usando a opção <i>scales</i>.</p></Description>
            <Code><CodeBlock Code="@MultiAxisCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Estilos de Linha" Id="linestyles">
            <Description><p>Vários estilos de uma série de linha podem ser personalizados para exibir customizações como um gráfico de área.</p></Description>
            <Code><CodeBlock Code="@LineStyleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Área Polar" Id="polararea">
            <Description><p>Gráficos de área polar são semelhantes aos gráficos de pizza, mas cada segmento tem o mesmo ângulo — o raio do segmento varia de acordo com o valor.</p></Description>
            <Code><CodeBlock Code="@PolarAreaCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Radar" Id="Radar">
            <Description><p>Um gráfico de radar é um método gráfico de exibir dados multivariados na forma de um gráfico bidimensional de três ou mais variáveis quantitativas representadas em eixos que partem do mesmo ponto.</p></Description>
            <Code><CodeBlock Code="@RadarCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Combo" Id="combo">
            <Description><p>Diferentes tipos de gráfico podem ser combinados no mesmo gráfico usando a opção <i>type</i> de um conjunto de dados.</p></Description>
            <Code><CodeBlock Code="@ComboCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Os componentes Chart usam internamente o elemento <i>canvas</i>; consulte o guia de <a href="https://www.chartjs.org/docs/latest/general/accessibility.html">acessibilidade do Chart.js</a> para mais informações.</p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode" Language="html"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

