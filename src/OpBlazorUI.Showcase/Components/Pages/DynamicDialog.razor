@page "/dynamicdialog"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.DynamicDialog
@using OpBlazorUI.Services

<PageTitle>DynamicDialog - OpBlazorUI</PageTitle>

<DocComponent Title="DynamicDialog"
              Description="Dialogs podem ser criados dinamicamente com qualquer componente como conteúdo, através do OpDialogService.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Uso" Id="usage">
            <Description>
                <p>
                    Registre os serviços com <code>AddOpBlazorUI</code> e renderize <strong>uma única vez</strong>
                    o host <code>OpDynamicDialogHost</code> no layout. O host cria um <code>OpDialog</code> para
                    cada instância aberta pelo <code>OpDialogService</code>.
                </p>
            </Description>
            <Code><CodeBlock Code="@UsageCode"/></Code>
        </DocSection>

        <DocSection Label="Abrindo um Dialog" Id="open">
            <Description>
                <p>
                    Injete o <code>OpDialogService</code> e chame <code>Open&lt;TComponent&gt;</code> com uma
                    <code>OpDynamicDialogConfig</code>. O método retorna um <code>OpDynamicDialogRef</code>; a
                    propriedade <code>Result</code> (ou <code>OpenAsync</code>) aguarda o valor passado a
                    <code>Close</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <button type="button" class="p-button p-component w-fit" @onclick="OpenDialog">
                        <span class="p-button-label">Abrir dialog dinâmico</span>
                    </button>
                    <div class="text-sm">Resultado: <strong>@_result</strong></div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@OpenCode"/></Code>
        </DocSection>

        <DocSection Label="Customização" Id="customization">
            <Description>
                <p>
                    O <code>OpDynamicDialogConfig</code> reaproveita as opções do <code>OpDialog</code>, como
                    <code>Width</code>, <code>Style</code> e <code>StyleClass</code>; veja a página
                    <a href="dialog">Dialog</a> para todas as propriedades. No Angular há <code>breakpoints</code>
                    para larguras responsivas — aqui use <code>Width</code> com uma unidade relativa (ex.: <code>50vw</code>).
                </p>
            </Description>
            <Code><CodeBlock Code="@CustomizationCode"/></Code>
        </DocSection>

        <DocSection Label="Passando Dados" Id="passingdata">
            <Description>
                <p>
                    Use <code>InputValues</code> para definir parâmetros do componente (tipagem segura) e
                    <code>Data</code> para dados genéricos. Ambos ficam acessíveis ao conteúdo: os parâmetros de
                    <code>InputValues</code> como parâmetros normais e o restante via
                    <code>CascadingParameter OpDynamicDialogConfig</code>.
                </p>
            </Description>
            <Code><CodeBlock Code="@InputValuesCode"/></Code>
        </DocSection>

        <DocSection Label="Fechando um Dialog" Id="close">
            <Description>
                <p>
                    O conteúdo fecha o dialog pelo <code>OpDynamicDialogRef</code> (injetável como
                    <code>CascadingParameter</code>). O valor passado a <code>Close</code> chega ao chamador em
                    <code>Result</code>.
                </p>
            </Description>
            <Code><CodeBlock Code="@CloseCode"/></Code>
        </DocSection>

        <DocSection Label="Exemplo" Id="example">
            <Description>
                <p>
                    Exemplo completo: um diálogo cujo conteúdo é um componente de lista de produtos. O item escolhido
                    é devolvido por <code>Close</code> e chega ao chamador pelo <code>Result</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <button type="button" class="p-button p-component w-fit" @onclick="OpenProductDialog">
                        <span class="p-button-label">Selecionar produto</span>
                    </button>
                    <div class="text-sm">Produto: <strong>@_product</strong></div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ExampleCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="OpDialogService" Id="api-service">
            <ChildContent>
                <ApiTable Caption="OpDialogService"
                          Headers="@(new[] { "Membro", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Open&lt;TComponent&gt;(config)", "OpDynamicDialogRef", "Abre um diálogo com o componente como conteúdo." },
                              new[] { "OpenAsync&lt;TComponent&gt;(config)", "Task&lt;object?&gt;", "Abre e aguarda o resultado de <code>Close</code>." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="OpDynamicDialogConfig" Id="api-config">
            <ChildContent>
                <ApiTable Caption="OpDynamicDialogConfig"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Header", "string?", "null", "Título do diálogo." },
                              new[] { "Width", "string?", "null", "Largura aplicada como <code>style=\"width:...\"</code>." },
                              new[] { "Style", "string?", "null", "Estilos inline extras do diálogo." },
                              new[] { "StyleClass", "string?", "null", "Classes extras no diálogo." },
                              new[] { "Modal", "bool", "true", "Máscara modal." },
                              new[] { "Closable", "bool", "true", "Exibe o botão de fechar." },
                              new[] { "CloseOnEscape", "bool", "true", "Fecha com Escape." },
                              new[] { "DismissableMask", "bool", "false", "Fecha ao clicar na máscara." },
                              new[] { "Draggable", "bool", "true", "Permite arrastar pelo cabeçalho." },
                              new[] { "Resizable", "bool", "false", "Permite redimensionar." },
                              new[] { "Data", "object?", "null", "Dados genéricos para o conteúdo." },
                              new[] { "InputValues", "Dictionary&lt;string, object?&gt;", "vazio", "Parâmetros do componente de conteúdo." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="OpDynamicDialogRef" Id="api-ref">
            <ChildContent>
                <ApiTable Caption="OpDynamicDialogRef"
                          Headers="@(new[] { "Membro", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Config", "OpDynamicDialogConfig", "Configuração do diálogo." },
                              new[] { "Result", "Task&lt;object?&gt;", "Concluída ao fechar, com o resultado." },
                              new[] { "Close(result)", "void", "Fecha o diálogo retornando um resultado." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><DocTokens Component="dialog"/></ChildContent>
        </DocSection>
    </Theming>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Diferente do Angular, o host é renderizado no layout (não há um serviço global que se auto-monta); sem o <code>OpDynamicDialogHost</code> os diálogos não aparecem.</li>
                        <li>Não há <code>onClose</code>/<code>onMaximize</code>/<code>onDragEnd</code> como <em>observables</em>; use <code>Result</code> e os eventos do <code>OpDialog</code>.</li>
                        <li>O conteúdo recebe a configuração e a referência via <code>CascadingParameter</code> (no Angular são injetadas no construtor).</li>
                        <li>O estado é <em>scoped</em> por circuito: os diálogos não sobrevivem a um recarregamento nem existem no prerender estático.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    [Inject] private OpDialogService DialogService { get; set; } = default!;

    private string _result = "nenhum";
    private string _product = "nenhum";

    private async Task OpenDialog()
    {
        var reference = DialogService.Open<DynamicDialogDemoContent>(new OpDynamicDialogConfig
        {
            Header = "Confirmação",
            Width = "28rem",
            InputValues = new Dictionary<string, object?> { ["Name"] = "visitante" }
        });

        var result = await reference.Result;
        _result = result?.ToString() ?? "nenhum";
    }

    private async Task OpenProductDialog()
    {
        var reference = DialogService.Open<DynamicDialogProductList>(new OpDynamicDialogConfig
        {
            Header = "Selecione um produto",
            Width = "34rem",
            Modal = true
        });

        var result = await reference.Result;
        _product = result?.ToString() ?? "nenhum";
    }

    private const string ImportCode = """
        @using OpBlazorUI.Components.DynamicDialog
        @using OpBlazorUI.Services

        @inject OpDialogService DialogService
        """;

    private const string UsageCode = """
        // Program.cs
        builder.Services.AddOpBlazorUI();

        // MainLayout.razor (uma única vez)
        <OpDynamicDialogHost />
        """;

    private const string OpenCode = """
        var reference = DialogService.Open<DynamicDialogDemoContent>(new OpDynamicDialogConfig
        {
            Header = "Confirmação",
            Width = "28rem",
            InputValues = new Dictionary<string, object?> { ["Name"] = "visitante" }
        });

        var result = await reference.Result;
        """;

    private const string InputValuesCode = """
        // Configuração
        var reference = DialogService.Open<DynamicDialogDemoContent>(new OpDynamicDialogConfig
        {
            InputValues = new Dictionary<string, object?> { ["Name"] = "visitante" }
        });

        // DynamicDialogDemoContent.razor
        @code {
            [CascadingParameter] private OpDynamicDialogRef? DialogRef { get; set; }
            [Parameter] public string? Name { get; set; }
        }
        """;

    private const string CloseCode = """
        private void CloseOk() => DialogRef?.Close("confirmado");

        private void CloseCancel() => DialogRef?.Close(null);

        // No chamador
        var result = await reference.Result; // "confirmado" ou null
        """;

    private const string CustomizationCode = """
        var reference = DialogService.Open<ProdutoLista>(new OpDynamicDialogConfig
        {
            Header = "Selecione um produto",
            Width = "50vw",
            Modal = true,
            StyleClass = "op-dynamic-dialog-custom"
        });
        """;

    private const string ExampleCode = """
        // DynamicDialogProductList.razor
        @code {
            [CascadingParameter] private OpDynamicDialogRef? DialogRef { get; set; }

            private void Select(string product) => DialogRef?.Close(product);
        }

        // Chamador
        var reference = DialogService.Open<DynamicDialogProductList>(new OpDynamicDialogConfig
        {
            Header = "Selecione um produto",
            Width = "34rem",
            Modal = true
        });

        var product = await reference.Result; // nome escolhido ou null
        """;
}
