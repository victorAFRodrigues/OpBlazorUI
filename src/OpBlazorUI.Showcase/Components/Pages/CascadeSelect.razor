@page "/cascadeselect"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.CascadeSelect
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.IftaLabel
@using OpBlazorUI.Base.Components.Button
@using System.ComponentModel.DataAnnotations

<PageTitle>CascadeSelect - OpBlazorUI</PageTitle>

<DocComponent Title="CascadeSelect"
              Description="O CascadeSelect exibe uma estrutura aninhada de opções para selecionar um valor em uma hierarquia (ex.: País → Estado → Cidade).">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O CascadeSelect exige um valor para vincular e uma coleção de objetos aninhados. Use
                <code>OptionGroupLabel</code> para o texto de uma categoria, <code>OptionLabel</code> para o rótulo
                das folhas e <code>OptionGroupChildren</code> para os nomes das propriedades de cada nível — a ordem
                importa e deve corresponder à hierarquia dos dados.
            </Description>
            <ChildContent>
                <OpCascadeSelect TValue="City" @bind-Value="_selectedCity" Options="Countries"
                                 OptionLabel="Cname" OptionGroupLabel="Name"
                                 OptionGroupChildren="@GroupChildren"
                                 Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                <div class="mt-2 text-sm">Selecionado: @(_selectedCity?.Cname ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                Por padrão o rótulo da opção é o texto exibido no item. Para conteúdo customizado defina
                <code>ItemTemplate</code>, cujo contexto é a instância da opção (grupo ou folha). Há ainda os slots
                <code>SelectedItemTemplate</code>, <code>DropdownIconTemplate</code>, <code>LoadingIconTemplate</code>,
                <code>ClearIconTemplate</code>, <code>OptionGroupIconTemplate</code>, <code>HeaderTemplate</code> e
                <code>FooterTemplate</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedTemplate" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Placeholder="Selecione uma Cidade" StyleClass="w-56">
                        <ItemTemplate Context="opt">
                            <div style="display:flex; align-items:center; gap:.5rem;">
                                <span style="color:var(--p-primary-color)">@NodeMark(opt)</span>
                                <span>@NodeLabel(opt)</span>
                            </div>
                        </ItemTemplate>
                        <HeaderTemplate>
                            <div style="padding:.5rem .75rem; font-weight:500;">Países disponíveis</div>
                        </HeaderTemplate>
                        <FooterTemplate>
                            <div style="padding:.5rem .75rem;">
                                <OpButton Label="Adicionar Novo" Fluid="true" Severity="secondary" Text="true" Size="small"/>
                            </div>
                        </FooterTemplate>
                    </OpCascadeSelect>

                    <OpCascadeSelect TValue="City" @bind-Value="_selectedTemplate2" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Placeholder="Valor e ícone customizados" StyleClass="w-56">
                        <SelectedItemTemplate Context="city">
                            <span style="display:flex; align-items:center; gap:.5rem;">
                                <span>@city.Cname</span>
                                <small style="opacity:.6">@city.Code</small>
                            </span>
                        </SelectedItemTemplate>
                        <DropdownIconTemplate>
                            <span class="pi pi-map" aria-hidden="true"></span>
                        </DropdownIconTemplate>
                    </OpCascadeSelect>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Carregando" Id="loading">
            <Description>
                O estado de carregamento é ativado com <code>Loading</code>, que troca o ícone do dropdown por um
                spinner. Diferente do Button, o CascadeSelect continua recebendo foco e cliques — use-o apenas como
                indicação visual.
            </Description>
            <ChildContent>
                <OpCascadeSelect TValue="City" Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                 OptionGroupChildren="@GroupChildren" Loading="true" Placeholder="Carregando..."
                                 StyleClass="w-56"/>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingCode"/></Code>
        </DocSection>

        <DocSection Label="FloatLabel" Id="float-label">
            <Description>
                Combine com <code>OpFloatLabel</code> para obter um rótulo flutuante. Informe <code>InputId</code> no
                CascadeSelect e um <code>&lt;label for&gt;</code> correspondente; as variantes <code>over</code>
                (padrão), <code>in</code> e <code>on</code> mudam a posição do rótulo.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <OpFloatLabel class="w-56">
                        <OpCascadeSelect TValue="City" @bind-Value="_selectedOver" InputId="over_label"
                                         Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                         OptionGroupChildren="@GroupChildren" StyleClass="w-full"/>
                        <label for="over_label">Sobre</label>
                    </OpFloatLabel>
                    <OpFloatLabel class="w-56" Variant="in">
                        <OpCascadeSelect TValue="City" @bind-Value="_selectedIn" InputId="in_label"
                                         Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                         OptionGroupChildren="@GroupChildren" StyleClass="w-full"/>
                        <label for="in_label">Dentro</label>
                    </OpFloatLabel>
                    <OpFloatLabel class="w-56" Variant="on">
                        <OpCascadeSelect TValue="City" @bind-Value="_selectedOn" InputId="on_label"
                                         Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                         OptionGroupChildren="@GroupChildren" StyleClass="w-full"/>
                        <label for="on_label">Na borda</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FloatLabelCode"/></Code>
        </DocSection>

        <DocSection Label="IftaLabel" Id="ifta-label">
            <Description>
                O <code>OpIftaLabel</code> cria um rótulo alinhado no topo, dentro do campo. A ligação é a mesma do
                FloatLabel: <code>InputId</code> no componente e <code>&lt;label for&gt;</code> no contêiner.
            </Description>
            <ChildContent>
                <OpIftaLabel class="w-56">
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedIfta" InputId="cs_city"
                                     Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                     OptionGroupChildren="@GroupChildren" StyleClass="w-full"/>
                    <label for="cs_city">Cidade</label>
                </OpIftaLabel>
            </ChildContent>
            <Code><CodeBlock Code="@IftaLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone de Limpar" Id="clearicon">
            <Description>
                Com <code>ShowClear</code>, um ícone de limpar é exibido assim que houver um valor selecionado,
                permitindo removê-lo.
            </Description>
            <ChildContent>
                <OpCascadeSelect TValue="City" @bind-Value="_selectedClear" Options="Countries"
                                 OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                 ShowClear="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
            </ChildContent>
            <Code><CodeBlock Code="@ClearCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos" Id="sizes">
            <Description>
                O CascadeSelect oferece os tamanhos <code>small</code> e <code>large</code> como alternativas ao
                padrão, via propriedade <code>Size</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedSmall" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Size="small" Placeholder="Pequeno" StyleClass="w-56"/>
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedNormal" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Placeholder="Normal" StyleClass="w-56"/>
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedLarge" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Size="large" Placeholder="Grande" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizesCode"/></Code>
        </DocSection>

        <DocSection Label="Largura Total" Id="fluid">
            <Description>
                Com <code>Fluid="true"</code> o componente ocupa toda a largura do contêiner.
            </Description>
            <ChildContent>
                <div style="width:100%;">
                    <OpCascadeSelect TValue="City" @bind-Value="_selectedFluid" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Fluid="true" Placeholder="Selecione uma Cidade"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FluidCode"/></Code>
        </DocSection>

        <DocSection Label="Preenchido" Id="filled">
            <Description>
                Defina <code>Variant="filled"</code> para exibir o componente com maior ênfase visual do que o estilo
                <code>outlined</code> padrão.
            </Description>
            <ChildContent>
                <OpCascadeSelect TValue="City" @bind-Value="_selectedFilled" Options="Countries"
                                 OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                 Variant="filled" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>
                Com <code>Disabled="true"</code> o componente não pode ser editado nem focado.
            </Description>
            <ChildContent>
                <OpCascadeSelect TValue="City" Options="Countries" OptionLabel="Cname" OptionGroupLabel="Name"
                                 OptionGroupChildren="@GroupChildren" Disabled="true" Placeholder="Desabilitado"
                                 StyleClass="w-56"/>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description>
                O estado <code>Invalid="true"</code> indica falha de validação e aplica a classe <code>p-invalid</code>.
                Dentro de um <code>EditForm</code> esse estado é calculado automaticamente a partir das mensagens do
                <code>EditContext</code>, então não é preciso informar <code>Invalid</code> manualmente.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-4">
                    <OpCascadeSelect TValue="City" @bind-Value="_invalid1" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Invalid="@(_invalid1 is null)" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <OpCascadeSelect TValue="City" @bind-Value="_invalid2" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Invalid="@(_invalid2 is null)" Variant="filled"
                                     Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários (Template Driven)" Id="templatedriven">
            <Description>
                No Blazor não há a distinção do Angular entre template driven e reactive forms: ambos usam
                <code>EditForm</code>. Aqui o vínculo por <code>@@bind-Value</code> registra o campo no
                <code>EditContext</code> e o <code>DataAnnotationsValidator</code> valida o modelo — equivalente ao
                <code>ngModel</code> com <code>required</code>.
            </Description>
            <ChildContent>
                <EditForm Model="_tdModel" OnValidSubmit="OnTemplateDrivenSubmit" class="flex flex-col items-start gap-2">
                    <DataAnnotationsValidator/>
                    <OpCascadeSelect TValue="City" @bind-Value="_tdModel.City" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <ValidationMessage For="() => _tdModel.City"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_tdSubmitted)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Enviado: @_tdModel.City?.Cname</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateDrivenCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários (Reactive)" Id="reactive">
            <Description>
                O equivalente ao <code>formControlName</code> é controlar o <code>EditContext</code> explicitamente.
                Neste exemplo o contexto e um <code>ValidationMessageStore</code> são criados no código e a mensagem é
                adicionada no envio, sem depender de DataAnnotations.
            </Description>
            <ChildContent>
                <EditForm EditContext="_reactiveContext" OnSubmit="OnReactiveSubmit" class="flex flex-col items-start gap-2">
                    <OpCascadeSelect TValue="City" @bind-Value="_reactiveModel.City" Options="Countries"
                                     OptionLabel="Cname" OptionGroupLabel="Name" OptionGroupChildren="@GroupChildren"
                                     Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <ValidationMessage For="() => _reactiveModel.City"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_reactiveSubmitted && _reactiveModel.City is not null)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Enviado: @_reactiveModel.City.Cname</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@ReactiveCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O valor que descreve o componente pode ser informado com <code>AriaLabelledBy</code> ou
                    <code>AriaLabel</code>. O campo tem o papel <code>combobox</code>, além de <code>aria-haspopup</code>
                    e <code>aria-expanded</code>; a relação entre o combobox e o popup é criada por
                    <code>aria-controls</code>, que aponta para o <code>id</code> da lista.
                </p>
                <p>
                    A lista usa o papel <code>tree</code> e cada item é um <code>treeitem</code> com
                    <code>aria-label</code>, <code>aria-selected</code> e <code>aria-expanded</code>. O contêiner de um
                    nó tem o papel <code>group</code>, e <code>aria-setsize</code>, <code>aria-posinset</code> e
                    <code>aria-level</code> são calculados implicitamente em cada <code>treeitem</code>.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Caption="Estado fechado"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o cascadeselect." },
                              new[] { "space", "Abre o popup e move o foco para a opção selecionada; se não houver, a primeira recebe o foco." },
                              new[] { "down arrow", "Abre o popup e move o foco para a opção selecionada; se não houver, a primeira recebe o foco." }
                          })"/>
                <ApiTable Caption="Popup aberto"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Fecha o popup e move o foco para o próximo elemento tabulável." },
                              new[] { "shift + tab", "Fecha o popup e move o foco para o elemento tabulável anterior." },
                              new[] { "enter", "Seleciona a opção focada e fecha o popup." },
                              new[] { "space", "Seleciona a opção focada e fecha o popup." },
                              new[] { "escape", "Fecha o popup e move o foco para o cascadeselect." },
                              new[] { "down arrow", "Move o foco para a próxima opção." },
                              new[] { "up arrow", "Move o foco para a opção anterior." },
                              new[] { "right arrow", "Se a opção estiver fechada, abre; caso contrário, move o foco para o primeiro filho." },
                              new[] { "left arrow", "Se a opção estiver aberta, fecha; caso contrário, move o foco para o pai." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

