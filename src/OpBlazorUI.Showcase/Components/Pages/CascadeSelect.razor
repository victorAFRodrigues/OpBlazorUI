                              new[] { "OptionLabel", "string?", "null", "Nome da propriedade usada como rótulo das folhas." },
                              new[] { "OptionValue", "string?", "null", "Nome da propriedade usada como valor/chave de comparação. Se omitido, o próprio item é comparado." },
                              new[] { "OptionDisabled", "string?", "null", "Nome da propriedade booleana que desabilita itens específicos." },
                              new[] { "OptionGroupLabel", "string", "label", "Nome da propriedade usada como rótulo dos grupos (categorias)." },
                              new[] { "OptionGroupChildren", "IReadOnlyList&lt;string&gt;?", "null", "Nomes das propriedades de cada nível da hierarquia (ex.: <code>[\"States\", \"Cities\"]</code>); a ordem deve seguir a hierarquia." },
                              new[] { "Placeholder", "string?", "null", "Texto exibido quando nada está selecionado." },
                              new[] { "Readonly", "bool", "false", "Impede abrir a lista, mantendo o componente focável." },
                              new[] { "Required", "bool", "false", "Marca o campo como obrigatório para validação/acessibilidade." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura do contêiner." },
                              new[] { "ShowClear", "bool", "false", "Exibe um ícone para limpar a seleção quando há valor." },
                              new[] { "Loading", "bool", "false", "Troca o ícone do dropdown por um spinner (não bloqueia a interação)." },
                              new[] { "DropdownIcon", "string?", "null", "Classe do ícone do dropdown (ex.: <code>pi pi-map</code>)." },
                              new[] { "TabIndex", "int", "0", "Índice de tabulação do campo." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível do combobox." },
                              new[] { "AriaLabelledBy", "string?", "null", "Id do elemento que rotula o combobox." },
                              new[] { "InputId", "string?", "null", "Id do campo interno (para <code>&lt;label for&gt;</code>)." },
                              new[] { "ShowOnFocus", "bool", "true", "Abre o overlay ao receber foco." },
                              new[] { "PanelStyleClass", "string?", "null", "Classes adicionais no overlay." },
                              new[] { "Value", "TValue?", "null", "Valor selecionado (a folha). Combine com <code>@bind-Value</code> (herdado de <code>InputBase&lt;TValue&gt;</code>)." },
                              new[] { "ValueExpression", "Expression&lt;Func&lt;TValue&gt;&gt;?", "null", "Expressão do campo para integração com o <code>EditForm</code>; gerada por <code>@bind-Value</code> (herdado de <code>InputBase&lt;TValue&gt;</code>)." },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente (herdado de <code>OpInputBase&lt;TValue&gt;</code>)." },
                              new[] { "Invalid", "bool", "false", "Estado inválido, combinado (OR) com as mensagens do <code>EditContext</code> (herdado de <code>OpInputBase&lt;TValue&gt;</code>)." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz (herdado de <code>OpInputBase&lt;TValue&gt;</code>)." },
                              new[] { "AdditionalAttributes", "IReadOnlyDictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;object&gt;?", "Conteúdo customizado de cada opção (grupo ou folha); o contexto é a instância do item." },
                              new[] { "SelectedItemTemplate", "RenderFragment&lt;TValue&gt;?", "Conteúdo customizado do valor selecionado exibido no campo." },
                              new[] { "OptionGroupIconTemplate", "RenderFragment?", "Substitui o ícone de seta dos grupos." },
                              new[] { "DropdownIconTemplate", "RenderFragment?", "Substitui o ícone do dropdown." },
