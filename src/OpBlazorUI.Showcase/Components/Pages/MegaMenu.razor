@page "/megamenu"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Menu
@using OpBlazorUI.Base.Models

<PageTitle>MegaMenu - OpBlazorUI</PageTitle>

<DocComponent Title="MegaMenu"
              Description="O MegaMenu apresenta submenus em colunas, ideal para muitos itens agrupados.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                Cada item raiz tem filhos que representam colunas; cada coluna tem um <code>Label</code> e a lista
                <code>Items</code> de links.
            </Description>
            <ChildContent>
                <OpMegaMenu Model="_items"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>A lista raiz usa <code>role="menubar"</code>; os itens usam <code>role="menuitem"</code> com <code>aria-expanded</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Os itens são alcançáveis por <code>tab</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Itens raiz; os filhos são colunas." },
                              new[] { "StartTemplate", "RenderFragment?", "null", "Conteúdo à esquerda." },
                              new[] { "EndTemplate", "RenderFragment?", "null", "Conteúdo à direita." },
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao clicar em um link." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="megamenu"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>As colunas usam uma largura fixa (<code>p-megamenu-col-3</code>); não há colunas de largura variável por item.</li>
                        <li>O submenu abre por clique; o fechamento ao clicar fora ainda não é automático.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem
        {
            Label = "Produtos",
            Icon = "pi pi-box",
            Items = new List<OpMenuItem>
            {
                new()
                {
                    Label = "Hardware",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Notebooks" },
                        new() { Label = "Monitores" },
                        new() { Label = "Periféricos" }
                    }
                },
                new()
                {
                    Label = "Software",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Editor" },
                        new() { Label = "Suíte" }
                    }
                },
                new()
                {
                    Label = "Serviços",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Consultoria" },
                        new() { Label = "Suporte" }
                    }
                }
            }
        },
        new OpMenuItem { Label = "Empresa", Icon = "pi pi-building" },
        new OpMenuItem { Label = "Contato", Icon = "pi pi-envelope" }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Menu
        @using OpBlazorUI.Base.Models

        <OpMegaMenu Model="_items" />
        """;

    private const string BasicCode = """
        <OpMegaMenu Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem
                {
                    Label = "Produtos",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Hardware", Items = new List<OpMenuItem> { new() { Label = "Notebooks" } } },
                        new() { Label = "Software", Items = new List<OpMenuItem> { new() { Label = "Editor" } } }
                    }
                },
                new OpMenuItem { Label = "Contato" }
            };
        }
        """;

    private const string AccessibilityCode = """
        <OpMegaMenu Model="_items" />
        """;
}
