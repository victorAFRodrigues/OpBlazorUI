        new OpMenuItem { Label = "Empresa", Icon = "pi pi-building", Badge = "2" },
        new OpMenuItem { Label = "Contato", Icon = "pi pi-envelope" }
    };

    private List<OpMenuItem> _routerItems = new();

    protected override void OnInitialized()
    {
        _routerItems = new List<OpMenuItem>
        {
            new OpMenuItem
            {
                Label = "Router",
                Icon = "pi pi-palette",
                Items = new List<OpMenuItem>
                {
                    new()
                    {
                        Label = "RouterLink",
                        Items = new List<OpMenuItem>
                        {
                            new() { Label = "Temas", Url = "/theming" },
                            new() { Label = "UI Kit", Url = "/uikit" }
                        }
                    }
                }
            },
            new OpMenuItem { Label = "Programático", Icon = "pi pi-link", Command = () => Navigation.NavigateTo("/installation") },
            new OpMenuItem
            {
                Label = "Externo",
                Icon = "pi pi-home",
                Items = new List<OpMenuItem>
                {
                    new()
                    {
                        Label = "Externo",
                        Items = new List<OpMenuItem>
                        {
                            new() { Label = "Blazor", Url = "https://dotnet.microsoft.com/", Target = "_blank" },
                            new() { Label = "PrimeNG", Url = "https://primeng.org", Target = "_blank" }
                        }
                    }
                }
            }
        };
    }

    private const string ImportCode = """
        @using OpBlazorUI.Components.Menu
        @using OpBlazorUI.Models

        <OpMegaMenu Model="_items" />
        """;

    private const string BasicCode = """
        <OpMegaMenu Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem
                {
                    Label = "Produtos",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Hardware", Items = new List<OpMenuItem> { new() { Label = "Notebooks" } } },
                        new() { Label = "Software", Items = new List<OpMenuItem> { new() { Label = "Editor" } } }
                    }
                },
                new OpMenuItem { Label = "Contato" }
            };
        }
        """;

    private const string VerticalCode = """
        <OpMegaMenu Model="_items" Orientation="vertical" />
        """;

    private const string TemplateCode = """
        <OpMegaMenu Model="_items">
            <StartTemplate>
                <span class="pi pi-box"></span>
            </StartTemplate>
            <ItemTemplate Context="ctx">
                <span class="@($"p-megamenu-item-icon {ctx.Item.Icon}")"></span>
                <span class="p-megamenu-item-label">@ctx.Item.Label</span>
                @if (!string.IsNullOrEmpty(ctx.Item.Badge))
                {
                    <span class="p-badge" style="margin-left:.5rem">@ctx.Item.Badge</span>
                }
            </ItemTemplate>
            <EndTemplate>
                <span class="pi pi-search"></span>
            </EndTemplate>
        </OpMegaMenu>
        """;

    private const string CommandCode = """
        new OpMenuItem
        {
            Label = "Sair",
            Icon = "pi pi-sign-out",
            Command = () => { /* callback */ }
        }
        """;

    private const string RouterCode = """
        <OpMegaMenu Model="_items" />

        @code {
            [Inject] private NavigationManager Navigation { get; set; } = default!;

            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem
                {
                    Label = "Router",
                    Icon = "pi pi-palette",
                    Items = new List<OpMenuItem>
                    {
                        new()
                        {
                            Label = "RouterLink",
                            Items = new List<OpMenuItem>
                            {
                                new() { Label = "Temas", Url = "/theming" },
                                new() { Label = "UI Kit", Url = "/uikit" }
                            }
                        }
                    }
                },
                new OpMenuItem { Label = "Programático", Icon = "pi pi-link", Command = () => Navigation.NavigateTo("/installation") }
            };
        }
        """;

    private const string AccessibilityCode = """
        <OpMegaMenu Model="_items" />
        """;
}
