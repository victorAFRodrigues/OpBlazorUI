@page "/megamenu"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.Menu
@using OpBlazorUI.Models

<PageTitle>MegaMenu - OpBlazorUI</PageTitle>

<DocComponent Title="MegaMenu"
              Description="O MegaMenu apresenta submenus em colunas, ideal para muitos itens agrupados.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                Cada item raiz tem filhos que representam colunas; cada coluna tem um <code>Label</code> e a lista
                <code>Items</code> de links.
            </Description>
            <ChildContent>
                <OpMegaMenu Model="_items"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Vertical" Id="vertical">
            <Description>
                O layout muda com a propriedade <code>Orientation</code>, que aceita <code>horizontal</code> (padrão)
                e <code>vertical</code>.
            </Description>
            <ChildContent>
                <OpMegaMenu Model="_items" Orientation="vertical"/>
            </ChildContent>
            <Code><CodeBlock Code="@VerticalCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                <code>StartTemplate</code>, <code>ItemTemplate</code> e <code>EndTemplate</code> colocam conteúdo
                customizado no menu. O menubar deve ser <code>horizontal</code> para o conteúdo customizado. No porte,
                o <code>ItemTemplate</code> substitui o conteúdo do link do item.
            </Description>
            <ChildContent>
                <OpMegaMenu Model="_templateItems" StyleClass="p-3" style="border-radius:3rem;display:flex">
                    <StartTemplate>
                        <span class="pi pi-box" style="font-size:1.5rem;color:var(--p-primary-color)"></span>
                    </StartTemplate>
                    <ItemTemplate Context="ctx">
                        @if (!string.IsNullOrEmpty(ctx.Item.Icon))
                        {
                            <span class="@($"p-megamenu-item-icon {ctx.Item.Icon}")" aria-hidden="true"></span>
                        }
                        <span class="p-megamenu-item-label">@ctx.Item.Label</span>
                        @if (!string.IsNullOrEmpty(ctx.Item.Badge))
                        {
                            <span class="p-badge" style="margin-left:.5rem">@ctx.Item.Badge</span>
                        }
                    </ItemTemplate>
                    <EndTemplate>
                        <span class="pi pi-search" style="font-size:1.25rem"></span>
                    </EndTemplate>
                </OpMegaMenu>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Command" Id="command">
            <Description>
                A propriedade <code>Command</code> de um item define o callback executado ao ser acionado por clique ou
                evento de teclado.
            </Description>
            <Code><CodeBlock Code="@CommandCode"/></Code>
        </DocSection>

        <DocSection Label="Router" Id="router">
            <Description>
                A navegação usa <code>OpMenuItem.Url</code> (equivalente ao <code>routerLink</code>); para navegação
                programática, use <code>Command</code> com o <code>NavigationManager</code>.
            </Description>
            <ChildContent>
                <OpMegaMenu Model="_routerItems"/>
            </ChildContent>
            <Code><CodeBlock Code="@RouterCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>A lista raiz usa <code>role="menubar"</code>; os itens usam <code>role="menuitem"</code> com <code>aria-expanded</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Os itens são alcançáveis por <code>tab</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Itens raiz; os filhos são colunas." },
                              new[] { "Orientation", "string", "&quot;horizontal&quot;", "Layout: <code>horizontal</code> ou <code>vertical</code>." },
                              new[] { "StartTemplate", "RenderFragment?", "null", "Conteúdo à esquerda." },
                              new[] { "EndTemplate", "RenderFragment?", "null", "Conteúdo à direita." },
                              new[] { "ItemTemplate", "RenderFragment&lt;OpMenuItemContext&gt;?", "null", "Conteúdo do item (equivale ao <code>#item</code> do upstream)." },
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao clicar em um link." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="megamenu"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>As colunas usam uma largura fixa (<code>p-megamenu-col-3</code>); não há colunas de largura variável por item.</li>
                        <li>O submenu abre por clique; o fechamento ao clicar fora ainda não é automático.</li>
                        <li>O <code>ItemTemplate</code> substitui o conteúdo do link, não o link inteiro (ver a seção Template).</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem
