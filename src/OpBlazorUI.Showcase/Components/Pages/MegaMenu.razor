                new()
                {
                    Label = "Software",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Editor" },
                        new() { Label = "Suíte" }
                    }
                },
                new()
                {
                    Label = "Serviços",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Consultoria" },
                        new() { Label = "Suporte" }
                    }
                }
            }
        },
        new OpMenuItem { Label = "Empresa", Icon = "pi pi-building" },
        new OpMenuItem { Label = "Contato", Icon = "pi pi-envelope" }
    };

    private readonly List<OpMenuItem> _templateItems = new()
    {
        new OpMenuItem
        {
            Label = "Produtos",
            Icon = "pi pi-box",
            Items = new List<OpMenuItem>
            {
                new()
                {
                    Label = "Hardware",
                    Items = new List<OpMenuItem>
                    {
                        new() { Label = "Notebooks" },
                        new() { Label = "Monitores" }
                    }
                },
                new()
                {
                    Label = "Software",
                    Items = new List<OpMenuItem>
