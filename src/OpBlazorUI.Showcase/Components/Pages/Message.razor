@page "/message"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Message
@using OpBlazorUI.Base.Components.Button

<DocComponent Title="Message"
              Description="O componente Message é usado para exibir mensagens inline.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpMessage Severity="info">Conteúdo da Mensagem</OpMessage>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Severidade">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpMessage Severity="success">Mensagem de Sucesso</OpMessage>
                    <OpMessage Severity="info">Mensagem de Informação</OpMessage>
                    <OpMessage Severity="warn">Mensagem de Aviso</OpMessage>
                    <OpMessage Severity="error">Mensagem de Erro</OpMessage>
                    <OpMessage Severity="secondary">Mensagem Secundária</OpMessage>
                    <OpMessage Severity="contrast">Mensagem de Contraste</OpMessage>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SeverityCode"/></Code>
        </DocSection>

        <DocSection Label="Variantes">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpMessage Severity="success">Texto (padrão)</OpMessage>
                    <OpMessage Severity="success" Variant="outlined">Contornada</OpMessage>
                    <OpMessage Severity="success" Variant="simple">Simples</OpMessage>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VariantCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpMessage Size="small" Icon="pi pi-info-circle">Mensagem Pequena</OpMessage>
                    <OpMessage Icon="pi pi-info-circle">Mensagem Normal</OpMessage>
                    <OpMessage Size="large" Icon="pi pi-check-circle">Mensagem Grande</OpMessage>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>

        <DocSection Label="Fechável">
            <ChildContent>
                <OpMessage Severity="info" Closable="true">Esta mensagem pode ser fechada</OpMessage>
            </ChildContent>
            <Code><CodeBlock Code="@ClosableCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone">
            <ChildContent>
                <OpMessage Severity="info" Icon="pi pi-send">Ícone de envio personalizado</OpMessage>
            </ChildContent>
            <Code><CodeBlock Code="@IconCode"/></Code>
        </DocSection>

        <DocSection Label="Duração">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpButton Label="Mostrar Fechamento Automático (3s)" @onclick="() => _showMsg = true" StyleClass="mb-2"/>
                    @if (_showMsg)
                    {
                        <OpMessage Severity="success" Life="3000" Closable="true" OnClose="@(_ => _showMsg = false)">Desaparece automaticamente em 3 segundos</OpMessage>
                    }
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LifeCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Severity", "string", "info", "Severidade: <code>success</code>, <code>info</code>, <code>warn</code>, <code>error</code>, <code>secondary</code>, <code>contrast</code>." },
                              new[] { "Variant", "string?", "null", "Variante: <code>text</code> (padrão), <code>outlined</code> ou <code>simple</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Closable", "bool", "false", "Exibe o botão de fechar." },
                              new[] { "Icon", "string?", "null", "Classe do ícone (ex.: <code>pi pi-send</code>)." },
                              new[] { "CloseIcon", "string", "pi pi-times", "Classe do ícone do botão de fechar." },
                              new[] { "Life", "int?", "null", "Tempo (ms) para fechar automaticamente." },
                              new[] { "Style", "string?", "null", "Estilo inline." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnClose", "EventCallback&lt;MouseEventArgs&gt;", "Disparado quando a mensagem é fechada (manual ou por <code>Life</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ChildContent", "RenderFragment?", "Conteúdo da mensagem." },
                              new[] { "IconTemplate", "RenderFragment?", "Template customizado para o ícone." },
                              new[] { "CloseIconTemplate", "RenderFragment?", "Template customizado para o ícone de fechar." },
                              new[] { "ContainerTemplate", "RenderFragment?", "Template customizado do container." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="message"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular ainda não foi portado para o Blazor. Use <code>StyleClass</code>, <code>Style</code>, <code>IconTemplate</code>/<code>CloseIconTemplate</code> e os <code>AdditionalAttributes</code> para customização.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private bool _showMsg;

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Message

        <OpMessage>Conteúdo da Mensagem</OpMessage>
        """;

    private const string BasicCode = """
        <OpMessage Severity="info">Conteúdo da Mensagem</OpMessage>
        """;

    private const string SeverityCode = """
        <OpMessage Severity="success">Mensagem de Sucesso</OpMessage>
        <OpMessage Severity="info">Mensagem de Informação</OpMessage>
        <OpMessage Severity="warn">Mensagem de Aviso</OpMessage>
        <OpMessage Severity="error">Mensagem de Erro</OpMessage>
        <OpMessage Severity="secondary">Mensagem Secundária</OpMessage>
        <OpMessage Severity="contrast">Mensagem de Contraste</OpMessage>
        """;

    private const string VariantCode = """
        <OpMessage Severity="success">Texto (padrão)</OpMessage>
        <OpMessage Severity="success" Variant="outlined">Contornada</OpMessage>
        <OpMessage Severity="success" Variant="simple">Simples</OpMessage>
        """;

    private const string SizeCode = """
        <OpMessage Size="small" Icon="pi pi-info-circle">Mensagem Pequena</OpMessage>
        <OpMessage Icon="pi pi-info-circle">Mensagem Normal</OpMessage>
        <OpMessage Size="large" Icon="pi pi-check-circle">Mensagem Grande</OpMessage>
        """;

    private const string ClosableCode = """
        <OpMessage Severity="info" Closable="true">Esta mensagem pode ser fechada</OpMessage>
        """;

    private const string IconCode = """
        <OpMessage Severity="info" Icon="pi pi-send">Ícone de envio personalizado</OpMessage>
        """;

    private const string LifeCode = """
        <OpButton Label="Mostrar" @onclick="() => _show = true" />

        @if (_show)
        {
            <OpMessage Severity="success" Life="3000" Closable="true" OnClose="@(_ => _show = false)">
                Desaparece automaticamente em 3 segundos
            </OpMessage>
        }

        @code {
            private bool _show;
        }
        """;
}
