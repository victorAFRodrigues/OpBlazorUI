    private const string LazyCode = """
        <OpVirtualScroller TItem="string" Items="_lazyItems" ItemSize="30" ScrollHeight="300px"
                           Lazy="true" Step="50" Delay="250" ShowLoader="true" Loading="_lazyLoading"
                           OnLazyLoad="OnLazyLoad"
                           StyleClass="border border-surface rounded" Style="width:18rem">
            <ItemTemplate Context="ctx">
                <div class="flex items-center px-3" style="height:30px;@Zebra(ctx.Odd)">@ctx.Item</div>
            </ItemTemplate>
        </OpVirtualScroller>

        @code {
            private readonly List<string> _lazyItems = [];
            private bool _lazyLoading;

            protected override void OnInitialized() => AppendLazy(50);

            private async Task OnLazyLoad(OpVirtualScrollerLazyLoadEvent e)
            {
                _lazyLoading = true;
                await Task.Delay(600);
                AppendLazy(50);
                _lazyLoading = false;
            }

            private void AppendLazy(int count)
            {
                var start = _lazyItems.Count;
                for (var i = 0; i < count; i++)
                {
                    _lazyItems.Add($"Item #{start + i}");
                }
            }
        }
        """;

