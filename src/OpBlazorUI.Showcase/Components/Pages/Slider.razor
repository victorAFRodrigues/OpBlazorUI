@page "/slider"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Slider
@using OpBlazorUI.Base.Components.InputText
@using System.ComponentModel.DataAnnotations

<PageTitle>Slider - OpBlazorUI</PageTitle>

<DocComponent Title="Slider"
              Description="O Slider fornece uma entrada numérica por meio de uma alça arrastável, com suporte a intervalo, orientação vertical e campos de entrada.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>O vínculo de duas vias é definido com <code>@@bind-Value</code>.</Description>
            <ChildContent>
                <div class="flex flex-col gap-2" style="max-width: 20rem;">
                    <OpSlider @bind-Value="_basic"/>
                    <span class="text-sm">Valor: <b>@_basic</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Input" Id="input">
            <Description>O Slider pode ser conectado a um campo de entrada usando o mesmo valor.</Description>
            <ChildContent>
                <div style="max-width: 20rem;">
                    <input type="number" class="p-inputtext p-component" style="width: 100%; margin-bottom: 1rem;" @bind="_inputValue"/>
                    <OpSlider @bind-Value="_inputValue"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InputCode"/></Code>
        </DocSection>

        <DocSection Label="Passo" Id="step">
            <Description>O tamanho de cada movimento é definido com <code>Step</code>.</Description>
            <ChildContent>
                <div class="flex flex-col gap-2" style="max-width: 20rem;">
                    <OpSlider @bind-Value="_step" Step="20"/>
                    <span class="text-sm">Valor: <b>@_step</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StepCode"/></Code>
        </DocSection>

        <DocSection Label="Intervalo" Id="range">
            <Description>
                Com dois valores, use <code>OpSliderRange</code>: dois manípulos definem os limites.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2" style="max-width: 20rem;">
                    <OpSliderRange @bind-Value="_range"/>
                    <span class="text-sm">Valor: <b>@_range[0] – @_range[1]</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RangeCode"/></Code>
        </DocSection>

        <DocSection Label="Vertical" Id="vertical">
            <Description>O layout padrão é horizontal; use <code>Orientation="vertical"</code> para o vertical.</Description>
            <ChildContent>
                <OpSlider @bind-Value="_vertical" Orientation="vertical" Style="height: 14rem;"/>
            </ChildContent>
            <Code><CodeBlock Code="@VerticalCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>Integra-se ao <code>EditForm</code> herdando de <code>OpInputBase&lt;TValue&gt;</code>.</Description>
            <ChildContent>
                <EditForm Model="_form" OnValidSubmit="SubmitForm" class="flex flex-col gap-2" style="max-width: 20rem;">
                    <DataAnnotationsValidator/>
                    <label for="slider-form">Nota (0–10)</label>
                    <OpSlider AriaLabel="Nota" @bind-Value="_form.Score" Max="10"/>
                    <ValidationMessage For="() => _form.Score"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_submitted)
                    {
                        <span class="text-sm">Enviado: <b>@_form.Score</b></span>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    A alça usa <code>role="slider"</code> com <code>aria-orientation</code>, <code>aria-valuemin</code>,
                    <code>aria-valuemax</code> e <code>aria-valuenow</code>. O valor é descrito por <code>AriaLabel</code>
                    ou <code>AriaLabelledBy</code>.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o slider." },
                              new[] { "left / up arrow", "Decrementa o valor." },
                              new[] { "right / down arrow", "Incrementa o valor." },
                              new[] { "home", "Define o valor mínimo." },
                              new[] { "end", "Define o valor máximo." },
                              new[] { "page up", "Incrementa o valor em 10 passos." },
                              new[] { "page down", "Decrementa o valor em 10 passos." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value / ValueChanged", "double (ou double[] em OpSliderRange)", "0", "Valor (usar com <code>@@bind-Value</code>)." },
                              new[] { "Min / Max", "double", "0 / 100", "Limites do intervalo." },
                              new[] { "Step", "double?", "null", "Incremento do passo." },
                              new[] { "Orientation", "string", "horizontal", "<code>horizontal</code> ou <code>vertical</code>." },
                              new[] { "Animate", "bool", "false", "Anima o clique na barra (classe <code>p-slider-animate</code>)." },
                              new[] { "Disabled", "bool", "false", "Desabilita o slider." },
                              new[] { "TabIndex / AriaLabel / AriaLabelledBy", "—", "—", "Acessibilidade e ordem de foco." },
                              new[] { "OnChange / OnSlideEnd", "EventCallback", "—", "Notificações de mudança e fim do arraste." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="slider"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>No Blazor há dois componentes com tipagem distinta: <code>OpSlider</code> (<code>double</code>) e <code>OpSliderRange</code> (<code>double[]</code>).</li>
                        <li>O arraste é feito por interop de ponteiro (<code>slider.interop.js</code>); o encaixe no passo (<code>Step</code>) é feito em grade a partir de <code>Min</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private double _basic = 50;
    private double _inputValue = 50;
    private double _step = 20;
    private double[] _range = new[] { 20.0, 80.0 };
    private double _vertical = 50;
    private bool _submitted;
    private FormModel _form = new() { Score = 5 };

    private void SubmitForm() => _submitted = true;

    private sealed class FormModel
    {
        [Range(1, 10, ErrorMessage = "Escolha uma nota de 1 a 10.")]
        public double Score { get; set; }
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Slider

        <OpSlider @bind-Value="_value" />
        <OpSliderRange @bind-Value="_range" />

        @code {
            private double _value = 50;
            private double[] _range = new[] { 20.0, 80.0 };
        }
        """;

    private const string BasicCode = """
        <OpSlider @bind-Value="_value" />

        <span>Valor: @_value</span>
        """;

    private const string InputCode = """
        <input type="number" class="p-inputtext p-component" @bind="_value" />
        <OpSlider @bind-Value="_value" />

        @code {
            private double _value = 50;
        }
        """;

    private const string StepCode = """
        <OpSlider @bind-Value="_value" Step="20" />
        """;

    private const string RangeCode = """
        <OpSliderRange @bind-Value="_range" />

        @code {
            private double[] _range = new[] { 20.0, 80.0 };
        }
        """;

    private const string VerticalCode = """
        <OpSlider @bind-Value="_value" Orientation="vertical" style="height: 14rem;" />
        """;

    private const string FormsCode = """
        <EditForm Model="_form" OnValidSubmit="SubmitForm">
            <DataAnnotationsValidator />
            <OpSlider @bind-Value="_form.Score" Max="10" />
            <ValidationMessage For="() => _form.Score" />
            <button type="submit" class="p-button p-component">Enviar</button>
        </EditForm>

        @code {
            private FormModel _form = new() { Score = 5 };

            private sealed class FormModel
            {
                [Range(1, 10)] public double Score { get; set; }
            }
        }
        """;
}
