@page "/galleria"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Galleria
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.SelectButton

<PageTitle>Galleria - OpBlazorUI</PageTitle>

<DocComponent Title="Galleria"
              Description="Galleria é um componente avançado de galeria de imagens com miniaturas, indicadores, autoplay, legenda e modo tela cheia.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    A Galleria exige um <code>Value</code> como coleção de itens, um <code>ItemTemplate</code> para a
                    imagem em alta resolução e um <code>ThumbnailTemplate</code> para a miniatura. O número de
                    miniaturas visíveis é definido por <code>NumVisible</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" ContainerStyle="max-width:640px;">
                        <ItemTemplate Context="photo">
                            <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ItemTemplate>
                        <ThumbnailTemplate Context="photo">
                            <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ThumbnailTemplate>
                    </OpGalleria>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Controlado" Id="controlled">
            <Description>
                <p>
                    A Galleria pode ser controlada programaticamente com <code>@@bind-ActiveIndex</code>. Os botões abaixo
                    alteram o slide ativo; o índice atual é exibido ao lado.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-4 items-center">
                    <div class="flex gap-2 items-center">
                        <OpButton Icon="pi pi-minus" AriaLabel="Anterior" OnClick="Prev"/>
                        <OpButton Icon="pi pi-plus" AriaLabel="Próximo" Severity="secondary" OnClick="Next"/>
                        <span class="text-sm text-muted-color">Slide @(_activeIndex + 1) de @_photos.Length</span>
                    </div>
                    <div class="card flex justify-center">
                        <OpGalleria TItem="Photo" Value="_photos" @bind-ActiveIndex="_activeIndex"
                                    Circular="true" NumVisible="5" ContainerStyle="max-width:640px;">
                            <ItemTemplate Context="photo">
                                <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                            </ItemTemplate>
                            <ThumbnailTemplate Context="photo">
                                <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                            </ThumbnailTemplate>
                        </OpGalleria>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ControlledCode"/></Code>
        </DocSection>

        <DocSection Label="Miniaturas" Id="thumbnail">
            <Description>
                <p>
                    A posição das miniaturas é definida com <code>ThumbnailsPosition</code>
                    (<code>bottom</code>, <code>top</code>, <code>left</code> ou <code>right</code>), e podem ser
                    ocultadas com <code>ShowThumbnails="false"</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-4">
                    <div class="flex justify-center">
                        <OpSelectButton TValue="string" @bind-Value="_thumbPosition"
                                        Options="_positionOptions" AllowEmpty="false"/>
                    </div>
                    <div class="card flex justify-center">
                        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5"
                                    ThumbnailsPosition="@_thumbPosition" ContainerStyle="max-width:640px;">
                            <ItemTemplate Context="photo">
                                <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                            </ItemTemplate>
                            <ThumbnailTemplate Context="photo">
                                <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                            </ThumbnailTemplate>
                        </OpGalleria>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ThumbnailCode"/></Code>
        </DocSection>

        <DocSection Label="Responsivo" Id="responsive">
            <Description>
                <p>
                    A responsividade é declarada com <code>ResponsiveOptions</code>, uma coleção de breakpoints com
                    <code>NumVisible</code>. Nesta versão a propriedade é aceita mas ainda não aplicada — veja
                    Problemas Conhecidos.
                </p>
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" Circular="true"
                                ResponsiveOptions="_responsiveOptions" ContainerStyle="max-width:640px;">
                        <ItemTemplate Context="photo">
                            <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ItemTemplate>
                        <ThumbnailTemplate Context="photo">
                            <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ThumbnailTemplate>
                    </OpGalleria>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ResponsiveCode"/></Code>
        </DocSection>

        <DocSection Label="Reprodução Automática" Id="autoplay">
            <Description>
                <p>
                    Uma apresentação de slides é criada com <code>AutoPlay="true"</code> e <code>Circular="true"</code>.
                    O intervalo entre as transições é definido em milissegundos por
                    <code>TransitionInterval</code> (padrão <code>4000</code>).
                </p>
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" Circular="true"
                                AutoPlay="true" TransitionInterval="3000" ContainerStyle="max-width:640px;">
                        <ItemTemplate Context="photo">
                            <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ItemTemplate>
                        <ThumbnailTemplate Context="photo">
                            <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ThumbnailTemplate>
                    </OpGalleria>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@AutoPlayCode"/></Code>
        </DocSection>

        <DocSection Label="Legenda" Id="caption">
            <Description>
                <p>A descrição de uma imagem é especificada com o template <code>CaptionTemplate</code>.</p>
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" ContainerStyle="max-width:640px;">
                        <ItemTemplate Context="photo">
                            <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ItemTemplate>
                        <ThumbnailTemplate Context="photo">
                            <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ThumbnailTemplate>
                        <CaptionTemplate Context="photo">
                            <div class="text-xl font-bold">@photo.Title</div>
                            <p class="text-sm">@photo.Alt</p>
                        </CaptionTemplate>
                    </OpGalleria>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CaptionCode"/></Code>
        </DocSection>

        <DocSection Label="Avançado" Id="advanced">
            <Description>
                <p>
                    Com <code>FullScreen="true"</code> a galeria é exibida dentro de uma camada modal controlada por
                    <code>@@bind-Visible</code>. Use um botão para abrir a tela cheia; o botão de fechar do componente
                    fecha a sobreposição.
                </p>
            </Description>
            <ChildContent>
                <div class="card flex flex-col gap-4 items-center">
                    <OpButton Label="Abrir em tela cheia" Icon="pi pi-external-link"
                              OnClick="OpenFullscreen"/>
                    <OpGalleria TItem="Photo" Value="_photos" FullScreen="true" @bind-Visible="_fullscreenVisible"
                                Circular="true" NumVisible="5" ContainerStyle="max-width:640px;">
                        <ItemTemplate Context="photo">
                            <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ItemTemplate>
                        <ThumbnailTemplate Context="photo">
                            <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;"/>
                        </ThumbnailTemplate>
                    </OpGalleria>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@AdvancedCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    A Galleria não define papéis ARIA ricos por padrão; o elemento raiz recebe os atributos extras
                    repassados (por exemplo, <code>aria-label</code> ou <code>aria-roledescription</code>). Os botões de
                    navegação e de miniaturas são <code>button</code> nativos com <code>aria-label</code>. Indicadores e
                    miniaturas usam <code>tabindex="0"</code> para serem alcançáveis por teclado.
                </p>
                <p>
                    No modo tela cheia, a sobreposição usa <code>role="dialog"</code> com <code>aria-modal="true"</code>.
                    Use os atributos adicionais para descrever a galeria.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <ApiTable Caption="Navegação"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco pelos botões de navegação, indicadores e miniaturas." },
                              new[] { "enter / space", "Ativa o elemento focado (navegar, selecionar indicador ou miniatura)." },
                              new[] { "left / right arrow", "Move o foco entre indicadores e miniaturas (previsto no upstream; não implementado nesta versão)." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "IReadOnlyList&lt;TItem&gt;", "[]", "Coleção de itens exibida pela galeria." },
                              new[] { "ActiveIndex", "int", "0", "Índice do item ativo; usar com <code>&#64;bind-ActiveIndex</code>." },
                              new[] { "Visible", "bool", "false", "Visibilidade no modo tela cheia (two-way)." },
                              new[] { "FullScreen", "bool", "false", "Habilita o modo tela cheia em camada modal." },
                              new[] { "NumVisible", "int", "3", "Quantidade de miniaturas visíveis na janela." },
                              new[] { "Circular", "bool", "false", "Retorna ao primeiro item após o último (e vice-versa)." },
                              new[] { "AutoPlay", "bool", "false", "Avança os slides automaticamente." },
                              new[] { "TransitionInterval", "int", "4000", "Intervalo do autoplay, em milissegundos." },
                              new[] { "ShowIndicators", "bool", "false", "Exibe a lista de indicadores." },
                              new[] { "ShowIndicatorsOnItem", "bool", "false", "Sobrepõe os indicadores à imagem." },
                              new[] { "IndicatorsPosition", "string", "\"bottom\"", "Posição dos indicadores: <code>bottom</code>, <code>top</code>, <code>left</code> ou <code>right</code>." },
                              new[] { "ShowThumbnails", "bool", "true", "Exibe a faixa de miniaturas." },
                              new[] { "ThumbnailsPosition", "string", "\"bottom\"", "Posição das miniaturas: <code>bottom</code>, <code>top</code>, <code>left</code> ou <code>right</code>." },
                              new[] { "ShowItemNavigators", "bool", "false", "Exibe os botões de navegação sobre o item." },
                              new[] { "ShowItemNavigatorsOnHover", "bool", "false", "Exibe os botões de navegação apenas ao passar o mouse." },
                              new[] { "ResponsiveOptions", "object?", "null", "Breakpoints responsivos (aceito, ainda não aplicado)." },
                              new[] { "ContainerStyle", "string?", "null", "Estilo inline do contêiner." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz." },
                              new[] { "Id", "string?", "null", "Id do elemento raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ActiveIndexChanged", "EventCallback&lt;int&gt;", "Notifica a mudança do item ativo (binding de <code>ActiveIndex</code>)." },
                              new[] { "VisibleChanged", "EventCallback&lt;bool&gt;", "Notifica a abertura/fechamento da tela cheia (binding de <code>Visible</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TItem&gt;?", "Conteúdo do slide ativo." },
                              new[] { "ThumbnailTemplate", "RenderFragment&lt;TItem&gt;?", "Conteúdo de cada miniatura." },
                              new[] { "CaptionTemplate", "RenderFragment&lt;TItem&gt;?", "Legenda sobreposta ao slide." },
                              new[] { "IndicatorTemplate", "RenderFragment&lt;int&gt;?", "Conteúdo de cada indicador; o contexto é o índice." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo exibido acima da galeria." },
                              new[] { "FooterTemplate", "RenderFragment?", "Conteúdo exibido abaixo da galeria." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Registro do item (exemplo Photo)" Id="api-item">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemImageSrc", "string", "URL da imagem em alta resolução." },
                              new[] { "ThumbnailImageSrc", "string", "URL da imagem de miniatura." },
                              new[] { "Alt", "string", "Texto alternativo da imagem." },
                              new[] { "Title", "string", "Título exibido na legenda." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><DocTokens Component="galleria"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular não foi portado. Para customização de estilo, use
                    <code>StyleClass</code>, os templates e os <code>AdditionalAttributes</code> (repassados ao
                    elemento raiz).</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li><code>ResponsiveOptions</code> é aceito por compatibilidade, mas os breakpoints não são aplicados: <code>NumVisible</code> permanece fixo.</li>
                        <li>As miniaturas são exibidas em uma janela de <code>NumVisible</code> itens, sem <em>swipe</em>/arraste e sem suporte a toque.</li>
                        <li>O autoplay é um timer que reinicia a cada renderização (a cada atualização de parâmetros), podendo reiniciar a contagem.</li>
                        <li>No modo tela cheia o overlay não possui <em>focus-trap</em> nem bloqueio de rolagem; a raiz fica oculta e o conteúdo só é renderizado quando <code>Visible</code> é <code>true</code>.</li>
                        <li>Indicadores e miniaturas têm <code>tabindex="0"</code>, mas a navegação por setas do upstream não foi implementada (apenas clique e tabulação).</li>
                        <li>Os rótulos acessíveis (Anterior/Próximo/Fechar) estão fixos em pt-BR, sem integração com a API de <em>locale</em>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    public sealed record Photo(string ItemImageSrc, string ThumbnailImageSrc, string Alt, string Title);

    private static readonly Photo[] _photos =
    [
        new("https://primefaces.org/cdn/primeng/images/galleria/galleria10.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria10.jpg", "Descrição da imagem 10", "Título 10"),
        new("https://primefaces.org/cdn/primeng/images/galleria/galleria11.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria11.jpg", "Descrição da imagem 11", "Título 11"),
        new("https://primefaces.org/cdn/primeng/images/galleria/galleria12.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria12.jpg", "Descrição da imagem 12", "Título 12"),
        new("https://primefaces.org/cdn/primeng/images/galleria/galleria3.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria3.jpg", "Descrição da imagem 3", "Título 3"),
        new("https://primefaces.org/cdn/primeng/images/galleria/galleria4.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria4.jpg", "Descrição da imagem 4", "Título 4")
    ];

    private static readonly object[] _positionOptions = ["bottom", "top", "left", "right"];

    private static readonly object[] _responsiveOptions =
    [
        new { Breakpoint = "1024px", NumVisible = 5 },
        new { Breakpoint = "640px", NumVisible = 3 }
    ];

    private int _activeIndex;
    private string _thumbPosition = "bottom";
    private bool _fullscreenVisible;

    private void Prev()
    {
        if (_activeIndex > 0)
        {
            _activeIndex--;
        }
    }

    private void Next()
    {
        if (_activeIndex < _photos.Length - 1)
        {
            _activeIndex++;
        }
    }

    private void OpenFullscreen() => _fullscreenVisible = true;

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Galleria
        """;

    private const string BasicCode = """
        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" ContainerStyle="max-width:640px;">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" alt="@photo.Alt" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" alt="@photo.Alt" style="width:100%; display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>

        @code {
            public sealed record Photo(string ItemImageSrc, string ThumbnailImageSrc, string Alt, string Title);

            private readonly Photo[] _photos =
            [
                new("https://primefaces.org/cdn/primeng/images/galleria/galleria10.jpg", "https://primefaces.org/cdn/primeng/images/galleria/galleria10.jpg", "Descrição da imagem", "Título")
            ];
        }
        """;

    private const string ControlledCode = """
        <OpButton Icon="pi pi-minus" AriaLabel="Anterior" OnClick="Prev" />
        <OpButton Icon="pi pi-plus" AriaLabel="Próximo" Severity="secondary" OnClick="Next" />

        <OpGalleria TItem="Photo" Value="_photos" @bind-ActiveIndex="_activeIndex" Circular="true" NumVisible="5">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>

        @code {
            private int _activeIndex;

            private void Prev() { if (_activeIndex > 0) _activeIndex--; }
            private void Next() { if (_activeIndex < _photos.Length - 1) _activeIndex++; }
        }
        """;

    private const string ThumbnailCode = """
        <OpSelectButton TValue="string" @bind-Value="_position" Options="_positionOptions" AllowEmpty="false" />

        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" ThumbnailsPosition="@_position">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>

        @code {
            private string _position = "bottom";
            private readonly object[] _positionOptions = ["bottom", "top", "left", "right"];
        }
        """;

    private const string ResponsiveCode = """
        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" Circular="true" ResponsiveOptions="_responsiveOptions">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>

        @code {
            private readonly object[] _responsiveOptions =
            [
                new { Breakpoint = "1024px", NumVisible = 5 },
                new { Breakpoint = "640px", NumVisible = 3 }
            ];
        }
        """;

    private const string AutoPlayCode = """
        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5" Circular="true"
                    AutoPlay="true" TransitionInterval="3000">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>
        """;

    private const string CaptionCode = """
        <OpGalleria TItem="Photo" Value="_photos" NumVisible="5">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
            <CaptionTemplate Context="photo">
                <div class="text-xl font-bold">@photo.Title</div>
                <p class="text-sm">@photo.Alt</p>
            </CaptionTemplate>
        </OpGalleria>
        """;

    private const string AdvancedCode = """
        <OpButton Label="Abrir em tela cheia" Icon="pi pi-external-link" OnClick="OpenFullscreen" />

        <OpGalleria TItem="Photo" Value="_photos" FullScreen="true" @bind-Visible="_fullscreen" Circular="true" NumVisible="5">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" style="width:100%; display:block;" />
            </ItemTemplate>
            <ThumbnailTemplate Context="photo">
                <img src="@photo.ThumbnailImageSrc" style="display:block;" />
            </ThumbnailTemplate>
        </OpGalleria>

        @code {
            private bool _fullscreen;

            private void OpenFullscreen() => _fullscreen = true;
        }
        """;

    private const string AccessibilityCode = """
        <OpGalleria TItem="Photo" Value="_photos" aria-label="Galeria de fotos">
            <ItemTemplate Context="photo">
                <img src="@photo.ItemImageSrc" alt="@photo.Alt" />
            </ItemTemplate>
        </OpGalleria>
        """;
}
