        <OpToggleButton @bind-Value="_notified" OnIcon="pi pi-bell" OffIcon="pi pi-bell-slash" AriaLabel="Notificações" />
        <OpToggleButton @bind-Value="_subscribed" OnLabel="Assinado" OffLabel="Cancelado"
                        OnIcon="pi pi-check" OffIcon="pi pi-times" IconPos="right" AriaLabel="Assinatura" />

        @code {
            private bool _locked;
            private bool _notified;
            private bool _subscribed;
        }
        """;

    private const string SizesCode = """
        <div class="flex flex-col items-center gap-4">
            <OpToggleButton @bind-Value="_sizeSmall" OnLabel="Ligado" OffLabel="Desligado" Size="small" style="min-width:8rem;" />
            <OpToggleButton @bind-Value="_sizeNormal" OnLabel="Ligado" OffLabel="Desligado" style="min-width:8rem;" />
            <OpToggleButton @bind-Value="_sizeLarge" OnLabel="Ligado" OffLabel="Desligado" Size="large" style="min-width:8rem;" />
        </div>
        """;

    private const string FluidCode = """
        <div style="width:100%; max-width:20rem;">
            <OpToggleButton @bind-Value="_fluid" OnLabel="Ligado" OffLabel="Desligado" Fluid="true" />
        </div>
        """;

    private const string DisabledCode = """
        <OpToggleButton @bind-Value="_disabledOn" OnLabel="Sim" OffLabel="Não"
                        OnIcon="pi pi-check" OffIcon="pi pi-times" Disabled="true" AriaLabel="Confirmação"
                        style="min-width:8rem;" />
        """;

    private const string InvalidCode = """
        <OpToggleButton @bind-Value="_invalidOn" Invalid="!_invalidOn"
                        OnIcon="pi pi-check" OffIcon="pi pi-times" AriaLabel="Confirmação" style="min-width:8rem;" />

        @code {
            private bool _invalidOn;
        }
        """;

    private const string TemplateDrivenCode = """
        <EditForm Model="_tdModel" OnValidSubmit="OnTemplateDrivenSubmit" class="flex flex-col items-start gap-2">
            <DataAnnotationsValidator />
            <OpToggleButton @bind-Value="_tdModel.Accepted" OnLabel="Aceitar" OffLabel="Recusar" />
            <ValidationMessage For="() => _tdModel.Accepted" />
            <button type="submit" class="p-button p-component">Enviar</button>
            @if (_tdSubmitted)
            {
                <div class="text-sm">Aceito: @_tdModel.Accepted</div>
            }
        </EditForm>

        @code {
            private sealed class TemplateDrivenModel
            {
                [Range(typeof(bool), "true", "true", ErrorMessage = "O aceite é obrigatório.")]
                public bool Accepted { get; set; }
            }

            private readonly TemplateDrivenModel _tdModel = new();
            private bool _tdSubmitted;

            private void OnTemplateDrivenSubmit() => _tdSubmitted = true;
