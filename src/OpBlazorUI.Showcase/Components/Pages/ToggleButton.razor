@page "/togglebutton"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.ToggleButton
@using System.ComponentModel.DataAnnotations

<DocComponent Title="ToggleButton"
              Description="O ToggleButton é usado para selecionar um valor booleano usando um botão.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpToggleButton @bind-Value="_on" OnLabel="Ligado" OffLabel="Desligado"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Ícones">
            <ChildContent>
                <div class="flex gap-3">
                    <OpToggleButton @bind-Value="_bold" OnIcon="pi pi-check" OffIcon="pi pi-times" AriaLabel="Alternar"/>
                    <OpToggleButton @bind-Value="_lock" OnLabel="Bloqueado" OffLabel="Desbloqueado" OnIcon="pi pi-lock" OffIcon="pi pi-lock" IconPos="left"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@IconCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido / Desabilitado / Tamanho">
            <ChildContent>
                <div class="flex gap-3 items-center">
                    <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Invalid="true"/>
                    <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Disabled="true"/>
                    <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Size="small"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StateCode"/></Code>
        </DocSection>
        <DocSection Label="Validação">
            <Description>
                O ToggleButton herda de <code>InputBase&lt;bool&gt;</code>, então integra-se ao <code>EditForm</code> com DataAnnotations. O estado <code>invalid</code> é aplicado automaticamente quando há erro de validação.
            </Description>
            <ChildContent>
                <EditForm Model="_form" OnValidSubmit="OnSubmit" class="flex flex-col items-start gap-2">
                    <DataAnnotationsValidator/>
                    <OpToggleButton @bind-Value="_form.Accepted" OnLabel="Sim" OffLabel="Não"/>
                    <ValidationMessage For="() => _form.Accepted"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_submitted)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Aceito: @_form.Accepted</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@ValidationCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "bool", "false", "Estado marcado." },
                              new[] { "ValueChanged", "EventCallback&lt;bool&gt;", "-", "Callback de binding." },
                              new[] { "OnLabel", "string?", "null", "Texto quando ligado." },
                              new[] { "OffLabel", "string?", "null", "Texto quando desligado." },
                              new[] { "OnIcon", "string?", "null", "Ícone quando ligado." },
                              new[] { "OffIcon", "string?", "null", "Ícone quando desligado." },
                              new[] { "IconPos", "string", "left", "Posição do ícone: <code>left</code> ou <code>right</code>." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;bool&gt;", "Disparado ao mudar o estado." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ContentTemplate", "RenderFragment&lt;bool&gt;?", "Template customizado do conteúdo." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="togglebutton"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e <code>ContentTemplate</code> para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private bool _on = true;
    private bool _bold;
    private bool _lock;

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.ToggleButton

        <OpToggleButton @bind-Value="_on" OnLabel="Ligado" OffLabel="Desligado" />
        """;

    private const string BasicCode = """
        <OpToggleButton @bind-Value="_on" OnLabel="Ligado" OffLabel="Desligado" />

        @code {
            private bool _on = true;
        }
        """;

    private const string IconCode = """
        <OpToggleButton @bind-Value="_bold" OnIcon="pi pi-check" OffIcon="pi pi-times" AriaLabel="Alternar" />
        <OpToggleButton @bind-Value="_lock" OnLabel="Bloqueado" OffLabel="Desbloqueado" OnIcon="pi pi-lock" OffIcon="pi pi-lock" />
        """;

    private const string StateCode = """
        <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Invalid="true" />
        <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Disabled="true" />
        <OpToggleButton Value="true" OnLabel="Ligado" OffLabel="Desligado" Size="small" />
        """;

    private bool _submitted;
    private ToggleButtonFormModel _form = new();

    private sealed class ToggleButtonFormModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "Ative para continuar.")]
        public bool Accepted { get; set; }
    }

    private void OnSubmit() => _submitted = true;

    private const string ValidationCode = """
        <EditForm Model="_form" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <OpToggleButton @bind-Value="_form.Accepted" OnLabel="Sim" OffLabel="Não" />
            <ValidationMessage For="() => _form.Accepted" />
            <button type="submit" class="p-button p-component">Enviar</button>
        </EditForm>
        """;
}
