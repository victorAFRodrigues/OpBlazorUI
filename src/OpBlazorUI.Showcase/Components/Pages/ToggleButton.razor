        """;

    private const string ReactiveCode = """
        <EditForm EditContext="_reactiveContext" OnSubmit="OnReactiveSubmit" class="flex flex-col items-start gap-2">
            <OpToggleButton @bind-Value="_reactiveModel.Accepted" OnLabel="Aceitar" OffLabel="Recusar" />
            <ValidationMessage For="() => _reactiveModel.Accepted" />
            <button type="submit" class="p-button p-component">Enviar</button>
            @if (_reactiveSubmitted && _reactiveModel.Accepted)
            {
