@page "/tabs"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.Tabs
@using OpBlazorUI.Models

<PageTitle>Tabs - OpBlazorUI</PageTitle>

<DocComponent Title="Tabs"
              Description="O Tabs organiza o conteúdo em abas selecionáveis, com suporte a rolagem.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Cada <code>OpTabPanel</code> define um <code>Header</code> e o conteúdo.</Description>
            <ChildContent>
                <OpTabs @bind-ActiveIndex="_active">
                    <OpTabPanel Header="Cabeçalho 1">
                        <p class="m-0">Conteúdo da primeira aba.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 2">
                        <p class="m-0">Conteúdo da segunda aba.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 3">
                        <p class="m-0">Conteúdo da terceira aba.</p>
                    </OpTabPanel>
                </OpTabs>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Dinâmico" Id="dynamic">
            <Description>
                As abas podem ser geradas dinamicamente com um laço <code>@@foreach</code> sobre uma coleção.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <div class="flex justify-end">
                        <button type="button" class="p-button p-component" @onclick="AddPanel">Adicionar aba</button>
                    </div>
                    <OpTabs @bind-ActiveIndex="_dynamicActive">
                        @foreach (var header in _dynamicPanels)
                        {
                            var h = header;
                            <OpTabPanel Header="@h" Closable="true" OnClose="@(() => RemovePanel(h))">
                                <p class="m-0">Conteúdo de @h.</p>
                            </OpTabPanel>
                        }
                    </OpTabs>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DynamicCode"/></Code>
        </DocSection>

        <DocSection Label="Controlado" Id="controlled">
            <Description>
                As abas podem ser controladas programaticamente pela propriedade <code>ActiveIndex</code>
                (<code>@@bind-ActiveIndex</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <div class="flex justify-end gap-2">
                        <button type="button" class="p-button p-component" @onclick="@(() => _controlledActive = 0)">1</button>
                        <button type="button" class="p-button p-component" @onclick="@(() => _controlledActive = 1)">2</button>
                        <button type="button" class="p-button p-component" @onclick="@(() => _controlledActive = 2)">3</button>
                    </div>
                    <OpTabs @bind-ActiveIndex="_controlledActive">
                        <OpTabPanel Header="Cabeçalho 1"><p class="m-0">Conteúdo 1.</p></OpTabPanel>
                        <OpTabPanel Header="Cabeçalho 2"><p class="m-0">Conteúdo 2.</p></OpTabPanel>
                        <OpTabPanel Header="Cabeçalho 3"><p class="m-0">Conteúdo 3.</p></OpTabPanel>
                    </OpTabs>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ControlledCode"/></Code>
        </DocSection>

        <DocSection Label="Com ícones" Id="icons">
            <Description>O painel pode ter um <code>Icon</code> ao lado do cabeçalho.</Description>
            <ChildContent>
                <OpTabs ActiveIndex="0">
                    <OpTabPanel Header="Perfil" Icon="pi pi-user">
                        <p class="m-0">Dados do perfil.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Configurações" Icon="pi pi-cog">
                        <p class="m-0">Preferências.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Bloqueado" Icon="pi pi-lock" Disabled="true">
                        <p class="m-0">Indisponível.</p>
                    </OpTabPanel>
                </OpTabs>
            </ChildContent>
            <Code><CodeBlock Code="@IconsCode"/></Code>
        </DocSection>

        <DocSection Label="Rolável" Id="scrollable">
            <Description>Com <code>Scrollable</code>, botões de navegação aparecem quando as abas excedem a largura.</Description>
            <ChildContent>
                <div style="max-width: 32rem;">
                    <OpTabs Scrollable="true">
                        @for (var i = 1; i <= 10; i++)
                        {
                            var n = i;
                            <OpTabPanel Header="@($"Cabeçalho {n}")">
                                <p class="m-0">Conteúdo da aba @n.</p>
                            </OpTabPanel>
                        }
                    </OpTabs>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ScrollableCode"/></Code>
        </DocSection>

        <DocSection Label="Preguiçoso (Lazy)" Id="lazy">
            <Description>
                O conteúdo é renderizado apenas para a aba ativa: as demais só são criadas quando selecionadas. É
                o equivalente à propriedade <code>lazy</code> do Angular — no Blazor esse é o comportamento padrão.
            </Description>
            <ChildContent>
                <OpTabs @bind-ActiveIndex="_lazyActive">
                    <OpTabPanel Header="Cabeçalho 1">
                        <p class="m-0">O conteúdo desta aba é criado ao ser exibida.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 2">
                        <p class="m-0">As abas inativas não fazem parte do DOM.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 3">
                        <p class="m-0">Trocar de aba descarta o conteúdo anterior.</p>
                    </OpTabPanel>
                </OpTabs>
            </ChildContent>
            <Code><CodeBlock Code="@LazyCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>Uma aba com <code>Disabled="true"</code> não pode ser ativada pelo usuário.</Description>
            <ChildContent>
                <OpTabs ActiveIndex="0">
                    <OpTabPanel Header="Cabeçalho 1">
                        <p class="m-0">Conteúdo da primeira aba.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 2" Disabled="true">
                        <p class="m-0">Indisponível.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 3">
                        <p class="m-0">Conteúdo da terceira aba.</p>
                    </OpTabPanel>
                </OpTabs>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                O cabeçalho de uma aba é customizado por <code>HeaderTemplate</code>.
            </Description>
            <ChildContent>
                <OpTabs ActiveIndex="0" Scrollable="true">
                    <OpTabPanel>
                        <HeaderTemplate>
                            <span style="display:flex; align-items:center; gap:.5rem;">
                                <span class="p-tab-icon pi pi-user" aria-hidden="true"></span>
                                <span>Perfil</span>
                                <span class="p-badge">3</span>
                            </span>
                        </HeaderTemplate>
                        <ChildContent>
                            <p class="m-0">Dados do perfil.</p>
                        </ChildContent>
                    </OpTabPanel>
                    <OpTabPanel>
                        <HeaderTemplate>
                            <span style="display:flex; align-items:center; gap:.5rem;">
                                <span class="p-tab-icon pi pi-cog" aria-hidden="true"></span>
                                <span>Configurações</span>
                            </span>
                        </HeaderTemplate>
                        <ChildContent>
                            <p class="m-0">Preferências.</p>
                        </ChildContent>
                    </OpTabPanel>
                </OpTabs>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Tab Menu" Id="tabmenu">
            <Description>
                Para uma navegação somente por abas (sem painéis de conteúdo), use o <code>OpTabMenu</code>.
            </Description>
            <ChildContent>
                <OpTabMenu Model="_tabMenuItems" @bind-ActiveIndex="_tabMenuActive"/>
            </ChildContent>
            <Code><CodeBlock Code="@TabMenuCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Cada aba usa <code>role="tab"</code> com <code>aria-selected</code> e <code>aria-controls</code>; o painel usa <code>role="tabpanel"</code>.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para a aba ativa." },
                              new[] { "enter / space", "Ativa a aba focada." },
                              new[] { "left / right", "Move para a aba anterior/seguinte." },
                              new[] { "home / end", "Move para a primeira/última aba." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="OpTabs" Id="api-tabs">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ActiveIndex", "int", "0", "Índice da aba ativa (usar <code>@@bind-ActiveIndex</code>)." },
                              new[] { "Scrollable", "bool", "false", "Habilita a rolagem com botões de navegação." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível da lista de abas." },
                              new[] { "OnChange", "EventCallback&lt;int&gt;", "—", "Disparado ao trocar de aba." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="OpTabPanel" Id="api-panel">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Header", "string?", "null", "Texto do cabeçalho da aba." },
                              new[] { "Icon", "string?", "null", "Ícone da aba." },
                              new[] { "Disabled", "bool", "false", "Desabilita a aba." },
                              new[] { "Closable", "bool", "false", "Exibe o ícone de fechar na aba." },
                              new[] { "OnClose", "EventCallback&lt;OpTabPanel&gt;", "-", "Disparado ao fechar a aba (remova-a da coleção de painéis)." },
                              new[] { "HeaderTemplate", "RenderFragment?", "null", "Cabeçalho customizado." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Conteúdo da aba." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="tabs"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O conteúdo é renderizado apenas para a aba ativa (as demais não ficam no DOM).</li>
                        <li>A barra ativa animada (<code>p-tablist-active-bar</code>) do upstream não é posicionada; o destaque usa <code>p-tab-active</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _active;
    private int _dynamicActive;
    private int _controlledActive;
    private int _lazyActive;
    private int _tabMenuActive;

    private readonly List<string> _dynamicPanels = new() { "Aba 1", "Aba 2", "Aba 3" };

    private readonly List<OpMenuItem> _tabMenuItems = new()
    {
        new OpMenuItem { Label = "Painel", Icon = "pi pi-home", Url = "/tabs" },
        new OpMenuItem { Label = "Button", Icon = "pi pi-check", Url = "/button" },
        new OpMenuItem { Label = "InputText", Icon = "pi pi-pencil", Url = "/inputtext" }
    };

    private void AddPanel() => _dynamicPanels.Add($"Aba {_dynamicPanels.Count + 1}");

    private void RemovePanel(string header)
    {
        var index = _dynamicPanels.IndexOf(header);
        if (index >= 0)
        {
            _dynamicPanels.RemoveAt(index);
        }
    }

    private const string ImportCode = """
        @using OpBlazorUI.Components.Tabs

        <OpTabs @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1">Conteúdo 1</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2">Conteúdo 2</OpTabPanel>
        </OpTabs>

        @code {
            private int _active;
        }
        """;

    private const string BasicCode = """
        <OpTabs @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1">
                <p class="m-0">Conteúdo da primeira aba.</p>
            </OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2">
                <p class="m-0">Conteúdo da segunda aba.</p>
            </OpTabPanel>
        </OpTabs>
        """;

    private const string IconsCode = """
        <OpTabs ActiveIndex="0">
            <OpTabPanel Header="Perfil" Icon="pi pi-user">...</OpTabPanel>
            <OpTabPanel Header="Configurações" Icon="pi pi-cog">...</OpTabPanel>
            <OpTabPanel Header="Bloqueado" Icon="pi pi-lock" Disabled="true">...</OpTabPanel>
        </OpTabs>
        """;

    private const string ScrollableCode = """
        <OpTabs Scrollable="true">
            @for (var i = 1; i <= 10; i++)
            {
                <OpTabPanel Header="@($"Cabeçalho {i}")">Conteúdo @i</OpTabPanel>
            }
        </OpTabs>
        """;

    private const string DynamicCode = """
        <OpTabs @bind-ActiveIndex="_active">
            @foreach (var header in _panels)
            {
                <OpTabPanel Header="@header" Closable="true" OnClose="@(() => RemovePanel(header))">
                    Conteúdo de @header
                </OpTabPanel>
            }
        </OpTabs>

        @code {
            private int _active;
            private List<string> _panels = new() { "Aba 1", "Aba 2", "Aba 3" };

            private void RemovePanel(string header) => _panels.Remove(header);
        }
        """;

    private const string ControlledCode = """
        <OpTabs @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1">Conteúdo 1</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2">Conteúdo 2</OpTabPanel>
        </OpTabs>

        <button type="button" class="p-button" @onclick="@(() => _active = 1)">Abrir a segunda</button>

        @code {
            private int _active;
        }
        """;

    private const string LazyCode = """
        <OpTabs @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1">O conteúdo é criado ao exibir a aba.</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2">As abas inativas não ficam no DOM.</OpTabPanel>
        </OpTabs>
        """;

    private const string DisabledCode = """
        <OpTabs ActiveIndex="0">
            <OpTabPanel Header="Cabeçalho 1">Conteúdo 1</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2" Disabled="true">Indisponível</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 3">Conteúdo 3</OpTabPanel>
        </OpTabs>
        """;

    private const string TemplateCode = """
        <OpTabs ActiveIndex="0">
            <OpTabPanel>
                <HeaderTemplate>
                    <span class="p-tab-icon pi pi-user"></span>
                    <span>Perfil</span>
                    <span class="p-badge">4</span>
                </HeaderTemplate>
                Conteúdo do perfil
            </OpTabPanel>
        </OpTabs>
        """;

    private const string TabMenuCode = """
        <OpTabMenu Model="_items" @bind-ActiveIndex="_active" />

        @code {
            private int _active;
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Painel", Icon = "pi pi-home", Url = "/tabs" },
                new OpMenuItem { Label = "Button", Icon = "pi pi-check", Url = "/button" }
            };
        }
        """;
}
