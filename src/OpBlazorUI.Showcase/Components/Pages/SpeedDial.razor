    private const string DynamicCode = """
        <OpButton Label="Adicionar" Icon="pi pi-plus" Size="small" OnClick="AddItem"
                  Disabled="@(_items.Count >= _pool.Count)" />
        <OpButton Label="Remover" Icon="pi pi-minus" Size="small" Severity="secondary" OnClick="RemoveItem"
                  Disabled="@(_items.Count <= 1)" />
        <OpButton Label="Reset (7)" Icon="pi pi-refresh" Size="small" Severity="help" Outlined="true"
                  OnClick="ResetItems" />
        <span>@_items.Count @(_items.Count == 1 ? "item" : "itens")</span>

        <OpSpeedDial @bind-Visible="_visible" Model="_items" Radius="100" Type="circle"
                     Style="position:absolute;" ButtonSeverity="warn" Tooltip="true" TooltipPosition="left" />

        @code {
            private bool _visible;
            private List<OpMenuItem> _pool = BuildPool();          // conjunto maior de itens
            private List<OpMenuItem> _items = _pool.Take(7).ToList();

            private void AddItem() => _items = _pool.Take(_items.Count + 1).ToList();
            private void RemoveItem() => _items = _pool.Take(_items.Count - 1).ToList();
            private void ResetItems() => _items = _pool.Take(7).ToList();
        }
        """;

