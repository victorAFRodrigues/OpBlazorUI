    <Theming>
        <DocSection Label="Classes CSS" Id="style">
            <Description>
                Classes estruturais aplicadas pelo componente. Para as cores e medidas de cada tema, veja os tokens abaixo.
            </Description>
            <ChildContent>
                <ApiTable Headers="@(new[] { "Classe", "Elemento" })"
                          Rows="@(new[] {
                              new[] { "p-listbox", "Contêiner raiz." },
                              new[] { "p-listbox-striped", "Raiz quando <code>Striped</code> está ativo." },
                              new[] { "p-listbox-header", "Cabeçalho da lista (filtro e selecionar tudo)." },
                              new[] { "p-listbox-header-checkbox", "Contêiner do checkbox de selecionar tudo." },
                              new[] { "p-listbox-filter-container", "Contêiner do campo de filtro." },
                              new[] { "p-listbox-filter", "Campo de entrada do filtro." },
                              new[] { "p-listbox-list-container", "Contêiner da lista com a altura máxima; também no scroll virtual." },
                              new[] { "p-listbox-list", "O <code>&lt;ul&gt;</code> com <code>role=&quot;listbox&quot;</code>." },
                              new[] { "p-listbox-option", "Cada <code>&lt;li&gt;</code> com <code>role=&quot;option&quot;</code>." },
                              new[] { "p-listbox-option-selected", "Opção selecionada quando <code>HighlightOnSelect</code> está ativo." },
                              new[] { "p-listbox-option-group", "Cabeçalho de um grupo." },
                              new[] { "p-listbox-option-check-icon", "Ícone de checkmark / checkbox de cada opção." },
                              new[] { "p-listbox-option-blank-icon", "Ícone vazio que reserva o espaço do checkmark." },
                              new[] { "p-listbox-empty-message", "Mensagem de lista vazia." },
                              new[] { "p-focus", "Opção com foco (teclado ou mouse)." },
                              new[] { "p-disabled / p-invalid", "Raiz conforme o estado do componente." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Temas" Id="theming">
            <ChildContent>
                <DocTokens Component="listbox"/>
            </ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular ainda não foi portado para o Blazor. Para customização de estilo, use <code>StyleClass</code>, <code>ListStyleClass</code> e os templates (<code>ItemTemplate</code>, <code>GroupTemplate</code>, <code>HeaderTemplate</code>, <code>FilterTemplate</code>, etc.). Atributos extras são repassados ao contêiner raiz.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Não há suporte a arrastar e soltar: o <code>dragDrop</code> do upstream (via <code>@@angular/cdk</code>) não foi portado e não existe parâmetro equivalente.</li>
                        <li>Não há <code>metaKeySelection</code>: no modo múltiplo cada clique alterna a seleção, sem exigir tecla modificadora.</li>
                        <li>Os atalhos estendidos do upstream (<code>shift</code>/<code>control</code> + setas, <code>control</code> + <code>A</code>, <code>control</code> + <code>shift</code> + <code>home</code>/<code>end</code>) não estão implementados; há apenas navegação, <code>home</code>/<code>end</code> e busca por digitação.</li>
                        <li>Não há <code>AriaLabelledBy</code>: o rótulo acessível vem apenas de <code>AriaLabel</code>. Atributos extras são aplicados ao contêiner raiz, não ao elemento com <code>role="listbox"</code>.</li>
                        <li>O parâmetro <code>Required</code> não altera o markup nem adiciona <code>aria-required</code>; use a validação do <code>EditForm</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private City? _city;
    private City? _cityCheckmark;
    private City? _cityFilter;
    private City? _cityTemplate;
    private City? _cityInvalid;
    private City? _cityDisabled;
    private City? _virtualCity;
    private IReadOnlyList<City>? _citiesCheckbox;
    private IReadOnlyList<City>? _citiesMultiple;
    private string? _country;

    private bool _submitted;
    private FormModel _form = new();

    private sealed class FormModel
    {
        [Required(ErrorMessage = "A cidade é obrigatória.")]
        public City? City { get; set; }
    }

    private void OnValidSubmit() => _submitted = true;

    private sealed class City
    {
        public string Name { get; set; } = "";
        public string Code { get; set; } = "";
    }

    private static readonly List<City> Cities = new()
    {
        new() { Name = "Nova York", Code = "NY" },
        new() { Name = "Roma", Code = "RM" },
        new() { Name = "Londres", Code = "LDN" },
        new() { Name = "Istambul", Code = "IST" },
        new() { Name = "Paris", Code = "PRS" }
    };

    private static readonly List<City> ManyCities = Enumerable.Range(0, 10000)
        .Select(i => new City { Name = $"Cidade {i}", Code = $"C{i}" })
        .ToList();

    private sealed class CountryGroup
    {
        public string Label { get; set; } = "";
        public List<string> Items { get; set; } = new();
    }

    private static readonly List<CountryGroup> CountryGroups = new()
    {
