                              new[] { "ValueChanged", "EventCallback&lt;TValue&gt;", "Callback de binding de <code>@bind-Value</code> (herdado)." },
                              new[] { "SelectedValuesChanged", "EventCallback&lt;IReadOnlyList&lt;TValue&gt;?&gt;", "Callback de binding de <code>@bind-SelectedValues</code>." },
                              new[] { "OnChange", "EventCallback&lt;TValue?&gt;", "Disparado ao mudar a seleção no modo único." },
                              new[] { "OnSelectionChange", "EventCallback&lt;IReadOnlyList&lt;TValue&gt;?&gt;", "Disparado ao mudar a seleção no modo múltiplo." },
                              new[] { "OnFilter", "EventCallback&lt;string&gt;", "Disparado ao alterar o texto do filtro." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado quando o componente recebe foco." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado quando o componente perde o foco." },
                              new[] { "OnClick", "EventCallback&lt;MouseEventArgs&gt;", "Disparado no clique sobre a lista." },
                              new[] { "OnDblClick", "EventCallback&lt;MouseEventArgs&gt;", "Disparado no duplo clique sobre uma opção." },
