@page "/listbox"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Listbox
@using System.ComponentModel.DataAnnotations

<PageTitle>Listbox - OpBlazorUI</PageTitle>

<DocComponent Title="Listbox"
              Description="O Listbox é usado para selecionar um ou mais valores de uma lista de itens.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O Listbox é um componente controlado: forneça <code>Options</code> e conecte o valor com
                <code>@@bind-Value</code>. O rótulo e o valor de cada opção vêm de <code>OptionLabel</code> e
                <code>OptionValue</code>. Se <code>OptionValue</code> for omitido, o próprio item é usado como valor —
                o que dispensa as duas propriedades quando <code>Options</code> é um array de primitivos.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_city" Options="Cities" OptionLabel="Name" OptionValue="Code" StyleClass="w-56"/>
                </div>
                <div class="mt-2 text-sm">Selecionado: @(_city?.Name ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Marca de Seleção" Id="checkmark">
            <Description>
                Uma alternativa ao realce de fundo é exibir um checkmark na opção selecionada. Ative
                <code>Checkmark</code> e, para ver apenas o ícone, desligue o realce com
                <code>HighlightOnSelect="false"</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_cityCheckmark" Options="Cities" OptionLabel="Name" Checkmark="true" HighlightOnSelect="false" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckmarkCode"/></Code>
        </DocSection>

        <DocSection Label="Checkbox" Id="checkbox">
            <Description>
                Com <code>Checkbox="true"</code> cada item recebe um checkbox. A propriedade implica seleção
                múltipla, então o valor é uma lista ligada por <code>@@bind-SelectedValues</code>. O checkbox do
                cabeçalho (selecionar/limpar tudo) aparece por padrão e pode ser controlado com
                <code>ShowToggleAll</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-SelectedValues="_citiesCheckbox" Options="Cities" Multiple="true" Checkbox="true" OptionLabel="Name" StyleClass="w-56"/>
                </div>
                <div class="mt-2 text-sm">Selecionados: @(_citiesCheckbox is null ? "—" : string.Join(", ", _citiesCheckbox.Select(c => c.Name)))</div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckboxCode"/></Code>
        </DocSection>

        <DocSection Label="Múltiplo" Id="multiple">
            <Description>
                Por padrão o Listbox permite escolher um único item; ative <code>Multiple="true"</code> para escolher
                vários. No Blazor não existe o <code>metaKeySelection</code> do Angular: cada clique alterna a
                seleção, sem exigir tecla modificadora.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-SelectedValues="_citiesMultiple" Options="Cities" OptionLabel="Name" Multiple="true" StyleClass="w-56"/>
                </div>
                <div class="mt-2 text-sm">Selecionados: @(_citiesMultiple is null ? "—" : string.Join(", ", _citiesMultiple.Select(c => c.Name)))</div>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Grupo" Id="group">
            <Description>
                As opções podem ser agrupadas quando <code>Options</code> traz uma estrutura aninhada e
                <code>Group="true"</code> é definido. O rótulo e os itens do grupo são lidos das propriedades
                indicadas em <code>OptionGroupLabel</code> (padrão <code>label</code>) e
                <code>OptionGroupChildren</code> (padrão <code>items</code>). O <code>GroupTemplate</code> recebe o
                grupo e permite customizar o cabeçalho.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="string" @bind-Value="_country" Options="CountryGroups" Group="true" OptionGroupLabel="Label" OptionGroupChildren="Items" StyleClass="w-56">
                        <GroupTemplate Context="g">
                            <div class="flex items-center gap-2">
                                <span class="pi pi-flag" aria-hidden="true"></span>
                                <span>@(((CountryGroup)g).Label)</span>
                            </div>
                        </GroupTemplate>
                    </OpListbox>
                </div>
                <div class="mt-2 text-sm">Selecionado: @(_country ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@GroupCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description>
                O Listbox traz filtragem nativa, habilitada com <code>Filter="true"</code>. O critério de busca é o
                rótulo da opção; use <code>FilterBy</code> para também casar uma segunda propriedade. A mensagem
                exibida quando nada é encontrado vem de <code>EmptyFilterMessage</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_cityFilter" Options="Cities" OptionLabel="Name" Filter="true" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                Para conteúdo customizado defina <code>ItemTemplate</code>; o contexto é o próprio item
                (<code>TValue</code>). Há ainda <code>GroupTemplate</code>, <code>HeaderTemplate</code>,
                <code>FooterTemplate</code>, <code>EmptyTemplate</code>, <code>EmptyFilterTemplate</code>,
                <code>FilterTemplate</code> e <code>CheckIconTemplate</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_cityTemplate" Options="Cities" OptionLabel="Name" StyleClass="w-56">
                        <ItemTemplate Context="c">
                            <div class="flex items-center gap-2">
                                <span class="pi pi-map-marker" style="color:var(--p-primary-color)"></span>
                                <span>@c.Name</span>
                                <span style="margin-left:auto; color:var(--p-text-muted-color); font-size:.8rem;">@c.Code</span>
                            </div>
                        </ItemTemplate>
                    </OpListbox>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Scroll Virtual" Id="virtualscroll">
            <Description>
                Para listas muito grandes, ative <code>VirtualScroll="true"</code> e defina <code>ScrollHeight</code>
                para renderizar apenas as opções visíveis, evitando problemas de desempenho. A altura de cada item
                pode ser informada em <code>VirtualScrollItemSize</code> (padrão 38).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_virtualCity" Options="ManyCities" OptionLabel="Name" VirtualScroll="true" ScrollHeight="200px" VirtualScrollItemSize="40" Striped="true" StyleClass="w-56"/>
                </div>
                <div class="mt-2 text-sm">Selecionado: @(_virtualCity?.Name ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@VirtualScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Arrastar e Soltar" Id="drag-drop">
            <Description>
                No Optimus UI o <code>dragDrop</code> permite reordenar os itens e depende do pacote
                <code>@@angular/cdk</code>. Não há recurso equivalente portado para o Blazor — o componente não
                expõe parâmetro de arrastar e soltar. Veja em <strong>Problemas Conhecidos</strong>.
            </Description>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description>
                O estado de erro é aplicado com <code>Invalid="true"</code>, que adiciona <code>p-invalid</code> à
                raiz. Dentro de um <code>EditForm</code> o estado vem da validação e não precisa ser informado
                manualmente — use a flag apenas para erros fora do formulário.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_cityInvalid" Options="Cities" OptionLabel="Name" Invalid="true" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>
                Quando <code>Disabled</code> está ativo, o elemento não pode ser editado nem focado.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpListbox TValue="City" @bind-Value="_cityDisabled" Options="Cities" OptionLabel="Name" Disabled="true" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>
                O Listbox herda de <code>OpInputBase&lt;TValue&gt;</code>, então integra-se ao <code>EditForm</code> do
                Blazor automaticamente. O <code>@@bind-Value</code> cria o <code>ValueExpression</code> que registra o
                campo no <code>EditContext</code>; com <code>DataAnnotationsValidator</code> e
                <code>ValidationMessage</code> o estado <code>p-invalid</code> é aplicado sozinho. No Angular os
                formulários se dividem em <em>template driven</em> e <em>reactive</em>; no Blazor ambos convergem para
                o <code>EditForm</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <EditForm Model="_form" OnValidSubmit="OnValidSubmit" class="flex flex-col gap-2">
                        <DataAnnotationsValidator/>
                        <OpListbox TValue="City" @bind-Value="_form.City" Options="Cities" OptionLabel="Name" StyleClass="w-56"/>
                        <ValidationMessage For="() => _form.City"/>
                        <button type="submit" class="p-button p-component">Enviar</button>
                        @if (_submitted)
                        {
                            <div class="text-sm" style="color:var(--p-green-600)">Formulário enviado: @_form.City?.Name</div>
                        }
                    </EditForm>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O elemento de lista tem <code>role="listbox"</code> e recebe <code>aria-multiselectable="true"</code>
                    no modo múltiplo. Cada item tem <code>role="option"</code> com <code>aria-selected</code> e
                    <code>aria-disabled</code>. O texto que descreve o componente vem de <code>AriaLabel</code>;
                    use-o sempre que não houver um rótulo visível associado.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o primeiro item, ou para o primeiro selecionado se houver." },
                              new[] { "up arrow", "Move o foco para o item anterior." },
                              new[] { "down arrow", "Move o foco para o próximo item." },
                              new[] { "enter", "Alterna a seleção do item focado." },
                              new[] { "space", "Alterna a seleção do item focado." },
                              new[] { "home", "Move o foco para o primeiro item." },
                              new[] { "end", "Move o foco para o último item." },
                              new[] { "letra/dígito", "Busca o próximo item cujo rótulo começa com a tecla digitada (type-ahead)." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

