                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;object&gt;?", "null", "Coleção de itens exibidos na lista." },
                              new[] { "OptionLabel", "string?", "null", "Propriedade do item usada como rótulo. Se omitida, usa <code>ToString()</code>." },
                              new[] { "OptionValue", "string?", "null", "Propriedade usada como valor. Se omitida, o próprio item é o valor." },
                              new[] { "OptionDisabled", "string?", "null", "Propriedade booleana que desabilita opções específicas." },
                              new[] { "SelectedValues", "IReadOnlyList&lt;TValue&gt;?", "null", "Valores selecionados no modo múltiplo. Combine com <code>@bind-SelectedValues</code>." },
                              new[] { "Multiple", "bool", "false", "Permite selecionar mais de um item." },
                              new[] { "Checkbox", "bool", "false", "Seleção por checkboxes. Implica seleção múltipla." },
                              new[] { "Checkmark", "bool", "false", "Exibe um checkmark na opção selecionada." },
                              new[] { "HighlightOnSelect", "bool", "true", "Aplica o realce de fundo à opção selecionada." },
                              new[] { "Filter", "bool", "false", "Exibe um campo de filtro no cabeçalho da lista." },
                              new[] { "FilterBy", "string?", "null", "Propriedade adicional considerada no critério do filtro." },
                              new[] { "Group", "bool", "false", "Ativa o modo agrupado." },
                              new[] { "OptionGroupLabel", "string", "label", "Propriedade do rótulo do grupo." },
                              new[] { "OptionGroupChildren", "string", "items", "Propriedade que contém os itens do grupo." },
                              new[] { "ShowToggleAll", "bool", "true", "Exibe o checkbox de selecionar tudo no cabeçalho (com <code>Checkbox</code>)." },
                              new[] { "Striped", "bool", "false", "Alterna o fundo das linhas." },
                              new[] { "ScrollHeight", "string?", "14rem", "Altura máxima da lista; habilita a rolagem." },
                              new[] { "VirtualScroll", "bool", "false", "Virtualiza a lista (renderiza só o visível). Requer <code>ScrollHeight</code>." },
                              new[] { "VirtualScrollItemSize", "int", "38", "Altura (px) de cada item usada no scroll virtual." },
                              new[] { "Readonly", "bool", "false", "Impede a alteração da seleção." },
                              new[] { "Required", "bool", "false", "Sinaliza campo obrigatório; não altera o markup (a validação vem do <code>EditForm</code>)." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação do listbox." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível aplicado ao elemento com <code>role=&quot;listbox&quot;</code>." },
                              new[] { "EmptyMessage", "string?", "No results found", "Mensagem exibida quando não há opções." },
                              new[] { "EmptyFilterMessage", "string?", "No results found", "Mensagem exibida quando o filtro não retorna opções." },
                              new[] { "ListStyleClass", "string?", "null", "Classes adicionais aplicadas ao <code>&lt;ul&gt;</code> da lista." },
                              new[] { "InputId", "string?", "null", "Base do id dos elementos internos (ex.: <code>{InputId}_list</code>); gerado automaticamente se omitido." },
                              new[] { "Value", "TValue?", "null", "Valor selecionado no modo único. Combine com <code>@bind-Value</code>. (herdado)" },
                              new[] { "Invalid", "bool", "false", "Estado de erro; também recebe o estado do <code>EditContext</code>. (herdado)" },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente. (herdado)" },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz. (herdado)" },
                              new[] { "ValueExpression", "Expression&lt;Func&lt;TValue&gt;&gt;?", "null", "Expressão de binding do valor, criada por <code>@bind-Value</code>. (herdado)" },
                              new[] { "CssClass", "string?", "null", "Classes de validação do campo no <code>EditContext</code>. (herdado)" },
                              new[] { "DisplayName", "string?", "null", "Nome do campo em mensagens de validação. (herdado)" },
                              new[] { "AdditionalAttributes", "IReadOnlyDictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao contêiner raiz. (herdado)" }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TValue&gt;?", "Conteúdo customizado de cada item; o contexto é o próprio item." },
                              new[] { "GroupTemplate", "RenderFragment&lt;object&gt;?", "Conteúdo customizado do cabeçalho de cada grupo; o contexto é o grupo." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo extra no cabeçalho da lista." },
                              new[] { "FooterTemplate", "RenderFragment?", "Conteúdo no rodapé da lista." },
                              new[] { "EmptyTemplate", "RenderFragment?", "Conteúdo exibido quando não há opções." },
                              new[] { "EmptyFilterTemplate", "RenderFragment?", "Conteúdo exibido quando o filtro não retorna opções." },
                              new[] { "FilterTemplate", "RenderFragment?", "Conteúdo customizado do campo de filtro." },
                              new[] { "CheckIconTemplate", "RenderFragment&lt;bool&gt;?", "Template do ícone de checkmark; o contexto indica se a opção está selecionada." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
