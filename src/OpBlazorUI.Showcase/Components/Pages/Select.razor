@page "/select"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Select

<DocComponent Title="Select"
              Description="O Select é usado para escolher um item de uma coleção de opções.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <Description>
                O Select exibe uma lista de opções em um overlay. O item escolhido é vinculado à sua propriedade por meio de <code>@@bind-Value</code>.
            </Description>
            <ChildContent>
                <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Placeholder="Selecione uma Cidade" StyleClass="w-full"/>
                <div class="mt-2 text-sm">Selecionado: @(_city ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro + Marcação + Limpar">
            <Description>
                Combine <code>Filter</code> para exibir um campo de busca no topo do overlay, <code>Checkmark</code> para marcar a opção selecionada e <code>ShowClear</code> para exibir um botão que limpa a seleção.
            </Description>
            <ChildContent>
                <OpSelect TValue="string" @bind-Value="_city2" Options="Cities" Filter="true" Checkmark="true" ShowClear="true" Placeholder="Selecione uma Cidade" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Preenchido + Inválido">
            <Description>
                Use <code>Variant="filled"</code> para o fundo preenchido e <code>Invalid</code> para indicar estado de erro.
            </Description>
            <ChildContent>
                <OpSelect TValue="string" @bind-Value="_city3" Options="Cities" Variant="filled" Invalid="true" Placeholder="Inválido" StyleClass="w-full"/>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado / Carregando">
            <Description>
                <code>Disabled</code> impede a interação, enquanto <code>Loading</code> exibe um spinner no lugar do ícone do dropdown.
            </Description>
            <ChildContent>
                <div class="flex gap-3">
                    <OpSelect TValue="string" Options="Cities" Disabled="true" Placeholder="Desabilitado" StyleClass="w-48"/>
                    <OpSelect TValue="string" Options="Cities" Loading="true" Placeholder="Carregando..." StyleClass="w-48"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Template de Item">
            <Description>
                Use <code>ItemTemplate</code> para customizar a aparência de cada opção. O contexto do template é o próprio item (<code>TValue</code>).
            </Description>
            <ChildContent>
                <OpSelect TValue="string" @bind-Value="_city4" Options="Cities" Placeholder="Selecione uma Cidade" StyleClass="w-full">
                    <ItemTemplate Context="opt">
                        <div style="display:flex; align-items:center; gap:.5rem;">
                            <span style="color:var(--p-primary-color)">◆</span>
                            <span>@opt</span>
                        </div>
                    </ItemTemplate>
                </OpSelect>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupado">
            <Description>
                Com <code>Group="true"</code>, as opções passam a ser lidas de grupos. <code>OptionGroupLabel</code> e <code>OptionGroupChildren</code> indicam as propriedades do rótulo e da lista de itens de cada grupo.
            </Description>
            <ChildContent>
                <OpSelect TValue="string" @bind-Value="_country" Options="CountryGroups" Group="true" OptionGroupLabel="Label" OptionGroupChildren="Items" Placeholder="Selecione um País" StyleClass="w-full"/>
                <div class="mt-2 text-sm">Selecionado: @(_country ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@GroupedCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <Description>
                Parâmetros públicos do componente. A combinação de <code>Options</code>, <code>OptionLabel</code> e <code>OptionValue</code> controla como os itens são lidos e exibidos.
            </Description>
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;object&gt;?", "null", "Coleção de itens exibidos no dropdown. Aceita objetos (use <code>OptionLabel</code>/<code>OptionValue</code>) ou strings." },
                              new[] { "OptionLabel", "string?", "null", "Nome da propriedade do item usada como texto de cada opção. Se omitido, é usado o <code>ToString()</code> do item." },
                              new[] { "OptionValue", "string?", "null", "Nome da propriedade usada como valor de cada opção. Se omitido, o próprio item é usado na comparação." },
                              new[] { "OptionDisabled", "string?", "null", "Nome da propriedade booleana que desabilita opções específicas." },
                              new[] { "Value", "TValue?", "null", "Valor selecionado (modo single). Combine com <code>@bind-Value</code> para binding bidirecional." },
                              new[] { "ValueChanged", "EventCallback&lt;TValue?&gt;", "-", "Callback de binding do valor selecionado." },
                              new[] { "Placeholder", "string?", "null", "Texto exibido quando nenhum item está selecionado." },
                              new[] { "Filter", "bool", "false", "Quando <code>true</code>, mostra um campo de busca no overlay para filtrar as opções conforme você digita." },
                              new[] { "FilterBy", "string?", "null", "Propriedade do item usada como critério do filtro. Se omitido, usa o mesmo campo do rótulo." },
                              new[] { "Checkmark", "bool", "false", "Exibe um ícone de check ao lado da opção selecionada." },
                              new[] { "ShowClear", "bool", "false", "Exibe um ícone para limpar a seleção, restaurando o valor padrão." },
                              new[] { "Editable", "bool", "false", "Permite digitar livremente no campo, além de selecionar uma opção." },
                              new[] { "Readonly", "bool", "false", "Impede edição mas mantém a interação com o overlay." },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente, impedindo foco e seleção." },
                              new[] { "Invalid", "bool", "false", "Aplica o estilo de erro (borda de cor de erro)." },
                              new[] { "Required", "bool", "false", "Marca o campo como obrigatório para validação e acessibilidade." },
                              new[] { "Group", "bool", "false", "Ativa o modo agrupado; as opções passam a vir de grupos." },
                              new[] { "OptionGroupLabel", "string", "label", "Propriedade do grupo usada como rótulo da categoria." },
                              new[] { "OptionGroupChildren", "string", "items", "Propriedade do grupo que contém a lista de itens." },
                              new[] { "Variant", "string", "outlined", "<code>outlined</code> (com borda) ou <code>filled</code> (fundo preenchido)." },
                              new[] { "Size", "string?", "null", "<code>small</code> ou <code>large</code>; por padrão usa o tamanho normal." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura disponível do contêiner." },
                              new[] { "ScrollHeight", "string?", "null", "Altura máxima (px) da lista de opções, com rolagem." },
                              new[] { "VirtualScroll", "bool", "false", "Virtualiza a lista de opções. Requer <code>ScrollHeight</code>." },
                              new[] { "VirtualScrollItemSize", "int", "38", "Altura (px) de cada opção no virtual scroll (incluindo o gap)." },
                              new[] { "Loading", "bool", "false", "Exibe um spinner no lugar do ícone do dropdown." },
                              new[] { "DropdownIcon", "string?", "null", "Classe do ícone do dropdown (ex.: <code>pi pi-chevron-down</code>)." },
                              new[] { "EmptyMessage", "string", "No results found", "Mensagem exibida quando a lista de opções está vazia." },
                              new[] { "EmptyFilterMessage", "string", "No results found", "Mensagem exibida quando o filtro não encontra nenhuma opção." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação do elemento." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo de acessibilidade do combobox." },
                              new[] { "InputId", "string?", "null", "Id do elemento interno (para associação com <code>&lt;label for&gt;</code>)." },
                              new[] { "ShowOnFocus", "bool", "true", "Quando <code>true</code> (padrão), abre o overlay ao focar o campo." },
                              new[] { "PanelStyleClass", "string?", "null", "Classes aplicadas ao painel do overlay." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais aplicadas ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <Description>
                Callbacks disparados em interações do usuário ou mudanças de estado do componente.
            </Description>
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;TValue?&gt;", "Disparado quando o valor selecionado muda." },
                              new[] { "OnFilter", "EventCallback&lt;string&gt;", "Disparado a cada alteração do texto do filtro." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar o componente." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar o componente." },
                              new[] { "OnClick", "EventCallback&lt;MouseEventArgs&gt;", "Disparado ao clicar no componente." },
                              new[] { "OnShow", "EventCallback", "Disparado ao abrir o overlay." },
                              new[] { "OnHide", "EventCallback", "Disparado ao fechar o overlay." },
                              new[] { "OnClear", "EventCallback", "Disparado quando a seleção é limpa pelo botão de clear." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <Description>
                Slots que substituem partes internas do componente por conteúdo customizado.
            </Description>
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TValue&gt;?", "Customiza o conteúdo de cada opção da lista." },
                              new[] { "SelectedItemTemplate", "RenderFragment&lt;TValue&gt;?", "Customiza o conteúdo do item selecionado exibido no campo." },
                              new[] { "GroupTemplate", "RenderFragment&lt;object&gt;?", "Customiza o rótulo de cada grupo." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo extra no topo do overlay." },
                              new[] { "FooterTemplate", "RenderFragment?", "Conteúdo extra no rodapé do overlay." },
                              new[] { "EmptyTemplate", "RenderFragment?", "Customiza a mensagem quando não há opções." },
                              new[] { "EmptyFilterTemplate", "RenderFragment?", "Customiza a mensagem quando o filtro não encontra opções." },
                              new[] { "DropdownIconTemplate", "RenderFragment?", "Substitui o ícone do dropdown." },
                              new[] { "LoadingIconTemplate", "RenderFragment?", "Substitui o ícone de carregamento." },
                              new[] { "ClearIconTemplate", "RenderFragment?", "Substitui o ícone de limpar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <Description>
                Classes CSS e design tokens (<code>--p-select-*</code>) usados pelo componente. Os valores dos tokens podem ser sobrescritos via CSS para customizar a aparência.
            </Description>
            <ChildContent><DocTokens Component="select"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code>, <code>PanelStyleClass</code> e os templates para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string? _city;
    private string? _city2;
    private string? _city3;
    private string? _city4;
    private string? _country;

    private static readonly List<string> Cities = new() { "Nova York", "Roma", "Londres", "Istambul", "Paris", "Barcelona", "Berlim" };

    private sealed class CountryGroup
    {
        public string Label { get; set; } = "";
        public List<string> Items { get; set; } = new();
    }

    private static readonly List<CountryGroup> CountryGroups = new()
    {
        new() { Label = "Alemanha", Items = new() { "Berlim", "Frankfurt", "Hamburgo" } },
        new() { Label = "EUA", Items = new() { "Chicago", "Los Angeles", "Nova York" } },
        new() { Label = "Japão", Items = new() { "Quioto", "Osaka", "Tóquio" } }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Select

        <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Placeholder="Selecione uma Cidade" />
        """;

    private const string BasicCode = """
        <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Placeholder="Selecione uma Cidade" StyleClass="w-full" />

        @code {
            private string? _city;
            private static readonly List<string> Cities = new() { "Nova York", "Roma", "Londres", "Istambul", "Paris" };
        }
        """;

    private const string FilterCode = """
        <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Filter="true" Checkmark="true" ShowClear="true" Placeholder="Selecione uma Cidade" />
        """;

    private const string FilledCode = """
        <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Variant="filled" Invalid="true" Placeholder="Inválido" />
        """;

    private const string DisabledCode = """
        <OpSelect TValue="string" Options="Cities" Disabled="true" Placeholder="Desabilitado" />
        <OpSelect TValue="string" Options="Cities" Loading="true" Placeholder="Carregando..." />
        """;

    private const string TemplateCode = """
        <OpSelect TValue="string" @bind-Value="_city" Options="Cities" Placeholder="Selecione uma Cidade">
            <ItemTemplate Context="opt">
                <div style="display:flex; align-items:center; gap:.5rem;">
                    <span style="color:var(--p-primary-color)">◆</span>
                    <span>@opt</span>
                </div>
            </ItemTemplate>
        </OpSelect>
        """;

    private const string GroupedCode = """
        <OpSelect TValue="string" @bind-Value="_country" Options="CountryGroups" Group="true"
                  OptionGroupLabel="Label" OptionGroupChildren="Items" Placeholder="Selecione um País" />

        @code {
            private string? _country;

            private sealed class CountryGroup
            {
                public string Label { get; set; } = "";
                public List<string> Items { get; set; } = new();
            }
        }
        """;
}
