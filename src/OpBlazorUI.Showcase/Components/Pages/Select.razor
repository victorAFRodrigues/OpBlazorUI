@page "/select"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Select
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.IftaLabel
@using System.ComponentModel.DataAnnotations

<PageTitle>Select - OpBlazorUI</PageTitle>

<DocComponent Title="Select"
              Description="O Select é usado para escolher um item de uma coleção de opções.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O Select é usado como um componente controlado com <code>@@bind-Value</code> e uma coleção
                <code>Options</code>. O rótulo e o valor de cada opção são definidos por <code>OptionLabel</code> e
                <code>OptionValue</code>. Quando as opções são valores primitivos (como um array de strings), não é
                necessário informar <code>OptionLabel</code> nem <code>OptionValue</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpSelect TValue="City" @bind-Value="_city" Options="Cities" OptionLabel="Name" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <span class="text-sm">Selecionado: <b>@(_city?.Name ?? "—")</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Checkmark" Id="checkmark">
            <Description>
                Uma forma alternativa de destacar a opção selecionada é exibir um check em vez de preencher o item.
                Combine com <code>ShowClear</code> para permitir limpar a seleção.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_checkCity" Options="Cities" OptionLabel="Name" Checkmark="true" ShowClear="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckmarkCode"/></Code>
        </DocSection>

        <DocSection Label="Editável" Id="editable">
            <Description>
                Com <code>Editable="true"</code> o campo vira um <code>&lt;input&gt;</code> e permite digitar. No
                Blazor, porém, o texto livre ainda não é capturado nem sincronizado com <code>Value</code>; a seleção
                continua sendo feita pela lista (veja Problemas Conhecidos).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_editableCity" Options="Cities" OptionLabel="Name" Editable="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@EditableCode"/></Code>
        </DocSection>

        <DocSection Label="Grupo" Id="group">
            <Description>
                As opções podem ser agrupadas quando a coleção contém estruturas aninhadas. Defina
                <code>Group="true"</code> e indique em <code>OptionGroupLabel</code> e <code>OptionGroupChildren</code>
                as propriedades do grupo que guardam o rótulo e a lista de itens. O <code>GroupTemplate</code> permite
                customizar a linha do grupo.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpSelect TValue="City" @bind-Value="_groupCity" Options="CountryGroups" Group="true"
                              OptionGroupLabel="Label" OptionGroupChildren="Items" OptionLabel="Name" OptionValue="Code"
                              Placeholder="Selecione uma Cidade" StyleClass="w-56">
                        <GroupTemplate Context="group">
                            <span class="p-select-option-group-label">@(((CountryGroup)group).Label)</span>
                        </GroupTemplate>
                    </OpSelect>
                    <span class="text-sm">Selecionado: <b>@(_groupCity?.Name ?? "—")</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@GroupCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                Tanto a opção selecionada quanto os itens da lista podem ser customizados. Use
                <code>SelectedItemTemplate</code> para o rótulo exibido no campo e <code>ItemTemplate</code> para o
                conteúdo de cada item do painel. Quando o agrupamento está ativo, o <code>GroupTemplate</code> está
                disponível para as linhas de grupo. Todos os templates recebem a instância da opção (<code>TValue</code>)
                como contexto. Também há <code>HeaderTemplate</code>, <code>FooterTemplate</code> e
                <code>DropdownIconTemplate</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_templateCity" Options="Countries" OptionLabel="Name" Placeholder="Selecione um País" StyleClass="w-56">
                        <SelectedItemTemplate Context="selected">
                            <div class="flex items-center gap-2">
                                <span style="width:.75rem;height:.75rem;border-radius:50%;background:var(--p-primary-color);"></span>
                                <span>@selected.Name</span>
                            </div>
                        </SelectedItemTemplate>
                        <ItemTemplate Context="country">
                            <div class="flex items-center gap-2">
                                <span style="width:.75rem;height:.75rem;border-radius:50%;background:var(--p-primary-color);"></span>
                                <span>@country.Name</span>
                            </div>
                        </ItemTemplate>
                        <DropdownIconTemplate>
                            <span class="p-select-dropdown-icon pi pi-map"></span>
                        </DropdownIconTemplate>
                        <HeaderTemplate>
                            <div style="padding:.5rem .75rem; font-weight:600;">Países Disponíveis</div>
                        </HeaderTemplate>
                        <FooterTemplate>
                            <div style="padding:.5rem .75rem;">
                                <button type="button" class="p-button p-component p-button-secondary" style="width:100%;">
                                    <span class="p-button-icon p-button-icon-left pi pi-plus"></span>
                                    <span class="p-button-label">Adicionar Novo</span>
                                </button>
                            </div>
                        </FooterTemplate>
                    </OpSelect>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description>
                O Select oferece filtragem embutida, habilitada com <code>Filter="true"</code>. O campo de busca
                processa o rótulo (ou a propriedade indicada em <code>FilterBy</code>) conforme o usuário digita.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_filterCity" Options="Countries" OptionLabel="Name" Filter="true" FilterBy="Name" ShowClear="true" Placeholder="Selecione um País" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Loading State" Id="loadingstate">
            <Description>
                O estado de carregamento é controlado pela propriedade <code>Loading</code>, que troca o ícone do
                dropdown por um spinner.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" Options="Cities" OptionLabel="Name" Loading="true" Placeholder="Carregando..." StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingStateCode"/></Code>
        </DocSection>

        <DocSection Label="Virtual Scroll" Id="virtualscroll">
            <Description>
                O virtual scroll renderiza apenas um pequeno subconjunto de itens no viewport de cada vez — indicado
                para listas muito grandes. Basta definir <code>VirtualScroll="true"</code> e o tamanho de cada item em
                <code>VirtualScrollItemSize</code> (padrão <code>38</code>).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="string" @bind-Value="_virtualItem" Options="_virtualItems" Placeholder="Selecione um Item" VirtualScroll="true" VirtualScrollItemSize="38" ScrollHeight="200px" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VirtualScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Lazy Virtual Scroll" Id="lazyvirtualscroll">
            <Description>
                No upstream, o <i>Lazy Virtual Scroll</i> usa <code>virtualScrollOptions</code> com
                <code>onLazyLoad</code> para carregar blocos sob demanda. O <code>OpSelect</code> não expõe esse
                callback, então aqui o carregamento é simulado reativamente com <code>OnFilter</code>: a cada consulta
                o componente troca <code>Options</code> por uma página de resultados, exibindo <code>Loading</code>
                durante a busca.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpSelect TValue="string" @bind-Value="_lazyItem" Options="_lazyItems" Filter="true" Loading="_lazyLoading"
                              VirtualScroll="true" ScrollHeight="200px" OnFilter="OnLazyFilter"
                              Placeholder="Digite para buscar" StyleClass="w-56"/>
                    <small>@_lazyItems.Length itens carregados</small>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LazyVirtualScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Filled" Id="filled">
            <Description>
                Defina <code>Variant="filled"</code> para exibir o componente com ênfase visual maior que o estilo
                <code>outlined</code> padrão.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_filledCity" Options="Cities" OptionLabel="Name" Variant="filled" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Float Label" Id="floatlabel">
            <Description>
                O rótulo flutuante aparece sobre o campo quando ele está focado ou preenchido. Use
                <code>OpFloatLabel</code> com <code>Variant</code> <code>over</code> (padrão), <code>in</code> e
                <code>on</code>; o <code>for</code> do <code>&lt;label&gt;</code> aponta para o <code>InputId</code> do
                Select.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <OpFloatLabel StyleClass="w-56">
                        <OpSelect TValue="City" @bind-Value="_fl1" InputId="over_label" Options="Cities" OptionLabel="Name" StyleClass="w-full"/>
                        <label for="over_label">Over Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="in" StyleClass="w-56">
                        <OpSelect TValue="City" @bind-Value="_fl2" InputId="in_label" Options="Cities" OptionLabel="Name" Variant="filled" StyleClass="w-full"/>
                        <label for="in_label">In Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="on" StyleClass="w-56">
                        <OpSelect TValue="City" @bind-Value="_fl3" InputId="on_label" Options="Cities" OptionLabel="Name" StyleClass="w-full"/>
                        <label for="on_label">On Label</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FloatLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Ifta Label" Id="iftalabel">
            <Description>
                O <code>OpIftaLabel</code> cria rótulos alinhados ao topo, dentro do campo; associe o
                <code>&lt;label&gt;</code> ao <code>InputId</code> do Select.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpIftaLabel StyleClass="w-56">
                        <OpSelect TValue="City" @bind-Value="_iftaCity" InputId="dd-city" Options="Cities" OptionLabel="Name" StyleClass="w-full"/>
                        <label for="dd-city">Cidade</label>
                    </OpIftaLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@IftaLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Clear Icon" Id="clearicon">
            <Description>
                Quando <code>ShowClear="true"</code> e há uma seleção, um ícone é exibido para limpar o valor. O evento
                <code>OnClear</code> é disparado nesse momento.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_clearCity" Options="Cities" OptionLabel="Name" ShowClear="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ClearIconCode"/></Code>
        </DocSection>

        <DocSection Label="Sizes" Id="sizes">
            <Description>
                O Select oferece os tamanhos <code>small</code> e <code>large</code> como alternativas ao padrão.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <OpSelect TValue="City" @bind-Value="_size1" Options="Cities" OptionLabel="Name" Size="small" Placeholder="Small" StyleClass="w-56"/>
                    <OpSelect TValue="City" @bind-Value="_size2" Options="Cities" OptionLabel="Name" Placeholder="Normal" StyleClass="w-56"/>
                    <OpSelect TValue="City" @bind-Value="_size3" Options="Cities" OptionLabel="Name" Size="large" Placeholder="Large" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizesCode"/></Code>
        </DocSection>

        <DocSection Label="Fluid" Id="fluid">
            <Description>
                Com <code>Fluid="true"</code> o componente ocupa toda a largura do contêiner.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width: 100%; max-width: 20rem;">
                        <OpSelect TValue="City" @bind-Value="_fluidCity" Options="Cities" OptionLabel="Name" Fluid="true" Placeholder="Selecione uma Cidade"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FluidCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>
                Quando <code>Disabled="true"</code>, o elemento não pode ser editado nem receber foco.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpSelect TValue="City" @bind-Value="_disabledCity" Options="Cities" OptionLabel="Name" Disabled="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description>
                O estado inválido é aplicado com <code>Invalid="true"</code> para indicar falha de validação — também
                é ativado automaticamente pelo <code>EditForm</code> quando o campo tem erro.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-4">
                    <OpSelect TValue="City" @bind-Value="_invalid1" Options="Cities" OptionLabel="Name" Invalid="true" ShowClear="true" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <OpSelect TValue="City" @bind-Value="_invalid2" Options="Cities" OptionLabel="Name" Invalid="true" ShowClear="true" Variant="filled" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>
                O <code>OpSelect&lt;TValue&gt;</code> herda de <code>OpInputBase&lt;TValue&gt;</code> (que por sua vez
                deriva de <code>InputBase</code>), portanto integra-se ao <code>EditForm</code> com
                <code>DataAnnotationsValidator</code>, e o estado inválido aparece automaticamente com
                <code>ValidationMessage</code>. Isso substitui as abordagens <i>Template Driven</i> e
                <i>Reactive Forms</i> do Angular.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <EditForm Model="_form" OnValidSubmit="OnSubmit" class="flex flex-col gap-4" style="width: 100%; max-width: 16rem;">
                        <DataAnnotationsValidator/>
                        <div class="flex flex-col gap-1">
                            <OpSelect TValue="City" @bind-Value="_form.City" Options="Cities" OptionLabel="Name" Placeholder="Selecione uma Cidade" StyleClass="w-full"/>
                            <ValidationMessage For="() => _form.City"/>
                        </div>
                        <button type="submit" class="p-button p-component p-button-secondary">Enviar</button>
                        @if (_submitted)
                        {
                            <div class="text-sm" style="color: var(--p-green-600)">Cidade: @_form.City?.Name</div>
                        }
                    </EditForm>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Vínculo" Id="binding">
            <Description>
                O vínculo bidirecional é feito com <code>@@bind-Value</code> (<code>Value</code> /
                <code>ValueChanged</code>). O evento <code>OnChange</code> recebe o valor selecionado
                (<code>TValue?</code>) e permite reagir à escolha.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpSelect TValue="City" @bind-Value="_boundCity" Options="Cities" OptionLabel="Name" OnChange="() => _changes++" Placeholder="Selecione uma Cidade" StyleClass="w-56"/>
                    <span class="text-sm">Selecionado: <b>@(_boundCity?.Name ?? "—")</b> — mudanças: <b>@_changes</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BindingCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O valor que descreve o componente pode vir de <code>AriaLabel</code> ou de um
                    <code>&lt;label&gt;</code> externo associado ao <code>InputId</code>. O elemento do campo tem role
                    <code>combobox</code> com <code>aria-haspopup</code> e <code>aria-expanded</code>. A relação entre
                    o combobox e o popup é feita com <code>aria-controls</code>, e <code>aria-activedescendant</code>
                    instrui o leitor de tela sobre qual opção ler durante a navegação por teclado.
                </p>
                <p>
                    A lista do popup usa role <code>listbox</code>. Cada item tem role <code>option</code>, um
                    <code>id</code> que corresponde ao <code>aria-activedescendant</code>, além de
                    <code>aria-label</code>, <code>aria-selected</code> e <code>aria-disabled</code>. O campo de filtro,
                    quando habilitado, usa role <code>searchbox</code>.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o elemento select." },
                              new[] { "space", "Abre o popup e move o foco visual para a opção selecionada; se não houver, a primeira opção recebe o foco." },
                              new[] { "down arrow", "Abre o popup e move o foco visual para a opção selecionada; se não houver, a primeira opção recebe o foco." },
                              new[] { "up arrow", "Abre o popup e move o foco visual para a opção selecionada; se não houver, a última opção recebe o foco." }
                          })"/>
                <div class="doc-section-description"><h3>Suporte de teclado no popup</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o próximo elemento focável do popup; se não houver, o primeiro recebe o foco." },
                              new[] { "shift + tab", "Move o foco para o elemento focável anterior do popup; se não houver, o último recebe o foco." },
                              new[] { "enter", "Seleciona a opção em foco e fecha o popup." },
                              new[] { "space", "Seleciona a opção em foco e fecha o popup." },
                              new[] { "escape", "Fecha o popup e move o foco para o elemento select." },
                              new[] { "down arrow", "Move o foco para a próxima opção; se não houver, o foco visual não muda." },
                              new[] { "up arrow", "Move o foco para a opção anterior; se não houver, o foco visual não muda." },
                              new[] { "right arrow", "Se o select for editável, remove o foco visual da opção atual e move o cursor uma posição à esquerda." },
                              new[] { "left arrow", "Se o select for editável, remove o foco visual da opção atual e move o cursor uma posição à direita." },
                              new[] { "home", "Se o select for editável, move o cursor para o fim; caso contrário, move o foco para a primeira opção." },
                              new[] { "end", "Se o select for editável, move o cursor para o início; caso contrário, move o foco para a última opção." },
                              new[] { "any printable character", "Move o foco para a opção cujo rótulo começa com os caracteres digitados, quando o select não é editável." }
                          })"/>
                <div class="doc-section-description"><h3>Suporte de teclado no campo de filtro</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "enter", "Fecha o popup e move o foco para o elemento select." },
                              new[] { "escape", "Fecha o popup e move o foco para o elemento select." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;object&gt;?", "null", "Coleção de opções exibidas no dropdown." },
                              new[] { "OptionLabel", "string?", "null", "Nome da propriedade usada como rótulo de cada opção; se omitido, usa o <code>ToString()</code> do item." },
                              new[] { "OptionValue", "string?", "null", "Nome da propriedade usada como valor da opção; se omitido, o próprio item é o valor." },
                              new[] { "OptionDisabled", "string?", "null", "Nome da propriedade booleana que desabilita opções específicas." },
                              new[] { "Value", "TValue?", "null", "Valor selecionado; combine com <code>@bind-Value</code> para vínculo bidirecional." },
                              new[] { "Placeholder", "string?", "null", "Texto exibido quando nada está selecionado." },
                              new[] { "Filter", "bool", "false", "Exibe um campo de busca no overlay para filtrar as opções." },
                              new[] { "FilterBy", "string?", "null", "Propriedade do item usada como critério do filtro; se omitida, usa o rótulo." },
                              new[] { "Checkmark", "bool", "false", "Exibe um ícone de check ao lado da opção selecionada." },
                              new[] { "ShowClear", "bool", "false", "Exibe um ícone para limpar a seleção." },
                              new[] { "Editable", "bool", "false", "Renderiza o campo como <code>&lt;input&gt;</code> para digitação livre." },
                              new[] { "Readonly", "bool", "false", "Somente leitura; impede a abertura do overlay." },
                              new[] { "Required", "bool", "false", "Marca o campo como obrigatório para validação e acessibilidade." },
                              new[] { "Group", "bool", "false", "Ativa o modo agrupado; as opções passam a vir de grupos." },
                              new[] { "OptionGroupLabel", "string", "label", "Propriedade do grupo usada como rótulo da categoria." },
                              new[] { "OptionGroupChildren", "string", "items", "Propriedade do grupo que contém a lista de itens." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura disponível do contêiner." },
                              new[] { "ScrollHeight", "string?", "200px", "Altura máxima da lista de opções, com rolagem." },
                              new[] { "VirtualScroll", "bool", "false", "Virtualiza a lista de opções. Requer <code>ScrollHeight</code>." },
                              new[] { "VirtualScrollItemSize", "int", "38", "Altura (px) de cada item no virtual scroll (incluindo o gap)." },
                              new[] { "Loading", "bool", "false", "Exibe um spinner no lugar do ícone do dropdown." },
                              new[] { "DropdownIcon", "string?", "null", "Classe do ícone do dropdown (ex.: <code>pi pi-chevron-down</code>)." },
                              new[] { "EmptyMessage", "string?", "No results found", "Mensagem exibida quando a lista está vazia." },
                              new[] { "EmptyFilterMessage", "string?", "No results found", "Mensagem exibida quando o filtro não encontra opções." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação do elemento." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo de acessibilidade do combobox." },
                              new[] { "InputId", "string?", "null", "Id do elemento interno (para associação com <code>&lt;label for&gt;</code>)." },
                              new[] { "ShowOnFocus", "bool", "true", "Abre o overlay ao focar o campo." },
