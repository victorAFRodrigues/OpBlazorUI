@page "/colorpicker"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.ColorPicker
@using System.ComponentModel.DataAnnotations

<PageTitle>ColorPicker - OpBlazorUI</PageTitle>

<DocComponent Title="ColorPicker"
              Description="O ColorPicker é um campo de entrada para selecionar uma cor, com formatos hex, rgb e hsb.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Clique na prévia para abrir o painel de seleção de cor.</Description>
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpColorPicker @bind-Value="_basic"/>
                    <span class="text-sm">Valor: <b>@_basic</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Inline" Id="inline">
            <Description>Com <code>Inline="true"</code>, o painel é exibido sempre, sem overlay.</Description>
            <ChildContent>
                <OpColorPicker @bind-Value="_inline" Inline="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@InlineCode"/></Code>
        </DocSection>

        <DocSection Label="Formato" Id="format">
            <Description>
                O parâmetro <code>Format</code> define a representação do valor: <code>hex</code>, <code>rgb</code>
                ou <code>hsb</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap gap-6">
                    <div class="flex flex-col gap-2">
                        <span>hex</span>
                        <OpColorPicker @bind-Value="_hex" Format="hex"/>
                        <span class="text-sm"><b>@_hex</b></span>
                    </div>
                    <div class="flex flex-col gap-2">
                        <span>rgb</span>
                        <OpColorPicker @bind-Value="_rgb" Format="rgb"/>
                        <span class="text-sm"><b>@_rgb</b></span>
                    </div>
                    <div class="flex flex-col gap-2">
                        <span>hsb</span>
                        <OpColorPicker @bind-Value="_hsb" Format="hsb"/>
                        <span class="text-sm"><b>@_hsb</b></span>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FormatCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>Integra-se ao <code>EditForm</code> herdando de <code>OpInputBase&lt;TValue&gt;</code>.</Description>
            <ChildContent>
                <EditForm Model="_form" OnValidSubmit="SubmitForm" class="flex flex-col gap-2">
                    <DataAnnotationsValidator/>
                    <OpColorPicker @bind-Value="_form.Color" Inline="true"/>
                    <ValidationMessage For="() => _form.Color"/>
                    <button type="submit" class="p-button p-component" style="width: fit-content;">Enviar</button>
                    @if (_submitted)
                    {
                        <span class="text-sm">Enviado: <b>@_form.Color</b></span>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>Com <code>Disabled</code>, o seletor não responde a interações.</Description>
            <ChildContent>
                <OpColorPicker Disabled="true" Inline="true" Value="#3b82f6"/>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    A prévia é um <code>input</code> somente leitura com <code>aria-label</code>. Ele pode ser
                    focado e aberto com <code>space</code> ou <code>enter</code>.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para a prévia." },
                              new[] { "space / enter", "Abre ou fecha o painel." },
                              new[] { "escape", "Fecha o painel." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value / ValueChanged", "string?", "null", "Valor (usar com <code>@@bind-Value</code>)." },
                              new[] { "Format", "string", "hex", "Representação do valor: <code>hex</code>, <code>rgb</code> ou <code>hsb</code>." },
                              new[] { "Inline", "bool", "false", "Exibe o painel embutido, sem overlay." },
                              new[] { "Disabled", "bool", "false", "Desabilita o seletor." },
                              new[] { "TabIndex / InputId / AriaLabel", "—", "—", "Acessibilidade e ordem de foco." },
                              new[] { "DefaultColor", "string", "ff0000", "Cor usada quando não há valor." },
                              new[] { "OnChange / OnShow / OnHide", "EventCallback", "—", "Notificações de mudança e do overlay." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="colorpicker"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>No Angular o formato <code>rgb</code>/<code>hsb</code> retorna objetos; no Blazor o <code>Value</code> é sempre <code>string</code> (<code>#rrggbb</code>, <code>rgb(r, g, b)</code> ou <code>hsb(h, s%, b%)</code>).</li>
                        <li>O painel é posicionado logo abaixo da prévia por estilo inline (o tema usa <code>top:0</code>, que seria sobreposto).</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string? _basic = "#ff0000";
    private string? _inline = "#3b82f6";
    private string? _hex = "#22c55e";
    private string? _rgb = "#f97316";
    private string? _hsb = "#8b5cf6";
    private bool _submitted;
    private FormModel _form = new();

    private void SubmitForm() => _submitted = true;

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Escolha uma cor.")]
        public string? Color { get; set; } = "#3b82f6";
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.ColorPicker

        <OpColorPicker @bind-Value="_color" />

        @code {
            private string? _color = "#ff0000";
        }
        """;

    private const string BasicCode = """
        <OpColorPicker @bind-Value="_color" />

        <span>Valor: @_color</span>
        """;

    private const string InlineCode = """
        <OpColorPicker @bind-Value="_color" Inline="true" />
        """;

    private const string FormatCode = """
        <OpColorPicker @bind-Value="_hex" Format="hex" />
        <OpColorPicker @bind-Value="_rgb" Format="rgb" />
        <OpColorPicker @bind-Value="_hsb" Format="hsb" />
        """;

    private const string FormsCode = """
        <EditForm Model="_form" OnValidSubmit="SubmitForm">
            <DataAnnotationsValidator />
            <OpColorPicker @bind-Value="_form.Color" Inline="true" />
            <ValidationMessage For="() => _form.Color" />
            <button type="submit" class="p-button p-component">Enviar</button>
        </EditForm>
        """;

    private const string DisabledCode = """
        <OpColorPicker Disabled="true" Inline="true" Value="#3b82f6" />
        """;
}
