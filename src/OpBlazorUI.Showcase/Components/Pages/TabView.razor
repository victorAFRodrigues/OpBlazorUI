@page "/tabview"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>TabView - OpBlazorUI</PageTitle>

<DocComponent Title="TabView"
              Description="Componente legado que agrupa conteúdo em abas. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>TabView é definido com o componente <code>TabView</code> contendo um ou mais <code>TabPanel</code>, cada um com sua propriedade <code>header</code>.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Rolável" Id="scrollable">
            <Description><p>Adicionar a propriedade <code>scrollable</code> exibe botões de navegação em cada lado para rolar entre as abas.</p></Description>
            <Code><CodeBlock Code="@ScrollableCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Dinâmico" Id="dynamic">
            <Description><p>Os painéis podem ser gerados dinamicamente usando o bloco padrão <code>&#64;for</code>.</p></Description>
            <Code><CodeBlock Code="@DynamicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description><p>Habilitar a propriedade <code>disabled</code> de um TabPanel impede a interação do usuário.</p></Description>
            <Code><CodeBlock Code="@DisabledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Controlado" Id="controlled">
            <Description><p>As abas podem ser controladas programaticamente usando a propriedade <code>activeIndex</code> como modelo.</p></Description>
            <Code><CodeBlock Code="@ControlledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O contêiner de TabView é definido com o papel <code>tablist</code>; cada cabeçalho de aba tem o papel <code>tab</code>, junto com os atributos <code>aria-selected</code> e <code>aria-controls</code>. O conteúdo de cada aba tem o papel <code>tabpanel</code> e é associado ao cabeçalho por <code>aria-labelledby</code>.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco pelos cabeçalhos." },
                              new[] { "enter", "Ativa o cabeçalho de aba em foco." },
                              new[] { "space", "Ativa o cabeçalho de aba em foco." },
                              new[] { "right arrow", "Move o foco para o próximo cabeçalho." },
                              new[] { "left arrow", "Move o foco para o cabeçalho anterior." },
                              new[] { "home", "Move o foco para o último cabeçalho." },
                              new[] { "end", "Move o foco para o primeiro cabeçalho." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { TabViewModule } from 'primeng/tabview';
        """;

    private const string BasicCode = """
        <p-tabView>
            <p-tabPanel header="Header I">
                <p class="m-0">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et
                    dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex
                    ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat
                    nulla pariatur.
                </p>
            </p-tabPanel>
            <p-tabPanel header="Header II">
                <p class="m-0">
                    Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem
                    aperiam, eaque ipsa quae ab illo inventore veritatis et quasi architecto beatae vitae dicta sunt explicabo.
                    Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut fugit.
                </p>
            </p-tabPanel>
            <p-tabPanel header="Header III">
                <p class="m-0">
                    At vero eos et accusamus et iusto odio dignissimos ducimus qui blanditiis praesentium voluptatum deleniti
                    atque corrupti quos dolores et quas molestias excepturi sint occaecati cupiditate non provident.
                </p>
            </p-tabPanel>
        </p-tabView>
        """;

    private const string ScrollableCode = """
        <p-tabView scrollable>
            <p-tabPanel header="Header I">
                Content I
            </p-tabPanel>
            <p-tabPanel header="Header II">
                Content II
            </p-tabPanel>
            <p-tabPanel header="Header III">
                Content III
            </p-tabPanel>
            <p-tabPanel header="Header IV">
                Content IV
            </p-tabPanel>
            <p-tabPanel header="Header V">
                Content V
            </p-tabPanel>
        </p-tabView>
        """;

    private const string DynamicCode = """
        <p-tabView>
            @for (tab of tabs; track tab.title) {
                <p-tabPanel [header]="tab.title">
                    <p class="m-0">{{ tab.content }}</p>
                </p-tabPanel>
            }
        </p-tabView>
        """;

    private const string DisabledCode = """
        <p-tabView>
            <p-tabPanel header="Header I">
                Content I
            </p-tabPanel>
            <p-tabPanel header="Header II">
                Content II
            </p-tabPanel>
            <p-tabPanel header="Header III" [disabled]="true">
                Content III
            </p-tabPanel>
        </p-tabView>
        """;

    private const string ControlledCode = """
        <div class="flex mb-2 gap-2 justify-end">
            <p-button (onClick)="activeIndex = 0" rounded="true" styleClass="w-8 h-8 p-0" [outlined]="activeIndex !== 0" label="1" />
            <p-button (onClick)="activeIndex = 1" rounded="true" styleClass="w-8 h-8 p-0" [outlined]="activeIndex !== 1" label="2" />
            <p-button (onClick)="activeIndex = 2" rounded="true" styleClass="w-8 h-8 p-0" [outlined]="activeIndex !== 2" label="3" />
        </div>
        <p-tabView [(activeIndex)]="activeIndex">
            <p-tabPanel header="Header I">
                Content I
            </p-tabPanel>
            <p-tabPanel header="Header II">
                Content II
            </p-tabPanel>
            <p-tabPanel header="Header III">
                Content III
            </p-tabPanel>
        </p-tabView>
        """;
}
