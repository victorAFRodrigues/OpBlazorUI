@page "/tabview"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Tabs

<PageTitle>TabView - OpBlazorUI</PageTitle>

<DocComponent Title="TabView"
              Description="O TabView exibe abas com conteúdo, no estilo do componente legado do PrimeNG.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>Reutiliza os painéis <code>OpTabPanel</code> com o visual <code>p-tabview</code>.</Description>
            <ChildContent>
                <OpTabView @bind-ActiveIndex="_active">
                    <OpTabPanel Header="Cabeçalho 1">
                        <p class="m-0">Conteúdo da primeira aba.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 2">
                        <p class="m-0">Conteúdo da segunda aba.</p>
                    </OpTabPanel>
                    <OpTabPanel Header="Cabeçalho 3">
                        <p class="m-0">Conteúdo da terceira aba.</p>
                    </OpTabPanel>
                </OpTabView>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Rolável" Id="scrollable">
            <Description>Com <code>Scrollable</code>, botões permitem rolar o cabeçalho de abas.</Description>
            <ChildContent>
                <div style="max-width: 32rem;">
                    <OpTabView Scrollable="true">
                        @for (var i = 1; i <= 10; i++)
                        {
                            var n = i;
                            <OpTabPanel Header="@($"Cabeçalho {n}")">
                                <p class="m-0">Conteúdo da aba @n.</p>
                            </OpTabPanel>
                        }
                    </OpTabView>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ScrollableCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Cada cabeçalho usa <code>role="tab"</code> e os painéis usam <code>role="tabpanel"</code>.</p>
                <h3>Suporte a teclado</h3>
                <p><code>enter</code>/<code>space</code> ativam a aba; <code>left</code>/<code>right</code> navegam entre as abas.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ActiveIndex", "int", "0", "Índice da aba ativa (usar <code>@@bind-ActiveIndex</code>)." },
                              new[] { "Scrollable", "bool", "false", "Rolagem das abas." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível." },
                              new[] { "OnChange", "EventCallback&lt;int&gt;", "—", "Disparado ao trocar de aba." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="tabview"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>TabView é um componente legado removido do PrimeNG atual; nesta biblioteca é uma variante de Tabs (sem referência upstream).</li>
                        <li>A barra de tinta (<code>p-tabview-ink-bar</code>) não é posicionada; o destaque usa <code>p-tabview-tab-header-active</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _active;

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Tabs

        <OpTabView @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1">Conteúdo 1</OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2">Conteúdo 2</OpTabPanel>
        </OpTabView>
        """;

    private const string BasicCode = """
        <OpTabView @bind-ActiveIndex="_active">
            <OpTabPanel Header="Cabeçalho 1"><p>Conteúdo 1</p></OpTabPanel>
            <OpTabPanel Header="Cabeçalho 2"><p>Conteúdo 2</p></OpTabPanel>
            <OpTabPanel Header="Cabeçalho 3"><p>Conteúdo 3</p></OpTabPanel>
        </OpTabView>
        """;

    private const string ScrollableCode = """
        <OpTabView Scrollable="true">
            @for (var i = 1; i <= 10; i++)
            {
                <OpTabPanel Header="@($"Cabeçalho {i}")">Conteúdo @i</OpTabPanel>
            }
        </OpTabView>
        """;

    private const string AccessibilityCode = """
        <OpTabView AriaLabel="Seções" @bind-ActiveIndex="_active">
            <OpTabPanel Header="Geral">...</OpTabPanel>
        </OpTabView>
        """;
}
