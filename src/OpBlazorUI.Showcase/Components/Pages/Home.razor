@page "/"
@namespace OpBlazorUI.Showcase.Components.Pages

<PageTitle>OpBlazorUI</PageTitle>

<div class="doc-section">
    <h1 style="font-size:2rem;font-weight:700;margin:0 0 1rem;">OpBlazor<span style="color:#6326b7;">UI</span></h1>
    <div class="doc-section-description">
        <p>Port do <a href="https://optimus.openng.org" target="_blank" rel="noopener noreferrer" style="color:var(--primary-color);">Optimus UI</a> para Blazor.</p>
        <p>Comece pela instalação e ajuste o tema antes de explorar os componentes.</p>
        <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin:1.25rem 0;">
            <a href="installation"
               style="display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.1rem;border-radius:var(--p-border-radius-md);background:var(--p-primary-color);color:var(--p-primary-contrast-color);font-weight:600;text-decoration:none;">
                <i class="pi pi-download"></i>
                Instalação
            </a>
            <a href="configuration"
               style="display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.1rem;border-radius:var(--p-border-radius-md);background:var(--p-content-hover-background);color:var(--p-text-color);border:1px solid var(--p-content-border-color);font-weight:600;text-decoration:none;">
                <i class="pi pi-cog"></i>
                Configuração
            </a>
        </div>
        <p>Depois, explore os componentes no menu lateral.</p>
    </div>
</div>
