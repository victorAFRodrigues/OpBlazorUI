@page "/animateonscroll"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Directives

<PageTitle>AnimateOnScroll - OpBlazorUI</PageTitle>

<style>
    .aos-demo {
        transition: opacity .6s ease, transform .6s ease;
        opacity: 0;
        transform: translateY(24px);
    }

    .aos-demo.aos-enter {
        opacity: 1;
        transform: none;
    }

    .aos-demo.aos-leave {
        opacity: 0;
        transform: translateY(24px);
    }

    .aos-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        max-width: 20rem;
        padding: 2rem;
        border: 1px solid var(--p-content-border-color);
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(0, 0, 0, .1);
        text-align: center;
    }

    .aos-spacer {
        height: 32rem;
    }
</style>

<DocComponent Title="AnimateOnScroll"
              Description="O AnimateOnScroll aplica animações a elementos ao entrar ou sair da viewport durante a rolagem. No Blazor é um componente que envolve o conteúdo observado (IntersectionObserver).">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                As classes de animação são definidas com <code>EnterClass</code> e <code>LeaveClass</code>.
                Qualquer animação CSS válida é suportada; este exemplo usa classes customizadas definidas na página.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <span class="font-bold">Scroll Down</span>
                    <span class="flex items-center justify-center rounded-full"
                          style="width:2rem;height:2rem;background:var(--p-primary-color);color:var(--p-primary-contrast-color)">
                        <i class="pi pi-arrow-down"></i>
                    </span>

                    <div class="aos-spacer"></div>

                    <OpAnimateOnScroll EnterClass="aos-enter" LeaveClass="aos-leave" StyleClass="aos-demo aos-card">
                        <i class="pi pi-user" style="font-size:2rem"></i>
                        <span class="font-bold">Individual</span>
                        <span class="text-muted-color">Lorem ipsum dolor sit amet consectetur adipisicing elit.</span>
                    </OpAnimateOnScroll>

                    <div class="aos-spacer"></div>

                    <OpAnimateOnScroll EnterClass="aos-enter" LeaveClass="aos-leave" StyleClass="aos-demo aos-card">
                        <i class="pi pi-users" style="font-size:2rem"></i>
                        <span class="font-bold">Team</span>
                        <span class="text-muted-color">Lorem ipsum dolor sit amet consectetur adipisicing elit.</span>
                    </OpAnimateOnScroll>

                    <div class="aos-spacer"></div>

                    <OpAnimateOnScroll EnterClass="aos-enter" LeaveClass="aos-leave" StyleClass="aos-demo aos-card">
                        <i class="pi pi-building" style="font-size:2rem"></i>
                        <span class="font-bold">Enterprise</span>
                        <span class="text-muted-color">Lorem ipsum dolor sit amet consectetur adipisicing elit.</span>
                    </OpAnimateOnScroll>

                    <div class="aos-spacer"></div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente não requer nenhum papel ou atributo (a animação é puramente visual).</p>
                <h3>Suporte a teclado</h3>
                <p>O componente não inclui elementos interativos.</p>
            </Description>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "EnterClass", "string?", "null", "Classes aplicadas quando o elemento entra na viewport." },
                              new[] { "LeaveClass", "string?", "null", "Classes aplicadas quando o elemento sai da viewport." },
                              new[] { "Threshold", "double", "0", "Fração do elemento visível necessária para disparar o observer (0 a 1)." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais aplicadas ao contêiner." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Conteúdo observado/animado." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao contêiner." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS" Id="style">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O componente não adiciona classes estruturais próprias além do contêiner
                        <code>&lt;div&gt;</code>; as classes de animação são definidas pelo consumidor via
                        <code>EnterClass</code>/<code>LeaveClass</code>.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular não será portado como tal; a customização é feita por
                        <code>StyleClass</code> e <code>AdditionalAttributes</code>.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O upstream aplica a diretiva ao próprio elemento hospedeiro; aqui o componente
                            renderiza um <code>&lt;div&gt;</code> contêiner que é o elemento observado/animado
                            (desvio consciente).</li>
                        <li>Estados iniciais dependem das classes do consumidor: se o elemento já estiver na
                            viewport no primeiro render, a animação de enter dispara imediatamente.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Directives
        """;

    private const string BasicCode = """
        <OpAnimateOnScroll EnterClass="aos-enter" LeaveClass="aos-leave">
            <!-- conteúdo -->
        </OpAnimateOnScroll>
        """;
}
