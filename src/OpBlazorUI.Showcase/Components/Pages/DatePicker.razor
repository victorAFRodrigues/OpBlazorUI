@page "/datepicker"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.DatePicker
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.IftaLabel
@using System.ComponentModel.DataAnnotations

<PageTitle>DatePicker - OpBlazorUI</PageTitle>

<DocComponent Title="DatePicker"
              Description="O DatePicker é um componente de entrada para selecionar uma data.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O valor é controlado por <code>Value</code> e atualizado por <code>ValueChanged</code> (ou
                <code>@@bind-Value</code>). No Blazor não existe <code>ngModel</code>; o vínculo é feito com
                <code>@@bind-Value</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpDatePicker @bind-Value="_basic" Placeholder="Básico"/>
                    <span class="text-sm">Valor: <b>@(_basic?.ToString("dd/MM/yyyy") ?? "—")</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Format" Id="format">
            <Description>
                O formato padrão é <code>mm/dd/yy</code> e pode ser alterado por <code>DateFormat</code>. Os tokens
                aceitos são:
                <ul>
                    <li><code>d</code> / <code>dd</code> — dia do mês (sem/com zero à esquerda)</li>
                    <li><code>m</code> / <code>mm</code> — mês do ano (sem/com zero à esquerda)</li>
                    <li><code>M</code> / <code>MM</code> — nome do mês (abreviado/completo)</li>
                    <li><code>D</code> / <code>DD</code> — nome do dia da semana (abreviado/completo)</li>
                    <li><code>yy</code> — ano com 2 dígitos</li>
                    <li><code>yyyy</code> — ano com 4 dígitos</li>
                    <li><code>'...'</code> — texto literal</li>
                </ul>
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_format" DateFormat="dd/mm/yyyy"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FormatCode"/></Code>
        </DocSection>

        <DocSection Label="Locale" Id="locale">
            <Description>
                Não existe um parâmetro <code>Locale</code>: os nomes de mês, dia e a formatação padrão vêm de
                <code>CultureInfo.CurrentCulture</code>. Defina a cultura no início da aplicação e combine com
                <code>DateFormat</code> para compor o formato desejado.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_locale" DateFormat="dd 'de' MMMM 'de' yyyy"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LocaleCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone" Id="icon">
            <Description>
                Com <code>ShowIcon</code> um ícone é exibido ao lado do input. <code>IconDisplay</code> define o
                estilo: <code>button</code> (botão separado) ou <code>input</code> (ícone dentro do campo, que também
                aceita <code>InputIconTemplate</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <div class="flex flex-col gap-2">
                        <label for="buttondisplay" class="font-bold">Button</label>
                        <OpDatePicker @bind-Value="_icon1" ShowIcon="true" ShowOnFocus="false" InputId="buttondisplay"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="icondisplay" class="font-bold">Default Icon</label>
                        <OpDatePicker @bind-Value="_icon2" ShowIcon="true" IconDisplay="input" InputId="icondisplay"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="templatedisplay" class="font-bold">Custom Icon</label>
                        <OpDatePicker @bind-Value="_icon3" ShowIcon="true" IconDisplay="input" TimeOnly="true" InputId="templatedisplay">
                            <InputIconTemplate Context="icon">
                                <span class="pi pi-clock" style="cursor: pointer" @onclick="icon.ClickCallback"></span>
                            </InputIconTemplate>
                        </OpDatePicker>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@IconCode"/></Code>
        </DocSection>

        <DocSection Label="Min / Max" Id="minmax">
            <Description>
                <code>MinDate</code> e <code>MaxDate</code> limitam o intervalo selecionável; <code>DisabledDates</code>
                bloqueia datas específicas e <code>DisabledDays</code> bloqueia dias da semana (0 = domingo).
                Datas indisponíveis recebem a classe <code>p-disabled</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <div class="flex flex-col gap-2">
                        <label for="minmax" class="font-bold">Min / Max</label>
                        <OpDatePicker @bind-Value="_minMax" MinDate="_min" MaxDate="_max" ShowIcon="true" IconDisplay="input" InputId="minmax"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="disableddays" class="font-bold">Fins de semana</label>
                        <OpDatePicker @bind-Value="_disabledDays" DisabledDays="_weekend" ShowIcon="true" IconDisplay="input" InputId="disableddays"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MinMaxCode"/></Code>
        </DocSection>

        <DocSection Label="Multiple" Id="multiple">
            <Description>
                Defina <code>SelectionMode="OpDateSelectionMode.Multiple"</code> para escolher várias datas. Nesse
                modo o vínculo é feito com <code>@@bind-MultipleValue</code> (uma lista de <code>DateTime?</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpDatePicker @bind-MultipleValue="_multiple" SelectionMode="OpDateSelectionMode.Multiple" ReadonlyInput="true"/>
                    <span class="text-sm">Selecionadas: <b>@((_multiple?.Count ?? 0).ToString())</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Intervalo" Id="range">
            <Description>
                Com <code>SelectionMode="OpDateSelectionMode.Range"</code> o valor é um intervalo, vinculado com
                <code>@@bind-RangeValue</code>: a lista começa com a data inicial e termina com a final.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <OpDatePicker @bind-RangeValue="_range" SelectionMode="OpDateSelectionMode.Range" ReadonlyInput="true"/>
                    <span class="text-sm">Pontas: <b>@(_range?.Count ?? 0)</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RangeCode"/></Code>
        </DocSection>

        <DocSection Label="Button Bar" Id="buttonbar">
            <Description>
                Com <code>ShowButtonBar</code> os botões <code>TodayLabel</code> ("Today") e <code>ClearLabel</code>
                ("Clear") aparecem no rodapé do painel. O conteúdo pode ser totalmente substituído por
                <code>ButtonBarTemplate</code>, cujo contexto expõe <code>TodayCallback</code> e
                <code>ClearCallback</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-start gap-4">
                    <OpDatePicker @bind-Value="_buttonBarDate" ShowButtonBar="true" Placeholder="Básico"/>
                    <OpDatePicker @bind-RangeValue="_buttonBarRange" SelectionMode="OpDateSelectionMode.Range" ReadonlyInput="true" ShowButtonBar="true" Placeholder="Personalizado">
                        <ButtonBarTemplate Context="bar">
                            <div class="flex justify-between w-full gap-2">
                                <OpButton Label="Hoje" Severity="secondary" Variant="outlined" Size="small" OnClick="bar.TodayCallback"/>
                                <OpButton Icon="pi pi-times" Severity="danger" Variant="text" Size="small" AriaLabel="Limpar" OnClick="bar.ClearCallback"/>
                            </div>
                        </ButtonBarTemplate>
                    </OpDatePicker>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ButtonBarCode"/></Code>
        </DocSection>

        <DocSection Label="Time" Id="time">
            <Description>
                Com <code>ShowTime</code> o seletor de hora é exibido, no formato de 12 ou 24 horas conforme
                <code>HourFormat</code>. Use <code>TimeOnly</code> para ocultar a parte de data e permitir apenas a
                escolha de horário.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <div class="flex flex-col gap-2">
                        <label for="calendar-12h" class="font-bold">12h Format</label>
                        <OpDatePicker @bind-Value="_time12" ShowTime="true" HourFormat="12" InputId="calendar-12h"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="calendar-24h" class="font-bold">24h Format</label>
                        <OpDatePicker @bind-Value="_time24" ShowTime="true" HourFormat="24" InputId="calendar-24h"/>
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="calendar-timeonly" class="font-bold">Time Only</label>
                        <OpDatePicker @bind-Value="_timeOnly" TimeOnly="true" InputId="calendar-timeonly"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TimeCode"/></Code>
        </DocSection>

        <DocSection Label="Month Picker" Id="monthpicker">
            <Description>
                O seletor de mês é habilitado com <code>View="OpDatePickerView.Month"</code>, em conjunto com um
                <code>DateFormat</code> adequado.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_month" View="OpDatePickerView.Month" DateFormat="mm/yy" ReadonlyInput="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MonthCode"/></Code>
        </DocSection>

        <DocSection Label="Year Picker" Id="yearpicker">
            <Description>
                O seletor de ano é habilitado com <code>View="OpDatePickerView.Year"</code>, também com um
                <code>DateFormat</code> adequado.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_year" View="OpDatePickerView.Year" DateFormat="yyyy"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@YearCode"/></Code>
        </DocSection>

        <DocSection Label="Multiple Months" Id="multiplemonths">
            <Description>
                O número de meses exibidos simultaneamente é definido por <code>NumberOfMonths</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_multipleMonths" NumberOfMonths="2"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleMonthsCode"/></Code>
        </DocSection>

        <DocSection Label="Date Template" Id="datetemplate">
            <Description>
                Conteúdo customizado pode ser colocado nas células de data com <code>DateTemplate</code>, um
                <code>RenderFragment&lt;OpDateMeta&gt;</code> que recebe dia, mês, ano e flags como
                <code>OtherMonth</code>, <code>Today</code> e <code>Selectable</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_dateTemplate">
                        <DateTemplate Context="meta">
                            @if (meta.Day > 10 && meta.Day < 15)
                            {
                                <strong style="text-decoration: line-through">@meta.Day</strong>
                            }
                            else
                            {
                                @meta.Day
                            }
                        </DateTemplate>
                    </OpDatePicker>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DateTemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Inline" Id="inline">
            <Description>
                Por padrão o calendarário é exibido em um popup. Com <code>Inline="true"</code> ele fica sempre
                visível. Combine com <code>ShowWeek</code> para exibir o número da semana.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_inline" Inline="true" ShowWeek="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InlineCode"/></Code>
        </DocSection>

        <DocSection Label="Float Label" Id="floatlabel">
            <Description>
                O <code>OpFloatLabel</code> integra o rótulo ao campo. Use <code>Variant</code>:
                <code>over</code> (padrão), <code>in</code> e <code>on</code>. O <code>for</code> do
                <code>&lt;label&gt;</code> precisa apontar para o <code>InputId</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <OpFloatLabel>
                        <OpDatePicker @bind-Value="_floatOver" InputId="over_label" ShowIcon="true" IconDisplay="input"/>
                        <label for="over_label">Over Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="in">
                        <OpDatePicker @bind-Value="_floatIn" InputId="in_label" ShowIcon="true" IconDisplay="input"/>
                        <label for="in_label">In Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="on">
                        <OpDatePicker @bind-Value="_floatOn" InputId="on_label" ShowIcon="true" IconDisplay="input"/>
                        <label for="on_label">On Label</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FloatLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Ifta Label" Id="iftalabel">
            <Description>
                O <code>OpIftaLabel</code> cria rótulos alinhados no topo, dentro do campo. O
                <code>&lt;label&gt;</code> aponta para o <code>InputId</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpIftaLabel>
                        <OpDatePicker @bind-Value="_ifta" InputId="date" ShowIcon="true" IconDisplay="input"/>
                        <label for="date">Date</label>
                    </OpIftaLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@IftaLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Clear Icon" Id="clearicon">
            <Description>
                Com <code>ShowClear</code> um ícone de limpar é exibido quando há valor selecionado, permitindo
                apagar a data.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_clear" ShowClear="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ClearIconCode"/></Code>
        </DocSection>

        <DocSection Label="Sizes" Id="sizes">
            <Description>
                O DatePicker oferece os tamanhos <code>small</code> e <code>large</code> como alternativas ao padrão,
                via propriedade <code>Size</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <OpDatePicker @bind-Value="_size1" Size="small" Placeholder="Small" ShowIcon="true" IconDisplay="input"/>
                    <OpDatePicker @bind-Value="_size2" Placeholder="Normal" ShowIcon="true" IconDisplay="input"/>
                    <OpDatePicker @bind-Value="_size3" Size="large" Placeholder="Large" ShowIcon="true" IconDisplay="input"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizesCode"/></Code>
        </DocSection>

        <DocSection Label="Fluid" Id="fluid">
            <Description>
                Com <code>Fluid="true"</code> o componente ocupa toda a largura do contêiner.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width: 100%; max-width: 20rem;">
                        <OpDatePicker @bind-Value="_fluid" Fluid="true"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FluidCode"/></Code>
        </DocSection>

        <DocSection Label="Filled" Id="filled">
            <Description>
                Defina <code>Variant="filled"</code> para exibir o componente com ênfase visual maior que o estilo
                <code>outlined</code> padrão.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_filled" Variant="filled"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>
                Quando <code>Disabled="true"</code>, o elemento não pode ser editado nem receber foco.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpDatePicker @bind-Value="_disabled" Disabled="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description>
                O estado inválido é aplicado com <code>Invalid="true"</code> para indicar falha de validação — também
                é ativado automaticamente pelo <code>EditForm</code> quando o campo tem erro.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-4">
                    <OpDatePicker @bind-Value="_invalid" Invalid="@(_invalid is null)" Placeholder="Date"/>
                    <OpDatePicker @bind-Value="_invalidFilled" Invalid="@(_invalidFilled is null)" Variant="filled" Placeholder="Date"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>
                O DatePicker herda de <code>OpInputBase&lt;DateTime?&gt;</code> e, no modo Single, integra-se ao
                <code>EditForm</code> com <code>DataAnnotationsValidator</code>; o estado inválido aparece
                automaticamente com <code>ValidationMessage</code>. Isso substitui as abordagens <i>Template Driven</i>
                e <i>Reactive Forms</i> do Angular. Nos modos Range e Multiple o vínculo é feito pelos valores próprios,
                que não passam pelo <code>EditForm</code>.
            </Description>
            <ChildContent>
                <EditForm Model="_form" OnValidSubmit="OnSubmit" class="flex flex-col gap-4 items-start" style="width: 100%; max-width: 16rem;">
                    <DataAnnotationsValidator/>
                    <div class="flex flex-col gap-1" style="width: 100%;">
                        <OpDatePicker @bind-Value="_form.Date" Placeholder="Data" InputId="form-date" ShowIcon="true" IconDisplay="input"/>
                        <ValidationMessage For="() => _form.Date"/>
                    </div>
                    <button type="submit" class="p-button p-component p-button-secondary">Enviar</button>
                    @if (_submitted)
                    {
                        <div class="text-sm" style="color: var(--p-green-600)">Formulário enviado com sucesso.</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Vínculo" Id="binding">
            <Description>
                O vínculo depende do <code>SelectionMode</code>: <code>@@bind-Value</code> (Single),
                <code>@@bind-RangeValue</code> (Range) e <code>@@bind-MultipleValue</code> (Multiple). Também é
                possível controlar manualmente por <code>ValueChanged</code>, <code>RangeValueChanged</code> e
                <code>MultipleValueChanged</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-3">
                    <div class="flex flex-wrap justify-center gap-4">
                        <OpDatePicker @bind-Value="_bound" Placeholder="Single" ShowIcon="true" IconDisplay="input"/>
                        <OpDatePicker @bind-RangeValue="_boundRange" SelectionMode="OpDateSelectionMode.Range" ReadonlyInput="true" Placeholder="Intervalo"/>
                        <OpDatePicker @bind-MultipleValue="_boundMultiple" SelectionMode="OpDateSelectionMode.Multiple" ReadonlyInput="true" Placeholder="Múltiplo"/>
                    </div>
                    <span class="text-sm">Single: <b>@(_bound?.ToString("dd/MM/yyyy") ?? "—")</b> — Intervalo: <b>@(_boundRange?.Count ?? 0)</b> — Múltiplo: <b>@(_boundMultiple?.Count ?? 0)</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BindingCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O texto que descreve o componente pode vir de um <code>&lt;label&gt;</code> combinado com
                    <code>InputId</code>, ou das propriedades <code>AriaLabelledBy</code> e <code>AriaLabel</code>. O
                    input tem o papel <code>combobox</code> com <code>aria-autocomplete="none"</code>,
                    <code>aria-haspopup="dialog"</code> e <code>aria-expanded</code>; a relação com o popup é criada por
                    <code>aria-controls</code>. O popup recebe o papel <code>dialog</code> com <code>aria-modal</code>,
                    e a tabela de dias usa o papel <code>grid</code>. Datas selecionadas também são anunciadas por um
                    trecho oculto com <code>aria-live="polite"</code>.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "space", "Abre o popup e move o foco para a data selecionada; se não houver, foca em hoje (botão de escolher data)." },
                              new[] { "enter", "Abre o popup e move o foco para a data selecionada; se não houver, foca em hoje (botão de escolher data)." },
                              new[] { "escape", "Fecha o popup e move o foco para o input." },
                              new[] { "tab", "Move o foco para o próximo elemento focável dentro do popup." },
                              new[] { "shift + tab", "Move o foco para o elemento focável anterior dentro do popup." },
                              new[] { "enter", "Dispara a ação do botão (cabeçalho e rodapé)." },
                              new[] { "space", "Dispara a ação do botão (cabeçalho e rodapé)." },
                              new[] { "enter", "Seleciona a data, fecha o popup e move o foco para o input (grade de datas)." },
                              new[] { "space", "Seleciona a data, fecha o popup e move o foco para o input (grade de datas)." },
                              new[] { "up arrow", "Move o foco para o mesmo dia da semana anterior." },
                              new[] { "down arrow", "Move o foco para o mesmo dia da semana seguinte." },
                              new[] { "right arrow", "Move o foco para o próximo dia." },
                              new[] { "left arrow", "Move o foco para o dia anterior." },
                              new[] { "home", "Move o foco para o primeiro dia da semana atual." },
                              new[] { "end", "Move o foco para o último dia da semana atual." },
                              new[] { "page up", "Muda para o mês anterior no modo data; para o ano anterior no modo mês; para a década anterior no modo ano." },
                              new[] { "shift + page up", "Muda para o ano anterior no modo data; sem efeito nos modos mês e ano." },
                              new[] { "page down", "Muda para o próximo mês no modo data; para o próximo ano no modo mês; para a próxima década no modo ano." },
                              new[] { "shift + page down", "Muda para o próximo ano no modo data; sem efeito nos modos mês e ano." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "DateTime?", "null", "Valor selecionado no modo Single." },
                              new[] { "RangeValue", "IReadOnlyList&lt;DateTime?&gt;?", "null", "Valores do modo Range (início e fim)." },
                              new[] { "MultipleValue", "IReadOnlyList&lt;DateTime?&gt;?", "null", "Valores do modo Multiple." },
                              new[] { "SelectionMode", "OpDateSelectionMode", "Single", "Modo de seleção: <code>Single</code>, <code>Multiple</code> ou <code>Range</code>." },
                              new[] { "View", "OpDatePickerView", "Date", "Visão inicial: <code>Date</code>, <code>Month</code> ou <code>Year</code>." },
                              new[] { "DateFormat", "string", "mm/dd/yy", "Formato de exibição do valor." },
                              new[] { "TodayLabel", "string?", "Today", "Rótulo do botão \"Hoje\" na barra de botões." },
                              new[] { "ClearLabel", "string?", "Clear", "Rótulo do botão \"Limpar\" na barra de botões." },
                              new[] { "Inline", "bool", "false", "Exibe o painel sempre aberto, sem popup." },
                              new[] { "ShowIcon", "bool", "false", "Exibe o ícone de calendário." },
                              new[] { "IconDisplay", "string", "button", "Posição do ícone: <code>button</code> ou <code>input</code>." },
                              new[] { "Icon", "string?", "null", "Classe do ícone quando <code>IconDisplay=\"button\"</code>." },
                              new[] { "ShowClear", "bool", "false", "Exibe o ícone de limpar quando há valor." },
                              new[] { "ReadonlyInput", "bool", "false", "Torna o input somente leitura (mas ainda abre o painel)." },
