            <div class="flex items-center">
                <OpCheckbox Id="@category.Key" Name="category" @bind-Value="category.Checked" />
                <label for="@category.Key" class="ml-2">@category.Label</label>
            </div>
        }

        @code {
            private readonly List<Option> _categories =
            [
                new() { Key = "A", Label = "Accounting" },
                new() { Key = "M", Label = "Marketing", Checked = true },
                new() { Key = "P", Label = "Production" },
                new() { Key = "R", Label = "Research" }
            ];
        }
        """;

    private const string FilledCode = """
