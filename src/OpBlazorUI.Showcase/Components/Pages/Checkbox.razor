@page "/checkbox"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Checkbox
@using System.ComponentModel.DataAnnotations

<DocComponent Title="Checkbox"
              Description="O Checkbox é uma extensão do elemento checkbox padrão, com temas.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpCheckbox @bind-Value="_checked" Id="cb1"/>
                <label class="ms-2" for="cb1">Checkbox</label>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Indeterminado">
            <ChildContent>
                <OpCheckbox Indeterminate="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@IndeterminateCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido / Desabilitado">
            <ChildContent>
                <div class="flex gap-4 items-center">
                    <OpCheckbox Value="true" Invalid="true"/>
                    <OpCheckbox Value="true" Disabled="true"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StateCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex gap-4 items-center">
                    <OpCheckbox Value="true" Size="small"/>
                    <OpCheckbox Value="true"/>
                    <OpCheckbox Value="true" Size="large"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>
        <DocSection Label="Validação">
            <Description>
                O Checkbox herda de <code>InputBase&lt;bool?&gt;</code>, então integra-se ao <code>EditForm</code> com DataAnnotations. O estado <code>invalid</code> é aplicado automaticamente quando há erro de validação.
            </Description>
            <ChildContent>
                <EditForm Model="_form" OnValidSubmit="OnSubmit" class="flex flex-col items-start gap-2">
                    <DataAnnotationsValidator/>
                    <div class="flex items-center gap-2">
                        <OpCheckbox Id="frm-accept" @bind-Value="_form.Accept"/>
                        <label for="frm-accept">Aceito os termos</label>
                    </div>
                    <ValidationMessage For="() => _form.Accept"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_submitted)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Aceito: @_form.Accept</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@ValidationCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "bool?", "null", "Estado marcado." },
                              new[] { "ValueChanged", "EventCallback&lt;bool?&gt;", "-", "Callback de binding." },
                              new[] { "Indeterminate", "bool", "false", "Estado indeterminado." },
                              new[] { "Name", "string?", "null", "Name do input." },
                              new[] { "Id", "string?", "null", "Id do input." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "AriaLabelledBy", "string?", "null", "Id do elemento que rotula." },
                              new[] { "Required", "bool", "false", "Obrigatório." },
                              new[] { "Readonly", "bool", "false", "Somente leitura." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Variant", "string", "outlined", "Variante: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "CheckboxIcon", "string?", "null", "Classe do ícone de marcação." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." },
                              new[] { "InputClass", "string?", "null", "Classes do input." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;bool&gt;", "Disparado ao mudar o estado." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="checkbox"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code>, <code>InputClass</code> e atributos extras para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private bool? _checked = true;

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Checkbox

        <OpCheckbox @bind-Value="_checked" Id="cb1" />
        <label for="cb1">Checkbox</label>
        """;

    private const string BasicCode = """
        <OpCheckbox @bind-Value="_checked" Id="cb1" />
        <label for="cb1">Checkbox</label>

        @code {
            private bool? _checked;
        }
        """;

    private const string IndeterminateCode = """
        <OpCheckbox Indeterminate="true" />
        """;

    private const string StateCode = """
        <OpCheckbox Value="true" Invalid="true" />
        <OpCheckbox Value="true" Disabled="true" />
        """;

    private const string SizeCode = """
        <OpCheckbox Value="true" Size="small" />
        <OpCheckbox Value="true" />
        <OpCheckbox Value="true" Size="large" />
        """;

    private bool _submitted;
    private CheckboxFormModel _form = new();

    private sealed class CheckboxFormModel
    {
        [Required(ErrorMessage = "É necessário aceitar os termos.")]
        public bool? Accept { get; set; }
    }

    private void OnSubmit() => _submitted = true;

    private const string ValidationCode = """
        <EditForm Model="_form" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <OpCheckbox @bind-Value="_form.Accept" />
            <ValidationMessage For="() => _form.Accept" />
            <button type="submit" class="p-button p-component">Enviar</button>
        </EditForm>
        """;
}
