            }

            private readonly List<Option> _ingredients =
            [
                new() { Key = "ingredient1", Label = "Cheese" },
                new() { Key = "ingredient2", Label = "Mushroom" },
                new() { Key = "ingredient3", Label = "Pepper" },
                new() { Key = "ingredient4", Label = "Onion" }
            ];
        }
        """;

