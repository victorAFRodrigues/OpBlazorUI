@page "/dataview"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.DataView
@using OpBlazorUI.Base.Components.Paginator
@using OpBlazorUI.Base.Components.Select
@using OpBlazorUI.Base.Components.SelectButton
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.Tag
@using OpBlazorUI.Base.Components.Skeleton

<PageTitle>DataView - OpBlazorUI</PageTitle>

<DocComponent Title="DataView"
              Description="Exibe os dados em layout de grade ou lista com recursos de paginação. Na v21 o layout é sempre definido pelos templates ListTemplate e GridTemplate.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>O DataView exige uma coleção em <code>Items</code> e um template <code>ListTemplate</code> que
                recebe o contexto com os itens da página atual. Diferente de versões anteriores, o conteúdo não é
                mais gerado pelo componente: o layout lista precisa de um <code>ListTemplate</code>.</p>
            </Description>
            <ChildContent>
                <OpDataView TItem="Product" Items="_products" Layout="list">
                    <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                </OpDataView>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação" Id="pagination">
            <Description>
                <p>A paginação é habilitada com as propriedades <code>Paginator</code> e <code>Rows</code>. Consulte a
                documentação de <a href="/paginator">Paginator</a> para mais informações sobre como customizar o
                paginador.</p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <OpDataView TItem="Product" Items="_products" Layout="list" Paginator="true" Rows="4" @bind-First="_first">
                        <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                    </OpDataView>
                    <span class="text-sm">Primeiro registro: <b>@(_first + 1)</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginationCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação" Id="sorting">
            <Description>
                <p>A ordenação embutida do upstream (<code>sortField</code>/<code>sortOrder</code>) não é exposta pelo
                componente Blazor. A ordenação pode ser feita pelo consumidor, reordenando <code>Items</code> a partir
                de uma UI customizada — como o campo no <code>HeaderTemplate</code> deste exemplo.</p>
            </Description>
            <ChildContent>
                <OpDataView TItem="Product" Items="_sortedProducts" Layout="list">
                    <HeaderTemplate>
                        <div class="flex justify-end">
                            <OpSelect TValue="string" @bind-Value="_sortKey" Options="_sortOptions" OptionLabel="Label"
                                      OptionValue="Value" OnChange="ApplySort" Placeholder="Ordenar por preço" StyleClass="w-56"/>
                        </div>
                    </HeaderTemplate>
                    <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                </OpDataView>
            </ChildContent>
            <Code><CodeBlock Code="@SortingCode"/></Code>
        </DocSection>

        <DocSection Label="Layout" Id="layout">
            <Description>
                <p>O DataView suporta os modos de exibição <code>list</code> e <code>grid</code> definidos pela
                propriedade <code>Layout</code>. Cada modo exige o seu template (<code>ListTemplate</code> ou
                <code>GridTemplate</code>). Use o <code>HeaderTemplate</code> para alternar entre eles.</p>
            </Description>
            <ChildContent>
                <OpDataView TItem="Product" Items="_products" Layout="@_layout">
                    <HeaderTemplate>
                        <div class="flex justify-end">
                            <OpSelectButton TValue="string" @bind-Value="_layout" Options="_layoutOptions" AllowEmpty="false">
                                <ItemTemplate Context="ctx">
                                    <i class="pi @LayoutIcon(ctx.Option)" aria-hidden="true"></i>
                                </ItemTemplate>
                            </OpSelectButton>
                        </div>
                    </HeaderTemplate>
                    <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                    <GridTemplate Context="ctx">@GridItems(ctx.Items)</GridTemplate>
                </OpDataView>
            </ChildContent>
            <Code><CodeBlock Code="@LayoutCode"/></Code>
        </DocSection>

        <DocSection Label="Carregando" Id="loading">
            <Description>
                <p>Enquanto os dados estão sendo carregados, use a propriedade <code>Loading</code> para exibir o
                overlay e o <code>LoadingTemplate</code> para conteúdo customizado — por exemplo, componentes
                <a href="/skeleton">Skeleton</a>.</p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-4">
                    <div class="flex justify-end">
                        <OpButton Label="Recarregar" Icon="pi pi-refresh" OnClick="Reload" Loading="_reloading"/>
                    </div>
                    <OpDataView TItem="Product" Items="_products" Layout="list" Loading="_reloading">
                        <LoadingTemplate>
                            <div style="padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
                                <OpSkeleton Height="2rem"/>
                                <OpSkeleton Width="60%" Height="2rem"/>
                                <OpSkeleton Height="2rem"/>
                            </div>
                        </LoadingTemplate>
                        <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                    </OpDataView>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingCode"/></Code>
        </DocSection>

        <DocSection Label="Vazio" Id="empty">
            <Description>
                <p>Quando a coleção está vazia, o DataView exibe a mensagem definida em <code>EmptyMessage</code>. Use
                o <code>EmptyTemplate</code> para conteúdo customizado.</p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-4">
                    <OpDataView TItem="Product" Items="_emptyProducts" Layout="list" EmptyMessage="Nenhum produto encontrado.">
                        <ListTemplate Context="ctx">@ListItems(ctx.Items)</ListTemplate>
                    </OpDataView>
                    <OpDataView TItem="Product" Items="_emptyProducts" Layout="grid" EmptyMessage="Nenhum produto encontrado.">
                        <GridTemplate Context="ctx">@GridItems(ctx.Items)</GridTemplate>
                        <EmptyTemplate>
                            <div style="padding:2rem; display:flex; flex-direction:column; align-items:center; gap:.5rem;">
                                <i class="pi pi-inbox" style="font-size:2rem; color:var(--p-text-muted-color);" aria-hidden="true"></i>
                                <span>Nenhum produto encontrado.</span>
                            </div>
                        </EmptyTemplate>
                    </OpDataView>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@EmptyCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O contêiner da lista não impõe papéis ARIA próprios; o conteúdo é definido pelos seus templates. Os
                botões de layout, quando usados no <code>HeaderTemplate</code>, devem informar o estado com
                <code>aria-pressed</code> e um rótulo com <code>AriaLabel</code>.</p>
                <p>Consulte a documentação de acessibilidade do <a href="/paginator">Paginator</a> para o paginador do
                componente.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para os controles do cabeçalho e do paginador." },
                              new[] { "enter / space", "Ativa o controle de layout em foco." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Items", "IReadOnlyList&lt;TItem&gt;", "[]", "Coleção de dados exibida pelo componente." },
                              new[] { "Layout", "string", "list", "Layout: <code>list</code> ou <code>grid</code>." },
                              new[] { "Paginator", "bool", "false", "Habilita o paginador." },
                              new[] { "Rows", "int", "10", "Número de registros por página." },
                              new[] { "First", "int", "0", "Índice do primeiro registro da página (usar <code>@@bind-First</code>)." },
                              new[] { "TotalRecords", "int", "0", "Total de registros; quando <code>0</code>, usa a contagem de <code>Items</code>." },
                              new[] { "Lazy", "bool", "false", "Modo lazy: o componente não fatia os dados (o consumidor fornece a página)." },
                              new[] { "PageLinks", "int", "5", "Quantidade de links de página exibidos." },
                              new[] { "AlwaysShowPaginator", "bool", "true", "Mantém o paginador visível mesmo com uma única página." },
                              new[] { "RowsPerPageOptions", "IReadOnlyList&lt;int&gt;?", "null", "Opções de registros por página no dropdown do paginador." },
                              new[] { "PaginatorPosition", "string", "bottom", "Posição do paginador: <code>top</code>, <code>bottom</code> ou <code>both</code>." },
                              new[] { "PaginatorStyleClass", "string?", "null", "Classes adicionais no paginador." },
                              new[] { "Loading", "bool", "false", "Exibe o overlay de carregamento." },
                              new[] { "EmptyMessage", "string?", "No records found.", "Mensagem exibida quando não há registros." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz." },
                              new[] { "Id", "string?", "null", "Id do elemento raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "FirstChanged", "EventCallback&lt;int&gt;", "Notifica a mudança do primeiro registro (binding de <code>First</code>)." },
                              new[] { "OnPageChange", "EventCallback&lt;OpPaginatorState&gt;", "Disparado quando a página muda; recebe <code>First</code>, <code>Rows</code>, <code>Page</code> e <code>PageCount</code>." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ListTemplate", "RenderFragment&lt;OpDataViewListContext&lt;TItem&gt;&gt;?", "Conteúdo do modo <code>list</code>; o contexto expõe <code>.Items</code> (itens da página)." },
                              new[] { "GridTemplate", "RenderFragment&lt;OpDataViewGridContext&lt;TItem&gt;&gt;?", "Conteúdo do modo <code>grid</code>; o contexto expõe <code>.Items</code> (itens da página)." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo exibido acima da lista/grade." },
                              new[] { "FooterTemplate", "RenderFragment?", "Conteúdo exibido abaixo da lista/grade." },
                              new[] { "EmptyTemplate", "RenderFragment?", "Conteúdo exibido quando não há registros (substitui <code>EmptyMessage</code>)." },
                              new[] { "LoadingTemplate", "RenderFragment?", "Conteúdo do overlay de carregamento (substitui o spinner padrão)." },
                              new[] { "TemplateLeft", "RenderFragment?", "Conteúdo extra à esquerda no paginador." },
                              new[] { "TemplateRight", "RenderFragment?", "Conteúdo extra à direita no paginador." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="dataview"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code>, os templates e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Não há ordenação nem filtragem embutidas do upstream (<code>sortField</code>, <code>sortOrder</code>, <code>filter</code>); a ordenação precisa ser feita pelo consumidor reordenando <code>Items</code>.</li>
                        <li>Na v21 a lista/grade é sempre renderizada pelos templates <code>ListTemplate</code>/<code>GridTemplate</code>; o componente não gera markup de item sozinho.</li>
                        <li><code>Rows</code> não possui evento <code>RowsChanged</code>: se o consumidor alterar o número de linhas por página, mantenha o valor em uma variável própria para não sobrescrever a seleção.</li>
                        <li>Não há o <code>selectbutton</code> de alternância de layout embutido no cabeçalho; ele é montado no <code>HeaderTemplate</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string _layout = "list";
    private int _first;
    private bool _reloading;
    private string? _sortKey;

    private readonly IReadOnlyList<Product> _products = BuildProducts();
    private IReadOnlyList<Product> _sortedProducts = BuildProducts();
    private static readonly IReadOnlyList<Product> _emptyProducts = Array.Empty<Product>();

    private static readonly object[] _layoutOptions = ["list", "grid"];

    private static readonly object[] _sortOptions =
    [
        new SortOption("Preço: menor para o maior", "price-asc"),
        new SortOption("Preço: maior para o menor", "price-desc")
    ];

    private sealed record Product(string Name, string Category, string Image, decimal Price, int Rating, string InventoryStatus);

    private sealed record SortOption(string Label, string Value);

    private static IReadOnlyList<Product> BuildProducts() =>
    [
        new("Bamboo Watch", "Acessórios", "bamboo-watch.jpg", 65, 5, "INSTOCK"),
        new("Black Watch", "Acessórios", "black-watch.jpg", 72, 4, "INSTOCK"),
        new("Blue Band", "Fitness", "blue-band.jpg", 79, 3, "LOWSTOCK"),
        new("Blue T-Shirt", "Vestuário", "blue-t-shirt.jpg", 29, 5, "INSTOCK"),
        new("Bolt Shirt", "Vestuário", "bolt-shirt.jpg", 89, 4, "LOWSTOCK"),
        new("Chakra Bracelet", "Acessórios", "chakra-bracelet.jpg", 45, 4, "OUTOFSTOCK"),
        new("Gaming Set", "Eletrônicos", "gaming-set.jpg", 299, 5, "INSTOCK"),
        new("Yellow T-Shirt", "Vestuário", "yellow-t-shirt.jpg", 27, 4, "INSTOCK"),
        new("Ivory T-Shirt", "Vestuário", "ivory-t-shirt.jpg", 32, 5, "INSTOCK"),
        new("Wristwatch", "Acessórios", "wristwatch.jpg", 120, 4, "LOWSTOCK"),
        new("Smart Watch", "Eletrônicos", "smart-watch.jpg", 199, 5, "INSTOCK"),
        new("Yoga Mat", "Fitness", "yoga-mat.jpg", 39, 4, "INSTOCK")
    ];

    private async Task Reload()
    {
        _reloading = true;
        await Task.Delay(1500);
        _reloading = false;
    }

    private void ApplySort(string? key)
    {
        _sortedProducts = key switch
        {
            "price-asc" => _products.OrderBy(p => p.Price).ToList(),
            "price-desc" => _products.OrderByDescending(p => p.Price).ToList(),
            _ => _products.ToList()
        };
    }

    private static string ImageUrl(string image) => $"https://primefaces.org/cdn/primeng/images/demo/product/{image}";

    private static bool IsOutOfStock(Product p) => p.InventoryStatus == "OUTOFSTOCK";

    private static string LayoutIcon(string option) => option == "list" ? "pi-bars" : "pi-table";

    private static string? SeverityFor(string status) => status switch
    {
        "INSTOCK" => "success",
        "LOWSTOCK" => "warn",
        "OUTOFSTOCK" => "danger",
        _ => null
    };

    private static string ListItemStyle(int index) => index == 0
        ? "display:flex; align-items:center; gap:1rem; padding:1.5rem;"
        : "display:flex; align-items:center; gap:1rem; padding:1.5rem; border-top:1px solid var(--p-content-border-color);";

    private RenderFragment ListItems(IReadOnlyList<Product> items) => __builder =>
    {
        for (var i = 0; i < items.Count; i++)
        {
            var p = items[i];
            <div style="@ListItemStyle(i)">
                <div style="position:relative; flex:0 0 8rem;">
                    <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:100%; border-radius:var(--p-content-border-radius); display:block;"/>
                    <span style="position:absolute; left:.25rem; top:.25rem;">
                        <OpTag Value="@p.InventoryStatus" Severity="@SeverityFor(p.InventoryStatus)"/>
                    </span>
                </div>
                <div style="flex:1; display:flex; flex-direction:column; gap:.25rem;">
                    <span class="text-sm" style="color:var(--p-text-muted-color);">@p.Category</span>
                    <span style="font-size:1.125rem; font-weight:500; color:var(--p-text-color);">@p.Name</span>
                    <span class="flex items-center gap-1 text-sm" style="color:var(--p-text-color);">
                        <i class="pi pi-star-fill" style="color:#eab308;" aria-hidden="true"></i>@p.Rating
                    </span>
                </div>
                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:.75rem;">
                    <span class="text-xl font-semibold" style="color:var(--p-text-color);">$@p.Price</span>
                    <div class="flex gap-2">
                        <OpButton Icon="pi pi-heart" Outlined="true" AriaLabel="Favoritar"/>
                        <OpButton Icon="pi pi-shopping-cart" Label="Comprar" Disabled="@IsOutOfStock(p)"/>
                    </div>
                </div>
            </div>
        }
    };

    private RenderFragment GridItems(IReadOnlyList<Product> items) => __builder =>
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(16rem, 1fr)); gap:1rem;">
            @foreach (var p in items)
            {
                <div style="border:1px solid var(--p-content-border-color); border-radius:var(--p-content-border-radius); background:var(--p-content-background); padding:1rem; display:flex; flex-direction:column; gap:1rem;">
                    <div style="position:relative; background:var(--p-surface-50); border-radius:var(--p-content-border-radius); padding:1rem; display:flex; justify-content:center;">
                        <img src="@ImageUrl(p.Image)" alt="@p.Name" style="max-width:100%; border-radius:var(--p-content-border-radius);"/>
                        <span style="position:absolute; left:.25rem; top:.25rem;">
                            <OpTag Value="@p.InventoryStatus" Severity="@SeverityFor(p.InventoryStatus)"/>
                        </span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:.5rem;">
                        <div>
                            <span class="text-sm" style="color:var(--p-text-muted-color);">@p.Category</span>
                            <div style="font-weight:500; color:var(--p-text-color);">@p.Name</div>
                        </div>
                        <span class="flex items-center gap-1 text-sm" style="color:var(--p-text-color);">
                            <i class="pi pi-star-fill" style="color:#eab308;" aria-hidden="true"></i>@p.Rating
                        </span>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:.75rem;">
                        <span class="text-2xl font-semibold" style="color:var(--p-text-color);">$@p.Price</span>
                        <div class="flex gap-2">
                            <OpButton Icon="pi pi-shopping-cart" Label="Comprar" Disabled="@IsOutOfStock(p)"/>
                            <OpButton Icon="pi pi-heart" Outlined="true" AriaLabel="Favoritar"/>
                        </div>
                    </div>
                </div>
            }
        </div>
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.DataView
        """;

    private const string BasicCode = """
        <OpDataView TItem="Product" Items="_products" Layout="list">
            <ListTemplate Context="ctx">
                @foreach (var p in ctx.Items)
                {
                    <div class="flex items-center gap-4 p-3">
                        <img src="@ImageUrl(p.Image)" alt="@p.Name" style="width:8rem;" />
                        <div class="flex flex-col gap-1">
                            <span class="text-sm">@p.Category</span>
                            <span class="font-medium">@p.Name</span>
                        </div>
                        <span class="text-xl font-semibold" style="margin-left:auto;">$@p.Price</span>
                    </div>
                }
            </ListTemplate>
        </OpDataView>

        @code {
            private sealed record Product(string Name, string Category, string Image, decimal Price);
            private readonly IReadOnlyList<Product> _products = [ new("Bamboo Watch", "Acessórios", "bamboo-watch.jpg", 65) ];
        }
        """;

    private const string PaginationCode = """
        <OpDataView TItem="Product" Items="_products" Layout="list" Paginator="true" Rows="4" @bind-First="_first">
            <ListTemplate Context="ctx">
                @foreach (var p in ctx.Items)
                {
                    <div>@p.Name</div>
                }
            </ListTemplate>
        </OpDataView>

        @code {
            private int _first;
        }
        """;

    private const string SortingCode = """
        <OpDataView TItem="Product" Items="_sortedProducts" Layout="list">
            <HeaderTemplate>
                <div class="flex justify-end">
                    <OpSelect TValue="string" @bind-Value="_sortKey" Options="_sortOptions" OptionLabel="Label"
                              OptionValue="Value" OnChange="ApplySort" Placeholder="Ordenar por preço" StyleClass="w-56" />
                </div>
            </HeaderTemplate>
            <ListTemplate Context="ctx">
                @foreach (var p in ctx.Items)
                {
                    <div>@p.Name - $@p.Price</div>
                }
            </ListTemplate>
        </OpDataView>

        @code {
            private string? _sortKey;

            private void ApplySort(string? key)
            {
                _sortedProducts = key switch
                {
                    "price-asc" => _products.OrderBy(p => p.Price).ToList(),
                    "price-desc" => _products.OrderByDescending(p => p.Price).ToList(),
                    _ => _products.ToList()
                };
            }
        }
        """;

    private const string LayoutCode = """
        <OpDataView TItem="Product" Items="_products" Layout="@_layout">
            <HeaderTemplate>
                <div class="flex justify-end">
                    <OpSelectButton TValue="string" @bind-Value="_layout" Options="_layoutOptions" AllowEmpty="false">
                        <ItemTemplate Context="ctx">
                            <i class="pi @(ctx.Option == "list" ? "pi-bars" : "pi-table")"></i>
                        </ItemTemplate>
                    </OpSelectButton>
                </div>
            </HeaderTemplate>
            <ListTemplate Context="ctx">...</ListTemplate>
            <GridTemplate Context="ctx">...</GridTemplate>
        </OpDataView>

        @code {
            private string _layout = "list";
            private static readonly object[] _layoutOptions = ["list", "grid"];
        }
        """;

    private const string LoadingCode = """
        <OpDataView TItem="Product" Items="_products" Layout="list" Loading="_reloading">
            <LoadingTemplate>
                <div style="padding:1.5rem; display:flex; flex-direction:column; gap:1rem;">
                    <OpSkeleton Height="2rem" />
                    <OpSkeleton Width="60%" Height="2rem" />
                </div>
            </LoadingTemplate>
            <ListTemplate Context="ctx">...</ListTemplate>
        </OpDataView>

        @code {
            private bool _reloading;

            private async Task Reload()
            {
                _reloading = true;
                await Task.Delay(1500);
                _reloading = false;
            }
        }
        """;

    private const string EmptyCode = """
        <OpDataView TItem="Product" Items="_emptyProducts" Layout="list" EmptyMessage="Nenhum produto encontrado.">
            <ListTemplate Context="ctx">...</ListTemplate>
        </OpDataView>

        <OpDataView TItem="Product" Items="_emptyProducts" Layout="grid" EmptyMessage="Nenhum produto encontrado.">
            <GridTemplate Context="ctx">...</GridTemplate>
            <EmptyTemplate>
                <div style="padding:2rem; text-align:center;">Nenhum produto encontrado.</div>
            </EmptyTemplate>
        </OpDataView>
        """;
}
