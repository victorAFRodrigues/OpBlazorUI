@page "/dataview"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>DataView - OpBlazorUI</PageTitle>

<DocComponent Title="DataView"
              Description="Exibe os dados em layout de grade ou lista com recursos de paginação e ordenação. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O DataView exige um valor exibido junto com um template <code>list</code> que recebe um objeto da coleção e retorna o conteúdo.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Paginação" Id="pagination">
            <Description><p>A paginação é habilitada com as propriedades <code>paginator</code> e <code>rows</code>. Consulte a documentação de <a href="/paginator">Paginator</a> para mais informações sobre como customizar o paginador.</p></Description>
            <Code><CodeBlock Code="@PaginationCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Ordenação" Id="sorting">
            <Description><p>A ordenação embutida é controlada pelos bindings das propriedades <code>sortField</code> e <code>sortOrder</code> a partir de uma UI customizada.</p></Description>
            <Code><CodeBlock Code="@SortingCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Layout" Id="layout">
            <Description><p>O DataView suporta os modos de exibição <code>list</code> e <code>grid</code> definidos pela propriedade <code>layout</code>. O modo <code>grid</code> não é embutido por questões de flexibilidade e exige uma biblioteca com recursos de CSS grid como o Tailwind.</p></Description>
            <Code><CodeBlock Code="@LayoutCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Carregando" Id="loading">
            <Description><p>Enquanto os dados estão sendo carregados, o componente <a href="/skeleton">Skeleton</a> pode ser usado para indicar o estado de carregamento.</p></Description>
            <Code><CodeBlock Code="@LoadingCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O elemento contêiner que envolve os botões de opção de layout tem o papel <code>group</code>, enquanto cada elemento de botão usa o papel <code>button</code> e o <code>aria-pressed</code> é atualizado conforme o estado de seleção. Os valores para descrever os botões são derivados das propriedades <code>aria.listView</code> e <code>aria.gridView</code> da API de <a href="/configuration/#locale">locale</a>, respectivamente.</p>
                <p>Consulte a documentação de acessibilidade do <a href="/paginator">Paginator</a> para o paginador do componente.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para os botões." },
                              new[] { "space", "Alterna o estado marcado de um botão." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { DataViewModule } from 'primeng/dataview';
        """;

    private const string BasicCode = """
        <p-dataview #dv [value]="products()">
            <ng-template #list let-items>
                <div class="grid grid-cols-12 gap-4 grid-nogutter">
                    <div class="col-span-12" *ngFor="let item of items; let first = first">
                        <div
                            class="flex flex-col sm:flex-row sm:items-center p-6 gap-4"
                            [ngClass]="{ 'border-t border-surface-200 dark:border-surface-700': !first }"
                        >
                            <div class="md:w-40 relative">
                                <img
                                    class="block xl:block mx-auto rounded-border w-full"
                                    [src]="'https://primefaces.org/cdn/primeng/images/demo/product/' + item.image"
                                    [alt]="item.name"
                                />
                                <p-tag
                                    [value]="item.inventoryStatus"
                                    [severity]="getSeverity(item)"
                                    class="absolute dark:!bg-surface-900"
                                    [style.left.px]="4"
                                    [style.top.px]="4"
                                />
                            </div>
                            <div class="flex flex-col md:flex-row justify-between md:items-center flex-1 gap-6">
                                <div class="flex flex-row md:flex-col justify-between items-start gap-2">
                                    <div>
                                        <span class="font-medium text-secondary text-sm">{{ item.category }}</span>
                                        <div class="text-lg font-medium text-surface-900 dark:text-surface-0 mt-2">{{ item.name }}</div>
                                    </div>
                                    <div class="bg-surface-100 dark:bg-surface-700 p-1" style="border-radius: 30px">
                                        <div
                                            class="bg-surface-0 dark:bg-surface-900 flex items-center gap-2 justify-center py-1 px-2"
                                            style="border-radius: 30px; box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.04), 0px 1px 2px 0px rgba(0, 0, 0, 0.06)"
                                        >
                                            <span class="text-surface-900 dark:text-surface-0 font-medium text-sm">{{
                                                item.rating
                                            }}</span>
                                            <i class="pi pi-star-fill text-yellow-500"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col md:items-end gap-8">
                                    <span class="text-xl font-semibold text-surface-900 dark:text-surface-0">{{
                                        '$' + item.price
                                    }}</span>
                                    <div class="flex flex-row-reverse md:flex-row gap-2">
                                        <p-button icon="pi pi-heart" [outlined]="true" />
                                        <p-button
                                            icon="pi pi-shopping-cart"
                                            class="flex-auto md:flex-initial whitespace-nowrap"
                                            label="Buy Now"
                                            [disabled]="item.inventoryStatus === 'OUTOFSTOCK'"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </ng-template>
        </p-dataview>
        """;

    private const string PaginationCode = """
