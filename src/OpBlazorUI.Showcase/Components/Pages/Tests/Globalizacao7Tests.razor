@page "/_tests/globalizacao-7"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using OpBlazorUI.Base.Components.Editor
@using OpBlazorUI.Base.Components.InputOtp
@using OpBlazorUI.Base.Components.Password
@using OpBlazorUI.Base.Globalization
@using OpBlazorUI.Base.Services
@inject OpTranslationService TranslationService

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/Globalizacao7Tests.cs).
   Fixa a tradução em pt-BR para verificar senha (medidor), editor (toolbar) e OTP. *@

<PageTitle>Testes: globalização lote 7</PageTitle>

<h1 id="t-title">Testes: globalização lote 7</h1>

<section id="t-password">
    <OpPassword @bind-Value="_password" InputId="pwd"/>
</section>

<section id="t-inputotp">
    <OpInputOtp Length="4"/>
</section>

<section id="t-editor">
    <OpEditor Value="texto"/>
</section>

@code {
    private string? _password = "abc";

    protected override void OnInitialized() => TranslationService.SetTranslation(OpTranslations.PtBr);
}
