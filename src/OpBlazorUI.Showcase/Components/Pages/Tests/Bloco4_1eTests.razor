@page "/_tests/bloco4-1e"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using OpBlazorUI.Base.Components.Listbox
@using OpBlazorUI.Base.Components.Select
@using OpBlazorUI.Base.Models

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/Bloco4_1eTests.cs). *@

<PageTitle>Testes: bloco 4.1e seleção</PageTitle>

<h1 id="t-title">Testes: bloco 4.1e seleção</h1>

<section id="t-select">
    <OpSelect TValue="string" Options="_cities" OptionLabel="Name" OptionValue="Code"
              @bind-Value="_selected"/>
    <span id="t-select-value">@_selected</span>
</section>

<section id="t-listbox">
    <OpListbox TValue="string" InputId="lb" Options="_cities" OptionLabel="Name" OptionValue="Code"
               @bind-Value="_listbox"/>
    <span id="t-listbox-value">@_listbox</span>
</section>

@code {
    private string? _selected;
    private string? _listbox;

    private sealed record City(string Name, string Code);

    private readonly List<City> _cities = Enumerable.Range(1, 30)
        .Select(i => new City($"Cidade {i:00}", $"C{i:00}"))
        .ToList();
}
