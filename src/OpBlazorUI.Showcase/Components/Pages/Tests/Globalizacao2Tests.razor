@page "/_tests/globalizacao-2"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using OpBlazorUI.Base.Components.AutoComplete
@using OpBlazorUI.Base.Components.CascadeSelect
@using OpBlazorUI.Base.Components.Listbox
@using OpBlazorUI.Base.Components.MultiSelect
@using OpBlazorUI.Base.Components.Select
@using OpBlazorUI.Base.Components.TreeSelect
@using OpBlazorUI.Base.Globalization
@using OpBlazorUI.Base.Services
@inject OpTranslationService TranslationService

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/Globalizacao2Tests.cs).
   Fixa a tradução em pt-BR para verificar que mensagens/rótulos/aria dos seletores vêm da tradução global. *@

<PageTitle>Testes: globalização lote 2</PageTitle>

<h1 id="t-title">Testes: globalização lote 2</h1>

<section id="t-select">
    <OpSelect TValue="string" Options="_empty" Filter="true" InputId="sel"/>
</section>

<section id="t-multiselect">
    <OpMultiSelect TValue="string" Options="_cities" OptionLabel="Name" OptionValue="Code"
                   Filter="true" ShowToggleAll="true" InputId="ms"/>
</section>

<section id="t-listbox">
    <OpListbox TValue="string" Options="_empty" Filter="true" InputId="lb"/>
</section>

<section id="t-treeselect">
    <OpTreeSelect Filter="true" InputId="ts"/>
</section>

<section id="t-cascadeselect">
    <OpCascadeSelect TValue="string"/>
</section>

<section id="t-autocomplete">
    <OpAutoComplete TValue="string" Dropdown="true"/>
</section>

@code {
    private readonly IReadOnlyList<object> _empty = Array.Empty<object>();

    private readonly List<object> _cities = new()
    {
        new City("São Paulo", "SP"),
        new City("Curitiba", "CT")
    };

    private sealed record City(string Name, string Code);

    protected override void OnInitialized() => TranslationService.SetTranslation(OpTranslations.PtBr);
}
