@page "/_tests/campos-formulario"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using OpBlazorUI.Components.Checkbox
@using OpBlazorUI.Components.Listbox
@using OpBlazorUI.Components.RadioButton
@using OpBlazorUI.Components.Select
@using OpBlazorUI.Components.Textarea

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/CamposFormularioTests.cs). *@

<PageTitle>Testes: campos de formulário</PageTitle>

<h1 id="t-title">Testes: campos de formulário</h1>

<section id="t-radio">
    <EditForm Model="_form" OnValidSubmit="OnValid">
        <DataAnnotationsValidator/>
        <OpRadioButton TValue="string" Name="ing" Value="@("A")" @bind-ModelValue="_form.Ingredient" Id="r-a"/>
        <OpRadioButton TValue="string" Name="ing" Value="@("B")" @bind-ModelValue="_form.Ingredient" Id="r-b"/>
    </EditForm>
    <span id="t-radio-value">@_form.Ingredient</span>
</section>

<section id="t-checkbox">
    <OpCheckbox Readonly="true" @bind-Value="_readonlyChecked"/>
    <span id="t-checkbox-value">@_readonlyChecked</span>
</section>

<section id="t-textarea">
    <OpTextarea @bind-Value="_text"/>
    <button id="t-textarea-clear" type="button" @onclick="ClearText">limpar</button>
    <span id="t-textarea-value">@_text</span>
</section>

<section id="t-list-edit">
    <EditForm Model="_form">
        <DataAnnotationsValidator/>
        <OpListbox TValue="string"
                   Options="_cities"
                   OptionLabel="Name"
                   OptionValue="Code"
                   Multiple="true"
                   @bind-SelectedValues="_form.Cities"/>
        <ValidationMessage For="() => _form.Cities"/>
        <button id="t-list-submit" type="submit">enviar</button>
    </EditForm>
</section>

<section id="t-select-edit">
    <EditForm Model="_form">
        <OpSelect TValue="string"
                  Options="_cities"
                  OptionLabel="Name"
                  OptionValue="Code"
                  @bind-Value="_form.City"/>
    </EditForm>
</section>

@code {
    private sealed record City(string Name, string Code);

    private sealed class FormModel
    {
        public string? Ingredient { get; set; }
        public string? City { get; set; }

        [AtLeastOne(ErrorMessage = "Escolha ao menos uma")]
        public IReadOnlyList<string> Cities { get; set; } = Array.Empty<string>();
    }

    private sealed class AtLeastOneAttribute : ValidationAttribute
    {
        public override bool IsValid(object? value)
            => value is System.Collections.IEnumerable items && items.Cast<object>().Any();
    }

    private static readonly List<City> _cities = new()
    {
        new City("São Paulo", "SP"),
        new City("Rio de Janeiro", "RJ")
    };

    private readonly FormModel _form = new();
    private bool? _readonlyChecked;
    private string _text = "";

    private void ClearText() => _text = "";

    private void OnValid()
    {
    }
}
