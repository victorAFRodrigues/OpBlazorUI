@page "/_tests/globalizacao-navegacao"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using OpBlazorUI.Components.Carousel
@using OpBlazorUI.Components.Paginator
@using OpBlazorUI.Components.Tabs
@using OpBlazorUI.Globalization
@using OpBlazorUI.Services
@inject OpTranslationService TranslationService

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/GlobalizacaoNavegacaoTests.cs).
   Fixa a tradução em pt-BR para verificar nav de abas, paginação e carrossel. *@

<PageTitle>Testes: globalização — navegação</PageTitle>

<h1 id="t-title">Testes: globalização — navegação</h1>

<section id="t-tabs">
    <OpTabs Scrollable="true">
        <OpTabPanel Header="A" Closable="true"/>
        <OpTabPanel Header="B"/>
    </OpTabs>
</section>

<section id="t-tabview">
    <OpTabView Scrollable="true">
        <OpTabPanel Header="A"/>
        <OpTabPanel Header="B"/>
    </OpTabView>
</section>

<section id="t-paginator">
    <OpPaginator First="0" Rows="10" TotalRecords="100" ShowJumpToPageInput="true" RowsPerPageOptions="_rowsOptions"/>
</section>

<section id="t-carousel">
    <OpCarousel TItem="string" Value="_items"/>
</section>

@code {
    private readonly IReadOnlyList<int> _rowsOptions = new[] { 10, 25 };
    private readonly List<string> _items = new() { "A", "B", "C" };

    protected override void OnInitialized() => TranslationService.SetTranslation(OpTranslations.PtBr);
}
