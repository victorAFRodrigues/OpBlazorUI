@page "/_tests/teclado-tree-select-tree-table"
@namespace OpBlazorUI.Showcase.Components.Pages.Tests
@using OpBlazorUI.Components.TreeSelect
@using OpBlazorUI.Components.TreeTable
@using OpBlazorUI.Models

@* Página fora do menu, usada pelos testes Playwright (tests/OpBlazorUI.Playwright/TecladoTreeSelectTreeTableTests.cs). *@

<PageTitle>Testes: teclado de TreeSelect e TreeTable</PageTitle>

<h1 id="t-title">Testes: teclado de TreeSelect e TreeTable</h1>

<section id="t-ts">
    <OpTreeSelect Options="_tsNodes" InputId="t-ts-input" Placeholder="Selecione" @bind-Value="_tsValue"/>
    <span id="t-ts-value">@_tsValue</span>
</section>

<section id="t-tt">
    <OpTreeTable Nodes="_ttNodes" Columns="_ttColumns" EmptyMessage="vazio" SelectionMode="single" OnNodeSelect="OnTtSelect"/>
    <span id="t-tt-log">@_ttLog</span>
</section>

@code {
    private string? _tsValue;
    private string _ttLog = "";

    private readonly List<TreeNode> _tsNodes = new()
    {
        new TreeNode
        {
            Key = "pai", Label = "Pai",
            Children = new()
            {
                new TreeNode { Key = "f1", Label = "Filho1", Leaf = true },
                new TreeNode { Key = "f2", Label = "Filho2", Leaf = true }
            }
        },
        new TreeNode { Key = "r2", Label = "Raiz2", Leaf = true }
    };

    private readonly List<OpTreeNode> _ttNodes = new()
    {
        new OpTreeNode
        {
            Key = "pai", Label = "Pai",
            Children = new()
            {
                new OpTreeNode { Key = "f1", Label = "Filho1", Leaf = true },
                new OpTreeNode { Key = "f2", Label = "Filho2", Leaf = true }
            }
        },
        new OpTreeNode { Key = "r2", Label = "Raiz2", Leaf = true }
    };

    private readonly List<OpTreeTableColumn> _ttColumns = new()
    {
        new OpTreeTableColumn { Field = "label", Header = "Nome", Expandable = true }
    };

    private void OnTtSelect(OpTreeNode node) => _ttLog = node.Label;
}
