@page "/fileupload"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.FileUpload

<PageTitle>FileUpload - OpBlazorUI</PageTitle>

<DocComponent Title="FileUpload"
              Description="O FileUpload é um uploader avançado com suporte a drag-and-drop, múltiplos arquivos, progresso e validações.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O modo avançado exibe os botões de escolher/enviar/cancelar e a lista de arquivos, com suporte a
                arrastar e soltar.
            </Description>
            <ChildContent>
                <div style="max-width: 40rem;">
                    <OpFileUpload Multiple="true" OnUpload="OnUploaded"/>
                </div>
                @if (_uploadedCount > 0)
                {
                    <span class="text-sm">Arquivos enviados nesta sessão: <b>@_uploadedCount</b></span>
                }
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Básico (simples)" Id="simple">
            <Description>Com <code>Mode="basic"</code>, apenas o botão de escolha e o rótulo são exibidos.</Description>
            <ChildContent>
                <div style="max-width: 40rem;">
                    <OpFileUpload Mode="basic" Auto="true" Accept="image/*" OnSelect="OnSelected"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SimpleCode"/></Code>
        </DocSection>

        <DocSection Label="Envio customizado" Id="custom">
            <Description>
                Com <code>CustomUpload="true"</code>, o envio é tratado pelo evento <code>UploadHandler</code>. Aqui
                apenas registramos os arquivos recebidos.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-2" style="max-width: 40rem;">
                    <OpFileUpload Multiple="true" CustomUpload="true" UploadHandler="OnCustomUpload"/>
                    @if (_lastBatch.Count > 0)
                    {
                        <span class="text-sm">Último lote: <b>@string.Join(", ", _lastBatch)</b></span>
                    }
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CustomCode"/></Code>
        </DocSection>

        <DocSection Label="Validação" Id="validation">
            <Description>
                Restrinja por tipo com <code>Accept</code>, por tamanho com <code>MaxFileSize</code> e por
                quantidade com <code>FileLimit</code>.
            </Description>
            <ChildContent>
                <div style="max-width: 40rem;">
                    <OpFileUpload Multiple="true" Accept=".pdf,.png,.jpg" MaxFileSize="1048576" FileLimit="3"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ValidationCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>O item da lista pode ser customizado com <code>FileTemplate</code>.</Description>
            <ChildContent>
                <div style="max-width: 40rem;">
                    <OpFileUpload Multiple="true">
                        <FileTemplate>
                            <div class="flex items-center gap-3" style="width: 100%;">
                                <i class="pi pi-file" style="font-size: 1.5rem;"></i>
                                <div class="flex flex-col">
                                    <span style="font-weight: 600;">@context.Name</span>
                                    <span class="text-sm">@context.ContentType</span>
                                </div>
                            </div>
                        </FileTemplate>
                    </OpFileUpload>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O campo de arquivo tem <code>aria-label</code>; os botões possuem rótulos textuais ou acessíveis.
                    A área de conteúdo aceita arquivos arrastados e soltos.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco entre os botões e o campo de arquivo." },
                              new[] { "enter / space", "Aciona o botão focado." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Mode", "string", "advanced", "<code>advanced</code> ou <code>basic</code>." },
                              new[] { "Multiple", "bool", "false", "Permite selecionar vários arquivos." },
                              new[] { "Accept", "string?", "null", "Tipos aceitos (MIME ou extensões separadas por vírgula)." },
                              new[] { "MaxFileSize", "long?", "null", "Tamanho máximo em bytes." },
                              new[] { "FileLimit", "int?", "null", "Número máximo de arquivos." },
                              new[] { "Auto", "bool", "false", "Envia automaticamente após a seleção." },
                              new[] { "CustomUpload", "bool", "false", "Usa <code>UploadHandler</code> em vez do envio interno." },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente." },
                              new[] { "ChooseLabel / UploadLabel / CancelLabel", "string", "Escolher/Enviar/Cancelar", "Rótulos dos botões." },
                              new[] { "ChooseIcon / UploadIcon / CancelIcon", "string", "pi pi-plus/upload/times", "Ícones dos botões." },
                              new[] { "ShowUploadButton / ShowCancelButton", "bool", "true", "Exibe os botões." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos e Templates" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnSelect", "EventCallback&lt;IReadOnlyList&lt;OpFileUploadFile&gt;&gt;", "Disparado ao selecionar arquivos." },
                              new[] { "OnRemove / OnClear", "EventCallback", "Remoção de um arquivo / limpeza da fila." },
                              new[] { "UploadHandler", "EventCallback&lt;IReadOnlyList&lt;OpFileUploadFile&gt;&gt;", "Envio customizado." },
                              new[] { "OnUpload / OnProgress / OnError", "EventCallback", "Notificações de envio." },
                              new[] { "HeaderTemplate / ContentTemplate / ToolbarTemplate / EmptyTemplate", "RenderFragment", "Customização das áreas." },
                              new[] { "FileTemplate", "RenderFragment&lt;OpFileUploadFile&gt;", "Customização de cada item da lista." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="fileupload"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O envio HTTP automático (<code>Url</code> + <code>HttpClient</code>) não foi portado; use <code>CustomUpload</code> + <code>UploadHandler</code> para enviar de fato.</li>
                        <li>A seleção usa o <code>InputFile</code> do Blazor; o arrastar-e-soltar é capturado por um <code>InputFile</code> transparente sobre a área de conteúdo.</li>
                        <li>Miniatura de imagem e badge por arquivo do upstream ainda não são exibidos por padrão.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _uploadedCount;
    private List<string> _lastBatch = new();

    private void OnUploaded(IReadOnlyList<OpFileUploadFile> files)
    {
        _uploadedCount += files.Count;
    }

    private void OnSelected(IReadOnlyList<OpFileUploadFile> files)
    {
        _lastBatch = files.Select(f => f.Name).ToList();
    }

    private void OnCustomUpload(IReadOnlyList<OpFileUploadFile> files)
    {
        _lastBatch = files.Select(f => f.Name).ToList();
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.FileUpload

        <OpFileUpload Multiple="true" />
        """;

    private const string BasicCode = """
        <OpFileUpload Multiple="true" OnUpload="OnUploaded" />

        @code {
            private void OnUploaded(IReadOnlyList<OpFileUploadFile> files) { /* ... */ }
        }
        """;

    private const string SimpleCode = """
        <OpFileUpload Mode="basic" Auto="true" Accept="image/*" />
        """;

    private const string CustomCode = """
        <OpFileUpload Multiple="true" CustomUpload="true" UploadHandler="OnCustomUpload" />

        @code {
            private void OnCustomUpload(IReadOnlyList<OpFileUploadFile> files) { /* enviar */ }
        }
        """;

    private const string ValidationCode = """
        <OpFileUpload Multiple="true" Accept=".pdf,.png,.jpg" MaxFileSize="1048576" FileLimit="3" />
        """;

    private const string TemplateCode = """
        <OpFileUpload Multiple="true">
            <FileTemplate>
                <div class="flex items-center gap-3">
                    <i class="pi pi-file"></i>
                    <div class="flex flex-col">
                        <span>@context.Name</span>
                        <span>@context.ContentType</span>
                    </div>
                </div>
            </FileTemplate>
        </OpFileUpload>
        """;
}
