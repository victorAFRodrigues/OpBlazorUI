@page "/fileupload"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>FileUpload - OpBlazorUI</PageTitle>

<DocComponent Title="FileUpload"
              Description="Upload de arquivos com modos básico e avançado. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular).">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O modo <code>basic</code> oferece uma interface mais simples como alternativa ao modo avançado padrão.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Automático" Id="auto">
            <Description><p>Com a propriedade <code>auto</code>, o arquivo é enviado imediatamente após a seleção.</p></Description>
            <Code><CodeBlock Code="@AutoCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Avançado" Id="advanced">
            <Description><p>O uploader avançado oferece suporte a arrastar-e-soltar, múltiplos arquivos, envio automático, acompanhamento de progresso e validações.</p></Description>
            <Code><CodeBlock Code="@AdvancedCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>A interface do uploader é customizável pelos templates <code>file</code>, <code>content</code> e <code>toolbar</code>.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O FileUpload usa um elemento <code>input</code> nativo oculto com <code>type="file"</code> para leitores de tela.</p>
                <h3>Suporte a teclado</h3>
                <p>Os elementos interativos do uploader são botões; veja a seção de acessibilidade de <a href="/button#accessibility">Button</a>.</p>
            </Description>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { FileUploadModule } from 'primeng/fileupload';
        """;

    private const string BasicCode = """
        <p-fileupload #fu mode="basic" chooseLabel="Choose" chooseIcon="pi pi-upload" name="demo[]"
            url="https://www.primefaces.org/cdn/api/upload.php" accept="image/*" maxFileSize="1000000"
            (onUpload)="onUpload($event)" />
        <p-button label="Upload" (onClick)="fu.upload()" severity="secondary" />
        """;

    private const string AutoCode = """
        <p-fileupload mode="basic" name="demo[]" chooseIcon="pi pi-upload"
            url="https://www.primefaces.org/cdn/api/upload.php" accept="image/*" maxFileSize="1000000"
            (onUpload)="onBasicUploadAuto($event)" [auto]="true" chooseLabel="Browse" />
        """;

    private const string AdvancedCode = """
        <p-fileupload name="demo[]" url="https://www.primefaces.org/cdn/api/upload.php"
            (onUpload)="onUpload($event)" [multiple]="true" accept="image/*" maxFileSize="1000000" mode="advanced">
            <ng-template #empty>
                <div>Drag and drop files to here to upload.</div>
            </ng-template>
        </p-fileupload>
        """;

    private const string TemplateCode = """
        <p-fileupload name="myfile[]" url="https://www.primefaces.org/cdn/api/upload.php" [multiple]="true"
            accept="image/*" maxFileSize="1000000" (onUpload)="onTemplatedUpload()" (onSelect)="onSelectedFiles($event)">
            <ng-template #header let-files let-chooseCallback="chooseCallback" let-clearCallback="clearCallback" let-uploadCallback="uploadCallback">
                <div class="flex flex-wrap justify-between items-center flex-1 gap-4">
                    <div class="flex gap-2">
                        <p-button (onClick)="choose($event, chooseCallback)" icon="pi pi-images" [rounded]="true" [outlined]="true" />
                        <p-button (onClick)="uploadEvent(uploadCallback)" icon="pi pi-cloud-upload" [rounded]="true" [outlined]="true" severity="success" [disabled]="!files || files.length === 0" />
                        <p-button (onClick)="clearCallback()" icon="pi pi-times" [rounded]="true" [outlined]="true" severity="danger" [disabled]="!files || files.length === 0" />
                    </div>
                    <p-progressbar [value]="totalSizePercent" [showValue]="false" class="w-full md:w-20rem h-1 md:ml-auto">
                        <span class="whitespace-nowrap">{{ totalSize }}B / 1Mb</span>
                    </p-progressbar>
                </div>
            </ng-template>
            <ng-template #content let-files let-uploadedFiles="uploadedFiles" let-removeFileCallback="removeFileCallback" let-removeUploadedFileCallback="removeUploadedFileCallback">
                <div class="flex flex-col gap-8 pt-4">
                    <div *ngIf="files?.length > 0">
                        <h5>Pending</h5>
                        <div class="flex flex-wrap gap-4">
                            <div *ngFor="let file of files; let i = index" class="p-8 rounded-border flex flex-col border border-surface items-center gap-4">
                                <img role="presentation" [alt]="file.name" [src]="file.objectURL" width="100" height="50" />
                                <span class="font-semibold text-ellipsis max-w-60 whitespace-nowrap overflow-hidden">{{ file.name }}</span>
                                <div>{{ formatSize(file.size) }}</div>
                                <p-badge value="Pending" severity="warn" />
                                <p-button icon="pi pi-times" (click)="onRemoveTemplatingFile($event, file, removeFileCallback, index)" [outlined]="true" [rounded]="true" severity="danger" />
                            </div>
                        </div>
                    </div>
                </div>
            </ng-template>
            <ng-template #file></ng-template>
            <ng-template #empty>
                <div class="flex items-center justify-center flex-col">
                    <i class="pi pi-cloud-upload !border-2 !rounded-full !p-8 !text-4xl !text-muted-color"></i>
                    <p class="mt-6 mb-0">Drag and drop files to here to upload.</p>
                </div>
            </ng-template>
        </p-fileupload>
        """;
}
