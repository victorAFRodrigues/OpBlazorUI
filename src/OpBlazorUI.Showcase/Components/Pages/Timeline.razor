@page "/timeline"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Timeline
@using OpBlazorUI.Base.Components.Card
@using OpBlazorUI.Base.Components.Button

<PageTitle>Timeline - OpBlazorUI</PageTitle>

<DocComponent Title="Timeline"
              Description="O Timeline visualiza uma série de eventos encadeados.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    O Timeline recebe os eventos pela propriedade <code>Items</code> como uma coleção de objetos
                    arbitrários. O template <code>ContentTemplate</code> é o que exibe a representação de um evento;
                    o tipo do item é inferido a partir de <code>Items</code>. A coleção abaixo é a amostra usada em
                    toda a documentação.
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpTimeline Items="_events">
                        <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                    </OpTimeline>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Alinhamento" Id="alignment">
            <Description>
                <p>
                    A posição do conteúdo em relação à linha é definida com a propriedade <code>Align</code>:
                    <code>left</code> (padrão), <code>right</code> e <code>alternate</code> no layout vertical.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-6">
                    <div style="width:20rem;">
                        <OpTimeline Items="_events">
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                    <div style="width:20rem;">
                        <OpTimeline Items="_events" Align="right">
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                    <div style="width:20rem;">
                        <OpTimeline Items="_events" Align="alternate">
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@AlignmentCode"/></Code>
        </DocSection>

        <DocSection Label="Lado Oposto" Id="opposite">
            <Description>
                <p>Conteúdo adicional no outro lado da linha pode ser fornecido pelo template
                <code>OppositeTemplate</code>.</p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpTimeline Items="_events">
                        <OppositeTemplate Context="ev">
                            <span class="text-sm text-muted-color">@ev.Date</span>
                        </OppositeTemplate>
                        <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                    </OpTimeline>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@OppositeCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                <p>
                    Implementação de exemplo com conteúdo personalizado (<code>ContentTemplate</code>) e marcadores
                    estilizados (<code>MarkerTemplate</code>). O <code>MarkerTemplate</code> substitui o marcador
                    padrão de cada evento.
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpTimeline Items="_events" Align="alternate">
                        <MarkerTemplate Context="ev">
                            <span class="inline-flex items-center justify-center rounded-full"
                                  style="width:2rem;height:2rem;background-color:@ev.Color;color:#fff;">
                                <i class="@ev.Icon"></i>
                            </span>
                        </MarkerTemplate>
                        <ContentTemplate Context="ev">
                            <OpCard Header="@ev.Status" Subheader="@ev.Date">
                                <p class="m-0">
                                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Inventore sed
                                    consequuntur error repudiandae numquam deserunt.
                                </p>
                                <OpButton Label="Ler mais" Variant="text"/>
                            </OpCard>
                        </ContentTemplate>
                    </OpTimeline>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Horizontal" Id="horizontal">
            <Description>
                <p>
                    A orientação do Timeline é controlada com a propriedade <code>Layout</code>; o padrão é
                    <code>vertical</code>, tendo <code>horizontal</code> como alternativa. No layout horizontal, o
                    <code>Align</code> aceita <code>top</code> (padrão), <code>bottom</code> e
                    <code>alternate</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-6">
                    <div style="width:100%;">
                        <OpTimeline Items="_events" Layout="horizontal" Align="top">
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                    <div style="width:100%;">
                        <OpTimeline Items="_events" Layout="horizontal" Align="bottom">
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                    <div style="width:100%;">
                        <OpTimeline Items="_events" Layout="horizontal" Align="alternate">
                            <OppositeTemplate Context="ev"><span>&nbsp;</span></OppositeTemplate>
                            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
                        </OpTimeline>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@HorizontalCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O componente renderiza um contêiner com os eventos como elementos <code>&lt;div&gt;</code> e não
                    impõe nenhum papel. Como qualquer atributo extra é repassado ao elemento raiz, defina papéis e
                    atributos ARIA (por exemplo, <code>role="list"</code> com <code>aria-label</code>) quando a lista
                    precisar ser anunciada como agrupamento.
                </p>
                <h3>Suporte a teclado</h3>
                <p>O componente não inclui nenhum elemento interativo.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Items", "IReadOnlyList&lt;TItem&gt;", "[]", "Coleção de eventos; define o tipo <code>TItem</code> por inferência." },
                              new[] { "Layout", "string", "\"vertical\"", "Orientação: <code>vertical</code> ou <code>horizontal</code>." },
                              new[] { "Align", "string", "\"left\"", "Alinhamento: <code>left</code>/<code>right</code>/<code>alternate</code> (vertical) ou <code>top</code>/<code>bottom</code>/<code>alternate</code> (horizontal)." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Contexto", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ContentTemplate", "TItem", "Conteúdo do evento (obrigatório para exibir a representação do evento)." },
                              new[] { "OppositeTemplate", "TItem", "Conteúdo do lado oposto da linha." },
                              new[] { "MarkerTemplate", "TItem", "Substitui o marcador padrão do evento." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><DocTokens Component="timeline"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular não foi portado. Para customização de estilo, use
                    <code>StyleClass</code>, os templates e os <code>AdditionalAttributes</code> (repassados ao
                    elemento raiz).</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>O componente usa elementos <code>&lt;div&gt;</code> para os eventos, sem papel de lista automático, diferente da descrição de acessibilidade do upstream.</li>
                        <li><code>ContentTemplate</code> é opcional na API, mas sem ele a área de conteúdo fica vazia; trate-o como obrigatório.</li>
                        <li>Não há animações de transição nem de entrada/saída.</li>
                        <li><code>Align</code> não é validado: valores fora da lista geram uma classe desconhecida.</li>
                        <li>Não há suporte a linhas de conexão customizadas além do conector padrão do tema.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private sealed record TimelineEvent(string Status, string Date, string Icon, string Color);

    private static readonly TimelineEvent[] _events =
    [
        new("Pedido realizado", "15/10/2020 10:30", "pi pi-shopping-cart", "#9C27B0"),
        new("Em processamento", "15/10/2020 14:00", "pi pi-cog", "#673AB7"),
        new("Enviado", "15/10/2020 16:15", "pi pi-send", "#FF9800"),
        new("Entregue", "16/10/2020 10:00", "pi pi-check", "#607D8B")
    ];

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Timeline

        <OpTimeline Items="_events">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>

        @code {
            private sealed record TimelineEvent(string Status, string Date, string Icon, string Color);

            private readonly TimelineEvent[] _events =
            [
                new("Pedido realizado", "15/10/2020 10:30", "pi pi-shopping-cart", "#9C27B0")
            ];
        }
        """;

    private const string BasicCode = """
        <OpTimeline Items="_events">
            <ContentTemplate Context="ev">
                @ev.Status
            </ContentTemplate>
        </OpTimeline>

        @code {
            private sealed record TimelineEvent(string Status, string Date, string Icon, string Color);

            private readonly TimelineEvent[] _events =
            [
                new("Pedido realizado", "15/10/2020 10:30", "pi pi-shopping-cart", "#9C27B0"),
                new("Em processamento", "15/10/2020 14:00", "pi pi-cog", "#673AB7"),
                new("Enviado", "15/10/2020 16:15", "pi pi-send", "#FF9800"),
                new("Entregue", "16/10/2020 10:00", "pi pi-check", "#607D8B")
            ];
        }
        """;

    private const string AlignmentCode = """
        <OpTimeline Items="_events">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>

        <OpTimeline Items="_events" Align="right">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>

        <OpTimeline Items="_events" Align="alternate">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>
        """;

    private const string OppositeCode = """
        <OpTimeline Items="_events">
            <OppositeTemplate Context="ev">
                <span class="text-sm text-muted-color">@ev.Date</span>
            </OppositeTemplate>
            <ContentTemplate Context="ev">
                @ev.Status
            </ContentTemplate>
        </OpTimeline>
        """;

    private const string TemplateCode = """
        <OpTimeline Items="_events" Align="alternate">
            <MarkerTemplate Context="ev">
                <span class="inline-flex items-center justify-center rounded-full"
                      style="width:2rem;height:2rem;background-color:@ev.Color;color:#fff;">
                    <i class="@ev.Icon"></i>
                </span>
            </MarkerTemplate>
            <ContentTemplate Context="ev">
                <OpCard Header="@ev.Status" Subheader="@ev.Date">
                    <p class="m-0">Lorem ipsum dolor sit amet, consectetur adipisicing elit.</p>
                    <OpButton Label="Ler mais" Variant="text" />
                </OpCard>
            </ContentTemplate>
        </OpTimeline>
        """;

    private const string HorizontalCode = """
        <OpTimeline Items="_events" Layout="horizontal" Align="top">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>

        <OpTimeline Items="_events" Layout="horizontal" Align="bottom">
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>

        <OpTimeline Items="_events" Layout="horizontal" Align="alternate">
            <OppositeTemplate Context="ev"><span>&nbsp;</span></OppositeTemplate>
            <ContentTemplate Context="ev">@ev.Status</ContentTemplate>
        </OpTimeline>
        """;

    private const string AccessibilityCode = """
        <OpTimeline Items="_events" role="list" aria-label="Histórico do pedido">
            <ContentTemplate Context="ev">
                <span>@ev.Status — @ev.Date</span>
            </ContentTemplate>
        </OpTimeline>
        """;
}
