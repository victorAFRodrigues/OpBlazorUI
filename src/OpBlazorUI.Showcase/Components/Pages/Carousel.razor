@page "/carousel"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Carousel

<PageTitle>Carousel - OpBlazorUI</PageTitle>

<DocComponent Title="Carousel"
              Description="Carousel é um controle deslizante de conteúdo com opções de orientação, autoplay e navegação circular.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    O Carousel exige uma coleção em <code>Value</code> e um <code>ItemTemplate</code> para renderizar
                    cada item. O número de itens visíveis e o número de itens por rolagem são definidos por
                    <code>NumVisible</code> e <code>NumScroll</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpCarousel TItem="Product" Value="_products" NumVisible="3" NumScroll="1">
                        <ItemTemplate Context="product">
                            <div style="border:1px solid var(--p-content-border-color); border-radius:var(--p-content-border-radius); margin:.5rem; padding:1rem;">
                                <div class="mb-4" style="background:var(--p-surface-50); border-radius:var(--p-content-border-radius); padding:1rem; display:flex; justify-content:center;">
                                    <img src="@product.Image" alt="@product.Name" class="w-full" style="border-radius:var(--p-content-border-radius); display:block;"/>
                                </div>
                                <div class="mb-2 font-medium">@product.Name</div>
                                <div class="flex justify-between items-center">
                                    <div class="font-semibold text-xl">$@product.Price</div>
                                    <span class="flex gap-2">
                                        <i class="pi pi-heart text-muted-color" aria-hidden="true"></i>
                                        <i class="pi pi-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                        </ItemTemplate>
                    </OpCarousel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Circular" Id="circular">
            <Description>
                <p>
                    Quando <code>AutoPlayInterval</code> é definido em milissegundos, os itens rolam automaticamente.
                    Para rolagem infinita, adicione <code>Circular="true"</code>. O autoplay só é ativado quando há mais
                    itens do que itens visíveis.
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpCarousel TItem="Product" Value="_products" NumVisible="3" NumScroll="1"
                                Circular="true" AutoPlayInterval="3000">
                        <ItemTemplate Context="product">
                            <div style="border:1px solid var(--p-content-border-color); border-radius:var(--p-content-border-radius); margin:.5rem; padding:1rem;">
                                <div class="mb-4" style="background:var(--p-surface-50); border-radius:var(--p-content-border-radius); padding:1rem; display:flex; justify-content:center;">
                                    <img src="@product.Image" alt="@product.Name" class="w-full" style="border-radius:var(--p-content-border-radius); display:block;"/>
                                </div>
                                <div class="mb-2 font-medium">@product.Name</div>
                                <div class="flex justify-between items-center">
                                    <div class="font-semibold text-xl">$@product.Price</div>
                                    <span class="flex gap-2">
                                        <i class="pi pi-heart text-muted-color" aria-hidden="true"></i>
                                        <i class="pi pi-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                        </ItemTemplate>
                    </OpCarousel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CircularCode"/></Code>
        </DocSection>

        <DocSection Label="Responsivo" Id="responsive">
            <Description>
                <p>
                    A configuração por tamanho de tela é declarada com <code>ResponsiveOptions</code>, uma coleção de
                    breakpoints com <code>NumVisible</code> e <code>NumScroll</code>. Nesta versão a propriedade é aceita
                    mas ainda não aplicada — veja Problemas Conhecidos.
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpCarousel TItem="Product" Value="_products" NumVisible="3" NumScroll="1"
                                ResponsiveOptions="_responsiveOptions">
                        <ItemTemplate Context="product">
                            <div style="border:1px solid var(--p-content-border-color); border-radius:var(--p-content-border-radius); margin:.5rem; padding:1rem;">
                                <div class="mb-4" style="background:var(--p-surface-50); border-radius:var(--p-content-border-radius); padding:1rem; display:flex; justify-content:center;">
                                    <img src="@product.Image" alt="@product.Name" class="w-full" style="border-radius:var(--p-content-border-radius); display:block;"/>
                                </div>
                                <div class="mb-2 font-medium">@product.Name</div>
                                <div class="flex justify-between items-center">
                                    <div class="font-semibold text-xl">$@product.Price</div>
                                    <span class="flex gap-2">
                                        <i class="pi pi-heart text-muted-color" aria-hidden="true"></i>
                                        <i class="pi pi-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                        </ItemTemplate>
                    </OpCarousel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ResponsiveCode"/></Code>
        </DocSection>

        <DocSection Label="Vertical" Id="vertical">
            <Description>
                <p>
                    Para criar um Carousel vertical, defina <code>Orientation="vertical"</code> junto com uma altura em
                    <code>VerticalViewPortHeight</code> (por exemplo, <code>330px</code>).
                </p>
            </Description>
            <ChildContent>
                <div class="card">
                    <OpCarousel TItem="Product" Value="_products" NumVisible="1" NumScroll="1"
                                Orientation="vertical" VerticalViewPortHeight="330px" ContentClass="flex items-center">
                        <ItemTemplate Context="product">
                            <div style="border:1px solid var(--p-content-border-color); border-radius:var(--p-content-border-radius); margin:.5rem; padding:1rem; display:flex; gap:1rem; align-items:center;">
                                <img src="@product.Image" alt="@product.Name" class="w-40" style="border-radius:var(--p-content-border-radius); display:block;"/>
                                <div class="flex flex-col gap-2">
                                    <div class="font-medium">@product.Name</div>
                                    <div class="font-semibold text-xl">$@product.Price</div>
                                    <span class="flex gap-2">
                                        <i class="pi pi-heart text-muted-color" aria-hidden="true"></i>
                                        <i class="pi pi-shopping-cart" aria-hidden="true"></i>
                                    </span>
                                </div>
                            </div>
                        </ItemTemplate>
                    </OpCarousel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VerticalCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O Carousel não define papéis ARIA ricos por padrão; o elemento raiz recebe os atributos extras
                    repassados, permitindo <code>aria-label</code> e <code>aria-roledescription</code>. Os botões
                    Anterior/Próximo são <code>button</code> nativos com <code>aria-label</code>, e os indicadores são
                    botões com <code>aria-label="Página N"</code>.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <ApiTable Caption="Navegação"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco pelos botões de navegação e indicadores." },
                              new[] { "enter / space", "Ativa o botão focado (anterior, próximo ou página)." },
                              new[] { "left / right arrow", "Navega entre as páginas (previsto no upstream; não implementado nesta versão)." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "IReadOnlyList&lt;TItem&gt;", "[]", "Coleção de itens exibida pelo carousel." },
                              new[] { "NumVisible", "int", "1", "Quantidade de itens visíveis por página." },
                              new[] { "NumScroll", "int", "1", "Quantidade de itens rolados por navegação." },
                              new[] { "Page", "int", "0", "Índice do primeiro item da página; usar com <code>&#64;bind-Page</code>." },
                              new[] { "Circular", "bool", "false", "Retorna à primeira página após a última (e vice-versa)." },
                              new[] { "Orientation", "string", "\"horizontal\"", "Orientação: <code>horizontal</code> ou <code>vertical</code>." },
                              new[] { "VerticalViewPortHeight", "string", "\"300px\"", "Altura da viewport no modo vertical." },
                              new[] { "AutoPlayInterval", "int", "0", "Intervalo do autoplay em ms; <code>0</code> desliga." },
                              new[] { "ResponsiveOptions", "object?", "null", "Breakpoints responsivos (aceito, ainda não aplicado)." },
                              new[] { "ContentClass", "string?", "null", "Classes adicionais no contêiner de conteúdo." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz." },
                              new[] { "Id", "string?", "null", "Id do elemento raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "PageChanged", "EventCallback&lt;int&gt;", "Notifica a mudança de página (binding de <code>Page</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;TItem&gt;?", "Conteúdo de cada item." },
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo exibido acima do carousel." },
                              new[] { "FooterTemplate", "RenderFragment?", "Conteúdo exibido abaixo do carousel." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Registro do item (exemplo Product)" Id="api-item">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Name", "string", "Nome do produto." },
                              new[] { "Image", "string", "URL da imagem do produto." },
                              new[] { "Price", "string", "Preço exibido no item." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><DocTokens Component="carousel"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description">
                    <p>O pass-through (pt) do Angular não foi portado. Para customização de estilo, use
                    <code>StyleClass</code>, os templates e os <code>AdditionalAttributes</code> (repassados ao
                    elemento raiz).</p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li><code>ResponsiveOptions</code> é aceito por compatibilidade, mas os breakpoints não são aplicados: <code>NumVisible</code> e <code>NumScroll</code> permanecem fixos.</li>
                        <li>Não há suporte a <em>swipe</em>/arraste nem a toque; a navegação é feita apenas pelos botões e indicadores.</li>
                        <li>O autoplay é um timer que reinicia a cada renderização (a cada atualização de parâmetros), podendo reiniciar a contagem.</li>
                        <li>Os itens usam <code>flex-basis</code> fixo (sem virtualização) e o modo circular apenas reposiciona a página, sem laço contínuo.</li>
                        <li>Os rótulos acessíveis (Anterior/Próximo/Página N) estão fixos em pt-BR, sem integração com a API de <em>locale</em>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

