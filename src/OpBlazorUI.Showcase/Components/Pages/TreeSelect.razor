@page "/treeselect"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.TreeSelect
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.IftaLabel
@using System.ComponentModel.DataAnnotations

<PageTitle>TreeSelect - OpBlazorUI</PageTitle>

<DocComponent Title="TreeSelect"
              Description="O TreeSelect é um componente de formulário para escolher dados hierárquicos.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O TreeSelect funciona como um componente controlado por <code>@@bind-Value</code>, junto de uma
                coleção <code>Options</code>. Os nós seguem a API <code>TreeNode</code> (<code>Key</code>,
                <code>Label</code>, <code>Children</code>, <code>Data</code>, <code>Leaf</code>,
                <code>Loading</code> e <code>Expanded</code>). No modo de seleção única — <code>SelectionMode</code>
                é <code>single</code> por padrão — o valor vinculado é a <code>Key</code> do nó.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_basicKey" Options="Nodes" Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                    <div class="mt-2 text-sm">Selecionado: @(_basicKey ?? "—")</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Múltiplo" Id="multiple">
            <Description>
                Mais de um nó pode ser selecionado definindo <code>SelectionMode="multiple"</code>. Nesse modo a
                seleção é um dicionário chave-valor (<code>IReadOnlyDictionary&lt;string,bool&gt;</code>) ligado a
                <code>@@bind-Selection</code>, onde a chave é a <code>Key</code> do nó e o valor indica se ele está
                selecionado. Diferente do Angular, não há <code>MetaKeySelection</code>: o clique simples alterna a
                seleção.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Selection="_multiSelection" Options="Nodes" SelectionMode="multiple"
                                      Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                    <div class="mt-2 text-sm">Selecionados: @Count(_multiSelection)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Checkbox" Id="checkbox">
            <Description>
                A seleção de múltiplos nós via checkboxes é habilitada com <code>SelectionMode="checkbox"</code>.
                Marcar um nó propaga a seleção aos descendentes, e os nós pais ficam em estado indeterminado quando
                apenas parte dos filhos está selecionada. Combine com <code>Display="chip"</code> para exibir as
                escolhas como chips removíveis.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:22rem;">
                        <OpTreeSelect @bind-Selection="_checkboxSelection" Options="Nodes" Display="chip"
                                      SelectionMode="checkbox" Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckboxCode"/></Code>
        </DocSection>

        <DocSection Label="Scroll Virtual" Id="virtual-scroll-doc">
            <Description>
                Para grandes volumes de nós, <code>VirtualScroll="true"</code> renderiza apenas os itens visíveis e
                <code>VirtualScrollItemSize</code> define a altura de cada item em pixels. Como a árvore é achatada
                para a virtualização, defina <code>ScrollHeight</code> para limitar a área da lista; os filhos só
                entram na lista quando o nó é expandido.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:22rem;">
                        <OpTreeSelect @bind-Selection="_virtualSelection" Options="_largeNodes" Display="chip"
                                      SelectionMode="checkbox" VirtualScroll="true" VirtualScrollItemSize="38"
                                      ScrollHeight="200px" Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VirtualScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Lazy" Id="lazy">
            <Description>
                O carregamento sob demanda é feito com <code>OnNodeExpand</code> e a propriedade
                <code>Loading</code> do nó. Ao expandir um nó sem filhos, o componente o marca como carregando e
                dispara o callback; no handler você popula <code>Children</code> e zera <code>Loading</code>.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:22rem;">
                        <OpTreeSelect @bind-Selection="_lazySelection" Options="_lazyNodes" Display="chip"
                                      SelectionMode="checkbox" Placeholder="Selecione um Item"
                                      OnNodeExpand="OnLazyNodeExpand" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LazyCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description>
                A filtragem é habilitada com <code>Filter="true"</code>. Por padrão o campo <code>Label</code> do nó
                é usado na comparação; <code>FilterBy</code> permite escolher outro campo. <code>FilterMode</code>
                define a estratégia: em <code>lenient</code> (padrão) quando um nó corresponde, seus descendentes são
                incluídos sem nova busca; em <code>strict</code> a busca continua nos descendentes.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_filterKey" Options="Nodes" Filter="true"
                                      Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                O TreeSelect oferece vários templates. <code>HeaderTemplate</code> e <code>FooterTemplate</code>
                decoram o topo e o rodapé do overlay; <code>DropdownIconTemplate</code> substitui a seta;
                <code>EmptyTemplate</code> substitui a mensagem de vazio; e <code>ClearIconTemplate</code>,
                <code>LoadingIconTemplate</code> e <code>ItemTogglerIconTemplate</code> (contexto
                <code>TreeNode</code>) customizam os ícones.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_templateKey" Options="Nodes" Placeholder="Selecione um Item">
                            <DropdownIconTemplate>
                                <i class="pi pi-search"></i>
                            </DropdownIconTemplate>
                            <HeaderTemplate>
                                <div style="padding:.5rem .75rem; font-weight:500;">Arquivos disponíveis</div>
                            </HeaderTemplate>
                            <FooterTemplate>
                                <div style="padding:.5rem .75rem; display:flex; justify-content:space-between; gap:.5rem;">
                                    <button type="button" class="p-button p-component p-button-secondary" style="padding:.25rem .5rem;">Adicionar</button>
                                    <button type="button" class="p-button p-component p-button-danger" style="padding:.25rem .5rem;">Remover Tudo</button>
                                </div>
                            </FooterTemplate>
                        </OpTreeSelect>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="FloatLabel" Id="floatlabel">
            <Description>
                Combine com <code>OpFloatLabel</code> para obter um rótulo flutuante. Informe <code>InputId</code> no
                TreeSelect e um <code>&lt;label for&gt;</code> correspondente. A variante é definida no
                <code>OpFloatLabel</code>: <code>over</code> (padrão), <code>in</code> ou <code>on</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <div style="width:100%; max-width:20rem;">
                        <OpFloatLabel StyleClass="w-full">
                            <OpTreeSelect @bind-Value="_fl1" InputId="ts_over" Options="Nodes" StyleClass="w-full"/>
                            <label for="ts_over">Sobre</label>
                        </OpFloatLabel>
                    </div>
                    <div style="width:100%; max-width:20rem;">
                        <OpFloatLabel Variant="in" StyleClass="w-full">
                            <OpTreeSelect @bind-Value="_fl2" InputId="ts_in" Options="Nodes" StyleClass="w-full"/>
                            <label for="ts_in">Dentro</label>
                        </OpFloatLabel>
                    </div>
                    <div style="width:100%; max-width:20rem;">
                        <OpFloatLabel Variant="on" StyleClass="w-full">
                            <OpTreeSelect @bind-Value="_fl3" InputId="ts_on" Options="Nodes" StyleClass="w-full"/>
                            <label for="ts_on">Na borda</label>
                        </OpFloatLabel>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FloatLabelCode"/></Code>
        </DocSection>

        <DocSection Label="IftaLabel" Id="iftalabel">
            <Description>
                <code>OpIftaLabel</code> cria um rótulo alinhado no topo, dentro do campo. Assim como no FloatLabel,
                use <code>InputId</code> no TreeSelect e um <code>&lt;label for&gt;</code> correspondente.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpIftaLabel StyleClass="w-full">
                            <OpTreeSelect @bind-Value="_ifta" InputId="ts_ifta" Options="Nodes" StyleClass="w-full"/>
                            <label for="ts_ifta">Arquivo</label>
                        </OpIftaLabel>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@IftaLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone de Limpar" Id="clearicon">
            <Description>
                Com <code>ShowClear="true"</code>, um ícone de limpar aparece quando há seleção, removendo o valor
                (e disparando <code>OnClear</code>).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_clearKey" Options="Nodes" ShowClear="true"
                                      Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ClearIconCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos" Id="sizes">
            <Description>
                O TreeSelect oferece os tamanhos <code>small</code> e <code>large</code> como alternativas ao
                padrão, via propriedade <code>Size</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_size1" Options="Nodes" Size="small" Placeholder="Small" StyleClass="w-full"/>
                    </div>
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_size2" Options="Nodes" Placeholder="Normal" StyleClass="w-full"/>
                    </div>
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_size3" Options="Nodes" Size="large" Placeholder="Large" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizesCode"/></Code>
        </DocSection>

        <DocSection Label="Largura Total" Id="fluid">
            <Description>
                Com <code>Fluid="true"</code> o componente ocupa toda a largura do contêiner.
            </Description>
            <ChildContent>
                <div style="width:100%; max-width:32rem;">
                    <OpTreeSelect @bind-Value="_fluidKey" Options="Nodes" Fluid="true" Placeholder="Selecione um Item"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FluidCode"/></Code>
        </DocSection>

        <DocSection Label="Preenchido" Id="filled">
            <Description>
                <code>Variant="filled"</code> exibe o componente com maior ênfase visual que o estilo
                <code>outlined</code> (padrão).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_filledKey" Options="Nodes" Variant="filled"
                                      Placeholder="Selecione um Item" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description>
                Com <code>Disabled="true"</code> o componente não pode ser editado nem focado.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_disabledKey" Options="Nodes" Disabled="true"
                                      Placeholder="TreeSelect" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido" Id="invalid">
            <Description>
                <code>Invalid="true"</code> aplica o estado de erro, útil para indicar validação falha fora de um
                <code>EditForm</code>. Dentro dele, o estado de erro vem do <code>EditContext</code> e
                <code>Invalid</code> é somado a ele.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-4">
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_invalidKey1" Options="Nodes" Invalid="true"
                                      Placeholder="TreeSelect" StyleClass="w-full"/>
                    </div>
                    <div style="width:100%; max-width:20rem;">
                        <OpTreeSelect @bind-Value="_invalidKey2" Options="Nodes" Invalid="true" Variant="filled"
                                      Placeholder="TreeSelect" StyleClass="w-full"/>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários (Template Driven)" Id="templatedriven">
            <Description>
                Como herda de <code>OpInputBase&lt;string&gt;</code> (que estende <code>InputBase&lt;string&gt;</code>),
                o TreeSelect integra-se ao <code>EditForm</code> com <code>DataAnnotationsValidator</code> e
                <code>ValidationMessage</code>. O <code>@@bind-Value</code> gera o <code>ValueExpression</code> que
                registra o campo no <code>EditContext</code>; o <code>p-invalid</code> sai automaticamente quando há
                erro de validação — não passe <code>Invalid</code> manualmente.
            </Description>
            <ChildContent>
                <EditForm Model="_tdForm" OnValidSubmit="SubmitTemplateDriven" class="flex flex-col items-start gap-3">
                    <DataAnnotationsValidator/>
                    <OpTreeSelect @bind-Value="_tdForm.Key" Options="Nodes" Placeholder="Selecione um Item" StyleClass="w-full"/>
                    <ValidationMessage For="() => _tdForm.Key"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_tdSubmitted)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Selecionado: @_tdForm.Key</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateDrivenCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários (Reactive)" Id="reactive">
            <Description>
                No Angular, os <i>Reactive Forms</i> validam o modelo programaticamente com <code>FormBuilder</code>.
                No Blazor o mesmo <code>EditForm</code> cobre os dois casos: use <code>OnSubmit</code> e
                <code>EditContext.Validate()</code> para controlar a validação no código.
            </Description>
            <ChildContent>
                <EditForm Model="_reForm" OnSubmit="SubmitReactive" class="flex flex-col items-start gap-3">
                    <DataAnnotationsValidator/>
                    <OpTreeSelect @bind-Value="_reForm.Key" Options="Nodes" Placeholder="Selecione um Item" StyleClass="w-full"/>
                    <ValidationMessage For="() => _reForm.Key"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_reMessage is not null)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">@_reMessage</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@ReactiveCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O valor que descreve o componente pode ser informado com <code>AriaLabel</code>. O campo tem
                    <code>role="combobox"</code>, <code>aria-haspopup="tree"</code> e <code>aria-expanded</code>; a
                    relação com o popup é feita por <code>aria-controls</code>, que aponta para o <code>id</code> da
                    árvore. A árvore usa <code>role="tree"</code>; cada item é um <code>treeitem</code> com
                    <code>aria-label</code>, <code>aria-selected</code> e <code>aria-expanded</code>, e o contêiner
                    dos filhos usa <code>role="group"</code>. No modo checkbox os itens usam <code>aria-selected</code>
                    (não <code>aria-checked</code>).
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description">
                    <h3>Suporte a teclado</h3>
                    <p>
                        A tabela abaixo reflete a especificação de teclado do TreeSelect no upstream; no port atual
                        apenas <code>escape</code> e <code>tab</code> estão implementados (ver Problemas Conhecidos).
                    </p>
                </div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o TreeSelect." },
                              new[] { "space / down arrow", "Abre o popup e foca o nó selecionado (ou o primeiro nó)." },
                              new[] { "enter / space", "Seleciona o nó em foco e fecha o popup no modo único." },
                              new[] { "escape", "Fecha o popup e devolve o foco ao TreeSelect." },
                              new[] { "down / up arrow", "Move o foco para o próximo/anterior nó." },
                              new[] { "right arrow", "Abre o nó ou foca o primeiro filho." },
                              new[] { "left arrow", "Fecha o nó ou foca o nó pai." },
                              new[] { "shift + tab", "Move o foco para o elemento anterior dentro do popup." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;TreeNode&gt;?", "null", "Coleção raiz de nós da árvore." },
                              new[] { "Selection", "IReadOnlyDictionary&lt;string, bool&gt;?", "null", "Seleção por chave nos modos <code>multiple</code> e <code>checkbox</code>. Combine com <code>&#64;bind-Selection</code>." },
                              new[] { "SelectionMode", "string", "single", "Modo de seleção: <code>single</code>, <code>multiple</code> ou <code>checkbox</code>." },
                              new[] { "Display", "string", "comma", "Formato de exibição das seleções: <code>comma</code> ou <code>chip</code>." },
                              new[] { "Placeholder", "string?", "null", "Texto exibido quando nada está selecionado." },
                              new[] { "Filter", "bool", "false", "Habilita o campo de filtro no topo do overlay." },
                              new[] { "FilterBy", "string", "label", "Campo(s) usados no filtro, separados por vírgula." },
                              new[] { "FilterMode", "string", "lenient", "Estratégia de filtro: <code>lenient</code> ou <code>strict</code>." },
                              new[] { "ShowClear", "bool", "false", "Exibe o ícone de limpar quando há seleção." },
                              new[] { "Required", "bool", "false", "Marca o campo como obrigatório (declarativo)." },
                              new[] { "Variant", "string", "outlined", "Variante visual: <code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura disponível." },
                              new[] { "ScrollHeight", "string?", "null", "Altura máxima da lista de nós. Quando omitido, usa <code>400px</code>." },
                              new[] { "VirtualScroll", "bool", "false", "Habilita a renderização virtual dos nós visíveis." },
                              new[] { "VirtualScrollItemSize", "int", "38", "Altura, em pixels, de cada nó no scroll virtual." },
                              new[] { "EmptyMessage", "string?", "No results found", "Mensagem exibida quando não há nós." },
                              new[] { "Loading", "bool", "false", "Exibe o spinner no lugar do ícone do dropdown." },
                              new[] { "LoadingMode", "string", "mask", "Modo de carregamento: <code>mask</code> ou <code>icon</code>. No port atual o parâmetro não tem efeito." },
                              new[] { "TabIndex", "int", "0", "Ordem de tabulação." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível do combobox." },
                              new[] { "InputId", "string?", "null", "Id base do componente, usado com <code>&lt;label for&gt;</code>." },
                              new[] { "PanelStyleClass", "string?", "null", "Classes adicionais no overlay." },
                              new[] { "Value", "string?", "null", "Chave do nó selecionado no modo <code>single</code>. Combine com <code>&#64;bind-Value</code>. (herdado)" },
                              new[] { "ValueChanged", "EventCallback&lt;string?&gt;", "-", "Callback de binding do valor selecionado. (herdado)" },
                              new[] { "ValueExpression", "Expression&lt;Func&lt;string?&gt;&gt;?", "null", "Expressão do campo para o <code>EditForm</code>; gerada por <code>&#64;bind-Value</code>. (herdado)" },
                              new[] { "Invalid", "bool", "false", "Estado de erro; somado ao estado do <code>EditContext</code>. (herdado)" },
                              new[] { "Disabled", "bool", "false", "Desabilita o componente. (herdado)" },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais no elemento raiz. (herdado)" },
                              new[] { "CssClass", "string?", "null", "Classes de validação do campo no <code>EditContext</code>. (herdado)" },
                              new[] { "DisplayName", "string?", "null", "Nome do campo nas mensagens de validação. (herdado)" },
                              new[] { "AdditionalAttributes", "IReadOnlyDictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao elemento raiz. (herdado)" }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "SelectionChanged", "EventCallback&lt;IReadOnlyDictionary&lt;string, bool&gt;?&gt;", "Callback de binding de <code>Selection</code>; disparado ao alterar a seleção múltipla." },
                              new[] { "ValueChanged", "EventCallback&lt;string?&gt;", "Callback de binding de <code>Value</code>; disparado ao alterar a seleção única. (herdado)" },
                              new[] { "OnNodeExpand", "EventCallback&lt;TreeNode&gt;", "Disparado ao expandir (ou carregar) um nó." },
                              new[] { "OnNodeCollapse", "EventCallback&lt;TreeNode&gt;", "Disparado ao recolher um nó." },
                              new[] { "OnNodeSelect", "EventCallback&lt;TreeNode&gt;", "Disparado ao selecionar um nó." },
                              new[] { "OnNodeUnselect", "EventCallback&lt;TreeNode&gt;", "Disparado ao desmarcar um nó." },
                              new[] { "OnFilter", "EventCallback&lt;string&gt;", "Disparado ao digitar no campo de filtro; recebe o texto atual." },
                              new[] { "OnShow", "EventCallback", "Disparado ao exibir o overlay." },
                              new[] { "OnHide", "EventCallback", "Disparado ao ocultar o overlay." },
                              new[] { "OnClear", "EventCallback", "Disparado ao limpar a seleção." },
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar o campo." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar o campo." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "HeaderTemplate", "RenderFragment?", "Conteúdo no topo do overlay, antes do filtro." },
