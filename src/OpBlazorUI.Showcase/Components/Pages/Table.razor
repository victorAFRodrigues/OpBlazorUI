@page "/table"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.DataTable
@using OpBlazorUI.Components.Badge
@using OpBlazorUI.Components.Button
@using OpBlazorUI.Components.Dialog
@using OpBlazorUI.Components.InputNumber
@using OpBlazorUI.Components.InputText
@using OpBlazorUI.Components.Menu
@using OpBlazorUI.Components.MultiSelect
@using OpBlazorUI.Components.Tag
@using OpBlazorUI.Components.ToggleButton
@using OpBlazorUI.Models
@using Microsoft.AspNetCore.Components.Web
@using System.ComponentModel.DataAnnotations
@using System.Text

<PageTitle>Table - OpBlazorUI</PageTitle>

<DocComponent Title="Table"
              Description="A tabela exibe dados em formato tabular.">

    <Features>
        <DocSection Label="Importação" Id="import-demo">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <code>Items</code> recebe a lista de dados e <code>Columns</code> a definição das colunas.
                Cada coluna lê uma propriedade pública do item pelo nome informado em <code>Field</code>
                (a comparação ignora maiúsculas/minúsculas). Sem template de célula, o valor é exibido com
                <code>ToString()</code>.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" Paginator="true" Rows="5" Sortable="true" RowHover="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Colunas Dinâmicas" Id="dynamic">
            <Description>
                As colunas são apenas dados: monte a lista de <code>OpDataTableColumn</code> em tempo de execução
                e atribua a <code>Columns</code>. O exemplo alterna entre o conjunto completo e um reduzido.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="_dynamicCols"/>
                    <div class="flex flex-wrap gap-4 items-center">
                        <OpButton Label="Alternar colunas" Icon="pi pi-table" OnClick="ToggleColumns"/>
                        <span class="text-sm">@_dynamicCols.Count coluna(s) visível(is)</span>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DynamicCode"/></Code>
        </DocSection>

        <DocSection Label="Templates de Coluna" Id="template">
            <Description>
                Para formatar a célula (moeda, badges, botões) use <code>OpDataTableColumn&lt;TItem&gt;</code>
                com <code>BodyTemplate</code> (tipado). <code>HeaderTemplate</code> e <code>FooterTemplate</code>
                substituem o título e o rodapé. Uma coluna com template não precisa de <code>Field</code> para
                exibir conteúdo, mas mantenha-o se quiser ordená-la ou filtrá-la. Ao definir qualquer rodapé, o
                componente renderiza um <code>&lt;tfoot&gt;</code> com todas as colunas.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="_tmplCols"/>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanho" Id="size">
            <Description>
                <code>Size</code> aceita <code>small</code> ou <code>large</code>; sem valor, a tabela usa o
                tamanho padrão do tema.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Size="small"/>
                    <OpDataTable Items="Products" Columns="Cols"/>
                    <OpDataTable Items="Products" Columns="Cols" Size="large"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas de Grade" Id="gridlines">
            <Description>
                <code>ShowGridlines</code> desenha as bordas entre as células.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" ShowGridlines="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@GridlinesCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas Listradas" Id="striped">
            <Description>
                <code>StripedRows</code> alterna o fundo das linhas pares e ímpares.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" StripedRows="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@StripedCode"/></Code>
        </DocSection>

        <DocSection Label="Estilo e Realce" Id="table-style">
            <Description>
                Na referência, o demo usa <code>rowClass</code>/<code>rowStyle</code> para pintar linhas
                condicionalmente. O port não tem callbacks de classe/estilo por linha — o equivalente é estilizar
                o conteúdo da célula dentro do <code>BodyTemplate</code> (como o badge de estoque abaixo), além de
                <code>StyleClass</code> (contêiner), <code>HeaderStyleClass</code>/<code>BodyStyleClass</code>
                (por coluna) e <code>AdditionalAttributes</code>, que entrega atributos como <code>style</code>
                ao contêiner raiz.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="_styleCols"/>
                    <OpDataTable Items="Products" Columns="Cols" RowHover="false"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TableStyleCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Máscara" Id="loading-mask">
            <Description>
                <code>Loading</code> sobrepõe uma máscara à tabela. <code>LoadingIconTemplate</code> substitui o
                spinner padrão. No exemplo, o botão simula uma consulta de 2 segundos.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadMask" Loading="_maskLoading"/>
                    <OpDataTable Items="Products" Columns="Cols" Loading="_maskLoading">
                        <LoadingIconTemplate>
                            <span class="p-datatable-loading-icon pi pi-spin pi-spinner" aria-hidden="true"></span>
                        </LoadingIconTemplate>
                    </OpDataTable>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingMaskCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Skeleton" Id="loading-skeleton">
            <Description>
                Com <code>LoadingMode="skeleton"</code> o componente exibe linhas de esqueleto em vez da máscara.
                <code>SkeletonRows</code> define quantas linhas mostrar (0 usa <code>Rows</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadSkeleton" Loading="_skeletonLoading"/>
                    <OpDataTable Items="Products" Columns="Cols" Loading="_skeletonLoading" LoadingMode="skeleton" SkeletonRows="5"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingSkeletonCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Básico" Id="paginator-basic">
            <Description>
                <code>Paginator</code> habilita a paginação e <code>Rows</code> define os itens por página.
                <code>PaginatorPosition</code> aceita <code>bottom</code> (padrão), <code>top</code> ou
                <code>both</code>. <code>OnPage</code> informa a página exibida (base 0); a navegação em si é
                interna ao componente.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Paginator="true" Rows="5" PaginatorPosition="both" OnPage="OnPageChanged"/>
                    <div class="text-sm">Última página navegada: @(_page + 1)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Programática" Id="paginator-programmatic">
            <Description>
                Na referência, o método <code>paginate()</code> navega por código. Aqui, a página é controlada por
                <code>@@bind-First</code> (deslocamento base 0 do primeiro item): alterar o campo vinculado muda a
                página exibida. <code>@@bind-Rows</code> faz o mesmo com o tamanho da página e
                <code>RowsPerPageOptions</code> habilita o seletor de itens por página.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex flex-wrap gap-2">
                        <OpButton Label="1" Outlined="true" OnClick="() => GoToPage(1)"/>
                        <OpButton Label="2" Outlined="true" OnClick="() => GoToPage(2)"/>
                        <OpButton Label="3" Outlined="true" OnClick="() => GoToPage(3)"/>
                    </div>
                    <OpDataTable Items="Products" Columns="Cols" Paginator="true" Rows="_progRows" @bind-First="_progFirst"/>
                    <div class="text-sm">first: @_progFirst · página atual: @(_progFirst / _progRows + 1)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorProgrammaticCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Coluna Única" Id="single-column-sort">
            <Description>
                A ordenação é embutida: clicar no cabeçalho percorre ascendente e descendente (ciclo de 2 estados,
                como na referência); com <code>RemovableSort</code> o terceiro clique remove a ordenação. Os itens
                são reordenados por reflexão sobre <code>Field</code>. <code>Sortable</code> desabilita globalmente
                e <code>OpDataTableColumn.Sortable</code> por coluna. <code>OnSort</code> entrega
                <code>Field</code>, <code>Order</code> (1 asc, -1 desc, 0 sem ordenação) e a lista
                <code>MultiSortMeta</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" OnSort="OnSorted"/>
                    <div class="text-sm">Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SortCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Múltiplas Colunas" Id="multiple-columns-sort">
            <Description>
                Com <code>SortMode="multiple"</code> mais de uma coluna pode ser ordenada: mantenha <i>⌘</i> (macOS)
                ou <i>Ctrl</i> pressionado ao clicar no cabeçalho para compor a ordenação. Um badge numérico indica
                a prioridade de cada coluna; clicar sem a tecla mantém a ordenação só naquela coluna.
                <code>OnSort</code> entrega <code>MultiSortMeta</code> na ordem de prioridade.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" SortMode="multiple" OnSort="OnSorted"/>
                    <div class="text-sm">Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@MultiSortCode"/></Code>
        </DocSection>

        <DocSection Label="Pré-ordenação" Id="pre-sort">
            <Description>
                Defina <code>SortField</code> e <code>SortOrder</code> para exibir os dados já ordenados na carga
                inicial. No modo <code>multiple</code>, use <code>MultiSortMeta</code> com a lista de
                <code>OpDataTableSortMeta</code> na ordem de prioridade.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" SortField="Price" SortOrder="-1" OnSort="OnSorted"/>
                    <div class="text-sm">Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PreSortCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação Removível" Id="removable-sort">
            <Description>
                <code>RemovableSort</code> acrescenta o terceiro estado ao ciclo: ascendente → descendente → sem
                ordenação (na referência isso é feito com <code>customSort</code> + <code>reset()</code>). O evento
                <code>OnSort</code> informa <code>Order = 0</code> quando a coluna é liberada.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" RemovableSort="true" OnSort="OnSorted"/>
                    <div class="text-sm">Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RemovableSortCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro Básico" Id="filter-basic">
            <Description>
                Com <code>OpDataTableColumn.Filter = true</code> a coluna exibe um campo de filtro no cabeçalho.
                A comparação usa <code>OpFilterService</code> (ignora acentos e caixa) no modo definido por
                <code>FilterMatchMode</code> (padrão <code>Contains</code>); <code>FilterPlaceholder</code> define
                o texto do campo e <code>OnFilter</code> entrega os filtros ativos.
                <br/>
                <code>GlobalFilter</code> filtra por todos os campos de <code>GlobalFilterFields</code> (ou por
                todas as colunas). O componente não desenha o campo: informe um input e vincule-o, como na
                <i>caption</i> do upstream. Também é possível filtrar por código com
                <code>FilterGlobalAsync</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpInputText IgnoreEditContext="true" Value="@_globalFilter" ValueChanged="v => _globalFilter = v"
                                 Placeholder="Filtrar produtos" AriaLabel="Filtro global"/>
                    <OpDataTable Items="Products" Columns="_filterCols" GlobalFilter="@_globalFilter"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FilterBasicCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro Avançado" Id="filter-advanced">
            <Description>
                Na referência, o filtro avançado exibe um menu sobreposto por coluna com operadores por tipo
                (<code>contém</code>, <code>igual</code>, <code>intervalo</code>, regras compostas com
                <code>e</code>/<code>ou</code>) usando o <code>FilterService</code>. Esse menu ainda não foi
                portado: o que existe é o filtro por coluna com <code>FilterMatchMode</code> fixo por coluna
                (<code>Contains</code>, <code>StartsWith</code>, <code>EndsWith</code>, <code>Equals</code>,
                <code>NotEquals</code> e os modos de <code>OpFilterMatchMode</code>), o filtro global e o
                <code>OpFilterService</code> — sem operadores escolhidos na interface nem composição de regras.
                Para filtros de servidor, use o modo <code>Lazy</code> com <code>OnLazyLoad</code>.
            </Description>
        </DocSection>

        <DocSection Label="Seleção - Única" Id="single-selection">
            <Description>
                Com <code>SelectionMode="single"</code> clicar na linha seleciona apenas ela; clicar de novo
                desmarca. <code>DataKey</code> define a propriedade usada como identidade da linha, importante
                quando a lista é reordenada ou paginada.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" SelectionMode="single" DataKey="Code"
                                 @bind-SelectedItems="_singleSelected"/>
                    <div class="text-sm">Selecionado: @(_singleSelected.Count == 0 ? "nenhum" : _singleSelected[0].Name)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionSingleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Múltipla" Id="multiple-selection">
            <Description>
                Com <code>Selection="true"</code> (modo padrão <code>multiple</code>) o clique alterna a linha na
                seleção, sem tecla modificadora (padrão <code>MetaKeySelection="false"</code>). Com
                <code>MetaKeySelection="true"</code>, clicar sem tecla deixa a seleção só naquela linha e
                <i>⌘</i>/<i>Ctrl</i> passa a somar ou remover. A lista é controlada por
                <code>SelectedItems</code>/<code>SelectedItemsChanged</code> (ou <code>@@bind-SelectedItems</code>).
                Para colunas dedicadas de checkbox ou radio, veja as seções seguintes.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex items-center gap-2">
                        <OpToggleButton @bind-Value="_multiMetaKey" OnLabel="MetaKey" OffLabel="MetaKey"/>
                        <span class="text-sm">MetaKeySelection: @(_multiMetaKey ? "true" : "false")</span>
                    </div>
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" MetaKeySelection="_multiMetaKey" DataKey="Code"
                                 SelectedItems="_selected"
                                 SelectedItemsChanged="(IReadOnlyList<Product>? items) => OnSelectedChanged(items)"/>
                    <div class="text-sm">Selecionados: @_selected.Count @(_selected.Count > 0 ? $"({string.Join(", ", _selected.Select(p => p.Name))})" : "")</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionMultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Radio" Id="radio-button-selection">
            <Description>
                A seleção única também pode ser feita com botões de rádio: declare uma coluna com
                <code>SelectionMode="single"</code> (deixe <code>Field</code> vazio). O <code>td</code> dessa coluna
                renderiza o rádio e o clique na célula não inicia edição de célula quando ela é a de seleção.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="_radioCols" DataKey="Code"
                                 @bind-SelectedItems="_radioSelected"/>
                    <div class="text-sm">Selecionado: @(_radioSelected.Count == 0 ? "nenhum" : _radioSelected[0].Name)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RadioSelectionCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Checkbox" Id="checkbox-selection">
            <Description>
                Para caixas de seleção, declare uma coluna com <code>SelectionMode="multiple"</code>. O cabeçalho
                dessa coluna ganha o checkbox de <i>selecionar tudo</i>, que marca todos os itens filtrados (com
                <code>SelectionPageOnly="true"</code>, apenas os da página atual). O vínculo é o mesmo
                <code>SelectedItems</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="_checkboxCols" DataKey="Code"
                                 SelectedItems="_checkboxSelected"
                                 SelectedItemsChanged="(IReadOnlyList<Product>? items) => { _checkboxSelected = items ?? Array.Empty<Product>(); }"/>
                    <div class="text-sm">Selecionados: @_checkboxSelected.Count</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckboxSelectionCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção por Coluna" Id="column-selection">
            <Description>
                Seleção a partir de um elemento dentro da coluna, implementada com template: o
                <code>BodyTemplate</code> pode chamar <code>SelectRowAsync</code>/<code>UnselectRowAsync</code> para
                marcar ou desmarcar a linha por código. Aqui o botão alterna a linha (ícone muda conforme o estado).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable @ref="_columnSelTable" Items="Products" Columns="_columnSelCols" DataKey="Code"
                                 SelectedItems="_columnSelSelected"
                                 SelectedItemsChanged="(IReadOnlyList<Product>? items) => { _columnSelSelected = items ?? Array.Empty<Product>(); }"/>
                    <div class="text-sm">Selecionados: @_columnSelSelected.Count</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ColumnSelectionCode"/></Code>
        </DocSection>

        <DocSection Label="Eventos de Seleção" Id="selection-events">
            <Description>
                <code>OnRowClick</code> dispara ao clicar em qualquer linha, entregando o item clicado. Quando
                <code>Selection</code> está ativo, a linha é marcada ou desmarcada antes do evento.
                A referência tem ainda <code>onRowSelect</code>/<code>onRowUnselect</code> dedicados; no port, o
                equivalente é observar <code>SelectedItemsChanged</code> (a lista completa após cada mudança),
                além do próprio <code>OnRowClick</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_clickSelected"
                                 OnRowClick="@((Product item) => OnRowClicked(item))"/>
                    <div class="text-sm">Última linha clicada: @(_lastClicked?.Name ?? "nenhuma")</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionEventsCode"/></Code>
        </DocSection>

        <DocSection Label="Expansão de Linha" Id="row-expansion">
            <Description>
                Para exibir conteúdo detalhado de uma linha informe <code>DataKey</code>, defina
                <code>RowExpansionTemplate</code> e controle o estado com
                <code>ExpandedItems</code>/<code>ExpandedItemsChanged</code>. O template renderiza a linha de
                detalhe inteira (<code>&lt;tr&gt;&lt;td colspan=...&gt;</code>), como na referência.
                <code>ToggleRowExpansionAsync</code> alterna uma linha por código — é o que os botões de
                expandir/recolher tudo usam (no upstream eles ficam no <i>caption</i>; aqui ficam acima da tabela,
                que não tem caption).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex flex-wrap justify-end gap-2">
                        <OpButton Label="Expandir tudo" Icon="pi pi-plus" Text="true" OnClick="ExpandAllRows"/>
                        <OpButton Label="Recolher tudo" Icon="pi pi-minus" Text="true" OnClick="CollapseAllRows"/>
                    </div>
                    <OpDataTable @ref="_expandTable" Items="Products" Columns="_expandCols" DataKey="Code"
                                 ExpandedItems="_expandedProducts"
                                 ExpandedItemsChanged="(IReadOnlyList<Product>? v) => { _expandedProducts = v ?? Array.Empty<Product>(); }">
                        <RowExpansionTemplate Context="product">
                            <tr>
                                <td colspan="7">
                                    <div class="p-4">
                                        <h5 class="mt-0">Pedidos de @product.Name</h5>
                                        <OpDataTable Items="OrdersOf(product)" Columns="_orderCols"/>
                                    </div>
                                </td>
                            </tr>
                        </RowExpansionTemplate>
                    </OpDataTable>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RowExpansionCode"/></Code>
        </DocSection>

        <DocSection Label="Edição de Célula" Id="cell-edit">
            <Description>
                Com <code>EditMode="cell"</code>, clicar numa célula com <code>EditorTemplate</code> troca o
                conteúdo pelo editor (dentro de um <code>p-celleditor</code>); <i>Enter</i> salva e <i>Escape</i>
                cancela. O componente não altera o modelo: <code>OnEditInit</code>/<code>OnEditComplete</code>/
                <code>OnEditCancel</code> avisam a página, que aplica o rascunho no item ao completar (padrão da
                referência, onde o clone/restauração também é da página). Trocar de célula salva a anterior.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable @ref="_cellEditTable" Items="_cellEditProducts" Columns="_cellEditCols" DataKey="Code" EditMode="cell"
                                 OnEditInit="(Product p) => OnCellEditInit(p)"
                                 OnEditComplete="(Product p) => OnCellEditComplete(p)"
                                 OnEditCancel="(Product p) => OnCellEditCancel(p)"/>
                    <div class="text-sm">Última edição: @_cellEditLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CellEditCode"/></Code>
        </DocSection>

        <DocSection Label="Edição de Linha" Id="row-edit">
            <Description>
                Com <code>EditMode="row"</code> todas as células editáveis da linha viram editores de uma vez.
                A linha entra em edição por <code>StartEditAsync</code> (aqui, pelo botão da coluna de ações) e
                sai por <code>SaveEditAsync</code>/<code>CancelEditAsync</code> — os eventos
                <code>OnRowEditInit</code>/<code>OnRowEditSave</code>/<code>OnRowEditCancel</code> avisam a página.
                O padrão da referência é clonar a linha no início e restaurar o clone ao cancelar, como no
                exemplo. <code>IsRowInEditMode</code> permite alternar os botões da linha.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable @ref="_rowEditTable" Items="_rowEditProducts" Columns="_rowEditCols" DataKey="Code" EditMode="row"
                                 OnRowEditInit="(Product p) => OnRowEditInit(p)"
                                 OnRowEditSave="(Product p) => OnRowEditSave(p)"
                                 OnRowEditCancel="(Product p) => OnRowEditCancel(p)"/>
                    <div class="text-sm">Última edição: @_rowEditLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@RowEditCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento Lazy" Id="lazy-load">
            <Description>
                Com <code>Lazy="true"</code> a tabela não filtra, ordena nem pagina: ela exibe <code>Items</code>
                como a página atual e dispara <code>OnLazyLoad</code> com o estado (<code>First</code>,
                <code>Rows</code>, ordenação e filtros). Use <code>TotalRecords</code> para o paginador saber o
                total. No exemplo, os dados são fatiados em memória para simular o servidor.
            </Description>
            <ChildContent>
                <OpDataTable Items="_lazyPage" Columns="Cols" Lazy="true" Paginator="true"
                             TotalRecords="LazyTotalRecords" OnLazyLoad="OnLazyLoad"/>
            </ChildContent>
            <Code><CodeBlock Code="@LazyLoadCode"/></Code>
        </DocSection>

        <DocSection Label="Rolagem Vertical" Id="vertical-scroll">
            <Description>
                <code>ScrollHeight</code> limita a altura do contêiner de rolagem e mantém o cabeçalho fixo — o
                equivalente a <code>[scrollable]="true"</code> + <code>scrollHeight</code> da referência.
                <code>StickyHeader</code> reforça o posicionamento do <code>thead</code>. Sem
                <code>ScrollHeight</code> a tabela cresce com o conteúdo.
            </Description>
            <ChildContent>
                <OpDataTable Items="Customers" Columns="_customerCols" ScrollHeight="400px" StickyHeader="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@VerticalScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Rolagem Flexível" Id="flex-scroll">
            <Description>
                <code>ScrollHeight="flex"</code> faz a área rolável acompanhar o tamanho do pai (raiz com
                <code>p-datatable-flex-scrollable</code>), em vez de uma altura fixa. É o que o demo da referência
                usa dentro de um diálogo maximizável: maximize e veja a tabela se ajustar. O pai precisa ter altura
                definida (no exemplo, o conteúdo do diálogo usa <code>ContentStyle="height: 300px"</code>).
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" Icon="pi pi-external-link" OnClick="() => _flexDialog = true"/>
                </div>
                <OpDialog Header="Clientes" Visible="_flexDialog" VisibleChanged="(bool v) => _flexDialog = v"
                          Modal="true" Maximizable="true" Resizable="false" Style="width: 75vw" ContentStyle="height: 300px">
                    <OpDataTable Items="Customers" Columns="_customerCols" ScrollHeight="flex"/>
                </OpDialog>
            </ChildContent>
            <Code><CodeBlock Code="@FlexScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Rolagem Horizontal" Id="horizontal-scroll">
            <Description>
                Quando a soma das larguras excede o pai, o contêiner de rolagem mostra barra horizontal. Defina
                <code>Width</code> em cada coluna (o demo usa larguras mínimas como a referência) e opcionalmente
                <code>ScrollHeight</code> para combinar com a rolagem vertical.
            </Description>
            <ChildContent>
                <OpDataTable Items="Customers" Columns="_wideCols" ScrollHeight="400px"/>
            </ChildContent>
            <Code><CodeBlock Code="@HorizontalScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas Congeladas" Id="frozen-rows">
            <Description>
                <code>FrozenItems</code> fixa certas linhas no topo da área rolável (o <code>frozenValue</code> da
                referência). Mova itens entre as listas para congelar/descongelar; a tabela aplica a classe
                <code>p-datatable-scrollable</code> automaticamente quando há itens congelados.
            </Description>
            <ChildContent>
                <OpDataTable Items="_unlockedCustomers" FrozenItems="_lockedCustomers" Columns="_frozenRowCols"
                             DataKey="Id" ScrollHeight="400px"/>
            </ChildContent>
            <Code><CodeBlock Code="@FrozenRowsCode"/></Code>
        </DocSection>

        <DocSection Label="Colunas Congeladas" Id="frozen-columns">
            <Description>
                <code>OpDataTableColumn.Frozen</code> aceita <code>left</code> ou <code>right</code> e fixa a coluna
                durante a rolagem horizontal — o <code>pFrozenColumn</code>/<code>alignFrozen</code> da referência.
                Informe <code>Width</code> nas colunas congeladas: o deslocamento <i>sticky</i> é calculado a partir
                delas. No demo, o botão alterna o congelamento da coluna <i>Balance</i> à direita.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex">
                        <OpToggleButton @bind-Value="_balanceFrozen" OnLabel="Balance" OffLabel="Balance"/>
                    </div>
                    <OpDataTable Items="Customers" Columns="@(_balanceFrozen ? _frozenOnCols : _frozenOffCols)" ScrollHeight="400px"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FrozenColumnsCode"/></Code>
        </DocSection>

        <DocSection Label="Scroll Virtual - Básico" Id="virtual-scroll-basic">
            <Description>
                Na referência, a tabela virtual renderiza apenas as linhas visíveis usando o
                <code>VirtualScroller</code>. A integração do <code>OpDataTable</code> com o
                <code>OpVirtualScroller</code> não foi portada: use a paginação para conjuntos grandes, ou o
                <code>OpVirtualScroller</code> diretamente com outro componente de lista.
            </Description>
        </DocSection>

        <DocSection Label="Scroll Virtual - Lazy" Id="virtual-scroll-lazy">
            <Description>
                O carregamento de lotes sob demanda na rolagem (<code>onLazyLoad</code> do virtual scroller) também
                depende da integração com o <code>OpVirtualScroller</code>, ainda não portada. Para paginação sob
                demanda, o modo <code>Lazy</code> do <code>OpDataTable</code> com <code>OnLazyLoad</code> cobre o
                mesmo cenário de servidor (seção <i>Carregamento Lazy</i>).
            </Description>
        </DocSection>

        <DocSection Label="Agrupamento de Colunas" Id="column-group">
            <Description>
                Cabeçalhos podem ser agrupados com <code>HeaderGroups</code>: cada item é uma linha extra do
                <code>thead</code>, com <code>Header</code>, <code>ColSpan</code> e <code>RowSpan</code>. A linha
                normal de colunas entra abaixo; colunas cobertas por um <code>RowSpan</code> usam
                <code>HideHeader="true"</code> para não repetir o título. O demo espelha a referência: três linhas
                de cabeçalho e totais no rodapé.
            </Description>
            <ChildContent>
                <OpDataTable Items="Sales" Columns="_saleCols" HeaderGroups="_saleHeaderGroups"/>
            </ChildContent>
            <Code><CodeBlock Code="@ColumnGroupCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupamento por Subheader" Id="subheader">
            <Description>
                <code>GroupRowsBy</code> agrupa as linhas por um campo e, com
                <code>RowGroupMode="subheader"</code>, cada grupo ganha cabeçalho e rodapé pelos templates
                <code>GroupHeaderTemplate</code>/<code>GroupFooterTemplate</code> (que entregam apenas o conteúdo —
                a linha e a célula com <code>colspan</code> são do componente). Ordene pelo campo agrupado
                (<code>SortField</code>) para manter os grupos contíguos, como na referência.
            </Description>
            <ChildContent>
                <OpDataTable Items="Customers" Columns="_customerCols" RowGroupMode="subheader" GroupRowsBy="Representative"
                             SortField="Representative" SortOrder="1" ScrollHeight="400px">
                    <GroupHeaderTemplate Context="group">
                        <div class="flex items-center gap-2">
                            <span class="font-bold">@group.Key</span>
                            <span class="text-sm">(@group.Items.Count clientes)</span>
                        </div>
                    </GroupHeaderTemplate>
                    <GroupFooterTemplate Context="group">
                        <div class="text-right font-bold">Total de clientes: @group.Items.Count</div>
                    </GroupFooterTemplate>
                </OpDataTable>
            </ChildContent>
            <Code><CodeBlock Code="@SubheaderCode"/></Code>
        </DocSection>

        <DocSection Label="Grupos Expansíveis" Id="expand">
            <Description>
                Em grupos por <i>subheader</i>, <code>ExpandableRowGroups</code> permite abrir e fechar cada grupo;
                o estado é controlado por <code>ExpandedGroups</code>/<code>ExpandedGroupsChanged</code> e o
                template recebe <code>OpDataTableGroupContext</code> com <code>Key</code>, <code>Items</code> e
                <code>Expanded</code>. O botão do cabeçalho chama <code>ToggleGroupExpansionAsync(group.Key)</code>.
                Sem <code>GroupHeaderTemplate</code> customizado, o componente desenha o próprio botão.
            </Description>
            <ChildContent>
                <OpDataTable @ref="_expandGroupTable" Items="Customers" Columns="_customerCols" RowGroupMode="subheader" GroupRowsBy="Representative"
                             ExpandableRowGroups="true" SortField="Representative" SortOrder="1"
                             ExpandedGroups="_expandedCustomerGroups"
                             ExpandedGroupsChanged="(IReadOnlyList<object?>? v) => { _expandedCustomerGroups = v ?? Array.Empty<object?>(); }">
                    <GroupHeaderTemplate Context="group">
                        <button type="button" class="p-button p-button-text p-button-rounded" aria-label="Alternar grupo"
                                @onclick="() => _expandGroupTable!.ToggleGroupExpansionAsync(group.Key)">
                            <i class="@($"pi pi-chevron-{(group.Expanded ? "down" : "right")}")" aria-hidden="true"></i>
                        </button>
                        <span class="font-bold">@group.Key</span>
                    </GroupHeaderTemplate>
                    <GroupFooterTemplate Context="group">
                        <div class="text-right">Total de clientes: @group.Items.Count</div>
                    </GroupFooterTemplate>
                </OpDataTable>
            </ChildContent>
            <Code><CodeBlock Code="@ExpandCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupamento por RowSpan" Id="row-span">
            <Description>
                Com <code>RowGroupMode="rowspan"</code> a coluna agrupada (<code>GroupRowsBy</code>) vira uma única
                célula com <code>rowspan</code> cobrindo o grupo: o componente emite a célula na primeira linha e
                omite nas demais. Vale o mesmo requisito de ordenação por <code>SortField</code>.
            </Description>
            <ChildContent>
                <OpDataTable Items="Customers" Columns="_rowSpanCols" RowGroupMode="rowspan" GroupRowsBy="Representative"
                             SortField="Representative" SortOrder="1"/>
            </ChildContent>
            <Code><CodeBlock Code="@RowSpanCode"/></Code>
        </DocSection>

        <DocSection Label="Fit Mode" Id="fit-mode">
            <Description>
                O <code>fitMode</code> da referência ajusta larguras de coluna por arraste (<i>Column Resize</i>).
                O redimensionamento por arraste ainda não foi portado — defina as larguras com
                <code>OpDataTableColumn.Width</code> ou classes de estilo.
            </Description>
        </DocSection>

        <DocSection Label="Expand Mode" Id="expand-mode">
            <Description>
                O <code>expandMode</code> também pertence ao redimensionamento de colunas (a coluna arrastada
                expande em vez de empurrar as vizinhas). Como o recurso de redimensionamento ainda não foi
                portado, esta seção fica documentada sem demo.
            </Description>
        </DocSection>

        <DocSection Label="Scrollable" Id="scrollable">
            <Description>
                O modo <code>[scrollable]="true"</code> da referência combina a área de rolagem com o
                redimensionamento por arraste das colunas — por isso segue não suportado. A rolagem vertical e
                horizontal continuam disponíveis por <code>ScrollHeight</code> e <code>Width</code> (veja as
                seções <i>Rolagem Vertical</i>, <i>Rolagem Flexível</i> e <i>Rolagem Horizontal</i>); o
                congelamento de linhas/colunas também aplica a classe <code>p-datatable-scrollable</code>
                automaticamente.
            </Description>
        </DocSection>

        <DocSection Label="Reordenação" Id="reorder">
            <Description>
                <code>ReorderableColumns</code> habilita arrastar os cabeçalhos e <code>ReorderableRows</code> as
                linhas (com uma coluna de alça definida por <code>OpDataTableColumn.RowReorder</code>); os eventos
                <code>OnColumnReorder</code>/<code>OnRowReorder</code> entregam <code>(from, to)</code> para a
                página reordenar as listas. O arraste usa o drag-and-drop nativo do navegador — como na referência,
                a página é quem mantém a ordem.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="_reorderProducts" Columns="_reorderCols" Sortable="false"
                                 ReorderableColumns="true" ReorderableRows="true"
                                 OnColumnReorder="ReorderColumns" OnRowReorder="ReorderRows"/>
                    <div class="text-sm">Colunas: @string.Join(", ", _reorderCols.Select(c => c.Header))</div>
                    <div class="text-sm">Linhas: @string.Join(", ", _reorderProducts.Select(p => p.Name))</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ReorderCode"/></Code>
        </DocSection>

        <DocSection Label="Alternar Colunas" Id="column-toggle">
            <Description>
                O demo da referência implementa a alternância de colunas com o componente <i>multiselect</i> no
                <i>caption</i>. Aqui o <code>OpMultiSelect</code> fica acima da tabela (que não tem caption) e a
                lista vinculada é atribuída diretamente a <code>Columns</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpMultiSelect TValue="OpDataTableColumn" @bind-Value="_selectedCols" Options="Cols"
                                   OptionLabel="Header" Display="chip"
                                   Placeholder="Escolha as colunas" StyleClass="w-fit"/>
                    <OpDataTable Items="Products" Columns="_selectedCols"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ColumnToggleCode"/></Code>
        </DocSection>

        <DocSection Label="Exportação" Id="export">
            <Description>
                <code>ExportCsv()</code> devolve o conteúdo CSV dos dados exibidos (após filtros e ordenação, sem
                paginação; no modo <code>Lazy</code>, a página atual) com uma linha de cabeçalho usando o título de
                cada coluna — não há cabeçalho de exportação customizado como o <code>exportHeader</code> da
                referência. O demo baixa o arquivo por <i>data URI</i> (sem JavaScript); a referência usa um botão
                no <i>caption</i>, aqui o botão fica acima da tabela.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="text-right">
                        <a class="p-button p-component" href="@CsvDataUri" download="produtos.csv">
                            <i class="pi pi-external-link" aria-hidden="true"></i>
                            <span class="p-button-label">Exportar</span>
                        </a>
                    </div>
                    <OpDataTable @ref="_exportTable" Items="Products" Columns="Cols"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ExportCode"/></Code>
        </DocSection>

        <DocSection Label="Menu de Contexto" Id="context-menu">
            <Description>
                <code>OnRowContextMenu</code> entrega o item clicado e o <code>MouseEventArgs</code> (o clique
                direito já vem com <code>preventDefault</code>), permitindo abrir o <code>OpContextMenu</code> nas
                coordenadas do cursor — a integração <code>pContextMenuRow</code> da referência. O item do menu
                selecionado fica guardado na página para as ações.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="_ctxProducts" Columns="Cols" DataKey="Code"
                                 OnRowContextMenu="RowContextMenuHandler"/>
                    <div class="text-sm">Último clique direito: @(_ctxSelected?.Name ?? "nenhum") · Ação: @_ctxLog</div>
                    <OpContextMenu @ref="_ctxMenu" Model="_ctxItems" OnItemClick="OnCtxItemClick"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ContextMenuCode"/></Code>
        </DocSection>

        <DocSection Label="Estado Persistente" Id="stateful">
            <Description>
                <code>StateKey</code> ativa a persistência do estado e <code>StateStorage</code> escolhe o
                armazenamento (<code>session</code>, padrão, ou <code>local</code>). São restaurados a página
                atual, a ordenação (simples ou múltipla) e os filtros (por coluna e global); a seleção não é
                persistida. O estado é gravado a cada mudança nesses campos e restaurado no primeiro render —
                recarregue a página para ver o efeito. Requer render mode interativo (usa JS interop).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Customers" Columns="_statefulCols" Paginator="true"
                                 StateKey="table-stateful" StateStorage="session"
                                 OnSort="OnSorted" OnFilter="OnFilterChanged"/>
                    <div class="text-sm">Filtros ativos: @(_statefulFilters.Count) · Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StatefulCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O componente usa a marcação semântica nativa (<code>table</code>, <code>thead</code>,
                    <code>tbody</code>, <code>tr</code>, <code>th</code>, <code>td</code>), então os leitores de
                    tela inferem os papéis <code>rowgroup</code>, <code>row</code>, <code>columnheader</code> e
                    <code>cell</code> automaticamente. Os cabeçalhos ordenáveis são focáveis e expõem
                    <code>aria-sort</code>; as linhas selecionáveis (com <code>Selection</code>) anunciam
                    <code>aria-selected</code>. Ainda faltam rótulos ARIA nas checkboxes da coluna de seleção.
                </p>
                <p>
                    Papéis e rótulos podem ser reforçados pelos <code>AdditionalAttributes</code>: qualquer
                    atributo extra (ex.: <code>aria-label</code>) é repassado ao contêiner raiz.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado implementado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Percorre os cabeçalhos ordenáveis (os não ordenáveis usam tabindex=\"-1\"), os botões do paginador e os campos de filtro/edição." },
                              new[] { "enter", "Ordena a coluna em foco; no editor de célula, salva a edição." },
                              new[] { "space", "Ordena a coluna em foco; aciona os botões do paginador." },
                              new[] { "escape", "No editor de célula, cancela a edição (descarta o rascunho)." }
                          })"/>
                <div class="doc-section-description">
                    <h3>Suporte da referência ainda não implementado</h3>
                    <p>Os atalhos abaixo dependem de navegação por foco nas linhas, que não foi portada.</p>
                </div>
                <ApiTable Headers="@(new[] { "Tecla", "Função na referência" })"
                          Rows="@(new[] {
                              new[] { "seta para cima / para baixo", "Move o foco entre as linhas." },
                              new[] { "shift + seta", "Move o foco e alterna a seleção da linha." },
                              new[] { "control + a", "Seleciona todas as linhas." }
                          })"/>
            </Code>
        </DocSection>

        <DocSection Label="Vínculo" Id="binding">
            <Description>
                <code>@@bind-SelectedItems</code> liga a seleção a um campo do componente que usa a tabela: a cada
                marcação o Blazor atualiza o campo com a nova lista. Mantenha a lista vinculada como fonte da
                verdade para habilitar ações que dependem do que está selecionado.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_boundSelected"/>
                    <div class="text-sm">
                        <div>Vinculados: @_boundSelected.Count</div>
                        @if (_boundSelected.Count > 0)
                        {
                            <ul style="margin:.25rem 0 0 1.25rem;">
                                @foreach (var product in _boundSelected)
                                {
                                    <li>@product.Name</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BindingCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>
                O <code>OpDataTable</code> não herda de <code>InputBase</code>, então não registra um campo no
                <code>EditContext</code>. Ainda assim, a seleção pode ser validada dentro de um
                <code>EditForm</code>: vincule a lista a uma propriedade do modelo e aplique um atributo de
                validação customizado. Como o componente não dispara <code>OnFieldChanged</code>, a mensagem só
                aparece quando o formulário é enviado (<code>Validate()</code>).
            </Description>
            <ChildContent>
                <EditForm Model="_model" OnValidSubmit="SubmitSelection" class="flex flex-col gap-3">
                    <DataAnnotationsValidator/>
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_model.Selected"/>
                    <ValidationMessage For="() => _model.Selected"/>
                    <div>
                        <button type="submit" class="p-button p-component"><span class="p-button-label">Confirmar</span></button>
                    </div>
                    @if (_selectionSubmitted)
                    {
                        <div class="text-sm">Seleção confirmada: @(_model.Selected?.Count ?? 0) item(ns).</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Items", "IReadOnlyList&lt;TItem&gt;?", "null", "Lista de dados exibida." },
                              new[] { "Columns", "IReadOnlyList&lt;OpDataTableColumn&gt;", "vazio", "Definição das colunas." },
                              new[] { "DataKey", "string?", "null", "Propriedade usada como identidade da linha (seleção, expansão e edição)." },
                              new[] { "Sortable", "bool", "true", "Habilita a ordenação global (combinada com <code>OpDataTableColumn.Sortable</code>)." },
                              new[] { "SortMode", "string", "single", "Modo de ordenação: <code>single</code> ou <code>multiple</code> (com <i>⌘</i>/<i>Ctrl</i>)." },
                              new[] { "RemovableSort", "bool", "false", "Acrescenta o terceiro estado ao ciclo (remove a ordenação)." },
                              new[] { "SortField", "string?", "null", "Campo da ordenação inicial." },
                              new[] { "SortOrder", "int", "0", "Ordem inicial: 1 asc, -1 desc, 0 sem ordenação." },
                              new[] { "MultiSortMeta", "IReadOnlyList&lt;OpDataTableSortMeta&gt;?", "null", "Ordenação inicial múltipla, na ordem de prioridade." },
                              new[] { "StripedRows", "bool", "false", "Alterna o fundo das linhas." },
                              new[] { "ShowGridlines", "bool", "false", "Desenha as bordas entre as células." },
                              new[] { "RowHover", "bool", "true", "Realça a linha sob o cursor." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Selection", "bool", "false", "Habilita a seleção (e o realce) ao clicar na linha." },
                              new[] { "SelectionMode", "string", "multiple", "Modo da seleção por clique: <code>multiple</code> ou <code>single</code>. Colunas de checkbox/radio são declaradas em <code>OpDataTableColumn.SelectionMode</code>." },
                              new[] { "MetaKeySelection", "bool", "false", "Exige <i>⌘</i>/<i>Ctrl</i> para adicionar/remover da seleção." },
                              new[] { "SelectedItems", "IReadOnlyList&lt;TItem&gt;?", "null", "Itens selecionados (para <code>@bind-SelectedItems</code>)." },
                              new[] { "SelectedItemsChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;?&gt;", "-", "Callback de seleção." },
                              new[] { "SelectionPageOnly", "bool", "false", "Em modo múltiplo, limita o select-all às linhas da página atual." },
                              new[] { "ExpandedItems", "IReadOnlyList&lt;TItem&gt;?", "null", "Linhas expandidas (expansão de linha)." },
                              new[] { "ExpandedItemsChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;?&gt;", "-", "Callback de mudança das linhas expandidas." },
                              new[] { "RowGroupMode", "string?", "null", "Modo de agrupamento de linhas: <code>subheader</code> ou <code>rowspan</code>." },
                              new[] { "GroupRowsBy", "string?", "null", "Campo usado como chave dos grupos de linha." },
                              new[] { "ExpandableRowGroups", "bool", "false", "Permite expandir/recolher grupos no modo <code>subheader</code>." },
