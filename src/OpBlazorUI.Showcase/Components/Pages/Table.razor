    private const string ColumnSelectionCode = """
        <OpDataTable @ref="_table" Items="Products" Columns="_cols" DataKey="Code"
                     SelectedItems="_selected"
                     SelectedItemsChanged="(IReadOnlyList<Product>? items) => _selected = items ?? Array.Empty<Product>()" />

        @code {
            private OpDataTable<Product>? _table;
            private IReadOnlyList<Product> _selected = Array.Empty<Product>();

            private async Task ToggleSelection(Product product)
            {
                if (_selected.Any(p => p.Code == product.Code))
                {
                    await _table!.UnselectRowAsync(product);
                }
                else
                {
                    await _table!.SelectRowAsync(product);
                }
            }

            private RenderFragment SelectionCell(Product product) =>
                @<OpButton Icon="@(_selected.Any(p => p.Code == product.Code) ? "pi pi-check" : "pi pi-plus")"
                           Rounded="true" Size="small" Severity="secondary" AriaLabel="Alternar seleção"
                           OnClick="() => ToggleSelection(product)" />;
        }
        """;

