    private const string ContextMenuCode = """
        <OpDataTable Items="Products" Columns="Cols" DataKey="Code"
                     OnRowContextMenu="RowContextMenuHandler" />
        <OpContextMenu @ref="_menu" Model="_items" OnItemClick="OnItemClick" />

        @code {
            private OpContextMenu? _menu;
            private Product? _selected;

            private EventCallback<(Product Item, MouseEventArgs Args)> RowContextMenuHandler =>
                EventCallback.Factory.Create<(Product Item, MouseEventArgs Args)>(
                    this, t => ShowMenu(t.Item, t.Args));

            private async Task ShowMenu(Product item, MouseEventArgs args)
            {
                _selected = item;
                await _menu!.ShowAsync(args.ClientX, args.ClientY);
            }

            private void OnItemClick(OpMenuItem item)
            {
                if (item.Label == "Excluir")
                {
                    _products.Remove(_selected!); // a página decide a ação
                }
            }

            private readonly List<OpMenuItem> _items = new()
            {
                new() { Label = "Ver", Icon = "pi pi-eye" },
                new() { Label = "Excluir", Icon = "pi pi-trash" }
            };
