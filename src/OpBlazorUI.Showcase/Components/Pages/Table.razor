    // ===================== Templates de célula =====================
    private static RenderFragment PriceCell(Product product)
        => @<span>@product.Price.ToString("C")</span>;

    private static RenderFragment OrderAmountCell(Order order)
        => @<span>@order.Amount.ToString("C")</span>;

    private static RenderFragment ProductStatusCell(Product product)
        => @<OpTag Value="@ProductStatusText(product.InventoryStatus)" Severity="@ProductStatusSeverity(product.InventoryStatus)"/>;

    private static RenderFragment QuantityBadge(Product product)
        => @<OpBadge Value="@product.Quantity.ToString()" Severity="@QuantitySeverity(product.Quantity)"/>;

    private static RenderFragment CustomerStatusCell(Customer customer)
        => @<OpTag Value="@customer.Status" Severity="@CustomerStatusSeverity(customer.Status)"/>;

    private static RenderFragment CustomerBalanceCell(Customer customer)
        => @<span>@customer.Balance.ToString("C")</span>;

    private static RenderFragment LastYearSaleCell(Sale sale) => @<span>@sale.LastYearSale</span>;
    private static RenderFragment ThisYearSaleCell(Sale sale) => @<span>@sale.ThisYearSale</span>;
    private static RenderFragment LastYearProfitCell(Sale sale) => @<span>@sale.LastYearProfit.ToString("C")</span>;
    private static RenderFragment ThisYearProfitCell(Sale sale) => @<span>@sale.ThisYearProfit.ToString("C")</span>;

    private RenderFragment ExpansionCell(Product product) =>
        @<OpButton Icon="@(_expandedProducts.Any(p => p.Code == product.Code) ? "pi pi-chevron-down" : "pi pi-chevron-right")"
                   Text="true" Rounded="true" Severity="secondary" AriaLabel="Alternar expansão"
                   OnClick="() => ToggleRowExpansion(product)"/>;

    private RenderFragment ColumnSelectionCell(Product product) =>
        @<OpButton Icon="@(_columnSelSelected.Any(p => p.Code == product.Code) ? "pi pi-check" : "pi pi-plus")"
                   Rounded="true" Size="small" Severity="secondary" AriaLabel="Alternar seleção"
                   OnClick="() => ToggleColumnSelection(product)"/>;

    private RenderFragment CellNameEditor(Product item) =>
        @<OpInputText IgnoreEditContext="true" @bind-Value="_cellDraft.Name" AriaLabel="Nome"/>;

    private RenderFragment CellPriceEditor(Product item) =>
        @<OpInputNumber IgnoreEditContext="true" Value="_cellDraft.Price" ValueChanged="@((decimal? v) => _cellDraft.Price = v ?? _cellDraft.Price)" AriaLabel="Preço"/>;

    private RenderFragment RowNameEditor(Product item) =>
        @<OpInputText IgnoreEditContext="true" @bind-Value="item.Name" AriaLabel="Nome"/>;

    private RenderFragment RowPriceEditor(Product item) =>
        @<OpInputNumber IgnoreEditContext="true" Value="item.Price" ValueChanged="@((decimal? v) => item.Price = v ?? item.Price)" AriaLabel="Preço"/>;

    private RenderFragment RowActionsCell(Product item) =>
        @<span class="flex gap-2 justify-center">
            @if (_rowEditTable is not null && _rowEditTable.IsRowInEditMode(item))
            {
                <OpButton Icon="pi pi-check" Rounded="true" Size="small" AriaLabel="Salvar" OnClick="() => SaveRowEdit(item)"/>
                <OpButton Icon="pi pi-times" Rounded="true" Size="small" Severity="secondary" AriaLabel="Cancelar" OnClick="() => CancelRowEdit(item)"/>
            }
            else
            {
                <OpButton Icon="pi pi-pencil" Rounded="true" Size="small" Severity="secondary" AriaLabel="Editar" OnClick="() => StartRowEdit(item)"/>
            }
        </span>;

    private RenderFragment FrozenRowActions(Customer customer) =>
        @<span class="flex justify-center">
            @if (_lockedCustomers.Any(c => c.Id == customer.Id))
            {
                <OpButton Icon="pi pi-lock" Text="true" Rounded="true" AriaLabel="Descongelar" OnClick="() => UnlockCustomer(customer)"/>
            }
            else
            {
                <OpButton Icon="pi pi-lock-open" Text="true" Rounded="true" AriaLabel="Congelar" OnClick="() => LockCustomer(customer)"/>
            }
        </span>;

    // ===================== Métodos =====================
    private void ToggleColumns()
    {
        _extended = !_extended;
        _dynamicCols = _extended
            ? new List<OpDataTableColumn>(Cols)
            : new List<OpDataTableColumn>(MinimalColumns);
    }

    private void GoToPage(int page) => _progFirst = (page - 1) * _progRows;

    private void OnPageChanged(int page) => _page = page;

    private void OnSorted(OpDataTableSortEvent e)
    {
        _sortField = e.Field ?? "";
        _sortOrder = e.Order;
    }

    private void OnFilterChanged(IReadOnlyDictionary<string, object?> filters)
        => _statefulFilters = filters;

    private void OnSelectedChanged(IReadOnlyList<Product>? items)
        => _selected = items ?? Array.Empty<Product>();

    private void OnRowClicked(Product item) => _lastClicked = item;

    private async Task LoadMask()
    {
        _maskLoading = true;
        await Task.Delay(2000);
        _maskLoading = false;
    }

    private async Task LoadSkeleton()
    {
        _skeletonLoading = true;
        await Task.Delay(2000);
        _skeletonLoading = false;
    }

    private void OnLazyLoad(OpDataTableLazyLoadEvent e)
        => _lazyPage = LazyCatalog.Skip(e.First).Take(e.Rows).ToList();

    private IReadOnlyList<Order> OrdersOf(Product product)
    {
        if (!_ordersCache.TryGetValue(product.Code, out var orders))
        {
            orders = new List<Order>
            {
                new(1, "Sofia Almeida", "2023-06-01", 120.00m, "Pago"),
                new(2, "Pedro Santos", "2023-06-15", 80.50m, "Pendente"),
                new(3, "Marta Silva", "2023-07-02", 45.90m, "Enviado")
            };
            _ordersCache[product.Code] = orders;
        }

        return orders;
    }

    private async Task ToggleRowExpansion(Product product)
    {
        if (_expandTable is not null)
        {
            await _expandTable.ToggleRowExpansionAsync(product);
        }
    }

    private void ExpandAllRows() => _expandedProducts = Products.ToList();

    private void CollapseAllRows() => _expandedProducts = Array.Empty<Product>();

    private void OnCellEditInit(Product item)
    {
        _cellOriginal = item;
        _cellDraft = CloneProduct(item);
        _cellEditLog = $"editar:{item.Name}";
    }

    private void OnCellEditComplete(Product item)
    {
        if (_cellOriginal is not null)
        {
            _cellOriginal.Name = _cellDraft.Name;
            _cellOriginal.Price = _cellDraft.Price;
        }

        _cellEditLog = $"salvo:{item.Name} → {_cellDraft.Name}";
        _cellOriginal = null;
    }

    private void OnCellEditCancel(Product item)
    {
        _cellOriginal = null;
        _cellEditLog = $"cancelado:{item.Name}";
    }

    private void OnRowEditInit(Product item)
    {
        _rowClones[item.Code] = CloneProduct(item);
        _rowEditLog = $"editar:{item.Name}";
    }

    private void OnRowEditSave(Product item)
    {
        _rowClones.Remove(item.Code);
        _rowEditLog = $"salvo:{item.Name}";
    }

    private void OnRowEditCancel(Product item)
    {
        if (_rowClones.Remove(item.Code, out var clone))
        {
            item.Name = clone.Name;
            item.Price = clone.Price;
        }

        _rowEditLog = $"cancelado:{item.Name}";
    }

    private async Task StartRowEdit(Product item)
    {
        if (_rowEditTable is not null)
        {
            await _rowEditTable.StartEditAsync(item);
        }
    }

    private async Task SaveRowEdit(Product item)
    {
        if (_rowEditTable is not null)
        {
            await _rowEditTable.SaveEditAsync(item);
        }
    }

    private async Task CancelRowEdit(Product item)
    {
        if (_rowEditTable is not null)
        {
            await _rowEditTable.CancelEditAsync(item);
        }
    }

    private async Task ToggleColumnSelection(Product product)
    {
        if (_columnSelTable is null)
        {
            return;
        }

        if (_columnSelSelected.Any(p => p.Code == product.Code))
        {
            await _columnSelTable.UnselectRowAsync(product);
        }
        else
        {
            await _columnSelTable.SelectRowAsync(product);
        }
    }

    private void LockCustomer(Customer customer)
    {
        _unlockedCustomers = _unlockedCustomers.Where(c => c.Id != customer.Id).ToList();
        _lockedCustomers = _lockedCustomers.Append(customer).OrderBy(c => c.Id).ToList();
    }

    private void UnlockCustomer(Customer customer)
    {
        _lockedCustomers = _lockedCustomers.Where(c => c.Id != customer.Id).ToList();
        _unlockedCustomers = _unlockedCustomers.Append(customer).OrderBy(c => c.Id).ToList();
    }

    private void ReorderColumns((int From, int To) info)
    {
        var column = _reorderCols[info.From];
        _reorderCols.RemoveAt(info.From);
        _reorderCols.Insert(info.To, column);
    }

    private void ReorderRows((int From, int To) info)
    {
        var item = _reorderProducts[info.From];
        _reorderProducts.RemoveAt(info.From);
        _reorderProducts.Insert(info.To, item);
    }

    private EventCallback<(Product Item, MouseEventArgs Args)> RowContextMenuHandler =>
        EventCallback.Factory.Create<(Product Item, MouseEventArgs Args)>(this, t => ShowRowContextMenu(t.Item, t.Args));

    private async Task ShowRowContextMenu(Product item, MouseEventArgs args)
    {
        _ctxSelected = item;

        if (_ctxMenu is not null)
        {
            await _ctxMenu.ShowAsync(args.ClientX, args.ClientY);
        }
    }

    private void ViewContextProduct()
        => _ctxLog = $"ver:{_ctxSelected?.Name ?? "—"}";

    private void OnCtxItemClick(OpMenuItem item)
    {
        if (item.Label == "Excluir")
        {
            DeleteContextProduct();
        }
        else
        {
            ViewContextProduct();
        }
    }

    private void DeleteContextProduct()
    {
        if (_ctxSelected is null)
        {
            return;
        }

        _ctxProducts.RemoveAll(p => p.Code == _ctxSelected.Code);
        _ctxLog = $"excluído:{_ctxSelected.Name}";
    }

    private string CsvDataUri
    {
        get
        {
            var csv = _exportTable?.ExportCsv();
            return string.IsNullOrEmpty(csv)
                ? "#"
                : "data:text/csv;charset=utf-8;base64," + Convert.ToBase64String(Encoding.UTF8.GetBytes(csv));
        }
    }

    private void SubmitSelection() => _selectionSubmitted = true;

    private static string ProductStatusText(string status) => status switch
    {
        "INSTOCK" => "Em estoque",
        "LOWSTOCK" => "Estoque baixo",
        _ => "Esgotado"
    };

    private static string ProductStatusSeverity(string status) => status switch
    {
        "INSTOCK" => "success",
        "LOWSTOCK" => "warn",
        _ => "danger"
    };

    private static string CustomerStatusSeverity(string status) => status switch
    {
        "qualified" or "renewal" => "success",
        "negotiation" => "warn",
        "new" => "info",
        _ => "danger"
    };

    private static string QuantitySeverity(int quantity) => quantity switch
    {
        > 100 => "success",
        > 50 => "warn",
        _ => "danger"
    };

    private static List<Product> CloneProducts()
        => Products.Select(CloneProduct).ToList();

    private static Product CloneProduct(Product product) => new()
    {
        Code = product.Code,
        Name = product.Name,
        Category = product.Category,
        Price = product.Price,
        Quantity = product.Quantity,
        InventoryStatus = product.InventoryStatus
    };

