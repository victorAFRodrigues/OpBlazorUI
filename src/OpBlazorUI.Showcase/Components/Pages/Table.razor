    private const string CellEditCode = """
        <OpDataTable @ref="_table" Items="_products" Columns="_editCols" DataKey="Code" EditMode="cell"
                     OnEditInit="(Product p) => OnCellEditInit(p)"
                     OnEditComplete="(Product p) => OnCellEditComplete(p)"
                     OnEditCancel="(Product p) => OnCellEditCancel(p)" />

        @code {
            private Product? _original;
            private Product _draft = new();

            private void OnCellEditInit(Product item)
            {
                _original = item;
                _draft = Clone(item); // rascunho: o modelo só muda ao salvar
            }

            private void OnCellEditComplete(Product item)
            {
                _original!.Name = _draft.Name;
                _original.Price = _draft.Price;
                _original = null;
            }

            private RenderFragment NameEditor(Product item)
                => @<OpInputText IgnoreEditContext="true" @bind-Value="_draft.Name" AriaLabel="Nome" />;

            private RenderFragment PriceEditor(Product item)
                => @<OpInputNumber IgnoreEditContext="true" Value="_draft.Price"
                                   ValueChanged="@((decimal? v) => _draft.Price = v ?? _draft.Price)" AriaLabel="Preço" />;
        }
        """;

    private const string RowEditCode = """
        <OpDataTable @ref="_table" Items="_products" Columns="_editCols" DataKey="Code" EditMode="row"
                     OnRowEditInit="(Product p) => OnRowEditInit(p)"
                     OnRowEditSave="(Product p) => OnRowEditSave(p)"
                     OnRowEditCancel="(Product p) => OnRowEditCancel(p)" />

        @code {
            private readonly Dictionary<string, Product> _clones = new();

            private void OnRowEditInit(Product item) => _clones[item.Code] = Clone(item);

            private void OnRowEditSave(Product item) => _clones.Remove(item.Code);

            private void OnRowEditCancel(Product item)
            {
                if (_clones.Remove(item.Code, out var clone))
                {
                    item.Name = clone.Name;
                    item.Price = clone.Price;
                }
            }

            private RenderFragment ActionsCell(Product item) =>
                @<span class="flex gap-2">
                    @if (_table!.IsRowInEditMode(item))
                    {
                        <OpButton Icon="pi pi-check" Rounded="true" Size="small" AriaLabel="Salvar"
                                  OnClick="() => _table.SaveEditAsync(item)" />
                        <OpButton Icon="pi pi-times" Rounded="true" Size="small" Severity="secondary" AriaLabel="Cancelar"
                                  OnClick="() => _table.CancelEditAsync(item)" />
                    }
                    else
                    {
                        <OpButton Icon="pi pi-pencil" Rounded="true" Size="small" Severity="secondary" AriaLabel="Editar"
                                  OnClick="() => _table.StartEditAsync(item)" />
                    }
                </span>;
        }
        """;

