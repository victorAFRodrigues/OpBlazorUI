@page "/table"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.DataTable
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Models
@using System.ComponentModel.DataAnnotations

<PageTitle>Table - OpBlazorUI</PageTitle>

<DocComponent Title="Table"
              Description="A tabela exibe dados em formato tabular.">

    <Features>
        <DocSection Label="Importação" Id="import-demo">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <code>Items</code> recebe a lista de dados e <code>Columns</code> a definição das colunas.
                Cada coluna lê uma propriedade pública do item pelo nome informado em <code>Field</code>
                (a comparação ignora maiúsculas/minúsculas). Como não existe template de célula, o valor é
                exibido com <code>ToString()</code>.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" Paginator="true" Rows="5" Sortable="true" RowHover="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Templates de Coluna" Id="templates">
            <Description>
                Para formatar a célula (moeda, datas, badges, botões) use <code>OpDataTableColumn&lt;TItem&gt;</code>
                com <code>BodyTemplate</code> (tipado). <code>HeaderTemplate</code> e <code>FooterTemplate</code>
                substituem o título e o rodapé. Uma coluna com template não precisa de <code>Field</code> para
                exibir conteúdo, mas mantenha-o se quiser ordená-la. Ao definir qualquer rodapé, o componente
                renderiza um <code>&lt;tfoot&gt;</code> com todas as colunas.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="_tmplCols"/>
            </ChildContent>
            <Code><CodeBlock Code="@TemplatesCode"/></Code>
        </DocSection>

        <DocSection Label="Colunas Dinâmicas" Id="dynamic">
            <Description>
                As colunas são apenas dados: monte a lista de <code>OpDataTableColumn</code> em tempo de execução
                e atribua a <code>Columns</code>. O exemplo alterna entre o conjunto completo e um reduzido.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="_dynamicCols"/>
                    <div class="flex flex-wrap gap-4 items-center">
                        <OpButton Label="Alternar colunas" Icon="pi pi-table" OnClick="ToggleColumns"/>
                        <span class="text-sm">@_dynamicCols.Count coluna(s) visível(is)</span>
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DynamicCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanho" Id="size">
            <Description>
                <code>Size</code> aceita <code>small</code> ou <code>large</code>; sem valor, a tabela usa o
                tamanho padrão do tema.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Size="small"/>
                    <OpDataTable Items="Products" Columns="Cols"/>
                    <OpDataTable Items="Products" Columns="Cols" Size="large"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas de Grade" Id="gridlines">
            <Description>
                <code>ShowGridlines</code> desenha as bordas entre as células.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" ShowGridlines="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@GridlinesCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas Listradas" Id="striped">
            <Description>
                <code>StripedRows</code> alterna o fundo das linhas pares e ímpares.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" StripedRows="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@StripedCode"/></Code>
        </DocSection>

        <DocSection Label="Estilo e Realce" Id="table-style">
            <Description>
                Não há templates de linha ou célula, então não existe estilo condicional por linha como na
                referência. O que está disponível é <code>StyleClass</code> (classes extras no contêiner),
                <code>RowHover</code> (realce ao passar o mouse) e os <code>AdditionalAttributes</code>, que
                entregam atributos como <code>style</code> ao contêiner raiz.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" StyleClass="w-full"/>
                    <OpDataTable Items="Products" Columns="Cols" RowHover="false"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TableStyleCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Máscara" Id="loading-mask">
            <Description>
                <code>Loading</code> sobrepõe uma máscara à tabela. <code>LoadingIconTemplate</code> substitui o
                spinner padrão. No exemplo, o botão simula uma consulta de 2 segundos.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadMask" Loading="_maskLoading"/>
                    <OpDataTable Items="Products" Columns="Cols" Loading="_maskLoading">
                        <LoadingIconTemplate>
                            <span class="p-datatable-loading-icon pi pi-spin pi-spinner" aria-hidden="true"></span>
                        </LoadingIconTemplate>
                    </OpDataTable>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingMaskCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Skeleton" Id="loading-skeleton">
            <Description>
                Com <code>LoadingMode="skeleton"</code> o componente exibe linhas de esqueleto em vez da máscara.
                <code>SkeletonRows</code> define quantas linhas mostrar (0 usa <code>Rows</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadSkeleton" Loading="_skeletonLoading"/>
                    <OpDataTable Items="Products" Columns="Cols" Loading="_skeletonLoading" LoadingMode="skeleton" SkeletonRows="5"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingSkeletonCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Básico" Id="paginator-basic">
            <Description>
                <code>Paginator</code> habilita a paginação e <code>Rows</code> define os itens por página.
                <code>PaginatorPosition</code> aceita <code>bottom</code> (padrão), <code>top</code> ou
                <code>both</code>. <code>OnPage</code> informa a página exibida (base 0); a navegação em si é
                interna ao componente.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Paginator="true" Rows="5" PaginatorPosition="both" OnPage="OnPageChanged"/>
                    <div class="text-sm">Última página navegada: @(_page + 1)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Controlada" Id="paginator-control">
            <Description>
                A paginação é controlável: <code>@@bind-First</code> recebe o deslocamento (base 0) do primeiro
                item e <code>@@bind-Rows</code> a quantidade por página. <code>RowsPerPageOptions</code> habilita o
                seletor de itens por página. Todas as páginas, quando não vinculados, usam estado interno.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Paginator="true"
                                 RowsPerPageOptions="_rowsOptions" @bind-First="_ctrlFirst" @bind-Rows="_ctrlRows"/>
                    <div class="text-sm">first: @_ctrlFirst · rows: @_ctrlRows</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorControlCode"/></Code>
        </DocSection>

        <DocSection Label="Cabeçalho Fixo" Id="sticky-header">
            <Description>
                <code>StickyHeader</code> fixa o cabeçalho durante a rolagem e <code>ScrollHeight</code> limita a
                altura do contêiner de rolagem (qualquer unidade CSS). Sem <code>ScrollHeight</code> a tabela cresce
                com o conteúdo e o cabeçalho só fica fixo se o contêiner já tiver altura.
            </Description>
            <ChildContent>
                <OpDataTable Items="Products" Columns="Cols" StickyHeader="true" ScrollHeight="12rem"/>
            </ChildContent>
            <Code><CodeBlock Code="@StickyHeaderCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Coluna Única" Id="single-column-sort">
            <Description>
                A ordenação é embutida: clicar no cabeçalho percorre ascendente, descendente e sem ordenação,
                reordenando os itens por reflexão. <code>Sortable</code> desabilita globalmente e
                <code>OpDataTableColumn.Sortable</code> por coluna. <code>OnSort</code> entrega o par
                <code>(Field, Order)</code>, com <code>Order</code> em 1 (asc), -1 (desc) ou 0 (sem ordenação).
                Não há multi-sort, ordenação inicial nem reset programático.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" OnSort="OnSorted"/>
                    <div class="text-sm">Ordenação: @SortLabel</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SortCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Múltipla" Id="multiple-selection">
            <Description>
                <code>Selection</code> habilita a coluna de checkboxes e a seleção ao clicar na linha. A lista é
                controlada por <code>SelectedItems</code> e <code>SelectedItemsChanged</code> (ou pelo atalho
                <code>@@bind-SelectedItems</code>). O componente sempre trabalha em modo múltiplo; não há modo
                único nem por radio.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" SelectedItems="_selected" SelectedItemsChanged="@((IReadOnlyList<Product>? items) => OnSelectedChanged(items))"/>
                    <div class="text-sm">Selecionados: @_selected.Count</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionMultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Única" Id="single-selection">
            <Description>
                Com <code>SelectionMode="single"</code> não há coluna de checkboxes: clicar na linha seleciona
                apenas ela (clicar de novo desmarca). <code>DataKey</code> define a propriedade usada como
                identidade da linha, importante quando a lista é reordenada ou paginada.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" SelectionMode="single" DataKey="Name"
                                 @bind-SelectedItems="_singleSelected"/>
                    <div class="text-sm">Selecionado: @(_singleSelected.Count == 0 ? "nenhum" : _singleSelected[0].Name)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionSingleCode"/></Code>
        </DocSection>

        <DocSection Label="Eventos de Seleção" Id="selection-events">
            <Description>
                <code>OnRowClick</code> dispara ao clicar em qualquer linha, entregando o item clicado. Quando
                <code>Selection</code> está ativo, a linha é marcada ou desmarcada antes do evento.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_clickSelected" OnRowClick="@((Product item) => OnRowClicked(item))"/>
                    <div class="text-sm">Última linha clicada: @(_lastClicked?.Name ?? "nenhuma")</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionEventsCode"/></Code>
        </DocSection>

        <DocSection Label="Vínculo" Id="binding">
            <Description>
                <code>@@bind-SelectedItems</code> liga a seleção a um campo do componente que usa a tabela: a cada
                marcação o Blazor atualiza o campo com a nova lista. Mantenha a lista vinculada como fonte da
                verdade para habilitar ações que dependem do que está selecionado.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_boundSelected"/>
                    <div class="text-sm">
                        <div>Vinculados: @_boundSelected.Count</div>
                        @if (_boundSelected.Count > 0)
                        {
                            <ul style="margin:.25rem 0 0 1.25rem;">
                                @foreach (var product in _boundSelected)
                                {
                                    <li>@product.Name</li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BindingCode"/></Code>
        </DocSection>

        <DocSection Label="Formulários" Id="forms">
            <Description>
                O <code>OpDataTable</code> não herda de <code>InputBase</code>, então não registra um campo no
                <code>EditContext</code>. Ainda assim, a seleção pode ser validada dentro de um
                <code>EditForm</code>: vincule a lista a uma propriedade do modelo e aplique um atributo de
                validação customizado. Como o componente não dispara <code>OnFieldChanged</code>, a mensagem só
                aparece quando o formulário é enviado (<code>Validate()</code>).
            </Description>
            <ChildContent>
                <EditForm Model="_model" OnValidSubmit="SubmitSelection" class="flex flex-col gap-3">
                    <DataAnnotationsValidator/>
                    <OpDataTable Items="Products" Columns="Cols" Selection="true" @bind-SelectedItems="_model.Selected"/>
                    <ValidationMessage For="() => _model.Selected"/>
                    <div>
                        <button type="submit" class="p-button p-component"><span class="p-button-label">Confirmar</span></button>
                    </div>
                    @if (_selectionSubmitted)
                    {
                        <div class="text-sm">Seleção confirmada: @(_model.Selected?.Count ?? 0) item(ns).</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@FormsCode"/></Code>
        </DocSection>

        <DocSection Label="Recursos não portados" Id="not-ported">
            <Description>
                Os recursos abaixo existem na referência Angular (PrimeNG/Optimus UI v21), mas não têm equivalente
                nesta versão do <code>OpDataTable</code> porque a API necessária não foi portada. Eles não têm
                demonstração nesta página; os detalhes estão em <strong>Problemas Conhecidos</strong>.
            </Description>
            <ChildContent>
                <ApiTable Caption="Recursos da referência sem equivalente no Blazor"
                          Headers="@(new[] { "Recurso", "Seção na referência", "Motivo (API ausente)" })"
                          Rows="NotPortedRows"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O componente usa a marcação semântica nativa (<code>table</code>, <code>thead</code>,
                    <code>tbody</code>, <code>tr</code>, <code>th</code>, <code>td</code>), então os leitores de
                    tela inferem os papéis <code>rowgroup</code>, <code>row</code>, <code>columnheader</code> e
                    <code>cell</code> automaticamente. Os cabeçalhos ordenáveis são focáveis e expõem
                    <code>aria-sort</code>; as linhas selecionáveis anunciam <code>aria-selected</code>. Ainda
                    faltam rótulos ARIA nas checkboxes de seleção.
                </p>
                <p>
                    Papéis e rótulos podem ser reforçados pelos <code>AdditionalAttributes</code>: qualquer
                    atributo extra (ex.: <code>aria-label</code>) é repassado ao contêiner raiz.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado implementado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Percorre os botões do paginador. As checkboxes de seleção usam tabindex=\"-1\" e ficam fora da ordem de tabulação." },
                              new[] { "space", "Aciona o botão do paginador em foco." },
                              new[] { "enter", "Aciona o botão do paginador em foco." }
                          })"/>
                <div class="doc-section-description">
                    <h3>Suporte da referência ainda não implementado</h3>
                    <p>Os atalhos abaixo dependem de navegação por foco nas linhas, que não foi portada.</p>
                </div>
                <ApiTable Headers="@(new[] { "Tecla", "Função na referência" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco entre os cabeçalhos ordenáveis." },
                              new[] { "enter", "Ordena a coluna em foco." },
                              new[] { "space", "Ordena a coluna em foco." },
                              new[] { "seta para cima / para baixo", "Move o foco entre as linhas." },
                              new[] { "shift + seta", "Move o foco e alterna a seleção da linha." },
                              new[] { "control + a", "Seleciona todas as linhas." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Items", "IReadOnlyList&lt;TItem&gt;?", "null", "Lista de dados exibida." },
                              new[] { "Columns", "IReadOnlyList&lt;OpDataTableColumn&gt;", "vazio", "Definição das colunas." },
                              new[] { "Sortable", "bool", "true", "Habilita a ordenação global (combinada com <code>OpDataTableColumn.Sortable</code>)." },
                              new[] { "StripedRows", "bool", "false", "Alterna o fundo das linhas." },
                              new[] { "ShowGridlines", "bool", "false", "Desenha as bordas entre as células." },
                              new[] { "RowHover", "bool", "true", "Realça a linha sob o cursor." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "Selection", "bool", "false", "Habilita a coluna de checkboxes e o clique para selecionar linhas." },
                              new[] { "SelectedItems", "IReadOnlyList&lt;TItem&gt;?", "null", "Itens selecionados (para <code>@bind-SelectedItems</code>)." },
                              new[] { "SelectedItemsChanged", "EventCallback&lt;IReadOnlyList&lt;TItem&gt;?&gt;", "-", "Callback de seleção." },
                              new[] { "DataKey", "string?", "null", "Propriedade usada como identidade da linha na seleção (útil com paginação/ordenação)." },
                              new[] { "SelectionMode", "string", "multiple", "Modo de seleção: <code>multiple</code> (checkbox) ou <code>single</code> (uma linha por clique)." },
                              new[] { "SelectionPageOnly", "bool", "false", "Em modo múltiplo, limita o select-all às linhas da página atual." },
                              new[] { "Paginator", "bool", "false", "Habilita a paginação." },
                              new[] { "PaginatorPosition", "string", "bottom", "Posição do paginador: <code>bottom</code>, <code>top</code> ou <code>both</code>." },
                              new[] { "First", "int", "0", "Deslocamento (base 0) do primeiro item da página (para <code>@bind-First</code>)." },
                              new[] { "FirstChanged", "EventCallback&lt;int&gt;", "-", "Callback de mudança de página (deslocamento)." },
                              new[] { "Rows", "int", "5", "Itens por página (para <code>@bind-Rows</code>)." },
                              new[] { "RowsChanged", "EventCallback&lt;int&gt;", "-", "Callback de mudança de itens por página." },
                              new[] { "RowsPerPageOptions", "IReadOnlyList&lt;int&gt;?", "null", "Opções do seletor de itens por página." },
                              new[] { "PageLinkSize", "int", "5", "Quantidade de botões de página visíveis na janela do paginador." },
                              new[] { "StickyHeader", "bool", "false", "Mantém o cabeçalho fixo durante a rolagem vertical." },
                              new[] { "ScrollHeight", "string?", "null", "Altura máxima do contêiner de rolagem (ex.: <code>12rem</code>)." },
                              new[] { "EmptyMessage", "string?", "No results found", "Mensagem exibida quando não há dados." },
                              new[] { "Loading", "bool", "false", "Exibe o estado de carregamento." },
                              new[] { "LoadingMode", "string", "mask", "Modo: <code>mask</code> (máscara) ou <code>skeleton</code> (linhas esqueleto)." },
                              new[] { "SkeletonRows", "int", "0", "Linhas do modo <code>skeleton</code> (0 usa <code>Rows</code>)." },
                              new[] { "LoadingIconTemplate", "RenderFragment?", "null", "Template do ícone da máscara de carregamento." },
                              new[] { "StyleClass", "string?", "null", "Classes extras no contêiner raiz." },
                              new[] { "AdditionalAttributes", "Dictionary&lt;string, object&gt;?", "null", "Atributos não mapeados, repassados ao contêiner raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnSort", "EventCallback&lt;(string Field, int Order)&gt;", "Dispara ao ordenar; <code>Order</code>: 1 asc, -1 desc, 0 sem ordenação." },
                              new[] { "OnPage", "EventCallback&lt;int&gt;", "Dispara ao mudar de página; o valor é a página (base 0)." },
                              new[] { "OnRowClick", "EventCallback&lt;TItem&gt;", "Dispara ao clicar em uma linha, com o item clicado." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="OpDataTableColumn" Id="api-column">
            <ChildContent>
                <ApiTable Caption="OpDataTableColumn"
                          Headers="@(new[] { "Propriedade", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Field", "string", "vazio", "Nome da propriedade pública lida por reflexão (case-insensitive)." },
                              new[] { "Header", "string", "vazio", "Título exibido no cabeçalho." },
                              new[] { "Sortable", "bool", "true", "Se a coluna pode ser ordenada (combinado com o <code>Sortable</code> global)." },
                              new[] { "Width", "string?", "null", "Largura aplicada como <code>style=\"width:...\"</code> no <code>th</code>." },
                              new[] { "StyleClass", "string?", "null", "Classes extras no <code>th</code> e nos <code>td</code> da coluna." },
                              new[] { "HeaderStyleClass", "string?", "null", "Classes extras apenas no <code>th</code>." },
                              new[] { "BodyStyleClass", "string?", "null", "Classes extras apenas nos <code>td</code> do corpo." },
                              new[] { "Footer", "string?", "null", "Texto do rodapé desta coluna (renderiza um <code>tfoot</code>)." },
                              new[] { "FooterStyleClass", "string?", "null", "Classes extras no <code>td</code> do rodapé." }
                          })"/>
                <ApiTable Caption="OpDataTableColumn&lt;TItem&gt; (herda as propriedades acima)"
                          Headers="@(new[] { "Propriedade", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "BodyTemplate", "RenderFragment&lt;TItem&gt;?", "null", "Template do conteúdo da célula (substitui a leitura por reflexão)." },
                              new[] { "HeaderTemplate", "RenderFragment?", "null", "Template do conteúdo do cabeçalho (substitui <code>Header</code>)." },
                              new[] { "FooterTemplate", "RenderFragment?", "null", "Template do conteúdo do rodapé (substitui <code>Footer</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS" Id="style">
            <Description>
                Classes estruturais aplicadas pelo componente. Para as cores e medidas de cada tema, veja os
                tokens abaixo.
            </Description>
            <ChildContent>
                <ApiTable Headers="@(new[] { "Classe", "Elemento" })"
                          Rows="StyleRows"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Temas" Id="theming">
            <ChildContent><DocTokens Component="datatable"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description">
                    <p>
                        O pass-through (pt) do Angular ainda não foi portado para o Blazor. Para customização, use
                        <code>StyleClass</code>, <code>OpDataTableColumn.StyleClass</code>,
                        <code>OpDataTableColumn.Width</code> e os <code>AdditionalAttributes</code> (repassados ao
                        contêiner raiz).
                    </p>
                </div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>
                            Sem template de linha (expansão, agrupamento) nem edição. Templates de célula,
                            cabeçalho e rodapé por coluna estão disponíveis via <code>OpDataTableColumn&lt;TItem&gt;</code>.
                        </li>
                        <li>
                            Sem filtro de qualquer tipo (por coluna, global ou avançado).
                        </li>
                        <li>
                            A seleção é por checkbox (múltipla) ou por clique (<code>SelectionMode="single"</code>).
                            Não há modo por radio nem coluna de seleção dedicada.
                        </li>
                        <li>
                            A ordenação é de coluna única. Não há multi-sort, ordenação inicial (presort) nem
                            ordenação removível controlada por código.
                        </li>
                        <li>
                            A paginação é client-side sobre a lista já carregada: <code>First</code> e
                            <code>Rows</code> são controláveis, mas não há modo lazy nem total de registros externo.
                        </li>
                        <li>
                            <code>StickyHeader</code> e <code>ScrollHeight</code> cobrem o cabeçalho fixo e a rolagem
                            vertical. Não há scroll flexível/horizontal dedicado, colunas/linhas congeladas nem
                            scroll virtual.
                        </li>
                        <li>
                            Sem redimensionamento, reordenação, agrupamento ou ocultação de colunas, e sem
                            exportação ou menu de contexto.
                        </li>
                        <li>
                            Acessibilidade parcial: a marcação é semântica e os cabeçalhos têm <code>aria-sort</code>,
                            mas faltam <code>aria-selected</code> em todos os cenários, rótulos ARIA nas checkboxes e
                            navegação por teclado nas linhas.
                        </li>
                        <li>
                            <code>EmptyMessage</code> tem padrão em inglês (<code>"No results found"</code>);
                            informe um texto em pt-BR para manter a consistência.
                        </li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

