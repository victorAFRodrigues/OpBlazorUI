@page "/metergroup"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>MeterGroup - OpBlazorUI</PageTitle>

<DocComponent Title="MeterGroup"
              Description="Exibe medições escalares dentro de um intervalo conhecido. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O MeterGroup requer um <code>value</code> como dado a exibir, onde cada item da coleção deve ser do tipo <code>MeterItem</code>.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Múltiplos" Id="multiple">
            <Description><p>Adicionar mais itens ao array exibe os medidores em grupo.</p></Description>
            <Code><CodeBlock Code="@MultipleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Ícone" Id="icon">
            <Description><p>Ícones podem ser exibidos ao lado dos rótulos em vez do marcador padrão.</p></Description>
            <Code><CodeBlock Code="@IconCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Rótulo" Id="label">
            <Description><p>A posição dos rótulos em relação aos medidores é definida com a propriedade <code>labelPosition</code>. A orientação padrão dos rótulos é horizontal, e a alternativa vertical está disponível pela opção <code>labelOrientation</code>.</p></Description>
            <Code><CodeBlock Code="@LabelCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Vertical" Id="vertical">
            <Description><p>O layout do MeterGroup é configurado com a propriedade <code>orientation</code>, que aceita <code>horizontal</code> ou <code>vertical</code> como opções disponíveis.</p></Description>
            <Code><CodeBlock Code="@VerticalCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Mín Máx" Id="minmax">
            <Description><p>Os limites são configurados com os valores <code>min</code> e <code>max</code>, cujos padrões são 0 e 100 respectivamente.</p></Description>
            <Code><CodeBlock Code="@MinMaxCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>O MeterGroup oferece suporte a templates para rótulos, itens de medidor e conteúdo ao redor dos medidores.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente MeterGroup usa o papel <code>meter</code> além dos atributos <code>aria-valuemin</code>, <code>aria-valuemax</code> e <code>aria-valuenow</code>. O valor para descrever o componente pode ser definido com a propriedade <code>aria-labelledby</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>O componente não inclui elementos interativos.</p>
            </Description>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { MeterGroupModule } from 'primeng/metergroup';
        """;

    private const string BasicCode = """
        <p-metergroup [value]="value" />
        """;

    private const string MultipleCode = """
        <p-metergroup [value]="value" />
        """;

    private const string IconCode = """
        <p-metergroup [value]="value" />
        """;

    private const string LabelCode = """
        <p-metergroup [value]="value" labelPosition="start" labelOrientation="vertical" />
        """;

    private const string VerticalCode = """
        <p-metergroup [value]="value" orientation="vertical" labelOrientation="vertical" [style]="{ height: '300px' }" />
        """;

    private const string MinMaxCode = """
        <p-metergroup [value]="value" [max]="200" />
        """;

    private const string TemplateCode = """
        <p-metergroup [value]="value" labelPosition="start">
            <ng-template #label>
                <div class="flex flex-wrap gap-4">
                    <ng-container *ngFor="let meterItem of value; let index = index">
                        <p-card class="flex-1" styleClass="border border-surface shadow-none">
                            <div class="flex justify-between gap-8">
                                <div class="flex flex-col gap-1">
                                    <span class="text-surface-500 dark:text-surface-400 text-sm">{{ meterItem.label }}</span>
                                    <span class="font-bold text-lg">{{ meterItem.value }}%</span>
                                </div>
                                <span class="w-8 h-8 rounded-full inline-flex justify-center items-center text-center" [style]="{ 'background-color': meterItem.color1, color: '#ffffff' }">
                                    <i [class]="meterItem.icon"></i>
                                </span>
                            </div>
                        </p-card>
                    </ng-container>
                </div>
            </ng-template>
            <ng-template #meter let-value let-class="class" let-width="size">
                <span [class]="class" [style]="{ background: 'linear-gradient(to right, ' + value.color1 + ', ' + value.color2 + ')', width: width }"></span>
            </ng-template>
            <ng-template #start let-totalPercent="totalPercent">
                <div class="flex justify-between mt-4 mb-2 relative">
                    <span>Storage</span>
                    <span [style]="{ width: totalPercent + '%' }" class="absolute text-right">{{ totalPercent }}%</span>
                    <span class="font-medium">1TB</span>
                </div>
            </ng-template>
            <ng-template #end>
                <div class="flex justify-between mt-4">
                    <p-button label="Manage Storage" [outlined]="true" size="small" />
                    <p-button label="Update Plan" size="small" />
                </div>
            </ng-template>
        </p-metergroup>
        """;
}
