@page "/toolbar"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.Toolbar
@using OpBlazorUI.Components.Button
@using OpBlazorUI.Components.Avatar

<PageTitle>Toolbar - OpBlazorUI</PageTitle>

<DocComponent Title="Toolbar"
              Description="O Toolbar é um contêiner para agrupar conteúdo nos lados esquerdo, centro e direito.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                Os templates <code>StartTemplate</code>, <code>CenterTemplate</code> e <code>EndTemplate</code>
                posicionam o conteúdo à esquerda, ao centro e à direita.
            </Description>
            <ChildContent>
                <OpToolbar>
                    <StartTemplate>
                        <button type="button" class="p-button p-component">Novo</button>
                    </StartTemplate>
                    <CenterTemplate>
                        <span style="font-weight: 600;">Documentos</span>
                    </CenterTemplate>
                    <EndTemplate>
                        <button type="button" class="p-button p-component p-button-outlined p-button-secondary" style="margin-right: .5rem;">Editar</button>
                        <button type="button" class="p-button p-component p-button-outlined p-button-secondary">Compartilhar</button>
                    </EndTemplate>
                </OpToolbar>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Customizado" Id="custom">
            <Description>
                Os templates <code>StartTemplate</code>/<code>EndTemplate</code> aceitam qualquer conteúdo —
                aqui, um ícone de marca, botões e um <code>OpAvatar</code>. Ajuste borda e espaçamento
                enviando <code>style</code> (atributo não mapeado).
            </Description>
            <ChildContent>
                <OpToolbar style="border-radius: 3rem; padding: 1rem 1rem 1rem 1.5rem;">
                    <StartTemplate>
                        <div class="flex items-center gap-2">
                            <i class="pi pi-prime" aria-hidden="true" style="font-size: 2rem; color: var(--p-primary-color); margin-right: .5rem;"></i>
                            <OpButton Label="Arquivos" Text="true" Plain="true"/>
                            <OpButton Label="Editar" Text="true" Plain="true"/>
                            <OpButton Label="Visualizar" Text="true" Plain="true"/>
                        </div>
                    </StartTemplate>
                    <EndTemplate>
                        <div class="flex items-center gap-2">
                            <OpButton Label="Compartilhar" Severity="contrast" Size="small"/>
                            <OpAvatar Image="https://primefaces.org/cdn/primevue/images/avatar/amyelsner.png" Shape="circle" Alt="Amy Elsner" Style="width: 32px; height: 32px;"/>
                        </div>
                    </EndTemplate>
                </OpToolbar>
            </ChildContent>
            <Code><CodeBlock Code="@CustomCode"/></Code>
        </DocSection>

        <DocSection Label="Somente conteúdo" Id="content">
            <Description>Sem templates, o conteúdo é inserido diretamente no toolbar.</Description>
            <ChildContent>
                <OpToolbar>
                    <span>Conteúdo livre dentro do toolbar.</span>
                </OpToolbar>
            </ChildContent>
            <Code><CodeBlock Code="@ContentCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente usa <code>role="toolbar"</code>. Informe um <code>AriaLabel</code> que descreva o grupo de controles.</p>
                <h3>Suporte a teclado</h3>
                <p>O foco percorre os controles internos normalmente com <code>tab</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível do toolbar." },
                              new[] { "StartTemplate", "RenderFragment?", "null", "Conteúdo alinhado ao início." },
                              new[] { "CenterTemplate", "RenderFragment?", "null", "Conteúdo alinhado ao centro." },
                              new[] { "EndTemplate", "RenderFragment?", "null", "Conteúdo alinhado ao fim." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Conteúdo livre." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="toolbar"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent><div class="doc-section-description"><p>Componente simples; sem desvios relevantes.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Components.Toolbar

        <OpToolbar>
            <StartTemplate><button class="p-button">Novo</button></StartTemplate>
            <EndTemplate><button class="p-button">Editar</button></EndTemplate>
        </OpToolbar>
        """;

    private const string BasicCode = """
        <OpToolbar>
            <StartTemplate>
                <button type="button" class="p-button p-component">Novo</button>
            </StartTemplate>
            <CenterTemplate>
                <span>Documentos</span>
            </CenterTemplate>
            <EndTemplate>
                <button type="button" class="p-button p-component">Editar</button>
                <button type="button" class="p-button p-component">Compartilhar</button>
            </EndTemplate>
        </OpToolbar>
        """;

    private const string ContentCode = """
        <OpToolbar>
            <span>Conteúdo livre dentro do toolbar.</span>
        </OpToolbar>
        """;

    private const string CustomCode = """
        <OpToolbar style="border-radius: 3rem; padding: 1rem 1rem 1rem 1.5rem;">
            <StartTemplate>
                <div class="flex items-center gap-2">
                    <i class="pi pi-prime" aria-hidden="true" style="font-size: 2rem; color: var(--p-primary-color);"></i>
                    <OpButton Label="Arquivos" Text="true" Plain="true" />
                    <OpButton Label="Editar" Text="true" Plain="true" />
                    <OpButton Label="Visualizar" Text="true" Plain="true" />
                </div>
            </StartTemplate>
            <EndTemplate>
                <div class="flex items-center gap-2">
                    <OpButton Label="Compartilhar" Severity="contrast" Size="small" />
                    <OpAvatar Image="..." Shape="circle" Alt="Amy Elsner" Style="width: 32px; height: 32px;" />
                </div>
            </EndTemplate>
        </OpToolbar>
        """;

    private const string AccessibilityCode = """
        <OpToolbar AriaLabel="Ações do documento">
            <StartTemplate><button class="p-button">Novo</button></StartTemplate>
        </OpToolbar>
        """;
}
