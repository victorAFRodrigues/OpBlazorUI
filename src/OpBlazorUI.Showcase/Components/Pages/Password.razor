@page "/password"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Password
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.IftaLabel
@using System.ComponentModel.DataAnnotations

<DocComponent Title="Password"
              Description="O Password exibe um indicador de força para campos de senha.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade">
            <Description>
                O valor pode ser descrito via <code>label</code> + <code>InputId</code> ou <code>AriaLabel</code>. O leitor de tela é notificado das mudanças de força por meio de uma seção com <code>aria-live</code> durante a digitação.
            </Description>
        </DocSection>

        <DocSection Label="Básico">
            <Description>
                O binding bidirecional é feito com <code>@@bind-Value</code>. Use <code>Feedback="false"</code> para ocultar o medidor de força.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_value" Feedback="false" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Toggle Mask">
            <Description>
                Com <code>ToggleMask</code>, um ícone é exibido para mostrar o valor como texto simples.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_value2" ToggleMask="true" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@ToggleMaskCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone de Limpar">
            <Description>
                Quando <code>ShowClear</code> está habilitado, um ícone de limpar é exibido para apagar o valor.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_value3" Feedback="false" ShowClear="true" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@ClearIconCode"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado">
            <ChildContent>
                <OpPassword @bind-Value="_value4" Disabled="true" Placeholder="Desabilitado" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@DisabledCode"/></Code>
        </DocSection>

        <DocSection Label="Preenchido">
            <Description>
                Especifique <code>Variant="filled"</code> para exibir o componente com maior ênfase visual.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_value5" Feedback="false" Variant="filled" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@FilledCode"/></Code>
        </DocSection>

        <DocSection Label="Fluid">
            <Description>
                A propriedade <code>Fluid</code> faz o componente ocupar toda a largura do contêiner.
            </Description>
            <ChildContent>
                <div class="w-full">
                    <OpPassword @bind-Value="_value6" Feedback="false" Fluid="true" Autocomplete="off"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FluidCode"/></Code>
        </DocSection>

        <DocSection Label="Float Label">
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <OpFloatLabel>
                        <OpPassword @bind-Value="_fl1" InputId="pw_over" Autocomplete="off"/>
                        <label for="pw_over">Over Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="in">
                        <OpPassword @bind-Value="_fl2" InputId="pw_in" Autocomplete="off"/>
                        <label for="pw_in">In Label</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="on">
                        <OpPassword @bind-Value="_fl3" InputId="pw_on" Autocomplete="off"/>
                        <label for="pw_on">On Label</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@FloatLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Ifta Label">
            <ChildContent>
                <OpIftaLabel>
                    <OpPassword @bind-Value="_ifta" InputId="pw_ifta" Autocomplete="off"/>
                    <label for="pw_ifta">Senha</label>
                </OpIftaLabel>
            </ChildContent>
            <Code><CodeBlock Code="@IftaLabelCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido">
            <Description>
                O estado inválido é aplicado com a propriedade <code>Invalid</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center gap-4">
                    <OpPassword @bind-Value="_inv1" Invalid="true" Placeholder="Senha"/>
                    <OpPassword @bind-Value="_inv2" Invalid="true" Variant="filled" Placeholder="Senha"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Medidor de Força">
            <Description>
                O medidor é exibido como um popup enquanto o valor é digitado. Use <code>PromptLabel</code>, <code>WeakLabel</code>, <code>MediumLabel</code> e <code>StrongLabel</code> para traduzir.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_meter" PromptLabel="Escolha uma senha" WeakLabel="Muito simples"
                            MediumLabel="Complexidade média" StrongLabel="Senha complexa" Autocomplete="off"/>
            </ChildContent>
            <Code><CodeBlock Code="@MeterCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanhos">
            <ChildContent>
                <div class="flex flex-col items-center gap-4">
                    <OpPassword @bind-Value="_s1" Feedback="false" Size="small" Placeholder="Small"/>
                    <OpPassword @bind-Value="_s2" Feedback="false" Placeholder="Normal"/>
                    <OpPassword @bind-Value="_s3" Feedback="false" Size="large" Placeholder="Large"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizesCode"/></Code>
        </DocSection>

        <DocSection Label="Template">
            <Description>
                Use <code>HeaderTemplate</code> e <code>FooterTemplate</code> para customizar o overlay. <code>ContentTemplate</code> substitui o medidor padrão.
            </Description>
            <ChildContent>
                <OpPassword @bind-Value="_tpl" Autocomplete="off">
                    <HeaderTemplate>
                        <div class="font-semibold" style="margin-bottom:.5rem;">Redefinir senha</div>
                    </HeaderTemplate>
                    <FooterTemplate>
                        <ul style="padding-left:1rem; margin:0; line-height:1.5; font-size:.85rem;">
                            <li>Ao menos uma minúscula</li>
                            <li>Ao menos uma maiúscula</li>
                            <li>Ao menos um número</li>
                            <li>Mínimo de 8 caracteres</li>
                        </ul>
                    </FooterTemplate>
                </OpPassword>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Validação">
            <Description>
                O Password integra-se ao <code>EditForm</code> do Blazor com DataAnnotations.
            </Description>
            <ChildContent>
                <EditForm Model="_pwForm" OnValidSubmit="OnPwSubmit" class="flex flex-col gap-2">
                    <DataAnnotationsValidator/>
                    <OpPassword @bind-Value="_pwForm.Password" Feedback="false" Fluid="true" Invalid="@(!_pwSubmitted && string.IsNullOrEmpty(_pwForm.Password))"/>
                    <ValidationMessage For="() => _pwForm.Password"/>
                    <button type="submit" class="p-button p-component">Enviar</button>
                    @if (_pwSubmitted)
                    {
                        <div class="text-sm" style="color:var(--p-green-600)">Senha válida.</div>
                    }
                </EditForm>
            </ChildContent>
            <Code><CodeBlock Code="@ValidationCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Value", "string?", "null", "Valor da senha. Combine com <code>@bind-Value</code>." },
                              new[] { "Feedback", "bool", "true", "Exibe o indicador de força." },
                              new[] { "ToggleMask", "bool", "false", "Exibe um ícone para mostrar a senha como texto." },
                              new[] { "ShowClear", "bool", "false", "Exibe um ícone para limpar o valor." },
                              new[] { "Placeholder", "string?", "null", "Texto de placeholder." },
                              new[] { "Variant", "string", "outlined", "<code>outlined</code> ou <code>filled</code>." },
                              new[] { "Size", "string?", "null", "<code>small</code> ou <code>large</code>." },
                              new[] { "Invalid", "bool", "false", "Estado de erro." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Readonly", "bool", "false", "Somente leitura." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura." },
                              new[] { "Autocomplete", "string?", "null", "Assistência do navegador." },
                              new[] { "InputId", "string?", "null", "Id do input." },
                              new[] { "AriaLabel", "string?", "null", "Label de acessibilidade." },
                              new[] { "AriaLabelledBy", "string?", "null", "Ids dos elementos que rotulam o input." },
                              new[] { "MaxLength", "int?", "null", "Número máximo de caracteres." },
                              new[] { "PromptLabel", "string?", "null", "Texto quando vazio." },
                              new[] { "WeakLabel", "string?", "null", "Texto para senha fraca." },
                              new[] { "MediumLabel", "string?", "null", "Texto para senha média." },
                              new[] { "StrongLabel", "string?", "null", "Texto para senha forte." },
                              new[] { "MediumRegex", "string", "...", "Regex de força média." },
                              new[] { "StrongRegex", "string", "...", "Regex de força forte." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnFocus", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao focar." },
                              new[] { "OnBlur", "EventCallback&lt;FocusEventArgs&gt;", "Disparado ao desfocar." },
                              new[] { "OnClear", "EventCallback", "Disparado ao limpar." },
                              new[] { "OnInput", "EventCallback&lt;string?&gt;", "Disparado ao digitar." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "HeaderTemplate", "RenderFragment?", "Template do cabeçalho do overlay." },
                              new[] { "ContentTemplate", "RenderFragment?", "Template do conteúdo (substitui o medidor)." },
                              new[] { "FooterTemplate", "RenderFragment?", "Template do rodapé do overlay." },
                              new[] { "ClearIconTemplate", "RenderFragment?", "Template do ícone de limpar." },
                              new[] { "ShowIconTemplate", "RenderFragment?", "Template do ícone de mostrar." },
                              new[] { "HideIconTemplate", "RenderFragment?", "Template do ícone de ocultar." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="password"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use os templates para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string? _value;
    private string? _value2;
    private string? _value3;
    private string? _value4;
    private string? _value5;
    private string? _value6;
    private string? _fl1;
    private string? _fl2;
    private string? _fl3;
    private string? _ifta;
    private string? _inv1;
    private string? _inv2;
    private string? _meter;
    private string? _s1;
    private string? _s2;
    private string? _s3;
    private string? _tpl;

    private bool _pwSubmitted;
    private PwForm _pwForm = new();

    private sealed class PwForm
    {
        [Required(ErrorMessage = "A senha é obrigatória.")]
        [MinLength(8, ErrorMessage = "A senha deve ter ao menos 8 caracteres.")]
        public string? Password { get; set; }
    }

    private void OnPwSubmit()
    {
        _pwSubmitted = true;
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Password

        <OpPassword @bind-Value="_value" />
        """;

    private const string BasicCode = """
        <OpPassword @bind-Value="_value" Feedback="false" Autocomplete="off" />
        """;

    private const string ToggleMaskCode = """
        <OpPassword @bind-Value="_value" ToggleMask="true" Autocomplete="off" />
        """;

    private const string ClearIconCode = """
        <OpPassword @bind-Value="_value" Feedback="false" ShowClear="true" Autocomplete="off" />
        """;

    private const string DisabledCode = """
        <OpPassword @bind-Value="_value" Disabled="true" Placeholder="Desabilitado" />
        """;

    private const string FilledCode = """
        <OpPassword @bind-Value="_value" Feedback="false" Variant="filled" />
        """;

    private const string FluidCode = """
        <OpPassword @bind-Value="_value" Feedback="false" Fluid="true" />
        """;

    private const string FloatLabelCode = """
        <OpFloatLabel>
            <OpPassword @bind-Value="_value" InputId="pw_over" />
            <label for="pw_over">Over Label</label>
        </OpFloatLabel>
        """;

    private const string IftaLabelCode = """
        <OpIftaLabel>
            <OpPassword @bind-Value="_value" InputId="pw_ifta" />
            <label for="pw_ifta">Senha</label>
        </OpIftaLabel>
        """;

    private const string InvalidCode = """
        <OpPassword @bind-Value="_value" Invalid="true" Placeholder="Senha" />
        """;

    private const string MeterCode = """
        <OpPassword @bind-Value="_value" PromptLabel="Escolha uma senha" WeakLabel="Muito simples"
                    MediumLabel="Complexidade média" StrongLabel="Senha complexa" />
        """;

    private const string SizesCode = """
        <OpPassword @bind-Value="_value" Size="small" Placeholder="Small" />
        <OpPassword @bind-Value="_value" Placeholder="Normal" />
        <OpPassword @bind-Value="_value" Size="large" Placeholder="Large" />
        """;

    private const string TemplateCode = """
        <OpPassword @bind-Value="_value">
            <HeaderTemplate>
                <div class="font-semibold">Redefinir senha</div>
            </HeaderTemplate>
            <FooterTemplate>
                <ul>
                    <li>Ao menos uma minúscula</li>
                    <li>Ao menos uma maiúscula</li>
                    <li>Ao menos um número</li>
                    <li>Mínimo de 8 caracteres</li>
                </ul>
            </FooterTemplate>
        </OpPassword>
        """;

    private const string ValidationCode = """
        <EditForm Model="_form" OnValidSubmit="OnSubmit">
            <DataAnnotationsValidator />
            <OpPassword @bind-Value="_form.Password" Fluid="true" Invalid="@(!_submitted && string.IsNullOrEmpty(_form.Password))" />
            <ValidationMessage For="() => _form.Password" />
            <button type="submit" class="p-button p-component">Enviar</button>
        </EditForm>
        """;
}
