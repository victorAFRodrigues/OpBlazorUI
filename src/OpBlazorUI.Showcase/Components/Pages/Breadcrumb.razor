@page "/breadcrumb"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Breadcrumb - OpBlazorUI</PageTitle>

<DocComponent Title="Breadcrumb"
              Description="Fornece informação contextual sobre a hierarquia da página. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O Breadcrumb fornece informação contextual sobre a hierarquia da página.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>Conteúdo personalizado pode ser colocado dentro dos itens usando o template <code>item</code>. O divisor entre os itens tem seu próprio template <code>separator</code>.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Roteamento" Id="router">
            <Description><p>Os itens de menu suportam navegação via <code>routerLink</code>, roteamento programático usando comandos ou URLs externas.</p></Description>
            <Code><CodeBlock Code="@RouterCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O Breadcrumb usa o elemento <code>nav</code> e, como qualquer atributo é passado implicitamente à raiz, <code>aria-labelledby</code> ou <code>aria-label</code> podem ser usados para descrever o componente. Internamente é usada uma lista ordenada, onde os separadores dos itens têm <code>aria-hidden</code> para serem ignorados pelos leitores de tela. Se o último link representar a rota atual, <code>aria-current</code> é adicionado com o valor "page".</p>
                <h3>Suporte a teclado</h3>
                <p>Nenhuma interação especial de teclado é necessária; todos os itens de menu são focáveis com base na sequência de tabulação da página.</p>
            </Description>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { BreadcrumbModule } from 'primeng/breadcrumb';
        """;

    private const string BasicCode = """
        <p-breadcrumb [model]="items" [home]="home" />
        """;

    private const string TemplateCode = """
        <p-breadcrumb [model]="items" [home]="home">
            <ng-template #item let-item>
                <a class="cursor-pointer" [routerLink]="item.url">
                    <i [class]="item.icon"></i>
                </a>
            </ng-template>
            <ng-template #separator> / </ng-template>
        </p-breadcrumb>
        """;

    private const string RouterCode = """
        <p-breadcrumb [home]="home" [model]="items" />
        """;
}
