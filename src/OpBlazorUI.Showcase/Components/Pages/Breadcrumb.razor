@page "/breadcrumb"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.Breadcrumb
@using OpBlazorUI.Models

<PageTitle>Breadcrumb - OpBlazorUI</PageTitle>

<DocComponent Title="Breadcrumb"
              Description="O Breadcrumb fornece navegação hierárquica baseada em uma lista de itens.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>O <code>Model</code> define os itens; o último é sempre o item ativo.</Description>
            <ChildContent>
                <OpBreadcrumb Model="_items"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Com Home" Id="home">
            <Description>O item <code>Home</code> é exibido antes dos demais, normalmente com um ícone.</Description>
            <ChildContent>
                <OpBreadcrumb Home="_home" Model="_items"/>
            </ChildContent>
            <Code><CodeBlock Code="@HomeCode"/></Code>
        </DocSection>

        <DocSection Label="Ícones" Id="icons">
            <Description>Cada item pode ter um ícone.</Description>
            <ChildContent>
                <OpBreadcrumb Home="_home"
                              Model="@(new[] {
                                  new OpMenuItem { Label = "Categoria", Icon = "pi pi-sitemap", Url = "#" },
                                  new OpMenuItem { Label = "Documento", Icon = "pi pi-file", Url = "#" },
                                  new OpMenuItem { Label = "Detalhe" }
                              })"/>
            </ChildContent>
            <Code><CodeBlock Code="@IconsCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                O <code>ItemTemplate</code> recebe o <code>OpMenuItem</code> e substitui o conteúdo de cada item; o
                <code>SeparatorTemplate</code> substitui o separador. Diferente dos menus, aqui o template fornece o
                próprio link do item.
            </Description>
            <ChildContent>
                <OpBreadcrumb Home="_home" Model="_templateItems">
                    <ItemTemplate Context="item">
                        <a class="p-breadcrumb-item-link" href="@item.Url" @onclick:preventDefault="true">
                            <span class="@($"p-breadcrumb-item-icon {item.Icon}")" aria-hidden="true"></span>
                        </a>
                    </ItemTemplate>
                    <SeparatorTemplate> / </SeparatorTemplate>
                </OpBreadcrumb>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Router" Id="router">
            <Description>
                A navegação usa <code>OpMenuItem.Url</code> (equivalente ao <code>routerLink</code>). O item
                <code>Home</code> normalmente aponta para a raiz.
            </Description>
            <ChildContent>
                <OpBreadcrumb Home="_routerHome" Model="_routerItems"/>
            </ChildContent>
            <Code><CodeBlock Code="@RouterCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente usa o elemento <code>nav</code> com <code>aria-label</code>; o último item tem <code>aria-current="page"</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Os itens são alcançáveis por <code>tab</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Itens do breadcrumb." },
                              new[] { "Home", "OpMenuItem?", "null", "Item inicial, exibido antes dos demais." },
                              new[] { "HomeTemplate", "RenderFragment&lt;OpMenuItem&gt;?", "null", "Conteúdo do item Home." },
                              new[] { "ItemTemplate", "RenderFragment&lt;OpMenuItem&gt;?", "null", "Conteúdo de cada item (equivale ao <code>#item</code> do upstream)." },
                              new[] { "SeparatorTemplate", "RenderFragment?", "null", "Conteúdo do separador (equivale ao <code>#separator</code> do upstream)." },
                              new[] { "SeparatorIcon", "string", "&quot;pi pi-angle-right&quot;", "Ícone do separador, quando não há <code>SeparatorTemplate</code>." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível do <code>nav</code>." },
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao clicar num item, após executar <code>Command</code>." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="breadcrumb"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Sem <code>ItemTemplate</code>, o último item é renderizado como texto (não clicável); os demais viram links.</li>
                        <li>O <code>ItemTemplate</code> substitui o conteúdo do item por inteiro, incluindo o link (ver a seção Template).</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private readonly OpMenuItem _home = new() { Icon = "pi pi-home", Url = "/" };
    private readonly OpMenuItem _routerHome = new() { Icon = "pi pi-home", Url = "/" };

    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem { Label = "Componentes", Url = "#" },
        new OpMenuItem { Label = "Formulário", Url = "#" },
        new OpMenuItem { Label = "InputText" }
    };

    private readonly List<OpMenuItem> _templateItems = new()
    {
        new() { Icon = "pi pi-sitemap" },
        new() { Icon = "pi pi-book" },
        new() { Icon = "pi pi-wallet" },
        new() { Icon = "pi pi-shopping-bag" },
        new() { Icon = "pi pi-calculator" }
    };

    private readonly List<OpMenuItem> _routerItems = new()
    {
        new() { Label = "Componentes", Url = "/" },
        new() { Label = "Formulário" },
        new() { Label = "InputText", Url = "/inputtext" }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Components.Breadcrumb
        @using OpBlazorUI.Models

        <OpBreadcrumb Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Componentes", Url = "#" },
                new OpMenuItem { Label = "Formulário" }
            };
        }
        """;

    private const string BasicCode = """
        <OpBreadcrumb Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Componentes", Url = "#" },
                new OpMenuItem { Label = "Formulário", Url = "#" },
                new OpMenuItem { Label = "InputText" }
            };
        }
        """;

    private const string HomeCode = """
        <OpBreadcrumb Home="_home" Model="_items" />

        @code {
            private OpMenuItem _home = new() { Icon = "pi pi-home", Url = "/" };
        }
        """;

    private const string IconsCode = """
        <OpBreadcrumb Home="_home" Model="_items" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Categoria", Icon = "pi pi-sitemap", Url = "#" },
                new OpMenuItem { Label = "Documento", Icon = "pi pi-file", Url = "#" },
                new OpMenuItem { Label = "Detalhe" }
            };
        }
        """;

    private const string TemplateCode = """
        <OpBreadcrumb Home="_home" Model="_items">
            <ItemTemplate Context="item">
                <a class="p-breadcrumb-item-link" href="@item.Url">
                    <span class="@($"p-breadcrumb-item-icon {item.Icon}")"></span>
                </a>
            </ItemTemplate>
            <SeparatorTemplate> / </SeparatorTemplate>
        </OpBreadcrumb>

        @code {
            private List<OpMenuItem> _items = new()
            {
                new() { Icon = "pi pi-sitemap" },
                new() { Icon = "pi pi-book" },
                new() { Icon = "pi pi-wallet" }
            };
        }
        """;

    private const string RouterCode = """
        <OpBreadcrumb Home="_home" Model="_items" />

        @code {
            private OpMenuItem _home = new() { Icon = "pi pi-home", Url = "/" };
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Componentes", Url = "#" },
                new OpMenuItem { Label = "Formulário", Url = "#" },
                new OpMenuItem { Label = "InputText", Url = "/inputtext" }
            };
        }
        """;

    private const string AccessibilityCode = """
        <OpBreadcrumb AriaLabel="Você está aqui" Model="_items" />
        """;
}
