@page "/inplace"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Inplace - OpBlazorUI</PageTitle>

<DocComponent Title="Inplace"
              Description="Exibe conteúdo no lugar de outro, alternando entre os estados de visualização e edição. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular).">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O componente exige os templates <code>display</code> e <code>content</code> para definir o conteúdo de cada estado.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Entrada" Id="input">
            <Description><p>O <code>closeCallback</code> retorna ao modo de visualização quando chamado a partir de um evento.</p></Description>
            <Code><CodeBlock Code="@InputCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Imagem" Id="image">
            <Description><p>Qualquer conteúdo, como uma imagem, pode ser colocado dentro de um Inplace.</p></Description>
            <Code><CodeBlock Code="@ImageCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Carregamento Preguiçoso" Id="lazy">
            <Description><p>Usando o evento <code>onActivate</code>, os dados podem ser carregados sob demanda antes de exibi-los.</p></Description>
            <Code><CodeBlock Code="@LazyCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O componente define <code>aria-live</code> como <code>polite</code> por padrão. O elemento de visualização usa role <code>button</code>; <code>displayProps</code> pode adicionar <code>aria-label</code>/<code>aria-labelledby</code>. Componentes fecháveis exibem um botão com <code>aria-label</code> padrão de fechar.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Caption="Modo de visualização"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] { new[] { "enter", "Alterna para o conteúdo." } })"/>
                <ApiTable Caption="Botão de fechar"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "enter", "Volta para a visualização." },
                              new[] { "space", "Volta para a visualização." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { InplaceModule } from 'primeng/inplace';
        """;

    private const string BasicCode = """
        <p-inplace>
            <ng-template #display>
                <span>View Content</span>
            </ng-template>
            <ng-template #content>
                <p class="m-0">
                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                </p>
            </ng-template>
        </p-inplace>
        """;

    private const string InputCode = """
        <p-inplace>
            <ng-template #display>
                <span>Click to Edit</span>
            </ng-template>
            <ng-template #content let-closeCallback="closeCallback">
                <span class="inline-flex gap-2">
                    <input type="text" pInputText [pAutoFocus]="true" />
                    <button type="button" pButton (click)="closeCallback($event)" text severity="danger">
                        <i class="pi pi-times" pButtonIcon></i>
                    </button>
                </span>
            </ng-template>
        </p-inplace>
        """;

    private const string ImageCode = """
        <p-inplace>
            <ng-template #display>
                <span class="inline-flex items-center gap-2">
                    <span class="pi pi-image" style="vertical-align: middle"></span>
                    <span class="ml-2">View Photo</span>
                </span>
            </ng-template>
            <ng-template #content>
                <img class="w-full sm:w-80 shadow-md" src="https://primefaces.org/cdn/primeng/images/demo/galleria/galleria5.jpg" alt="Nature" />
            </ng-template>
        </p-inplace>
        """;

    private const string LazyCode = """
        <p-inplace (onActivate)="loadData()">
            <ng-template #display>
                <span>View Data</span>
            </ng-template>
            <ng-template #content>
                <p-table [value]="products" responsiveLayout="scroll">
                    <ng-template #header>
                        <tr>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Quantity</th>
                        </tr>
                    </ng-template>
                    <ng-template #body let-product>
                        <tr>
                            <td>{{ product.code }}</td>
                            <td>{{ product.name }}</td>
                            <td>{{ product.category }}</td>
                            <td>{{ product.quantity }}</td>
                        </tr>
                    </ng-template>
                </p-table>
            </ng-template>
        </p-inplace>
        """;
}
