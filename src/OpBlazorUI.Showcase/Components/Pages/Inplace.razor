@page "/inplace"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Inplace
@using OpBlazorUI.Base.Components.InputText

<PageTitle>Inplace - OpBlazorUI</PageTitle>

<DocComponent Title="Inplace"
              Description="O Inplace permite exibir e editar ao mesmo tempo: clicar na exibição mostra o conteúdo real.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O Inplace requer os templates de exibição (<code>DisplayTemplate</code>) e conteúdo
                (<code>ContentTemplate</code>).
            </Description>
            <ChildContent>
                <OpInplace>
                    <DisplayTemplate><span>Ver conteúdo</span></DisplayTemplate>
                    <ContentTemplate>
                        <p class="m-0" style="max-width: 30rem;">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut
                            labore et dolore magna aliqua. Ut enim ad minim veniam.
                        </p>
                    </ContentTemplate>
                </OpInplace>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Input" Id="input">
            <Description>
                O callback <code>closeCallback</code> (aqui <code>context.Close</code>) volta ao estado de exibição
                quando chamado a partir de um evento.
            </Description>
            <ChildContent>
                <OpInplace>
                    <DisplayTemplate><span>Clique para editar</span></DisplayTemplate>
                    <ContentTemplate>
                        <span class="inline-flex gap-2 align-items-center">
                            <OpInputText @bind-Value="_inplaceText"/>
                            <button type="button" class="p-button p-component p-button-text p-button-danger p-button-icon-only" aria-label="Fechar" @onclick="context.Close">
                                <i class="pi pi-times" aria-hidden="true"></i>
                            </button>
                        </span>
                    </ContentTemplate>
                </OpInplace>
            </ChildContent>
            <Code><CodeBlock Code="@InputCode"/></Code>
        </DocSection>

        <DocSection Label="Imagem" Id="image">
            <Description>Qualquer conteúdo, como uma imagem, pode ser colocado dentro de um Inplace.</Description>
            <ChildContent>
                <OpInplace>
                    <DisplayTemplate>
                        <span class="inline-flex items-center gap-2">
                            <i class="pi pi-image" aria-hidden="true"></i>
                            <span>Ver foto</span>
                        </span>
                    </DisplayTemplate>
                    <ContentTemplate>
                        <img src="https://primefaces.org/cdn/primeng/images/demo/galleria/galleria5.jpg" alt="Natureza" style="width: 20rem; border-radius: var(--p-content-border-radius);" />
                    </ContentTemplate>
                </OpInplace>
            </ChildContent>
            <Code><CodeBlock Code="@ImageCode"/></Code>
        </DocSection>

        <DocSection Label="Lazy" Id="lazy">
            <Description>
                Com o evento <code>OnActivate</code>, os dados podem ser carregados de forma tardia (lazy) antes de
                exibi-los.
            </Description>
            <ChildContent>
                <OpInplace OnActivate="LoadDataAsync">
                    <DisplayTemplate><span>Ver dados</span></DisplayTemplate>
                    <ContentTemplate>
                        @if (_lazyProducts.Count == 0)
                        {
                            <span>Carregando…</span>
                        }
                        else
                        {
                            <ul style="margin: 0;">
                                @foreach (var item in _lazyProducts)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                    </ContentTemplate>
                </OpInplace>
            </ChildContent>
            <Code><CodeBlock Code="@LazyCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O contêiner raiz usa <code>aria-live="polite"</code>. O elemento de exibição tem
                    <code>role="button"</code> e <code>tabindex="0"</code>; a ativação pode ser feita com clique ou
                    com a tecla <code>enter</code>.
                </p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o elemento de exibição." },
                              new[] { "enter", "Ativa o modo de edição/content." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Active", "bool", "false", "Se o conteúdo está exibido (usar com <code>@@bind-Active</code>)." },
                              new[] { "Disabled", "bool", "false", "Desabilita a interação." },
                              new[] { "PreventClick", "bool", "false", "Impede a ativação por clique." },
                              new[] { "Closable", "bool", "false", "Exibe um botão para voltar à exibição (obsoleto no upstream)." },
                              new[] { "CloseIcon / CloseAriaLabel", "string?", "null", "Ícone e rótulo acessível do botão de fechar." },
                              new[] { "ActiveChanged / OnActivate / OnDeactivate", "EventCallback", "—", "Notificações de estado." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "DisplayTemplate", "RenderFragment?", "Conteúdo do estado de exibição." },
                              new[] { "ContentTemplate", "RenderFragment&lt;OpInplaceContext&gt;?", "Conteúdo do estado ativo; o contexto expõe <code>Close</code>." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="inplace"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>Os templates do Angular usam <code>#display</code>/<code>#content</code> e <code>ng-content</code>; aqui são parâmetros <code>DisplayTemplate</code>/<code>ContentTemplate</code>.</li>
                        <li>O parâmetro <code>closable</code> é obsoleto no upstream (substituído por <code>closeCallback</code>); mantido por compatibilidade.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string? _inplaceText = "Valor editável";
    private readonly List<string> _lazyProducts = new();

    private async Task LoadDataAsync()
    {
        if (_lazyProducts.Count > 0)
        {
            return;
        }

        await Task.Delay(300);
        _lazyProducts.AddRange(new[] { "F230FH0G3 — Bamboo Watch", "NVKLALG — Bluetooth Headphones", "244FGC — Gaming Mouse" });
    }

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Inplace

        <OpInplace>
            <DisplayTemplate><span>Ver conteúdo</span></DisplayTemplate>
            <ContentTemplate>
                <p>Conteúdo</p>
            </ContentTemplate>
        </OpInplace>
        """;

    private const string BasicCode = """
        <OpInplace>
            <DisplayTemplate><span>Ver conteúdo</span></DisplayTemplate>
            <ContentTemplate>
                <p class="m-0">Lorem ipsum dolor sit amet...</p>
            </ContentTemplate>
        </OpInplace>
        """;

    private const string InputCode = """
        <OpInplace>
            <DisplayTemplate><span>Clique para editar</span></DisplayTemplate>
            <ContentTemplate>
                <span class="inline-flex gap-2">
                    <OpInputText @bind-Value="_value" />
                    <button type="button" class="p-button p-button-text p-button-danger p-button-icon-only"
                            @onclick="context.Close">
                        <i class="pi pi-times"></i>
                    </button>
                </span>
            </ContentTemplate>
        </OpInplace>
        """;

    private const string ImageCode = """
        <OpInplace>
            <DisplayTemplate>
                <span class="inline-flex items-center gap-2">
                    <i class="pi pi-image"></i>
                    <span>Ver foto</span>
                </span>
            </DisplayTemplate>
            <ContentTemplate>
                <img src="foto.jpg" alt="Natureza" style="width: 20rem;" />
            </ContentTemplate>
        </OpInplace>
        """;

    private const string LazyCode = """
        <OpInplace OnActivate="LoadDataAsync">
            <DisplayTemplate><span>Ver dados</span></DisplayTemplate>
            <ContentTemplate>
                @if (_products.Count == 0)
                {
                    <span>Carregando…</span>
                }
                else
                {
                    <ul>
                        @foreach (var item in _products) { <li>@item</li> }
                    </ul>
                }
            </ContentTemplate>
        </OpInplace>
        """;
}
