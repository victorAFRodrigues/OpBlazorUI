@page "/floatlabel"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.FloatLabel
@using OpBlazorUI.Base.Components.InputText

<DocComponent Title="FloatLabel"
              Description="O FloatLabel aparece sobre o campo de entrada quando focalizado.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade">
            <Description>
                O FloatLabel não requer roles nem atributos ARIA adicionais e não inclui elementos interativos.
                O vínculo entre o rótulo e o campo é feito pelo atributo <code>for</code> do <code>&lt;label&gt;</code>
                apontando para o <code>id</code> do input.
            </Description>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpFloatLabel>
                    <OpInputText Id="fl1" @bind-Value="_value" Fluid="true"/>
                    <label for="fl1">Rótulo Sobre</label>
                </OpFloatLabel>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido">
            <Description>
                Quando o campo está inválido, o rótulo também é destacado.
            </Description>
            <ChildContent>
                <div class="flex flex-wrap justify-center items-end gap-4">
                    <OpFloatLabel>
                        <OpInputText Id="fli1" @bind-Value="_invalid1" Invalid="@(string.IsNullOrEmpty(_invalid1))" Autocomplete="off"/>
                        <label for="fli1">Usuário</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="in">
                        <OpInputText Id="fli2" @bind-Value="_invalid2" Invalid="@(string.IsNullOrEmpty(_invalid2))" Autocomplete="off"/>
                        <label for="fli2">Usuário</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="on">
                        <OpInputText Id="fli3" @bind-Value="_invalid3" Invalid="@(string.IsNullOrEmpty(_invalid3))" Autocomplete="off"/>
                        <label for="fli3">Usuário</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@InvalidCode"/></Code>
        </DocSection>

        <DocSection Label="Variantes">
            <ChildContent>
                <div class="flex flex-col gap-4">
                    <OpFloatLabel Variant="in">
                        <OpInputText Id="fl2" Variant="filled" Fluid="true"/>
                        <label for="fl2">Rótulo Dentro</label>
                    </OpFloatLabel>
                    <OpFloatLabel Variant="on">
                        <OpInputText Id="fl3" Fluid="true"/>
                        <label for="fl3">Rótulo Sobre a Borda</label>
                    </OpFloatLabel>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@VariantCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Variant", "string", "over", "Variante: <code>over</code>, <code>in</code> ou <code>on</code>." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Input + label." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="floatlabel"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e <code>ChildContent</code> para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.FloatLabel
        @using OpBlazorUI.Base.Components.InputText

        <OpFloatLabel>
            <OpInputText Id="fl1" Fluid="true" />
            <label for="fl1">Rótulo Sobre</label>
        </OpFloatLabel>
        """;

    private const string BasicCode = """
        <OpFloatLabel>
            <OpInputText Id="fl1" @bind-Value="_value" Fluid="true" />
            <label for="fl1">Rótulo Sobre</label>
        </OpFloatLabel>

        @code {
            private string? _value;
        }
        """;

    private const string InvalidCode = """
        <OpFloatLabel>
            <OpInputText Id="fli1" @bind-Value="_value1" Invalid="@(string.IsNullOrEmpty(_value1))" Autocomplete="off" />
            <label for="fli1">Usuário</label>
        </OpFloatLabel>

        <OpFloatLabel Variant="in">
            <OpInputText Id="fli2" @bind-Value="_value2" Invalid="@(string.IsNullOrEmpty(_value2))" Autocomplete="off" />
            <label for="fli2">Usuário</label>
        </OpFloatLabel>

        <OpFloatLabel Variant="on">
            <OpInputText Id="fli3" @bind-Value="_value3" Invalid="@(string.IsNullOrEmpty(_value3))" Autocomplete="off" />
            <label for="fli3">Usuário</label>
        </OpFloatLabel>
        """;

    private const string VariantCode = """
        <OpFloatLabel Variant="in">
            <OpInputText Id="fl2" Variant="filled" Fluid="true" />
            <label for="fl2">Rótulo Dentro</label>
        </OpFloatLabel>

        <OpFloatLabel Variant="on">
            <OpInputText Id="fl3" Fluid="true" />
            <label for="fl3">Rótulo Sobre a Borda</label>
        </OpFloatLabel>
        """;

    private string? _value;
    private string? _invalid1;
    private string? _invalid2;
    private string? _invalid3;
}
