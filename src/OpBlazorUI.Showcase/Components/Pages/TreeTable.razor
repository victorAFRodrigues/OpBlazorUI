@page "/treetable"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>TreeTable - OpBlazorUI</PageTitle>

<DocComponent Title="TreeTable"
              Description="Tabela que exibe dados hierárquicos em formato tabular. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import-demo">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>O TreeTable requer uma coleção de instâncias de <code>TreeNode</code> como <code>value</code>, com componentes como filhos para a representação.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Colunas Dinâmicas" Id="dynamiccolumns">
            <Description><p>As colunas podem ser criadas programaticamente.</p></Description>
            <Code><CodeBlock Code="@DynamicColumnsCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Controlado" Id="controlled">
            <Description><p>O estado de expansão é controlado com a propriedade <code>expandedKeys</code>.</p></Description>
            <Code><CodeBlock Code="@ControlledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>Conteúdo personalizado nas seções <code>caption</code>, <code>header</code>, <code>body</code> e <code>summary</code> é suportado via templates.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Tamanho" Id="size">
            <Description><p>Além do treetable comum, há alternativas com tamanhos diferentes. Adicione a classe <code>p-treetable-sm</code> para reduzir o tamanho do treetable ou <code>p-treetable-lg</code> para ampliá-lo.</p></Description>
            <Code><CodeBlock Code="@SizeCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Linhas de Grade" Id="gridlines">
            <Description><p>Habilitar <code>showGridlines</code> exibe as linhas de grade.</p></Description>
            <Code><CodeBlock Code="@GridlinesCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Máscara" Id="loading-mask">
            <Description><p>A propriedade <code>loading</code> exibe uma camada de máscara para indicar estado de ocupado. Use o paginador para exibir a máscara.</p></Description>
            <Code><CodeBlock Code="@LoadingMaskCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Skeleton" Id="loading-skeleton">
            <Description><p>O componente Skeleton pode ser usado como placeholder durante o processo de carregamento.</p></Description>
            <Code><CodeBlock Code="@LoadingSkeletonCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Básico" Id="paginatorbasic">
            <Description><p>A paginação é habilitada adicionando a propriedade <code>paginator</code> e definindo <code>rows</code> por página.</p></Description>
            <Code><CodeBlock Code="@PaginatorBasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Template" Id="paginatortemplate">
            <Description><p>A UI do paginador é personalizada usando as propriedades <code>paginatorleft</code> e <code>paginatorright</code>. Cada elemento também pode ser personalizado ainda mais com sua própria UI para substituir a padrão; consulte o componente <a href="/paginator">Paginator</a> para mais informações sobre as opções avançadas de personalização.</p></Description>
            <Code><CodeBlock Code="@PaginatorTemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Coluna Única" Id="sortsinglecolumn">
            <Description><p>A ordenação em uma coluna é habilitada adicionando a propriedade <code>ttSortableColumn</code>.</p></Description>
            <Code><CodeBlock Code="@SortSingleColumnCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Múltiplas Colunas" Id="sortmultiplecolumns">
            <Description><p>Múltiplas colunas podem ser ordenadas definindo <code>sortMode</code> como <code>multiple</code>. Esse modo exige que a metaKey (ex.: <code>⌘</code>) seja pressionada ao clicar em um cabeçalho.</p></Description>
            <Code><CodeBlock Code="@SortMultipleColumnsCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description><p>O <code>filterMode</code> especifica a estratégia de filtragem: no modo <code>lenient</code>, quando a consulta corresponde a um nó, os filhos do nó não são pesquisados adiante, pois todos os descendentes do nó são incluídos. Por outro lado, no modo <code>strict</code>, quando a consulta corresponde a um nó, a filtragem continua em todos os descendentes. Um campo geral chamado <code>filterGlobal</code> também é fornecido para pesquisar todas as colunas que suportam filtragem.</p></Description>
            <Code><CodeBlock Code="@FilterCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Única" Id="selectionsingle">
            <Description>
                <p>A seleção de um único nó é configurada definindo <code>selectionMode</code> como <code>single</code>, junto da propriedade <code>selection</code> para gerenciar o vínculo do valor selecionado.</p>
                <p>Por padrão, é necessário pressionar a metaKey (ex.: <code>⌘</code>) para desmarcar um nó; isso pode ser configurado desabilitando a propriedade <code>metaKeySelection</code>. Em dispositivos com toque esta opção não tem efeito e o comportamento é o mesmo de defini-la como false.</p>
            </Description>
            <Code><CodeBlock Code="@SelectionSingleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Múltipla" Id="selectionmultiple">
            <Description><p>Mais de um nó pode ser selecionado definindo <code>selectionMode</code> como <code>multiple</code>. Por padrão, no modo de seleção múltipla, é necessário pressionar a metaKey (ex.: <code>⌘</code>) para adicionar às seleções existentes; isso pode ser configurado desabilitando a propriedade <code>metaKeySelection</code>. Note que em dispositivos com toque, o TreeTable sempre ignora a metaKey.</p></Description>
            <Code><CodeBlock Code="@SelectionMultipleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Checkbox" Id="checkbox">
            <Description>
                <p>A seleção de múltiplos nós via checkboxes é habilitada configurando <code>selectionMode</code> como <code>checkbox</code>.</p>
                <p>No modo de seleção por checkbox, o vínculo de valor deve ser um par chave-valor, onde a chave (ou o <code>dataKey</code>) é a chave do nó e o valor é um objeto com as propriedades <code>checked</code> e <code>partialChecked</code> para representar o estado de marcação de um nó.</p>
            </Description>
            <Code><CodeBlock Code="@SelectionCheckboxCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Eventos" Id="events">
            <Description><p>O TreeTable fornece os eventos <code>onNodeSelect</code> e <code>onNodeUnselect</code> para escutar eventos de seleção.</p></Description>
            <Code><CodeBlock Code="@SelectionEventsCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Agrupamento de Colunas" Id="columngroup">
            <Description><p>Grupos de colunas são definidos no template <code>header</code> usando <code>rowspan</code> e <code>colspan</code>.</p></Description>
            <Code><CodeBlock Code="@ColumnGroupCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Carregamento Lazy" Id="lazyload">
            <Description>
                <p>O modo lazy é útil para lidar com grandes conjuntos de dados; em vez de carregar todos os dados, pequenos blocos de dados são carregados invocando callbacks correspondentes sempre que ocorre <code>paging</code>, <code>sorting</code> e <code>filtering</code>. O exemplo abaixo simula o carregamento lazy de dados de uma fonte remota usando uma lista em memória e timeouts para imitar a conexão de rede.</p>
                <p>Habilitar a propriedade <code>lazy</code> e atribuir o número lógico de linhas a <code>totalRecords</code> por meio de uma consulta de projeção são os elementos-chave da implementação, de modo que o paginador exibe a UI supondo que existam registros do tamanho de totalRecords, embora na realidade eles não estejam presentes na página; apenas os registros exibidos na página atual existem.</p>
                <p>Além disso, apenas os elementos raiz devem ser carregados; os filhos podem ser carregados sob demanda usando o callback <code>onNodeExpand</code>.</p>
            </Description>
            <Code><CodeBlock Code="@LazyLoadCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Scroll - Vertical" Id="vertical">
            <Description><p>Adicionar a propriedade <code>scrollable</code> junto de um <code>scrollHeight</code> para a área de dados habilita a rolagem vertical com cabeçalhos fixos.</p></Description>
            <Code><CodeBlock Code="@ScrollVerticalCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Scroll - Flexível" Id="flexible">
            <Description><p>O recurso de scroll flexível torna a seção da área de rolagem dinâmica em vez de um valor fixo, para que ela possa crescer ou encolher em relação ao tamanho do contêiner pai da tabela. Clique no botão abaixo para exibir um Dialog maximizável onde a área de dados se ajusta conforme as mudanças de tamanho.</p></Description>
            <Code><CodeBlock Code="@ScrollFlexibleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Scroll - Horizontal" Id="horizontal">
            <Description><p>A rolagem horizontal é habilitada quando a largura total das colunas excede a largura da tabela.</p></Description>
            <Code><CodeBlock Code="@ScrollHorizontalCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Scroll - Colunas Fixas" Id="frozencolumns">
            <Description><p>Uma coluna pode ser fixada durante a rolagem horizontal habilitando a propriedade <code>frozenColumns</code>.</p></Description>
            <Code><CodeBlock Code="@FrozenColumnsCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Redimensionamento de Colunas - Fit" Id="fitmode">
            <Description><p>As colunas podem ser redimensionadas com arrastar e soltar quando <code>resizableColumns</code> está habilitado. O modo de redimensionamento padrão é <code>fit</code>, que não altera a largura total da tabela.</p></Description>
            <Code><CodeBlock Code="@ResizeFitCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Redimensionamento de Colunas - Expand" Id="expandmode">
            <Description><p>Definir <code>columnResizeMode</code> como <code>expand</code> também altera a largura da tabela.</p></Description>
            <Code><CodeBlock Code="@ResizeExpandCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Redimensionamento de Colunas - Scroll" Id="scrollable">
            <Description><p>Para utilizar os modos de redimensionamento de colunas com um TreeTable rolável, um template <code>colgroup</code> deve ser definido. O valor padrão de <code>scrollHeight</code> é "flex"; ele também pode ser definido como um valor de string.</p></Description>
            <Code><CodeBlock Code="@ResizeScrollableCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Reordenar" Id="reorder">
            <Description><p>A ordem das colunas pode ser alterada usando arrastar e soltar quando <code>reorderableColumns</code> está presente.</p></Description>
            <Code><CodeBlock Code="@ReorderCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Alternar Colunas" Id="columntoggle">
            <Description><p>A visibilidade das colunas com base em uma condição pode ser implementada com colunas dinâmicas; neste exemplo, um MultiSelect é usado para gerenciar as colunas visíveis.</p></Description>
            <Code><CodeBlock Code="@ColumnToggleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Estilo Condicional" Id="conditionalstyle">
            <Description><p>Linhas e células específicas podem ser estilizadas com base em condições. O <code>ngClass</code> recebe os dados da linha como parâmetro para retornar uma classe de estilo para a linha, enquanto as células são personalizadas usando o template <code>body</code>.</p></Description>
            <Code><CodeBlock Code="@ConditionalStyleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Menu de Contexto" Id="contextmenu">
            <Description><p>O TreeTable tem integração exclusiva com o componente <code>contextmenu</code>. Para anexar um menu a uma tabela, adicione a diretiva <code>ttContextMenuRow</code> às linhas que podem ser selecionadas com o menu de contexto, defina uma variável de template local para o menu e vincule-a à propriedade <code>contextMenu</code> da tabela. Isso permite exibir o menu sempre que uma linha for clicada com o botão direito. Uma propriedade separada <code>contextMenuSelection</code> é usada para obter a linha clicada com o botão direito. Para colunas dinâmicas, definir a propriedade <code>ttContextMenuRowDisabled</code> como true desabilita o menu de contexto para aquela linha específica.</p></Description>
            <Code><CodeBlock Code="@ContextMenuCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O papel padrão da tabela é <code>table</code>. Os elementos de cabeçalho, corpo e rodapé usam <code>rowgroup</code>, as linhas usam o papel <code>row</code>, as células de cabeçalho têm <code>columnheader</code> e as células de corpo usam o papel <code>cell</code>. Cabeçalhos ordenáveis utilizam o atributo <code>aria-sort</code> definido como "ascending" ou "descending".</p>
                <p>Os elementos de linha gerenciam <code>aria-expanded</code> para estado e o atributo <code>aria-level</code> para definir a hierarquia através da diretiva <code>ttRow</code>. As linhas e células da tabela devem ser especificadas pelos usuários usando os atributos <code>aria-posinset</code>, <code>aria-setsize</code>, <code>aria-label</code> e <code>aria-describedby</code>, pois são determinados por meio de templates.</p>
                <p>Quando a seleção está habilitada, a diretiva <code>ttSelectableRow</code> define <code>aria-selected</code> como true em uma linha. No modo checkbox, o componente de checkbox interno usa o papel <code>checkbox</code> com o atributo de estado <code>aria-checked</code>.</p>
                <p>Células editáveis usam templates personalizados, então você precisa gerenciar os papéis e atributos aria manualmente, se necessário.</p>
                <p>O Paginator é um componente autônomo usado dentro do TreeTable; consulte <a href="/paginator">paginator</a> para mais informações sobre os recursos de acessibilidade.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Caption="Suporte a teclado dos cabeçalhos ordenáveis"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Percorre os cabeçalhos." },
                              new[] { "enter", "Ordena a coluna." },
                              new[] { "space", "Ordena a coluna." }
                          })"/>
                <ApiTable Caption="Suporte a teclado"
                          Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o primeiro nó selecionado quando o foco entra no componente; se não houver nenhum, o primeiro elemento recebe o foco. Se o foco já estiver dentro do componente, move o foco para o próximo elemento focalizável na sequência de tabulação da página." },
                              new[] { "shift + tab", "Move o foco para o último nó selecionado quando o foco entra no componente; se não houver nenhum, o primeiro elemento recebe o foco. Se o foco já estiver dentro do componente, move o foco para o elemento focalizável anterior na sequência de tabulação da página." },
                              new[] { "enter", "Seleciona o nó em foco." },
                              new[] { "space", "Seleciona o nó em foco." },
                              new[] { "down arrow", "Move o foco para o próximo nó." },
                              new[] { "up arrow", "Move o foco para o nó anterior." },
                              new[] { "right arrow", "Se o nó estiver fechado, abre o nó; caso contrário, move o foco para o primeiro nó filho." },
                              new[] { "left arrow", "Se o nó estiver aberto, fecha o nó; caso contrário, move o foco para o nó pai." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private const string ImportCode = """
        import { TreeTableModule } from 'primeng/treetable';
        """;

    private const string BasicCode = """
        <p-treetable [value]="files" [scrollable]="true" [tableStyle]="{'min-width':'50rem'}">
            <ng-template #header>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Type</th>
                </tr>
            </ng-template>
            <ng-template #body let-rowNode let-rowData="rowData">
                <tr [ttRow]="rowNode">
                    <td>
                        <div class="flex items-center gap-2">
                            <p-treetable-toggler [rowNode]="rowNode" />
                            <span>{{ rowData.name }}</span>
                        </div>
                    </td>
                    <td>{{ rowData.size }}</td>
                    <td>{{ rowData.type }}</td>
                </tr>
            </ng-template>
        </p-treetable>
        """;

    private const string DynamicColumnsCode = """
        <p-treetable [value]="files" [columns]="cols" [scrollable]="true" [tableStyle]="{'min-width':'50rem'}">
            <ng-template #header let-columns>
                <tr>
                    @for (col of columns; track col) {
                        <th>
                            {{ col.header }}
                        </th>
                    }
                </tr>
            </ng-template>
            <ng-template #body let-rowNode let-rowData="rowData" let-columns="columns">
                <tr [ttRow]="rowNode">
                    @for (col of columns; let first = $first; track col) {
                        <td>
                            @if (first) {
                                <div class="flex items-center gap-2">
                                    <p-treetable-toggler [rowNode]="rowNode"></p-treetable-toggler>
                                    <span>{{ rowData[col.field] }}</span>
                                </div>
                            } @else {
                                {{ rowData[col.field] }}
                            }
                        </td>
                    }
                </tr>
            </ng-template>
        </p-treetable>
        """;

    private const string ControlledCode = """
        <p-button (click)="toggleApplications()" label="Toggle Applications" class="block mb-4" />
        <p-treetable [value]="files" [scrollable]="true" [tableStyle]="{ 'min-width': '50rem' }">
            <ng-template #header>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
                    <th>Type</th>
                </tr>
            </ng-template>
            <ng-template #body let-rowNode let-rowData="rowData">
                <tr [ttRow]="rowNode">
                    <td>
                        <div class="flex items-center gap-2">
                            <p-treetable-toggler [rowNode]="rowNode" />
                            <span>{{ rowData.name }}</span>
                        </div>
                    </td>
                    <td>{{ rowData.size }}</td>
                    <td>{{ rowData.type }}</td>
                </tr>
            </ng-template>
        </p-treetable>
        """;

    private const string TemplateCode = """
        <p-treetable [value]="files" [columns]="cols" [tableStyle]="{ 'min-width': '50rem' }">
            <ng-template #caption><div class="text-xl font-bold">File Viewer</div> </ng-template>
            <ng-template #header let-columns>
                <tr>
                    @for (col of columns; let last = $last; track col) {
                        <th [class]="{ 'w-40': last }">
                            {{ col.header }}
                        </th>
                    }
                </tr>
            </ng-template>
            <ng-template #body let-rowNode let-rowData="rowData" let-columns="columns">
                <tr [ttRow]="rowNode">
                    @for (col of columns; let first = $first; let last = $last; track col) {
                        <td>
                            @if (first) {
                                <div class="flex items-center gap-2">
                                    <p-treetable-toggler [rowNode]="rowNode" />
                                    <span>{{ rowData[col.field] }}</span>
                                </div>
                            } @else if (last) {
                                <div class="flex flex-wrap gap-2">
                                    <p-button icon="pi pi-search" rounded="true" severity="secondary" />
                                    <p-button icon="pi pi-pencil" rounded="true" severity="secondary" />
                                </div>
                            } @else {
                                <span>{{ rowData[col.field] }}</span>
                            }
                        </td>
                    }
                </tr>
            </ng-template>
            <ng-template #summary>
                <div style="text-align:left">
                    <p-button icon="pi pi-refresh" label="Reload" severity="warn" />
                </div>
            </ng-template>
        </p-treetable>
        """;

    private const string SizeCode = """
        <div class="flex justify-center mb-4">
            <p-selectbutton [options]="sizes" [(ngModel)]="selectedSize" [multiple]="false" optionLabel="name" optionValue="class" />
        </div>
        <p-treetable [value]="files" [scrollable]="true" [tableStyle]="{'min-width':'50rem'}" [class]="selectedSize">
            <ng-template #header>
                <tr>
                    <th>Name</th>
                    <th>Size</th>
