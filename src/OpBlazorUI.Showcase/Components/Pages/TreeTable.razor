@page "/treetable"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Components.TreeTable
@using OpBlazorUI.Components.Button
@using OpBlazorUI.Components.Menu
@using OpBlazorUI.Components.Dialog
@using OpBlazorUI.Components.InputText
@using OpBlazorUI.Components.MultiSelect
@using OpBlazorUI.Components.Paginator
@using OpBlazorUI.Components.SelectButton
@using OpBlazorUI.Models
@using Microsoft.AspNetCore.Components.Web

<PageTitle>TreeTable - OpBlazorUI</PageTitle>

<DocComponent Title="TreeTable"
              Description="O TreeTable exibe dados hierárquicos em formato tabular, com colunas configuráveis, ordenação, filtro, seleção, paginação e rolagem.">

    <Features>
        <DocSection Label="Importação" Id="import-demo">
            <Description>
                <p>
                    O componente usa os modelos <code>OpTreeNode</code> (nós com <code>Label</code>,
                    <code>Data</code> e <code>Children</code>) e <code>OpTreeTableColumn</code> (colunas com
                    <code>Field</code> que lê as propriedades de <code>Data</code> por reflexão) e é consumido
                    diretamente em Razor.
                </p>
            </Description>
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    Informe <code>Nodes</code> e <code>Columns</code>. A coluna marcada com
                    <code>Expandable</code> (por padrão, a primeira) recebe o botão de expandir/recolher e o
                    recuo de cada nível. Sem nós, o componente exibe <code>EmptyMessage</code>.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_basicNodes" Columns="_columns"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Colunas Dinâmicas" Id="dynamiccolumns">
            <Description>
                <p>
                    As colunas são montadas em código: além de <code>Field</code> (leitura por reflexão),
                    <code>HeaderTemplate</code> e <code>BodyTemplate</code> permitem desenhar cabeçalho e célula
                    com qualquer marcação — como no demo da referência, que monta as colunas a partir da lista de
                    colunas exibidas.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_dynamicNodes" Columns="_dynamicColumns"/>
            </ChildContent>
            <Code><CodeBlock Code="@DynamicColumnsCode"/></Code>
        </DocSection>

        <DocSection Label="Expansão Controlada" Id="controlled">
            <Description>
                <p>
                    A expansão vive nos próprios nós (<code>OpTreeNode.Expanded</code>): a página pode expandir e
                    recolher por código, e <code>OnNodeExpand</code>/<code>OnNodeCollapse</code> avisam a cada
                    alternância (o modo <code>Lazy</code> usa o primeiro para carregar os filhos). O botão abaixo
                    alterna as pastas da árvore.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex">
                        <OpButton Label="Alternar pastas" Icon="pi pi-sort-alt" OnClick="ToggleControlledFolders"/>
                    </div>
                    <OpTreeTable Nodes="_controlledNodes" Columns="_columns"
                                 OnNodeExpand="OnControlledExpand" OnNodeCollapse="OnControlledCollapse"/>
                    <div class="text-sm">Último evento: @_controlledLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ControlledCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                <p>
                    O componente aceita <code>CaptionTemplate</code> (área acima da tabela),
                    <code>HeaderTemplate</code> (linha extra no <code>thead</code>), <code>FooterTemplate</code>
                    (substitui a linha padrão do <code>tfoot</code> — o template desenha o <code>tr</code>),
                    <code>EmptyTemplate</code> e <code>LoadingTemplate</code>; cada coluna aceita
                    <code>HeaderTemplate</code>, <code>BodyTemplate</code> e <code>FooterTemplate</code>. O demo
                    usa a caption, o rodapé do componente e templates de célula com ícones.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_templateNodes" Columns="_templateColumns">
                    <CaptionTemplate>
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-sm font-semibold">Sistema de arquivos</span>
                            <span class="text-sm">@_templateTotalSize.ToString("N0") KB</span>
                        </div>
                    </CaptionTemplate>
                    <FooterTemplate>
                        <tr>
                            <td colspan="3">
                                <div class="text-sm">Total de itens: @CountNodes(_templateNodes)</div>
                            </td>
                        </tr>
                    </FooterTemplate>
                </OpTreeTable>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Tamanho" Id="size">
            <Description>
                <code>Size</code> aceita <code>small</code> e <code>large</code> (vazio usa o tamanho padrão do
                tema), aplicando as classes <code>p-treetable-sm</code> e <code>p-treetable-lg</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex">
                        <OpSelectButton TValue="string" @bind-Value="_size" Options="_sizeOptions" AllowEmpty="false"/>
                    </div>
                    <OpTreeTable Nodes="_sizeNodes" Columns="_columns" Size="@_size"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SizeCode"/></Code>
        </DocSection>

        <DocSection Label="Linhas de Grade" Id="gridlines">
            <Description>
                <code>ShowGridlines</code> desenha as bordas verticais entre as colunas
                (<code>p-treetable-gridlines</code>).
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_gridNodes" Columns="_columns" ShowGridlines="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@GridlinesCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Máscara" Id="loading-mask">
            <Description>
                <code>Loading</code> sobrepõe uma máscara à tabela e <code>LoadingTemplate</code> substitui o
                spinner padrão. No exemplo, o botão simula uma consulta de 2 segundos.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex">
                        <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadMask" Loading="_maskLoading"/>
                    </div>
                    <OpTreeTable Nodes="_maskNodes" Columns="_columns" Loading="_maskLoading">
                        <LoadingTemplate>
                            <span class="pi pi-spin pi-spinner" aria-hidden="true"></span>
                        </LoadingTemplate>
                    </OpTreeTable>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingMaskCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento - Skeleton" Id="loading-skeleton">
            <Description>
                Com <code>LoadingMode="skeleton"</code> o componente exibe linhas de esqueleto em vez da máscara;
                <code>SkeletonRows</code> define quantas linhas mostrar (0 usa <code>Rows</code>).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <div class="flex">
                        <OpButton Label="Carregar (2 s)" Icon="pi pi-refresh" OnClick="LoadSkeleton" Loading="_skeletonLoading"/>
                    </div>
                    <OpTreeTable Nodes="_skeletonNodes" Columns="_columns" Loading="_skeletonLoading"
                                 LoadingMode="skeleton" SkeletonRows="5"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingSkeletonCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Básico" Id="paginatorbasic">
            <Description>
                <code>Paginator</code> habilita a paginação e <code>Rows</code> define quantas raízes por página —
                cada raiz leva junto a subárvore visível. <code>PaginatorPosition</code> aceita
                <code>bottom</code> (padrão), <code>top</code> ou <code>both</code>;
                <code>RowsPerPageOptions</code> habilita o seletor de itens por página e <code>OnPageChange</code>
                informa a página exibida (base 0).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_pageNodes" Columns="_columns" Paginator="true" Rows="2"
                                 PaginatorPosition="both" RowsPerPageOptions="_rowsPerPageOptions"
                                 OnPageChange="OnTreePageChanged"/>
                    <div class="text-sm">Última página navegada: @(_pageState + 1) · linhas por página: @_pageRows</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorBasicCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação - Template" Id="paginatortemplate">
            <Description>
                <code>PaginatorLeftTemplate</code> e <code>PaginatorRightTemplate</code> preenchem o início e o fim
                do paginador — o <code>leftContent</code>/<code>rightContent</code> da referência. O demo usa um
                botão que volta à primeira página e um contador.
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_pageTemplateNodes" Columns="_columns" Paginator="true" Rows="2"
                             @bind-First="_pageTemplateFirst">
                    <PaginatorLeftTemplate>
                        <OpButton Label="Reiniciar" Icon="pi pi-refresh" Outlined="true"
                                  OnClick="() => _pageTemplateFirst = 0"/>
                    </PaginatorLeftTemplate>
                    <PaginatorRightTemplate>
                        <span class="text-sm">Raízes: @_pageTemplateNodes.Count</span>
                    </PaginatorRightTemplate>
                </OpTreeTable>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorTemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Coluna Única" Id="sortsinglecolumn">
            <Description>
                A ordenação é embutida: clicar no cabeçalho percorre ascendente e descendente (ciclo de 2 estados,
                como na referência) e <code>aria-sort</code> acompanha. Cada nível é ordenado pelos campos das
                colunas com <code>Sortable</code>; <code>Sortable</code> no componente desliga o recurso
                globalmente. <code>OnSort</code> entrega o campo, a ordem e a lista de <code>MultiSortMeta</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_sortNodes" Columns="_sortColumns" OnSort="OnSingleSort"/>
                    <div class="text-sm">Ordenação: @_singleSortLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SortSingleCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação - Múltiplas Colunas" Id="sortmultiplecolumns">
            <Description>
                Com <code>SortMode="multiple"</code>, <i>ctrl</i>/<i>meta</i> + clique adiciona a coluna à
                ordenação (com badge numérico de prioridade); o clique simples ordena só por ela. Também é possível
                controlar a ordenação pela página com <code>MultiSortMeta</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_multiSortNodes" Columns="_sortColumns" SortMode="multiple" OnSort="OnMultiSort"/>
                    <div class="text-sm">Ordenação: @_multiSortLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SortMultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Ordenação Removível" Id="sortremovable">
            <Description>
                Com <code>RemovableSort</code> o terceiro clique na coluna remove a ordenação — a seção
                <i>Removable Sort</i> que a referência mantém comentada no índice. O comportamento é o mesmo em
                <code>SortMode="multiple"</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_removableSortNodes" Columns="_sortColumns" RemovableSort="true" OnSort="OnRemovableSort"/>
                    <div class="text-sm">Ordenação: @_removableSortLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SortRemovableCode"/></Code>
        </DocSection>

        <DocSection Label="Filtro" Id="filter">
            <Description>
                <p>
                    Com <code>OpTreeTableColumn.Filter = true</code> a coluna exibe um campo de filtro no
                    cabeçalho; a comparação usa <code>OpFilterService</code> (ignora acentos e caixa) no modo de
                    <code>FilterMatchMode</code> da coluna. <code>FilterMode</code> escolhe o comportamento:
                    <code>lenient</code> (padrão) mantém a subárvore inteira de um nó que casa;
                    <code>strict</code> continua filtrando os descendentes. <code>GlobalFilter</code> filtra pelos
                    campos de <code>GlobalFilterFields</code> (ou por todas as colunas) e o botão vinculado é
                    desenhado pela página — no demo, na caption, como na referência. <code>OnFilter</code> entrega
                    os filtros ativos.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_filterNodes" Columns="_filterColumns" GlobalFilter="@_filterGlobal"
                             FilterMode="@_filterMode"
                             OnFilter="OnTreeFilters">
                    <CaptionTemplate>
                        <div class="flex items-center justify-between gap-2">
                            <OpSelectButton TValue="string" @bind-Value="_filterMode" Options="_filterModes" AllowEmpty="false"/>
                            <OpInputText IgnoreEditContext="true" @bind-Value="_filterGlobal"
                                         Placeholder="Buscar" AriaLabel="Filtro global"/>
                        </div>
                    </CaptionTemplate>
                </OpTreeTable>
                <div class="text-sm mt-2">Filtros de coluna ativos: @_treeFilters.Count</div>
            </ChildContent>
            <Code><CodeBlock Code="@FilterCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Única" Id="selectionsingle">
            <Description>
                <code>SelectionMode="single"</code> seleciona um nó por clique, com
                <code>@@bind-Selection</code> ligando o nó selecionado à página — como na referência, a
                seleção da linha é indicada por <code>aria-selected</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_singleNodes" Columns="_columns" SelectionMode="single" @bind-Selection="_singleSelection"/>
                    <div class="text-sm">Selecionado: @SelectedLabel(_singleSelection)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionSingleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Múltipla" Id="selectionmultiple">
            <Description>
                Com <code>SelectionMode="multiple"</code> o vínculo de <code>Selection</code> é um dicionário
                <code>Key→bool</code> — a mesma chave do upstream, onde a seleção múltipla é um mapa de chaves
                selecionadas. Cada clique alterna a marcação do nó (ao contrário da referência, que por padrão
                exige <i>ctrl</i>/<i>meta</i> — veja os problemas conhecidos).
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_multipleNodes" Columns="_columns" SelectionMode="multiple" @bind-Selection="_multipleSelection"/>
                    <div class="text-sm">Selecionados: @CountSelection(_multipleSelection)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionMultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Checkbox" Id="checkbox">
            <Description>
                <code>SelectionMode="checkbox"</code> exibe checkboxes em cada linha (e no cabeçalho para marcar
                tudo que está visível). O vínculo é o mesmo dicionário da seleção múltipla.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_checkboxNodes" Columns="_columns" SelectionMode="checkbox" @bind-Selection="_checkboxSelection"/>
                    <div class="text-sm">Marcados: @CountSelection(_checkboxSelection)</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CheckboxCode"/></Code>
        </DocSection>

        <DocSection Label="Eventos de Seleção" Id="events">
            <Description>
                <code>OnNodeSelect</code> e <code>OnNodeUnselect</code> entregam o nó alterado e
                <code>SelectionChanged</code> entrega o estado completo da seleção — no demo a referência usa um
                <i>growl</i>; aqui o evento fica em um rótulo.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_eventNodes" Columns="_columns" SelectionMode="multiple"
                                 @bind-Selection="_eventSelection"
                                 OnNodeSelect="OnTreeNodeSelect" OnNodeUnselect="OnTreeNodeUnselect"/>
                    <div class="text-sm">Último evento: @_eventLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@EventsCode"/></Code>
        </DocSection>

        <DocSection Label="Agrupamento de Colunas" Id="columngroup">
            <Description>
                Cabeçalhos podem ser agrupados com <code>HeaderGroups</code>: cada item é uma linha do
                <code>thead</code>, com <code>Header</code>, <code>ColSpan</code> e <code>RowSpan</code>. A última
                linha traz os títulos das colunas folha; colunas com <code>HideHeader="true"</code> não repetem o
                título (quando todas as colunas o definem, a linha normal de títulos é omitida). O rodapé usa
                <code>Footer</code>/<code>FooterTemplate</code> por coluna.
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_groupNodes" Columns="_groupColumns" HeaderGroups="_groupRows"/>
            </ChildContent>
            <Code><CodeBlock Code="@ColumnGroupCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento Lazy" Id="lazyload">
            <Description>
                <p>
                    Com <code>Lazy="true"</code> a árvore cresce sob demanda: nós sem <code>Children</code> com
                    <code>Leaf="false"</code> mostram o botão de expandir, que marca <code>Loading</code> e dispara
                    <code>OnNodeExpand</code> — o handler preenche <code>Children</code> e zera o
                    <code>Loading</code> do nó. No modo lazy os dados da página vêm prontos do "servidor": nada é
                    ordenado ou filtrado localmente, e <code>OnLazyLoad</code> recebe primeira linha, linhas,
                    ordenação e filtros. O demo simula a latência com um atraso de 600 ms.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_lazyNodes" Columns="_columns" Lazy="true"
                                 OnNodeExpand="LoadLazyNode" OnLazyLoad="OnTreeLazyLoad" TotalRecords="2"/>
                    <div class="text-sm">Último carregamento lazy: @_lazyLog</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@LazyLoadCode"/></Code>
        </DocSection>

        <DocSection Label="Edição" Id="edit">
            <Description>
                A edição por célula/linha da referência (demo legada com <code>pTemplate="editableColumn"</code>)
                não foi portada — no próprio índice do upstream a seção aparece comentada. Para editar, use
                templates de célula com os componentes de formulário do OpBlazorUI ou um diálogo, aplicando as
                alterações no <code>Data</code> dos nós.
            </Description>
        </DocSection>

        <DocSection Label="Rolagem Vertical" Id="vertical">
            <Description>
                <code>ScrollHeight</code> limita a altura do contêiner de rolagem (valor CSS, ex.: <code>200px</code>)
                e <code>StickyHeader</code> reforça o cabeçalho fixo no <code>thead</code>. Sem
                <code>ScrollHeight</code> a tabela cresce com o conteúdo.
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_scrollNodes" Columns="_columns" ScrollHeight="200px" StickyHeader="true"/>
            </ChildContent>
            <Code><CodeBlock Code="@VerticalScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Rolagem Flexível" Id="flexible">
            <Description>
                <code>ScrollHeight="flex"</code> faz a área rolável acompanhar o tamanho do pai (raiz com
                <code>p-treetable-flex-scrollable</code>) em vez de uma altura fixa. O pai precisa ter altura
                definida — no demo, o conteúdo do diálogo usa <code>ContentStyle="height: 300px"</code>:
                maximize e veja a tabela se ajustar.
            </Description>
            <ChildContent>
                <div class="flex justify-center">
                    <OpButton Label="Mostrar" Icon="pi pi-external-link" OnClick="() => _flexDialog = true"/>
                </div>
                <OpDialog Header="Arquivos" Visible="_flexDialog" VisibleChanged="(bool v) => _flexDialog = v"
                          Modal="true" Maximizable="true" Resizable="false" Style="width: 75vw" ContentStyle="height: 300px">
                    <OpTreeTable Nodes="_flexNodes" Columns="_columns" ScrollHeight="flex"/>
                </OpDialog>
            </ChildContent>
            <Code><CodeBlock Code="@FlexScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Rolagem Horizontal" Id="horizontal">
            <Description>
                Quando a soma das larguras excede o contêiner, a rolagem horizontal aparece. Defina
                <code>Width</code> nas colunas e opcionalmente <code>TableStyle</code> com uma largura mínima —
                <code>min-width</code> — como na referência; <code>ScrollHeight</code> pode combinar a rolagem
                vertical.
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_wideNodes" Columns="_wideColumns" TableStyle="min-width: 60rem"/>
            </ChildContent>
            <Code><CodeBlock Code="@HorizontalScrollCode"/></Code>
        </DocSection>

        <DocSection Label="Colunas Congeladas" Id="frozencolumns">
            <Description>
                <code>OpTreeTableColumn.Frozen</code> aceita <code>left</code> ou <code>right</code> e fixa a
                coluna durante a rolagem horizontal. Informe <code>Width</code> nas colunas congeladas: o
                deslocamento <i>sticky</i> é calculado a partir delas. É um desvio consciente do upstream, que
                congela um bloco de colunas com <code>frozenColumns</code>/<code>frozenWidth</code> e templates
                espelhados — aqui o congelamento é por coluna. No demo, <i>Nome</i> fica à esquerda e <i>Tipo</i>
                à direita.
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_frozenNodes" Columns="_frozenColumns" ScrollHeight="200px" TableStyle="min-width: 60rem"/>
            </ChildContent>
            <Code><CodeBlock Code="@FrozenColumnsCode"/></Code>
        </DocSection>

        <DocSection Label="Fit Mode" Id="fitmode">
            <Description>
                O <code>fitMode</code> da referência pertence ao redimensionamento de colunas por arraste
                (<i>Column Resize</i>): as colunas se ajustam à largura do contêiner enquanto a coluna arrastada
                muda de tamanho. O redimensionamento por arraste ainda não foi portado — defina as larguras com
                <code>OpTreeTableColumn.Width</code> ou classes de estilo.
            </Description>
        </DocSection>

        <DocSection Label="Expand Mode" Id="expandmode">
            <Description>
                O <code>expandMode</code> também pertence ao redimensionamento de colunas: a coluna arrastada
                expande em vez de empurrar as vizinhas. Como o recurso ainda não foi portado, esta seção fica
                documentada sem demo.
            </Description>
        </DocSection>

        <DocSection Label="Scrollable" Id="scrollable">
            <Description>
                O modo <code>[scrollable]="true"</code> da referência combina a área de rolagem com o
                redimensionamento por arraste das colunas — por isso não foi portado. A rolagem vertical e
                horizontal continuam disponíveis por <code>ScrollHeight</code>, <code>TableStyle</code> e
                <code>Width</code> (veja as seções <i>Rolagem Vertical</i>, <i>Rolagem Flexível</i> e
                <i>Rolagem Horizontal</i>); o congelamento por coluna também aplica a classe
                <code>p-treetable-scrollable</code> automaticamente.
            </Description>
        </DocSection>

        <DocSection Label="Reordenar Colunas" Id="reorder">
            <Description>
                <code>ReorderableColumns</code> habilita arrastar os cabeçalhos e
                <code>OnColumnReorder</code> entrega <code>(from, to)</code> para a página reordenar a lista de
                colunas — o arraste usa o drag-and-drop nativo do navegador, como na referência. No demo a
                ordenação por clique fica desligada para não competir com o arraste.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpTreeTable Nodes="_reorderNodes" Columns="_reorderColumns" Sortable="false"
                                 ReorderableColumns="true" OnColumnReorder="ReorderTreeColumns"/>
                    <div class="text-sm">Colunas: @string.Join(", ", _reorderColumns.Select(c => c.Header))</div>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@ReorderCode"/></Code>
        </DocSection>

        <DocSection Label="Alternar Colunas" Id="columntoggle">
            <Description>
                O demo da referência implementa a alternância de colunas com o componente <i>multiselect</i> na
                <i>caption</i>. Aqui o <code>OpMultiSelect</code> fica acima da tabela e a lista vinculada é
                atribuída diretamente a <code>Columns</code>.
            </Description>
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpMultiSelect TValue="OpTreeTableColumn" @bind-Value="_selectedColumns" Options="_toggleColumns"
