    {
        new OpTreeNode { Key = "l0", Label = "Documentos", Leaf = false, Data = new FileRecord("Documentos", 0, "Pasta") },
        new OpTreeNode { Key = "l1", Label = "Imagens", Leaf = false, Data = new FileRecord("Imagens", 0, "Pasta") }
    };

