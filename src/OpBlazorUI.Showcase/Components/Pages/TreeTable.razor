                              new[] { "seta para baixo / para cima", "Move o foco entre as linhas." },
                              new[] { "seta para a direita", "Expande o nó focado; se já estiver expandido, move o foco para a primeira linha filha." },
                              new[] { "seta para a esquerda", "Recolhe o nó focado; se recolhido, move o foco para a linha anterior (pai)." },
                              new[] { "home / end", "Move o foco para a primeira ou a última linha." },
                              new[] { "enter / space", "Aciona a linha em foco (seleção ou alternância de expansão)." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

