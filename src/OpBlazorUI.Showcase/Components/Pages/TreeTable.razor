@page "/treetable"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.TreeTable
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.Paginator
@using OpBlazorUI.Base.Models

<PageTitle>TreeTable - OpBlazorUI</PageTitle>

<DocComponent Title="TreeTable"
              Description="O TreeTable exibe dados hierárquicos em formato tabular, com colunas configuráveis, seleção, paginação e carregamento.">

    <Features>
        <DocSection Label="Importação" Id="import-demo">
            <Description>
                <p>O componente usa os modelos <code>OpTreeNode</code> e <code>OpTreeTableColumn</code> e é consumido diretamente em Razor.</p>
            </Description>
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                <p>
                    O TreeTable requer uma coleção de instâncias de <code>OpTreeNode</code> como <code>Nodes</code>,
                    com colunas em <code>Columns</code>. A coluna marcada como <code>Expandable</code> recebe o botão
                    de expandir/recolher (por padrão, a primeira).
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_basicNodes" Columns="_columns" EmptyMessage="Nenhum registro encontrado"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Única" Id="selectionsingle">
            <Description>
                <p>
                    A seleção de um único nó é configurada definindo <code>SelectionMode</code> como
                    <code>single</code>, junto da propriedade <code>Selection</code> para gerenciar o vínculo do valor
                    selecionado.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_singleNodes" Columns="_columns" SelectionMode="single"
                             @bind-Selection="_singleSelection" EmptyMessage="Nenhum registro encontrado"/>
                <p class="mt-2">Selecionado: <b>@SelectedLabel(_singleSelection)</b></p>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionSingleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Múltipla" Id="selectionmultiple">
            <Description>
                <p>
                    Mais de um nó pode ser selecionado definindo <code>SelectionMode</code> como
                    <code>multiple</code>. No modo de seleção múltipla, o vínculo de valor é um par chave-valor, onde a
                    chave é a <code>Key</code> do nó e o valor é um booleano que indica a seleção.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_multipleNodes" Columns="_columns" SelectionMode="multiple"
                             @bind-Selection="_multiSelection" EmptyMessage="Nenhum registro encontrado"/>
                <p class="mt-2">Selecionados: <b>@CountSelection(_multiSelection)</b></p>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionMultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Seleção - Checkbox" Id="checkbox">
            <Description>
                <p>
                    A seleção de múltiplos nós via checkboxes é habilitada configurando <code>SelectionMode</code>
                    como <code>checkbox</code>. Uma coluna de seleção é adicionada automaticamente, com propagação
                    para os descendentes e recálculo dos ancestrais.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_checkboxNodes" Columns="_columns" SelectionMode="checkbox"
                             @bind-Selection="_checkboxSelection" EmptyMessage="Nenhum registro encontrado"/>
                <p class="mt-2">Selecionados: <b>@CountSelection(_checkboxSelection)</b></p>
            </ChildContent>
            <Code><CodeBlock Code="@SelectionCheckboxCode"/></Code>
        </DocSection>

        <DocSection Label="Paginação" Id="paginatorbasic">
            <Description>
                <p>
                    A paginação é habilitada adicionando a propriedade <code>Paginator</code> e definindo
                    <code>Rows</code> por página. A posição é controlada por <code>PaginatorPosition</code>
                    (<code>top</code>, <code>bottom</code> ou <code>both</code>). A paginação percorre os nós
                    raiz; os descendentes expandidos de cada raiz acompanham a página.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_pageNodes" Columns="_columns" Paginator="true" Rows="5"
                             RowsPerPageOptions="_rowsPerPage" @bind-First="_first" OnPageChange="OnPage"
                             EmptyMessage="Nenhum registro encontrado"/>
                <p class="mt-2">Página atual: <b>@_pageLabel</b></p>
            </ChildContent>
            <Code><CodeBlock Code="@PaginatorCode"/></Code>
        </DocSection>

        <DocSection Label="Carregamento" Id="loading-mask">
            <Description>
                <p>
                    A propriedade <code>Loading</code> exibe uma camada de máscara para indicar estado ocupado. O
                    conteúdo pode ser customizado por <code>LoadingTemplate</code>.
                </p>
            </Description>
            <ChildContent>
                <div class="flex flex-wrap gap-2 mb-4">
                    <OpButton Label="Alternar carregamento" Icon="pi pi-refresh" OnClick="ToggleLoading"/>
                </div>
                <OpTreeTable Nodes="_basicNodes" Columns="_columns" Loading="_loading" EmptyMessage="Nenhum registro encontrado"/>
            </ChildContent>
            <Code><CodeBlock Code="@LoadingCode"/></Code>
        </DocSection>

        <DocSection Label="Vazio" Id="empty">
            <Description>
                <p>
                    Quando não há nós, é exibido <code>EmptyMessage</code> ou o conteúdo de
                    <code>EmptyTemplate</code>.
                </p>
            </Description>
            <ChildContent>
                <OpTreeTable Nodes="_emptyNodes" Columns="_columns" EmptyMessage="Nenhum registro encontrado"/>
            </ChildContent>
            <Code><CodeBlock Code="@EmptyCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O papel padrão da tabela é <code>treegrid</code>. Os elementos de cabeçalho, corpo e rodapé usam
                    <code>rowgroup</code>, as linhas usam o papel <code>row</code>, as células de cabeçalho têm
                    <code>columnheader</code> e as células de corpo usam o papel <code>cell</code>.
                </p>
                <p>
                    Os elementos de linha gerenciam <code>aria-expanded</code> e o atributo <code>aria-level</code>
                    para definir a hierarquia.
                </p>
                <p>
                    Quando a seleção está habilitada, as linhas expõem <code>aria-selected</code>. No modo checkbox, o
                    checkbox interno usa o papel <code>checkbox</code> com o atributo de estado
                    <code>aria-checked</code>.
                </p>
                <p>
                    O Paginator é um componente autônomo usado dentro do TreeTable; consulte a documentação do
                    Paginator para os recursos de acessibilidade.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o primeiro nó selecionado quando o foco entra no componente; se não houver nenhum, o primeiro elemento recebe o foco. Se o foco já estiver dentro do componente, move o foco para o próximo elemento focalizável na sequência de tabulação da página." },
                              new[] { "shift + tab", "Move o foco para o último nó selecionado quando o foco entra no componente; se não houver nenhum, o primeiro elemento recebe o foco. Se o foco já estiver dentro do componente, move o foco para o elemento focalizável anterior na sequência de tabulação da página." },
                              new[] { "enter", "Seleciona o nó em foco." },
                              new[] { "space", "Seleciona o nó em foco." },
                              new[] { "down arrow", "Move o foco para o próximo nó." },
                              new[] { "up arrow", "Move o foco para o nó anterior." },
                              new[] { "right arrow", "Se o nó estiver fechado, abre o nó; caso contrário, move o foco para o primeiro nó filho." },
                              new[] { "left arrow", "Se o nó estiver aberto, fecha o nó; caso contrário, move o foco para o nó pai." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Nodes", "IReadOnlyList&lt;OpTreeNode&gt;?", "null", "Coleção de nós raiz." },
                              new[] { "Columns", "IReadOnlyList&lt;OpTreeTableColumn&gt;", "[]", "Definição das colunas." },
                              new[] { "SelectionMode", "string?", "null", "Modo de seleção: <code>single</code>, <code>multiple</code> ou <code>checkbox</code>." },
                              new[] { "Selection", "object?", "null", "Em <code>single</code>, um <code>OpTreeNode</code>; em <code>multiple</code>/<code>checkbox</code>, um <code>IReadOnlyDictionary&lt;string, bool&gt;</code> chaveado por <code>Key</code>." },
                              new[] { "SelectionChanged", "EventCallback&lt;object?&gt;", "—", "Notifica a mudança de seleção (usar com <code>@@bind-Selection</code>)." },
                              new[] { "Loading", "bool", "false", "Exibe a máscara de carregamento." },
                              new[] { "EmptyMessage", "string?", "No records found", "Mensagem exibida quando não há nós." },
                              new[] { "Paginator", "bool", "false", "Habilita a paginação." },
                              new[] { "Rows", "int", "10", "Número de linhas por página." },
                              new[] { "First", "int", "0", "Índice da primeira linha da página (usar com <code>@@bind-First</code>)." },
                              new[] { "FirstChanged", "EventCallback&lt;int&gt;", "—", "Notifica a mudança de página." },
                              new[] { "TotalRecords", "int", "0", "Total lógico de registros no modo lazy; 0 usa a contagem real." },
                              new[] { "Lazy", "bool", "false", "Indica carregamento sob demanda (flag; não há callback de dados)." },
                              new[] { "RowHover", "bool", "true", "Destaca a linha sob o cursor." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "PaginatorPosition", "string", "bottom", "Posição do paginador: <code>top</code>, <code>bottom</code> ou <code>both</code>." },
                              new[] { "PageLinks", "int", "5", "Quantidade de links de página exibidos." },
                              new[] { "AlwaysShowPaginator", "bool", "true", "Exibe o paginador mesmo com uma única página." },
                              new[] { "RowsPerPageOptions", "IReadOnlyList&lt;int&gt;?", "null", "Opções do seletor de linhas por página." },
                              new[] { "StyleClass / AdditionalAttributes", "—", "—", "Classes e atributos extras repassados ao elemento raiz." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Templates" Id="api-templates">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "HeaderTemplate", "RenderFragment?", "Cabeçalho da tabela." },
                              new[] { "FooterTemplate", "RenderFragment?", "Rodapé da tabela." },
                              new[] { "EmptyTemplate", "RenderFragment?", "Conteúdo exibido no lugar de <code>EmptyMessage</code>." },
                              new[] { "LoadingTemplate", "RenderFragment?", "Conteúdo exibido na máscara de carregamento." },
                              new[] { "CaptionTemplate", "RenderFragment?", "Legenda/cabeçalho acima da tabela." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Coluna (OpTreeTableColumn)" Id="api-column">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Field", "string", "\"\"", "Campo lido do nó (ou de <code>Node.Data</code>)." },
                              new[] { "Header", "string", "\"\"", "Texto do cabeçalho." },
                              new[] { "Width", "string?", "null", "Largura da coluna (ex.: <code>8rem</code>)." },
                              new[] { "Sortable", "bool", "false", "Marca a coluna como ordenável (exibe o ícone; sem ordenação implementada)." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais da célula." },
                              new[] { "BodyTemplate", "RenderFragment&lt;OpTreeTableCellContext&gt;?", "null", "Conteúdo customizado da célula; recebe <code>Node</code>, <code>Level</code> e <code>Field</code>." },
                              new[] { "Expandable", "bool", "false", "Coluna que recebe o botão de expandir/recolher." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="Eventos" Id="api-events">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnNodeExpand", "EventCallback&lt;OpTreeNode&gt;", "Disparado ao expandir um nó." },
                              new[] { "OnNodeCollapse", "EventCallback&lt;OpTreeNode&gt;", "Disparado ao recolher um nó." },
                              new[] { "OnNodeSelect", "EventCallback&lt;OpTreeNode&gt;", "Disparado ao selecionar um nó." },
                              new[] { "OnNodeUnselect", "EventCallback&lt;OpTreeNode&gt;", "Disparado ao desmarcar um nó." },
                              new[] { "OnPageChange", "EventCallback&lt;OpPaginatorState&gt;", "Disparado quando a página ou o número de linhas muda." },
                              new[] { "SelectionChanged", "EventCallback&lt;object?&gt;", "Disparado quando a seleção muda." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="treetable"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code>, os templates e os <code>AdditionalAttributes</code>.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li><b>Redimensionamento de colunas</b> (<code>resizableColumns</code>, fit/expand) não foi portado.</li>
                        <li><b>Reordenar colunas</b> (<code>reorderableColumns</code>) não foi portado.</li>
                        <li><b>Colunas fixas</b> (<code>frozenColumns</code>) não foi portado.</li>
                        <li><b>Filtro</b> por coluna e global não foi portado.</li>
                        <li><b>Ordenação</b> não foi implementada: <code>Sortable</code> existe na coluna e exibe o ícone, mas não há ordenação nem <code>OnSort</code>; as teclas de cabeçalhos ordenáveis do Angular não se aplicam.</li>
                        <li><b>Edição</b> de células não foi portada.</li>
                        <li><b>Virtual Scroll</b> não foi portado.</li>
                        <li><b>Agrupamento de colunas</b> (<code>rowspan</code>/<code>colspan</code> e <code>colgroup</code>) não foi portado.</li>
                        <li><b>Alternar colunas</b> (column toggle) não foi portado; é possível trocar <code>Columns</code> via código.</li>
                        <li><b>Menu de contexto</b> não foi portado.</li>
                        <li><b>Carregamento lazy</b>: a flag <code>Lazy</code> existe, mas não há callback de dados (<code>OnLazyLoad</code>) nem projeção de <code>TotalRecords</code>.</li>
                        <li><b>Estilo condicional</b> por linha não é automático; aplique-o no <code>BodyTemplate</code>.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private List<OpTreeNode> _basicNodes = new();
    private List<OpTreeNode> _singleNodes = new();
    private List<OpTreeNode> _multipleNodes = new();
    private List<OpTreeNode> _checkboxNodes = new();
    private List<OpTreeNode> _pageNodes = new();
    private List<OpTreeNode> _emptyNodes = new();

    private List<OpTreeTableColumn> _columns = new();
    private readonly IReadOnlyList<int> _rowsPerPage = new[] { 5, 10, 25 };

    private object? _singleSelection;
    private object? _multiSelection;
    private object? _checkboxSelection;
    private bool _loading;
    private int _first;
    private string _pageLabel = "1";

    protected override void OnInitialized()
    {
        _basicNodes = FileTree();
        _singleNodes = FileTree();
        _multipleNodes = FileTree();
        _checkboxNodes = FileTree();
        _pageNodes = FileTree();
        _emptyNodes = new();

        _columns = new List<OpTreeTableColumn>
        {
            new OpTreeTableColumn { Field = "label", Header = "Nome", Expandable = true },
            new OpTreeTableColumn { Field = "size", Header = "Tamanho", Width = "8rem" },
            new OpTreeTableColumn
            {
                Field = "type",
                Header = "Tipo",
                Width = "8rem",
                BodyTemplate = ctx => @<span class="font-semibold">@TypeText(ctx.Node)</span>
            }
        };
    }

    private void ToggleLoading() => _loading = !_loading;

    private void OnPage(OpPaginatorState state)
    {
        _first = state.First;
        _pageLabel = state.Page.ToString();
    }

    private static string SelectedLabel(object? selection) => selection is OpTreeNode node ? node.Label : "nenhum";

    private static int CountSelection(object? selection) =>
        selection is IReadOnlyDictionary<string, bool> map ? map.Count(entry => entry.Value) : 0;

    private static string TypeText(OpTreeNode node) => node.Data is FileRecord record ? record.Type : string.Empty;

    private static List<OpTreeNode> FileTree() => new()
    {
        new OpTreeNode
        {
            Key = "0", Label = "Documentos", Expanded = true, Data = new FileRecord("Documentos", "—", "Pasta"),
            Children = new()
            {
                new OpTreeNode { Key = "0-0", Label = "Contratos.pdf", Leaf = true, Data = new FileRecord("Contratos.pdf", "2 MB", "PDF") },
                new OpTreeNode { Key = "0-1", Label = "Relatório.docx", Leaf = true, Data = new FileRecord("Relatório.docx", "845 KB", "Word") },
                new OpTreeNode { Key = "0-2", Label = "Planilha.xlsx", Leaf = true, Data = new FileRecord("Planilha.xlsx", "120 KB", "Excel") }
            }
        },
        new OpTreeNode
        {
            Key = "1", Label = "Imagens", Expanded = true, Data = new FileRecord("Imagens", "—", "Pasta"),
            Children = new()
            {
                new OpTreeNode { Key = "1-0", Label = "logo.png", Leaf = true, Data = new FileRecord("logo.png", "48 KB", "PNG") },
                new OpTreeNode { Key = "1-1", Label = "banner.jpg", Leaf = true, Data = new FileRecord("banner.jpg", "512 KB", "JPG") },
                new OpTreeNode { Key = "1-2", Label = "icone.svg", Leaf = true, Data = new FileRecord("icone.svg", "12 KB", "SVG") }
            }
        },
        new OpTreeNode { Key = "2", Label = "README.md", Leaf = true, Data = new FileRecord("README.md", "4 KB", "Markdown") }
    };

    private sealed record FileRecord(string Name, string Size, string Type);

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.TreeTable
        @using OpBlazorUI.Base.Models

        <OpTreeTable Nodes="_nodes" Columns="_columns" />

        @code {
            private List<OpTreeTableColumn> _columns = new()
            {
                new() { Field = "label", Header = "Nome", Expandable = true },
                new() { Field = "size", Header = "Tamanho" },
                new() { Field = "type", Header = "Tipo" }
            };
        }
        """;

    private const string BasicCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" />

        @code {
            private List<OpTreeNode> _nodes = new()
            {
                new OpTreeNode
                {
                    Key = "0", Label = "Documentos", Expanded = true,
                    Children = new()
                    {
                        new OpTreeNode { Key = "0-0", Label = "Contratos.pdf", Leaf = true }
                    }
                }
            };

            private List<OpTreeTableColumn> _columns = new()
            {
                new() { Field = "label", Header = "Nome", Expandable = true },
                new() { Field = "size", Header = "Tamanho" },
                new() { Field = "type", Header = "Tipo" }
            };
        }
        """;

    private const string SelectionSingleCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" SelectionMode="single"
                     @bind-Selection="_selection" />

        @code {
            private object? _selection;
        }
        """;

    private const string SelectionMultipleCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" SelectionMode="multiple"
                     @bind-Selection="_selection" />

        @code {
            private object? _selection;
        }
        """;

    private const string SelectionCheckboxCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" SelectionMode="checkbox"
                     @bind-Selection="_selection" />

        @code {
            private object? _selection;
        }
        """;

    private const string PaginatorCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" Paginator="true" Rows="5"
                     RowsPerPageOptions="_rowsPerPage" @bind-First="_first"
                     OnPageChange="OnPage" />

        @code {
            private int _first;
            private IReadOnlyList<int> _rowsPerPage = new[] { 5, 10, 25 };

            private void OnPage(OpPaginatorState state) => _first = state.First;
        }
        """;

    private const string LoadingCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" Loading="_loading" />

        @code {
            private bool _loading;
        }
        """;

    private const string EmptyCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" EmptyMessage="Nenhum registro encontrado" />

        @code {
            private List<OpTreeNode> _nodes = new();
        }
        """;

    private const string AccessibilityCode = """
        <OpTreeTable Nodes="_nodes" Columns="_columns" SelectionMode="single"
                     @bind-Selection="_selection" />
        """;
}
