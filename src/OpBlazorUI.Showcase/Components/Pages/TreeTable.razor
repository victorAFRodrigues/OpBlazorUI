    private static string FolderIcon(OpTreeNode node)
        => node.Leaf == true ? "pi pi-file" : "pi pi-folder";

    // ===================== Handlers =====================
    private void ToggleControlledFolders()
    {
        var expand = Visits(_controlledNodes).Any(node => node.Children is { Count: > 0 } && !node.Expanded);
        foreach (var node in Visits(_controlledNodes))
        {
            if (node.Children is { Count: > 0 })
            {
                node.Expanded = expand;
            }
        }
    }

    private void OnControlledExpand(OpTreeNode node) => _controlledLog = $"expandido: {node.Label}";

    private void OnControlledCollapse(OpTreeNode node) => _controlledLog = $"recolhido: {node.Label}";

    private async Task LoadMask()
    {
        _maskLoading = true;
        await Task.Delay(2000);
        _maskLoading = false;
    }

    private async Task LoadSkeleton()
    {
        _skeletonLoading = true;
        await Task.Delay(2000);
        _skeletonLoading = false;
    }

    private void OnTreePageChanged(OpPaginatorState state)
    {
        _pageState = state.Page;
        _pageRows = state.Rows;
    }

    private void OnSingleSort(OpTreeTableSortEvent e) => _singleSortLog = SortLog(e);

    private void OnMultiSort(OpTreeTableSortEvent e) => _multiSortLog = SortLog(e);

    private void OnRemovableSort(OpTreeTableSortEvent e) => _removableSortLog = SortLog(e);

    private void OnTreeFilters(IReadOnlyDictionary<string, object?> filters) => _treeFilters = filters;

    private void OnTreeNodeSelect(OpTreeNode node) => _eventLog = $"selecionado: {node.Label}";

    private void OnTreeNodeUnselect(OpTreeNode node) => _eventLog = $"desselecionado: {node.Label}";

    private async Task LoadLazyNode(OpTreeNode node)
    {
        await Task.Delay(600);
        node.Children = new List<OpTreeNode>
        {
            FileNode($"{node.Key}-0", $"{node.Label}/arquivo-1.pdf", 12, "PDF"),
            FileNode($"{node.Key}-1", $"{node.Label}/arquivo-2.docx", 5, "Word")
        };
        node.Loading = false;
        _lazyLog = $"filhos de \"{node.Label}\" carregados";
    }

    private void OnTreeLazyLoad(OpTreeTableLazyLoadEvent e)
        => _lazyLog = $"lazy: first={e.First} rows={e.Rows} campo={e.SortField ?? "—"} ordem={e.SortOrder}";

    private void ReorderTreeColumns((int From, int To) info)
    {
        var column = _reorderColumns[info.From];
        _reorderColumns.RemoveAt(info.From);
        _reorderColumns.Insert(info.To, column);
    }

    private static string? FolderRowClass(OpTreeNode node)
        => node.Data is FileRecord record && record.Type == "Pasta" ? "font-bold" : null;

    private async Task TreeContextMenu((OpTreeNode Item, MouseEventArgs Args) info)
    {
        _ctxSelected = info.Item;

        if (_ctxMenu is not null)
        {
            await _ctxMenu.ShowAsync(info.Args.ClientX, info.Args.ClientY);
        }
    }

    private void OnTreeCtxItemClick(OpMenuItem item)
    {
        _ctxLog = $"{item.Label} {_ctxSelected?.Label ?? ""}".Trim();
        _ctxSelected = null;
    }

    private static string SortLog(OpTreeTableSortEvent e)
    {
        if (e.MultiSortMeta.Count > 0)
        {
            return string.Join(", ", e.MultiSortMeta.Select(m => $"{m.Field} ({(m.Order == 1 ? "asc" : "desc")})"));
        }

        return string.IsNullOrEmpty(e.Field) || e.Order == 0
            ? "nenhuma"
            : $"{e.Field} ({(e.Order == 1 ? "asc" : "desc")})";
    }

    // ===================== Utilitários =====================
    private static IEnumerable<OpTreeNode> Visits(IEnumerable<OpTreeNode> nodes)
    {
        foreach (var node in nodes)
        {
            yield return node;
            foreach (var child in Visits(node.Children ?? new List<OpTreeNode>()))
            {
                yield return child;
            }
        }
    }

    private static int CountNodes(IEnumerable<OpTreeNode> nodes) => Visits(nodes).Count();

    private static int TotalSize(OpTreeNode node) => Visits(new[] { node }).Sum(n => ((FileRecord)n.Data!).Size);

    private static string SelectedLabel(object? selection) => selection is OpTreeNode node ? node.Label : "nenhum";

    private static int CountSelection(object? selection)
        => selection is IReadOnlyDictionary<string, bool> map ? map.Count(entry => entry.Value) : 0;

