        <DocSection Label="Temas" Id="theming">
            <ChildContent>
                <DocTokens Component="confirmdialog"/>
                <div class="doc-section-description">
                    <p>A variante <code>Appearance="Badge"</code> usa <code>--p-primary-color</code> (fundo do badge),
                    <code>--p-primary-contrast-color</code> (glifo e texto do botão primário) e
                    <code>--p-text-muted-color</code> (mensagem), além dos tokens padrão de Dialog. Por isso ela
                    acompanha o tema e o modo claro/escuro sem CSS extra por preset.</p>
                </div>
            </ChildContent>
        </DocSection>
    </Theming>

