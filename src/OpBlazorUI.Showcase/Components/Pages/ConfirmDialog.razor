@page "/confirmdialog"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.ConfirmDialog
@using OpBlazorUI.Base.Components.ConfirmDialog.Models
@using OpBlazorUI.Base.Components.Button
@using OpBlazorUI.Base.Components.Toast
@using OpBlazorUI.Base.Services
@using OpBlazorUI.Base.Models

<PageTitle>ConfirmDialog - OpBlazorUI</PageTitle>

<DocComponent Title="ConfirmDialog"
              Description="O ConfirmDialog é uma janela de confirmação controlada por um serviço, reutilizável por várias ações da mesma página.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>
                O diálogo é exibido via <code>OpConfirmationService</code>: injete o serviço, chame
                <code>Confirm()</code> com um <code>ConfirmOptions</code> e coloque um
                <code>&lt;OpConfirmDialog&gt;</code> na página (ou no layout) com o <code>Key</code> correspondente.
                O <code>Key</code> do componente e o <code>Key</code> das opções são comparados por igualdade
                estrita (<code>Ordinal</code>), então um componente sem <code>Key</code> só atende opções sem
                <code>Key</code>. Os callbacks <code>Accept</code> e <code>Reject</code> executam a ação escolhida.
            </Description>
            <ChildContent>
                <div class="card flex justify-center gap-2">
                    <OpButton Label="Salvar" Outlined="true" OnClick="ConfirmSave"/>
                    <OpButton Label="Excluir" Severity="danger" Outlined="true" OnClick="ConfirmDelete"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Posição" Id="position">
            <Description>
                A propriedade <code>Position</code> (nas opções ou no componente) posiciona o diálogo nas bordas e
                cantos da tela: <code>center</code> (padrão), <code>top</code>, <code>bottom</code>,
                <code>left</code>, <code>right</code>, <code>topleft</code>, <code>topright</code>,
                <code>bottomleft</code> e <code>bottomright</code>. O valor definido nas opções sobrescreve o do
                componente.
            </Description>
            <ChildContent>
                <div class="card flex flex-wrap justify-center gap-2">
                    <OpButton Label="Centro" OnClick="@(() => ConfirmPosition("center"))"/>
                    <OpButton Label="Topo" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("top"))"/>
                    <OpButton Label="Base" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("bottom"))"/>
                    <OpButton Label="Esquerda" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("left"))"/>
                    <OpButton Label="Direita" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("right"))"/>
                    <OpButton Label="Topo Esquerda" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("topleft"))"/>
                    <OpButton Label="Topo Direita" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("topright"))"/>
                    <OpButton Label="Base Esquerda" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("bottomleft"))"/>
                    <OpButton Label="Base Direita" Severity="secondary" Outlined="true" OnClick="@(() => ConfirmPosition("bottomright"))"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@PositionCode"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description>
                <code>Message</code>, <code>Header</code> e <code>Icon</code> podem vir das opções do serviço ou de
                templates declarativos no próprio componente. <code>MessageTemplate</code> recebe um
                <code>ConfirmMessageContext</code> com as <code>Options</code> resolvidas; também existem
                <code>HeaderTemplate</code>, <code>FooterTemplate</code> e <code>IconTemplate</code>. Um template
                informado no <code>Confirm()</code> tem precedência sobre o do componente.
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpButton Label="Confirmar com Template" OnClick="ConfirmTemplate"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Headless" Id="headless">
            <Description>
                No modo <code>headless</code>, toda a interface é substituída pelo <code>HeadlessTemplate</code>,
                que recebe um <code>ConfirmHeadlessContext</code> com as <code>Options</code> e as ações
                <code>OnAccept</code>/<code>OnReject</code>. Use-o quando o layout padrão (cabeçalho, ícone e
                rodapé) não servir — nesse caso os botões passam a ser os seus.
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpButton Label="Mostrar Headless" OnClick="ConfirmHeadless"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@HeadlessCode"/></Code>
        </DocSection>

        <DocSection Label="Ícone e Botões Customizados" Id="custom">
            <Description>
                <code>AcceptIcon</code> e <code>RejectIcon</code> adicionam ícones aos botões.
                <code>AcceptButtonProps</code> e <code>RejectButtonProps</code> são dicionários repassados ao
                <code>OpButton</code> (chaves como <code>severity</code>, <code>outlined</code>, <code>text</code>,
                <code>raised</code>, <code>rounded</code> e <code>variant</code>), enquanto
                <code>AcceptButtonStyleClass</code> e <code>RejectButtonStyleClass</code> adicionam classes CSS.
            </Description>
            <ChildContent>
                <div class="card flex justify-center gap-2">
                    <OpButton Label="Confirmar Exclusão" Severity="danger" Outlined="true" OnClick="ConfirmCustom"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@CustomCode"/></Code>
        </DocSection>

        <DocSection Label="Declarativo" Id="declarative">
            <Description>
                Quando o conteúdo é fixo, defina <code>Header</code>, <code>Message</code>, <code>Icon</code> e os
                templates diretamente no <code>&lt;OpConfirmDialog&gt;</code> e abra-o chamando
                <code>ShowDeclarative()</code> via <code>@@ref</code>. O método monta um <code>ConfirmOptions</code>
                a partir dos parâmetros do próprio componente e o envia ao serviço.
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpButton Label="Ação Declarativa" OnClick="ConfirmDeclarative"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@DeclarativeCode"/></Code>
        </DocSection>

        <DocSection Label="Eventos" Id="events">
            <Description>
                <code>OnHide</code> é disparado ao fechar, entregando um <code>ConfirmEvent</code> cujo
                <code>Accepted</code> indica se a ação foi aceita (<code>true</code>) ou rejeitada/fechada
                (<code>false</code>). O mesmo resultado chega ao callback <code>OnClose</code> das opções.
            </Description>
            <ChildContent>
                <div class="card flex flex-col items-center gap-4">
                    <OpButton Label="Confirmar" OnClick="ConfirmEvents"/>
                    <span>Último OnHide: <b>@(_lastHide ?? "—")</b></span>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@EventsCode"/></Code>
        </DocSection>

        <DocSection Label="Appearance Badge" Id="badge">
            <Description>
                <code>Appearance="Badge"</code> é uma extensão do OpBlazorUI: não existe no OptimusUI/PrimeNG.
                Mantém o DOM do upstream e troca só o layout — badge circular sobreposto ao topo do card,
                título e botões centralizados e largura fixa de <code>410px</code>.
                Cor do badge, do botão primário e contraste vêm dos tokens do tema, então a variante acompanha
                claro/escuro e os três presets. Defina <code>Header</code> para o título centralizado e use
                <code>Icon="pi pi-question"</code> para o interrogante dentro do círculo.
            </Description>
            <ChildContent>
                <div class="card flex justify-center">
                    <OpButton Label="Mostrar Badge" OnClick="ConfirmBadge"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@BadgeCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>
                    O diálogo usa o papel <code>alertdialog</code> com <code>aria-modal="true"</code>,
                    <code>aria-labelledby</code> apontando para o título e <code>aria-describedby</code> para a
                    mensagem. Ao abrir, o foco vai para o botão indicado por <code>DefaultFocus</code> (por padrão,
                    o de aceitar) e fica preso ao diálogo enquanto <code>FocusTrap</code> for <code>true</code>; ao
                    fechar, o foco volta ao elemento que disparou a ação. Os nomes acessíveis dos botões vêm de
                    <code>AcceptAriaLabel</code>, <code>RejectAriaLabel</code> e <code>CloseAriaLabel</code> e,
                    quando vazios, do próprio texto visível.
                </p>
            </Description>
            <Code>
                <CodeBlock Code="@AccessibilityCode"/>
                <div class="doc-section-description"><h3>Suporte a teclado</h3></div>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o próximo elemento focável dentro do diálogo." },
                              new[] { "shift + tab", "Move o foco para o elemento focável anterior dentro do diálogo." },
                              new[] { "escape", "Fecha o diálogo (quando <code>CloseOnEscape</code> é <code>true</code>) e devolve o foco ao gatilho." },
                              new[] { "enter", "Aciona o botão focado, fecha o diálogo e devolve o foco ao gatilho." },
                              new[] { "space", "Aciona o botão focado, fecha o diálogo e devolve o foco ao gatilho." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

