            }

            private void ValidateField(FieldIdentifier field)
            {
                _reactiveMessages?.Clear(field);

                if (field.FieldName == nameof(ReactiveModel.Option) && _reactiveModel.Option is null)
                {
                    _reactiveMessages?.Add(field, "Selecione uma opção.");
                }
            }
        }
        """;

    private const string AccessibilityCode = """
        <span id="rotulo-periodo">Período</span>
        <OpSelectButton TValue="StateOption" @bind-Value="_a11y" Options="StateOptions"
                        OptionLabel="Label" OptionValue="Value" AriaLabelledBy="rotulo-periodo" />
        """;
}
