@page "/selectbutton"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.SelectButton

<DocComponent Title="SelectButton"
              Description="SelectButton é usado para escolher um ou vários itens de uma lista usando botões.">

    <Features>
        <DocSection Label="Importação">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico">
            <ChildContent>
                <OpSelectButton TValue="string" @bind-Value="_single" Options="Options"/>
                <div class="mt-2 text-sm">Selecionado: @(_single ?? "—")</div>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Múltiplo">
            <ChildContent>
                <OpSelectButton TValue="string" @bind-MultipleValue="_multiple" Multiple="true" Options="Options"/>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Template de Item">
            <ChildContent>
                <OpSelectButton TValue="string" @bind-Value="_template" Options="Options">
                    <ItemTemplate Context="ctx">
                        <div style="display:flex; align-items:center; gap:.375rem;">
                            <i class="pi pi-check" style="font-size:.75rem"></i>
                            <span>@ctx.Option</span>
                        </div>
                    </ItemTemplate>
                </OpSelectButton>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Inválido / Desabilitado / Fluido / Tamanho">
            <ChildContent>
                <div class="flex flex-col gap-3">
                    <OpSelectButton TValue="string" @bind-Value="_v1" Options="Options" Invalid="true"/>
                    <OpSelectButton TValue="string" @bind-Value="_v2" Options="Options" Disabled="true"/>
                    <OpSelectButton TValue="string" @bind-Value="_v3" Options="Options" Fluid="true"/>
                    <OpSelectButton TValue="string" @bind-Value="_v4" Options="Options" Size="small"/>
                </div>
            </ChildContent>
            <Code><CodeBlock Code="@StateCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades">
            <ChildContent>
                <ApiTable Caption="Propriedades"
                          Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Options", "IReadOnlyList&lt;object&gt;?", "null", "Coleção de opções." },
                              new[] { "OptionLabel", "string?", "null", "Propriedade usada como rótulo." },
                              new[] { "OptionValue", "string?", "null", "Propriedade usada como valor." },
                              new[] { "OptionDisabled", "string?", "null", "Propriedade que indica opção desabilitada." },
                              new[] { "Value", "TValue?", "null", "Valor selecionado (single)." },
                              new[] { "Multiple", "bool", "false", "Seleção múltipla." },
                              new[] { "MultipleValue", "IReadOnlyList&lt;TValue&gt;?", "null", "Valores selecionados (multiple)." },
                              new[] { "AllowEmpty", "bool", "true", "Permite desmarcar tudo." },
                              new[] { "Disabled", "bool", "false", "Desabilitado." },
                              new[] { "Invalid", "bool", "false", "Estado inválido." },
                              new[] { "Fluid", "bool", "false", "Ocupa toda a largura." },
                              new[] { "Size", "string?", "null", "Tamanho: <code>small</code> ou <code>large</code>." },
                              new[] { "StyleClass", "string?", "null", "Classes adicionais." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Eventos">
            <ChildContent>
                <ApiTable Caption="Eventos"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "OnChange", "EventCallback&lt;TValue?&gt;", "Disparado ao mudar o valor." }
                          })"/>
            </ChildContent>
        </DocSection>
        <DocSection Label="Templates">
            <ChildContent>
                <ApiTable Caption="Templates"
                          Headers="@(new[] { "Nome", "Tipo", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "ItemTemplate", "RenderFragment&lt;(TValue Option, int Index)&gt;?", "Template do item." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas">
            <ChildContent><DocTokens Component="selectbutton"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent>
                <div class="doc-section-description"><p>O pass-through (pt) do Angular ainda não foi portado. Use <code>StyleClass</code> e <code>ItemTemplate</code> para customização.</p></div>
            </ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent>
                <div class="doc-section-description"><p>Nenhum problema conhecido no momento.</p></div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private string? _single;
    private IReadOnlyList<string>? _multiple;
    private string? _template;
    private string? _v1;
    private string? _v2;
    private string? _v3;
    private string? _v4;

    private static readonly List<string> Options = new() { "Opção 1", "Opção 2", "Opção 3" };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.SelectButton

        <OpSelectButton TValue="string" @bind-Value="_single" Options="Options" />
        """;

    private const string BasicCode = """
        <OpSelectButton TValue="string" @bind-Value="_single" Options="Options" />

        @code {
            private string? _single;
            private static readonly List<string> Options = new() { "Opção 1", "Opção 2", "Opção 3" };
        }
        """;

    private const string MultipleCode = """
        <OpSelectButton TValue="string" @bind-MultipleValue="_multiple" Multiple="true" Options="Options" />

        @code {
            private IReadOnlyList<string>? _multiple;
        }
        """;

    private const string TemplateCode = """
        <OpSelectButton TValue="string" @bind-Value="_template" Options="Options">
            <ItemTemplate Context="ctx">
                <div style="display:flex; align-items:center; gap:.375rem;">
                    <i class="pi pi-check" style="font-size:.75rem"></i>
                    <span>@ctx.Option</span>
                </div>
            </ItemTemplate>
        </OpSelectButton>
        """;

    private const string StateCode = """
        <OpSelectButton TValue="string" @bind-Value="_v1" Options="Options" Invalid="true" />
        <OpSelectButton TValue="string" @bind-Value="_v2" Options="Options" Disabled="true" />
        <OpSelectButton TValue="string" @bind-Value="_v3" Options="Options" Fluid="true" />
        <OpSelectButton TValue="string" @bind-Value="_v4" Options="Options" Size="small" />
        """;
}
