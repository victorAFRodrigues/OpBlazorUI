@page "/accordion"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc

<PageTitle>Accordion - OpBlazorUI</PageTitle>

<DocComponent Title="Accordion"
              Description="Agrupa uma coleção de conteúdos em abas. Componente ainda não portado para o Blazor: os textos e exemplos abaixo são da documentação de referência (PrimeNG/Optimus UI v21 em Angular) e serão substituídos por exemplos reais quando o componente existir.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode" Language="typescript"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description><p>Accordion é definido usando os componentes <code>AccordionPanel</code>, <code>AccordionHeader</code> e <code>AccordionContent</code>. Cada AccordionPanel deve conter uma propriedade <code>value</code> única para especificar o item ativo.</p></Description>
            <Code><CodeBlock Code="@BasicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Dinâmico" Id="dynamic">
            <Description><p>AccordionPanel pode ser gerado dinamicamente usando o bloco padrão <code>&#64;for</code>.</p></Description>
            <Code><CodeBlock Code="@DynamicCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Múltiplo" Id="multiple">
            <Description><p>Por padrão, apenas uma aba por vez pode ficar ativa; habilitar a propriedade <code>multiple</code> muda esse comportamento para permitir várias abas. Nesse caso, <code>activeIndex</code> precisa ser um array.</p></Description>
            <Code><CodeBlock Code="@MultipleCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Desabilitado" Id="disabled">
            <Description><p>Habilitar a propriedade <code>disabled</code> de um AccordionTab impede a interação do usuário.</p></Description>
            <Code><CodeBlock Code="@DisabledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Controlado" Id="controlled">
            <Description><p>Os painéis podem ser controlados programaticamente usando a propriedade <code>value</code> como modelo.</p></Description>
            <Code><CodeBlock Code="@ControlledCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Template" Id="template">
            <Description><p>O Accordion é personalizado com o template <code>toggleicon</code>.</p></Description>
            <Code><CodeBlock Code="@TemplateCode" Language="html"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Os elementos de cabeçalho do Accordion têm o papel <code>button</code> e usam <code>aria-controls</code> para definir o id da seção de conteúdo, além de <code>aria-expanded</code> para o estado de visibilidade. O valor lido de um cabeçalho vem por padrão da propriedade <code>header</code> e pode ser customizado com <code>aria-label</code> ou <code>aria-labelledby</code>. Cabeçalhos desabilitados usam <code>aria-disabled</code> e são excluídos da navegação por teclado. O conteúdo usa o papel <code>region</code>, define um id que corresponde ao <code>aria-controls</code> do cabeçalho e uma referência <code>aria-labelledby</code> ao cabeçalho.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o próximo elemento focável na sequência de tabulação da página." },
                              new[] { "shift + tab", "Move o foco para o elemento focável anterior na sequência de tabulação da página." },
                              new[] { "enter", "Alterna a visibilidade do conteúdo." },
                              new[] { "space", "Alterna a visibilidade do conteúdo." },
                              new[] { "down arrow", "Move o foco para o próximo cabeçalho." },
                              new[] { "up arrow", "Move o foco para o cabeçalho anterior." },
                              new[] { "home", "Move o foco para o primeiro cabeçalho." },
                              new[] { "end", "Move o foco para o último cabeçalho." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="API" Id="api">
            <ChildContent><div class="doc-section-description"><p>A API ainda não está disponível: será documentada a partir do <code>.razor.cs</code> quando o componente for portado.</p></div></ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Temas" Id="theming">
            <ChildContent><div class="doc-section-description"><p>Os tokens de tema já existem no tema gerado (<code>@@openng/optimus-ui-themes</code>); a tabela de classes e tokens será adicionada junto com o componente.</p></div></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não será portado como tal; a customização será feita por parâmetros e <code>StyleClass</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos">
            <ChildContent><div class="doc-section-description"><p>Componente ainda não portado para o Blazor. Os exemplos exibidos são da documentação de referência em Angular e serão substituídos por exemplos reais.</p></div></ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

