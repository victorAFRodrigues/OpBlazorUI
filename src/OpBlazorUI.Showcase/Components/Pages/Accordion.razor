@page "/accordion"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Accordion

<PageTitle>Accordion - OpBlazorUI</PageTitle>

<DocComponent Title="Accordion"
              Description="O Accordion agrupa painéis de conteúdo que podem ser expandidos e recolhidos.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Padrão" Id="basic">
            <Description>Por padrão apenas um painel fica aberto por vez.</Description>
            <ChildContent>
                <OpAccordion @bind-ActiveIndexes="_single">
                    <OpAccordionPanel Header="Cabeçalho I">
                        <p class="m-0">Conteúdo do primeiro painel.</p>
                    </OpAccordionPanel>
                    <OpAccordionPanel Header="Cabeçalho II">
                        <p class="m-0">Conteúdo do segundo painel.</p>
                    </OpAccordionPanel>
                    <OpAccordionPanel Header="Cabeçalho III">
                        <p class="m-0">Conteúdo do terceiro painel.</p>
                    </OpAccordionPanel>
                </OpAccordion>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Múltiplo" Id="multiple">
            <Description>Com <code>Multiple</code>, vários painéis podem ficar abertos ao mesmo tempo.</Description>
            <ChildContent>
                <OpAccordion Multiple="true" ActiveIndexes="@(new[] { 0, 1 })">
                    <OpAccordionPanel Header="Cabeçalho I">
                        <p class="m-0">Conteúdo do primeiro painel.</p>
                    </OpAccordionPanel>
                    <OpAccordionPanel Header="Cabeçalho II">
                        <p class="m-0">Conteúdo do segundo painel.</p>
                    </OpAccordionPanel>
                    <OpAccordionPanel Header="Cabeçalho III">
                        <p class="m-0">Conteúdo do terceiro painel.</p>
                    </OpAccordionPanel>
                </OpAccordion>
            </ChildContent>
            <Code><CodeBlock Code="@MultipleCode"/></Code>
        </DocSection>

        <DocSection Label="Template de cabeçalho" Id="template">
            <Description>O <code>HeaderTemplate</code> permite conteúdo customizado no cabeçalho.</Description>
            <ChildContent>
                <OpAccordion ActiveIndexes="@(new[] { 0 })">
                    <OpAccordionPanel>
                        <HeaderTemplate>
                            <span class="flex items-center gap-2">
                                <i class="pi pi-user" aria-hidden="true"></i>
                                <span style="font-weight: 600;">Usuário</span>
                            </span>
                        </HeaderTemplate>
                        <ChildContent>
                            <p class="m-0">Detalhes do usuário.</p>
                        </ChildContent>
                    </OpAccordionPanel>
                    <OpAccordionPanel Header="Sistema">
                        <p class="m-0">Detalhes do sistema.</p>
                    </OpAccordionPanel>
                </OpAccordion>
            </ChildContent>
            <Code><CodeBlock Code="@TemplateCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>O cabeçalho usa <code>role="button"</code> com <code>aria-expanded</code> e <code>aria-controls</code>; o conteúdo usa <code>role="region"</code>.</p>
                <h3>Suporte a teclado</h3>
            </Description>
            <Code>
                <ApiTable Headers="@(new[] { "Tecla", "Função" })"
                          Rows="@(new[] {
                              new[] { "tab", "Move o foco para o cabeçalho." },
                              new[] { "enter / space", "Expande ou recolhe o painel." }
                          })"/>
            </Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="OpAccordion" Id="api-acc">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Multiple", "bool", "false", "Permite vários painéis abertos." },
                              new[] { "ActiveIndexes", "IReadOnlyList&lt;int&gt;", "[]", "Índices abertos (usar <code>@@bind-ActiveIndexes</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>

        <DocSection Label="OpAccordionPanel" Id="api-panel">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Header", "string?", "null", "Texto do cabeçalho." },
                              new[] { "Disabled", "bool", "false", "Desabilita o painel." },
                              new[] { "HeaderTemplate", "RenderFragment?", "null", "Cabeçalho customizado." },
                              new[] { "ChildContent", "RenderFragment?", "null", "Conteúdo do painel." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="accordion"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>A expansão é controlada por <code>ActiveIndexes</code> (lista de índices), em vez de <code>value</code> por painel como no Angular.</li>
                        <li>A animação usa transição CSS de <code>grid-template-rows</code> (não o motion do upstream).</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private IReadOnlyList<int> _single = new[] { 0 };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Accordion

        <OpAccordion>
            <OpAccordionPanel Header="Cabeçalho I">Conteúdo</OpAccordionPanel>
            <OpAccordionPanel Header="Cabeçalho II">Conteúdo</OpAccordionPanel>
        </OpAccordion>
        """;

    private const string BasicCode = """
        <OpAccordion @bind-ActiveIndexes="_active">
            <OpAccordionPanel Header="Cabeçalho I"><p>Conteúdo 1</p></OpAccordionPanel>
            <OpAccordionPanel Header="Cabeçalho II"><p>Conteúdo 2</p></OpAccordionPanel>
        </OpAccordion>

        @code {
            private IReadOnlyList<int> _active = new[] { 0 };
        }
        """;

    private const string MultipleCode = """
        <OpAccordion Multiple="true" ActiveIndexes="@(new[] { 0, 1 })">
            <OpAccordionPanel Header="Cabeçalho I">...</OpAccordionPanel>
            <OpAccordionPanel Header="Cabeçalho II">...</OpAccordionPanel>
        </OpAccordion>
        """;

    private const string TemplateCode = """
        <OpAccordion ActiveIndexes="@(new[] { 0 })">
            <OpAccordionPanel>
                <HeaderTemplate>
                    <span class="flex items-center gap-2">
                        <i class="pi pi-user"></i>
                        <span>Usuário</span>
                    </span>
                </HeaderTemplate>
                <ChildContent><p>Detalhes do usuário.</p></ChildContent>
            </OpAccordionPanel>
        </OpAccordion>
        """;
}
