@page "/tabmenu"
@namespace OpBlazorUI.Showcase.Components.Pages
@using OpBlazorUI.Showcase.Components.Doc
@using OpBlazorUI.Base.Components.Tabs
@using OpBlazorUI.Base.Models

<PageTitle>TabMenu - OpBlazorUI</PageTitle>

<DocComponent Title="TabMenu"
              Description="O TabMenu exibe uma lista horizontal de itens de navegação no estilo de abas.">

    <Features>
        <DocSection Label="Importação" Id="import">
            <Code><CodeBlock Code="@ImportCode"/></Code>
        </DocSection>

        <DocSection Label="Básico" Id="basic">
            <Description>O <code>Model</code> define os itens; o item ativo é destacado.</Description>
            <ChildContent>
                <OpTabMenu Model="_items" @bind-ActiveIndex="_active"/>
            </ChildContent>
            <Code><CodeBlock Code="@BasicCode"/></Code>
        </DocSection>

        <DocSection Label="Com ícones" Id="icons">
            <Description>Cada item pode ter um ícone e ficar desabilitado.</Description>
            <ChildContent>
                <OpTabMenu Model="_icons" @bind-ActiveIndex="_iconsActive"/>
            </ChildContent>
            <Code><CodeBlock Code="@IconsCode"/></Code>
        </DocSection>

        <DocSection Label="Acessibilidade" Id="accessibility">
            <Description>
                <h3>Leitor de tela</h3>
                <p>Os itens usam <code>role="tab"</code> com <code>aria-selected</code>.</p>
                <h3>Suporte a teclado</h3>
                <p>Os links são focáveis com <code>tab</code> e acionáveis com <code>enter</code>.</p>
            </Description>
            <Code><CodeBlock Code="@AccessibilityCode"/></Code>
        </DocSection>
    </Features>

    <Api>
        <DocSection Label="Propriedades" Id="api-props">
            <ChildContent>
                <ApiTable Headers="@(new[] { "Nome", "Tipo", "Padrão", "Descrição" })"
                          Rows="@(new[] {
                              new[] { "Model", "IReadOnlyList&lt;OpMenuItem&gt;", "[]", "Itens de navegação." },
                              new[] { "ActiveIndex", "int", "0", "Índice ativo (usar <code>@@bind-ActiveIndex</code>)." },
                              new[] { "AriaLabel", "string?", "null", "Rótulo acessível." },
                              new[] { "OnItemClick", "EventCallback&lt;OpMenuItem&gt;", "—", "Disparado ao clicar em um item (após <code>Command</code>)." }
                          })"/>
            </ChildContent>
        </DocSection>
    </Api>

    <Theming>
        <DocSection Label="Classes CSS e Tokens" Id="theming">
            <ChildContent><DocTokens Component="tabmenu"/></ChildContent>
        </DocSection>
    </Theming>

    <Passthrough>
        <DocSection Label="Pass Through" Id="pt">
            <ChildContent><div class="doc-section-description"><p>O pass-through (pt) do Angular não é portado; use <code>StyleClass</code> e os <code>AdditionalAttributes</code>.</p></div></ChildContent>
        </DocSection>
    </Passthrough>

    <KnownIssues>
        <DocSection Label="Problemas Conhecidos" Id="issues">
            <ChildContent>
                <div class="doc-section-description">
                    <ul>
                        <li>TabMenu foi removido do PrimeNG atual; nesta biblioteca é uma variante de navegação (sem referência upstream).</li>
                        <li>A navegação usa <code>Url</code> (link nativo), sem integração com o roteador do Blazor.</li>
                    </ul>
                </div>
            </ChildContent>
        </DocSection>
    </KnownIssues>
</DocComponent>

@code {
    private int _active;
    private int _iconsActive;
    private readonly List<OpMenuItem> _items = new()
    {
        new OpMenuItem { Label = "Início", Url = "#" },
        new OpMenuItem { Label = "Recursos", Url = "#" },
        new OpMenuItem { Label = "Preços", Url = "#" }
    };
    private readonly List<OpMenuItem> _icons = new()
    {
        new OpMenuItem { Label = "Perfil", Icon = "pi pi-user", Url = "#" },
        new OpMenuItem { Label = "Configurações", Icon = "pi pi-cog", Url = "#" },
        new OpMenuItem { Label = "Bloqueado", Icon = "pi pi-lock", Disabled = true }
    };

    private const string ImportCode = """
        @using OpBlazorUI.Base.Components.Tabs
        @using OpBlazorUI.Base.Models

        <OpTabMenu Model="_items" @bind-ActiveIndex="_active" />
        """;

    private const string BasicCode = """
        <OpTabMenu Model="_items" @bind-ActiveIndex="_active" />

        @code {
            private int _active;
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Início", Url = "#" },
                new OpMenuItem { Label = "Recursos", Url = "#" },
                new OpMenuItem { Label = "Preços", Url = "#" }
            };
        }
        """;

    private const string IconsCode = """
        <OpTabMenu Model="_items" @bind-ActiveIndex="_active" />

        @code {
            private List<OpMenuItem> _items = new()
            {
                new OpMenuItem { Label = "Perfil", Icon = "pi pi-user", Url = "#" },
                new OpMenuItem { Label = "Configurações", Icon = "pi pi-cog", Url = "#" },
                new OpMenuItem { Label = "Bloqueado", Icon = "pi pi-lock", Disabled = true }
            };
        }
        """;

    private const string AccessibilityCode = """
        <OpTabMenu AriaLabel="Navegação principal" Model="_items" @bind-ActiveIndex="_active" />
        """;
}
