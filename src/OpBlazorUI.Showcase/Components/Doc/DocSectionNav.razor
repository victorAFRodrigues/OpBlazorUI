@namespace OpBlazorUI.Showcase.Components.Doc

<div class="doc-section-nav">
    <div class="doc-section-nav-container">
        <ul>
            @foreach (var item in Items)
            {
                <li class="navbar-item">
                    <a href="#@Slug(item)"><button type="button">@item</button></a>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    [Parameter] public IReadOnlyList<string> Items { get; set; } = [];

    private static string Slug(string s) => s.ToLowerInvariant().Replace(" ", "-");
}
