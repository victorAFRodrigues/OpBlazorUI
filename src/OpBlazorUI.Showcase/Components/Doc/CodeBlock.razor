@namespace OpBlazorUI.Showcase.Components.Doc

<div class="doc-section-code">
    <div class="doc-section-code-buttons">
        <button type="button" title="Copy Code" aria-label="Copy Code" onclick="window.opCopy(this)">
            <i class="pi pi-copy"></i>
        </button>
    </div>
    <pre><code class="language-@Language">@((MarkupString)_html)</code></pre>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Language { get; set; } = "razor";

    private string _html = "";
    private string? _lastCode;
    private string? _lastLanguage;

    protected override void OnParametersSet()
    {
        if (Code == _lastCode && Language == _lastLanguage) return;
        _lastCode = Code;
        _lastLanguage = Language;
        _html = SyntaxHighlighter.Highlight(Code, Language);
    }
}
